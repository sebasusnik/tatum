# A dry FM pluck: two operators at a 1.41 ratio for a metallic edge, the
# modulator gone in 70 ms so only the attack rings. A detail layer over a
# dark groove, not a melody.
module fm pluck {
  algorithm two_op
  level 2.0
  mod_index 45%
  feedback 12%
  waveform sine
  op0_ratio 1x
  op1_ratio 1.41x
  op0_envelope 0.001 0.28 0 0.12
  op1_envelope 0.001 0.07 0.05 0.05
}
