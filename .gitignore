target/

# The web UI was an experiment and is being rewritten outside this tree. The
# worklet that drove the engine from it is kept in wasm/examples/worklet/.
web/

# macOS
.DS_Store

# Renders are artifacts, not source. The .synth file is the master;
# anything you can regenerate by running it does not belong here.
*.wav
*.mp3
*.flac
*.ogg
*.aif
*.aiff
*.m4a
test_output/
core/test_output/

# Agent scratch. The skills under .claude/skills/ ARE tracked.
.claude/worktrees/
.claude/settings.local.json

# Sets that did not make the cut. They still play; they are just not
# worth 3000 lines of near-duplicate text in the history.
sets/scratch/

# Planning and session notes. These are working documents -- they are written
# by whoever is at the keyboard, they go stale between one session and the
# next, and a diff of them says nothing about the code. The tracked
# documentation is README.md and docs/, which describe what the thing does.
BACKLOG.md
IMPROVEMENTS.md
PLAN.md
PROMPT.md
ROADMAP.md
UX_PLAN.md
docs/mcp-dogfood/
