# set: bars=8 phase=outro energy=2
# set-note: The close — `sub` goes out to 0, `drums` thin to `beat_air` at 0.14 and the pad drops to 0.12 on `chords_low` with its `ph` bypassed again, `air` holding `air_hold` into the reverb tail; three voices, back where the set opened.

use "../../examples/rigs/proghouse_rig.synth"

track drums { play beat_air level 0.280 }
track sub { level 0.000 out > lowpass(170hz, 0.02) as lp > saturate(0.25, wet=1.0) as drive > master }
track pad { level 0.048 delay_send 0.12 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=0.0) as ph > autopan(0.3, bars=10, wet=1.0) as pan > master }
track air { level 0.070 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
