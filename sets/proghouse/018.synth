# set: bars=12 phase=outro energy=5
# set-note: The long exhale — `lead` and `bass` go out to 0, `drums` ease back to `beat_main` at 0.20 and `sub` to `sub_hold` at 0.14, and `air` drifts in on `air_hold` at 0.10 over the breathing pad; four voices, coming down.

use "../../examples/rigs/proghouse_rig.synth"

track drums { play beat_main level 0.400 }
track sub { level 0.112 out > lowpass(170hz, 0.02) as lp > saturate(0.25, wet=1.0) as drive > master }
track bass { play bass_c level 0.000 }
track pad { level 0.064 delay_send 0.12 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=1.0) as ph > autopan(0.3, bars=10, wet=1.0) as pan > master }
track lead { level 0.000 delay_send 0.45 reverb_send 0.5 out > highpass(300, 0.02) as hp > autowah(0.6, base=900hz, range=2800hz, peak=0.25, wet=1.0) as wah > lowpass(8khz, 0.02) as lp > master }
track air { level 0.070 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
