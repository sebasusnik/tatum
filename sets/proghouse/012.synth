# set: bars=24 phase=breakdown energy=3
# set-note: The floor drops away — `drums`, `sub` and `bass` all fall to 0 and stay out for twenty-four bars while `pad` holds `chords_low` at 0.16 with its `ph` full wet, `rhodes` lifts to `chords_high`, and `lead` (`lead_b` 0.13), `air` (`air_lift` 0.11) and `sweep` (`sweep_slow` 0.10) open the room on long reverb sends; five voices, no kick.

use "../../examples/rigs/proghouse_rig.synth"

track drums { play beat_main level 0.000 }
track sub { play sub_push level 0.000 out > lowpass(170hz, 0.02) as lp > saturate(0.25, wet=1.0) as drive > master }
track bass { level 0.000 }
track pad { level 0.064 delay_send 0.2 reverb_send 0.55 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=1.0) as ph > autopan(0.3, bars=10, wet=0.0) as pan > master }
track rhodes { play chords_high level 0.072 delay_send 0.3 reverb_send 0.5 out > highpass(260, 0.02) as hp > vowel(o, a, bars=16, wet=1.0) as vox > lowpass(5khz, 0.02) as lp > master }
track lead { play lead_b level 0.091 delay_send 0.45 reverb_send 0.5 out > highpass(300, 0.02) as hp > autowah(0.6, base=900hz, range=2800hz, peak=0.25, wet=1.0) as wah > lowpass(8khz, 0.02) as lp > master }
track air { play air_lift level 0.077 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
track sweep { level 0.10 reverb_send 0.4 }
