# set: bars=8 phase=intro energy=3
# set-note: Pad swaps up to `chords_high` and its phaser opens to full, so the same four voices turn brighter and start to move without anything new coming in.

use "../../examples/rigs/proghouse_rig.synth"

track drums { level 0.360 }
track sub { level 0.120 }
track pad { play chords_high level 0.056 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=1.0) as ph > autopan(0.3, bars=10, wet=0.0) as pan > master }
track air { level 0.070 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
