# set: bars=12 phase=groove energy=5
# set-note: `bass` arrives on `bass_a` at 0.13 with its `lp` bypassed so it stays open and round, and the pad falls back to `chords_low` to sit under it — five voices, nothing out, the groove landed.

use "../../examples/rigs/proghouse_rig.synth"

track drums { play beat_main level 0.360 }
track sub { level 0.120 }
track pad { level 0.056 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=1.0) as ph > autopan(0.3, bars=10, wet=0.0) as pan > master }
track bass { level 0.169 }
track pluck { level 0.077 }
track air { level 0.000 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
