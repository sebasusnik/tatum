# set: bars=8 phase=transition energy=6
# set-note: Thinning toward the breakdown — `rhodes` comes in on `chords_stab` at 0.12 with its `vox` at full wet exactly as `lead` falls to 0, while `drums` ease back to `beat_main` and `bass` to the plain off-beat `bass_a`; still five voices, but the room is opening up.

use "../../examples/rigs/proghouse_rig.synth"

track drums { play beat_main level 0.520 }
track sub { play sub_push level 0.168 out > lowpass(170hz, 0.02) as lp > saturate(0.25, wet=1.0) as drive > master }
track pad { level 0.096 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=1.0) as ph > autopan(0.3, bars=10, wet=0.0) as pan > master }
track bass { level 0.247 }
track pluck { level 0.000 out > highpass(400, 0.02) as hp > autopan(0.45, bars=7, wet=1.0) as pan > master }
track rhodes { level 0.072 out > highpass(260, 0.02) as hp > vowel(o, a, bars=16, wet=1.0) as vox > lowpass(5khz, 0.02) as lp > master }
track lead { play lead_b level 0.000 out > highpass(300, 0.02) as hp > autowah(0.6, base=900hz, range=2800hz, peak=0.25, wet=1.0) as wah > lowpass(8khz, 0.02) as lp > master }
track arp { play arp_b level 0.000 }
track air { level 0.000 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
