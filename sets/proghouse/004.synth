# set: bars=12 phase=groove energy=4
# set-note: Drums swap to `beat_main` so the clap lands on the backbeat and `pluck` comes in on `pluck_a` at 0.11 while `air` drops out to 0, holding four voices but moving the weight from the top down into the groove.

use "../../examples/rigs/proghouse_rig.synth"

track drums { play beat_main level 0.360 }
track sub { level 0.120 }
track pad { play chords_high level 0.056 out > highpass(200, 0.02) as hp > phaser(0.3, bars=12, wet=1.0) as ph > autopan(0.3, bars=10, wet=0.0) as pan > master }
track pluck { level 0.077 }
track air { level 0.000 out > highpass(1.4khz, 0.02) as hp > autopan(0.35, bars=14, wet=1.0) as pan > master }
