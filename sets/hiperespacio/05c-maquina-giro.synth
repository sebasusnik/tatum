# set: bars=16 phase=05-maquina energy=7
# set-note: The robot's cell gets its octave leap and a second hit, the glitch hats come off the grid; the zaps idle then spin up in the last two bars and cut (gesture 1).
# cue: 9 B4 held · zap figure
# cue: 11 let go of B4
use "_t05.synth"

track drums  { play m_main, m_main, m_main, m_main_turn }
track glitch { play g_a level 0.9 }
track robo   { play r_b, r_b, r_b, r_b_turn level 0.45 }
track zap    { play z_spin_16 level 0.25 }
auto zap.crush wet 0.3 > 0.3 > 0.9 over 16
