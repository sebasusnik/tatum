# set: bars=8 phase=06-hondo energy=7
# set-note: Eight bars withheld without a break: hats, clap and ride out, the roll down to one note per gap, and the drone pushed up and crushed so it fills the space.
# cue: 7 tecla D apretada · kick fuera · vuelve con la sección nueva
use "_t06.synth"

track drums { play k_rim, k_rim, k_rim, k_rim_turn }
track ride  { level 0 }
track bass  { play h_thin }
track drone { level 0.14 }
track rub   { level 0.07 }
auto drone level 0.11 > 0.16 over 8
auto rub level 0.05 > 0.08 over 8
auto drone.crush wet 0.3 > 0.45 over 8
auto rub.crush wet 0.2 > 0.35 over 8
auto abyss mod_index 0.5 > 0.6 over 8
