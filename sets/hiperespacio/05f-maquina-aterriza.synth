# set: bars=16 phase=05-maquina energy=8
# set-note: Out of the jam: the bass's new ratchet figure with the b2 every second bar, the robot run into sixteenths, and a crushed zap burst on the one (gesture 2).
# cue: 1 B3 crash · DROP!
use "_t05.synth"

track drums  { play m_drive, m_drive, m_drive, m_drive_turn }
track glitch { play g_b level 0.9 }
track bass   { play b_mach, b_mach, b_mach, b_mach_turn }
track robo   { play r_c, r_c, r_c, r_b_turn level 0.45 }
track zap    { play z_land_16 level 0.18 }
auto zap.crush wet 1 > 0.5 over 16
