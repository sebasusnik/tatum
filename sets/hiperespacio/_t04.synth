    openhat: - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -
