    hat:     - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x  - o x o  - x o o  - o x o  - x o x
    openhat: - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - x:0.6 -  - - - -
}

