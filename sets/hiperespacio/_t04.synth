    snare:   -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  - - - -  - - - -  - - - -  x x x x
