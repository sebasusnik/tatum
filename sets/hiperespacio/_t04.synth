    1.2:1.0(edepth=0.96, cutoff=0.49) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.2:1.0 1.3:0.8 1.2:0.6 ~2.3:0.95  1.2:0.6 <1.3:0.9 2.3:0.9> 1.2:0.6 5.2:0.8
    1.2:1.0(edepth=0.97, cutoff=0.52) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  <1.2:0.8 2.2:0.85 3.2:0.9 5.2:0.95> <7.2:0.9 1.3:0.95 2.3:1.0 3.3:1.0> 2.3:1.0*3 1.3:1.0*3  1.2:0.7 ~1.3:1.0 ~2.3:1.0 1.2:0.6
    1.2:1.0(edepth=0.94, cutoff=0.46) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.2:1.0 1.3:0.8 1.2:0.6 ~2.3:0.95  1.2:0.6 <1.3:0.9 2.3:0.9> 1.2:0.6 5.2:0.8
    1.2:1.0(edepth=0.95, cutoff=0.48) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.3:1.0*3 1.2:0.6 ~2.2:0.8 1.2:0.6  <5.2:0.8 7.2:0.85> 1.3:1.0 ~2.3:0.95 1.2:0.6
    1.2:1.0(edepth=0.95, cutoff=0.47) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.2:1.0 1.3:0.8 1.2:0.6 ~2.3:0.95  1.2:0.6 <1.3:0.9 2.3:0.9> 1.2:0.6 5.2:0.8
    1.2:1.0(edepth=0.96, cutoff=0.50) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.3:1.0*3 1.2:0.6 ~2.2:0.8 1.2:0.6  <5.2:0.8 7.2:0.85> 1.3:1.0 ~2.3:0.95 1.2:0.6
    1.2:1.0(edepth=0.95, cutoff=0.48) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.2:1.0 1.3:0.8 1.2:0.6 ~2.3:0.95  1.2:0.6 <1.3:0.9 2.3:0.9> 1.2:0.6 5.2:0.8
    1.2:1.0(edepth=0.96, cutoff=0.50) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.3:1.0*3 1.2:0.6 ~2.2:0.8 1.2:0.6  <5.2:0.8 7.2:0.85> 1.3:1.0 ~2.3:0.95 1.2:0.6
    1.2:1.0(edepth=0.96, cutoff=0.49) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  1.2:1.0 1.3:0.8 1.2:0.6 ~2.3:0.95  1.2:0.6 <1.3:0.9 2.3:0.9> 1.2:0.6 5.2:0.8
    1.2:1.0(edepth=0.97, cutoff=0.52) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  <1.2:0.8 2.2:0.85 3.2:0.9 5.2:0.95> <7.2:0.9 1.3:0.95 2.3:1.0 3.3:1.0> 2.3:1.0*3 1.3:1.0*3  1.2:0.7 ~1.3:1.0 ~2.3:1.0 1.2:0.6
}

# Drop variation: the riff turned over, starting on the octave, the filter a notch further
pattern acid_wide2 {
    1.3:1.0(edepth=0.97, cutoff=0.52) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  1.3:1.0*2 1.2:0.6 ~7.2:0.85 1.2:0.6  <1.2:0.8 1.3:0.9> ~2.3:0.95 1.2:0.6 1.3:0.9
    1.3:1.0(edepth=0.96, cutoff=0.50) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  2.3:1.0*3 1.3:0.9 ~2.3:0.95 1.2:0.6  <7.2:0.8 5.2:0.8 4.2:0.85 2.2:0.9> 1.2:0.7 1.3:1.0*2 -
    1.3:1.0(edepth=0.97, cutoff=0.53) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  1.3:1.0*2 1.2:0.6 ~7.2:0.85 1.2:0.6  <1.2:0.8 1.3:0.9> ~2.3:0.95 1.2:0.6 1.3:0.9
    1.3:1.0(edepth=0.98, cutoff=0.55) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  2.3:1.0*3 1.3:0.9 ~2.3:0.95 1.2:0.6  <7.2:0.8 5.2:0.8 4.2:0.85 2.2:0.9> 1.2:0.7 1.3:1.0*2 -
    1.3:1.0(edepth=0.97, cutoff=0.52) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  1.3:1.0*2 1.2:0.6 ~7.2:0.85 1.2:0.6  <1.2:0.8 1.3:0.9> ~2.3:0.95 1.2:0.6 1.3:0.9
    1.3:1.0(edepth=0.96, cutoff=0.51) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  2.3:1.0*3 1.3:0.9 ~2.3:0.95 1.2:0.6  <7.2:0.8 5.2:0.8 4.2:0.85 2.2:0.9> 1.2:0.7 1.3:1.0*2 -
    1.3:1.0(edepth=0.98, cutoff=0.54) 1.2:0.6 1.3:0.8 ~2.3:0.95  1.2:0.6 1.2:0.6*2 5.2:0.8 1.2:0.6  1.3:1.0*2 1.2:0.6 ~7.2:0.85 1.2:0.6  <1.2:0.8 1.3:0.9> ~2.3:0.95 1.2:0.6 1.3:0.9
    1.2:1.0(edepth=0.99, cutoff=0.56) 1.3:0.8 1.2:0.6*2 ~2.3:0.95  1.2:0.6 1.3:0.9 5.2:0.7 ~7.2:0.85  <1.2:0.8 2.2:0.85 3.2:0.9 5.2:0.95> <7.2:0.9 1.3:0.95 2.3:1.0 3.3:1.0> 2.3:1.0*3 1.3:1.0*3  1.2:0.7 ~1.3:1.0 ~2.3:1.0 1.2:0.6
}

# Two held tones, root and fifth low, the drone of the breakdown
pattern drone_break {
    [1.2 5.2]:0.8  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
}

# The drone under the first half of the build, gone for the second
pattern drone_build {
    [1.2 5.2]:0.8  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
}

# Riser: a metallic noise that climbs every bar and stops a beat before the drop
pattern rise8 {
    1.4:0.5  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    1.4:0.58  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    2.4:0.64  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    2.4:0.7  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    4.4:0.76  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    5.4:0.83  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    7.4:0.9  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..
    1.5:1.0  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  ..  -  -  -  -
}

# ────────────────────────────────────────────────
# TRACKS (the drums track first: it is the sidechain's kick)
# ────────────────────────────────────────────────

track drums {
    play a4_drive
    using akit
    level 1.0
    velocity 1.0
    out > highpass(30hz, 0.05) > eq(low=1, mid=-1, high=1.5) > drums
}

track bass {
    play rl_a
    using rodillo
    level 0
    velocity 1.0
    gate 0.7
    sidechain 0.3
    out > highpass(32hz, 0.05) > saturate(0.3) > eq(low=1, mid=-2, high=0.5) > master
}

track gallop {
    play b_rest
    using galope
    level 0
    velocity 1.0
    gate 0.7
    sidechain 0.5
    out > highpass(32hz, 0.05) > saturate(0.4) > eq(low=1, mid=-1.5, high=1) > master
}

track acid {
    play acid_low
    using tb
    level 0
    velocity 1.0
    gate 0.55
    pan 0.28
    delay_send 0.2
    reverb_send 0.05
    sidechain 0.6
    out > highpass(180hz, 0.05) > saturate(0.7) as dirt > lowpass(9khz, 0.05) as lp > limiter(0.5) > autopan(0.3, bars=4) > master
}

track drone {
    play drone_break
    using pozo
    level 0
    velocity 1.0
    gate 1.0
    pan -0.35
    reverb_send 0.4
    delay_send 0.1
    sidechain 0.4
    out > highpass(60hz, 0.05) > lowpass(900, 0.1, lfo_bars=8, lfo_depth=500) as lp > phaser(0.3, bars=8) > autopan(0.35, bars=8) > master
}

track riser {
    play rise8
    using sirena
    level 0
    velocity 1.0
    gate 1.0
    pan 0.2
    reverb_send 0.3
    sidechain 0
    out > highpass(700hz, 0.05, lfo_bars=2, lfo_depth=400) > lowpass(11khz, 0.05) > autopan(0.6, bars=1) > master
}

# ────────────────────────────────────────────────
# PERFORMANCE VOICES: played from the pads only. No step touches them.
# ────────────────────────────────────────────────

# The signature on a pad: a 303 that holds. Press and it sustains on the
# root with a slow wobble on the filter; K3 is its character, from a closed
# growl to a squeal, the resonance stopping short of a whistle.
module bass chirrido {
    osc1_wave saw
    cutoff 300hz
    cutoff_env 1.4khz
    resonance 72%
    glide 10%
    keytrack 20%
    attack 2ms
    decay 300ms
    sustain 55%
    release 120ms
    vel_env 50%
    lfo_target cutoff
    lfo_sync quarter
    lfo_waveform triangle
    lfo_depth 12%
}

# The second figure: the 303 an octave up, ratchets on the grid
module bass tb_alto {
    osc1_wave saw
    cutoff 420hz
    cutoff_env 2.4khz
    resonance 80%
    glide 12%
    keytrack 22%
    attack 1ms
    decay 140ms
    sustain 8%
    release 30ms
    vel_env 60%
}

# The riser: the build's metallic noise, its pitch climbing through every bar
module fm sirena_pad {
    algorithm pair_plus_two
    level 1.0
    mod_index 90%
    feedback 80%
    waveform abs_sine
    op0_ratio 5.41x
    op1_ratio 1.73x
    op2_ratio 3.29x
    op3_ratio 7.07x
    op0_envelope 0.3 1.0 1.0 0.12
    op1_envelope 0.3 1.0 1.0 0.12
    op2_envelope 0.3 1.0 1.0 0.12
    op3_envelope 0.3 1.0 1.0 0.12
    op0_feedback 70%
    lfo_target pitch
    lfo_sync bar
    lfo_waveform saw
    lfo_depth 65%
}

pattern pad_rest { -*16 }

pattern alto {
    1.3:0.95*2 - 1.3:0.6 -  ~2.3:0.9 - 1.3:0.6 -  1.3:0.95*2 - 5.2:0.8 -  1.3:1.0*3 - 1.3:0.6 -
}

pattern silbido {
    1.4:0.8  ..  ..  ..   ..  ..  ..  ..   ..  ..  ..  ..   ..  ..  -  -
}

track squeal {
    play pad_rest
    using chirrido
    level 0.6
    velocity 1.0
    pan -0.25
    delay_send 0.25
    reverb_send 0.08
    sidechain 0.4
    out > highpass(150hz, 0.05) > saturate(0.6) > lowpass(8khz, 0.05) > limiter(0.5) > autopan(0.3, bars=2) > master
}

track alto {
    play alto
    using tb_alto
    level 0.9
    velocity 1.0
    gate 0.5
    pan 0.3
    delay_send 0.3
    reverb_send 0.05
    sidechain 0.4
    out > highpass(220hz, 0.05) > saturate(0.6) > lowpass(9khz, 0.05) > limiter(0.55) > master
}

track silbido {
    play silbido
    using sirena_pad
    level 0.55
    velocity 1.0
    gate 1.0
    pan -0.2
    reverb_send 0.3
    sidechain 0
    out > highpass(700hz, 0.05) > lowpass(10khz, 0.05) > autopan(0.6, bars=1) > master
}

# The KeyLab, laid out as CONTROLES.md says. Main voice: the 303. Second
# voice: the breakdown drone. Signature: the held 303 on B1, its filter on
# K3. T04 has no second drum track, so F2 is the kit's hats and A2 takes the
# roll in and out instead. The base already maps F7 reverb, F8 echo, F9 DJ
# filter, A4 freeze, A7 prev, A8 next. B8 is left free.
# The keyboard's lead in this track: its own acid voice (tb), for the
# lead zone, through the same chain, plus a filter (`klp`) and a vowel
# (`talk`) the wheel and the knobs reach, and its own gain (`kgain`).
track ktema {
    play krest
    using tb
    level 0.5
    velocity 1.0
    gate 0.55
    pan 0.28
    delay_send 0.2
    reverb_send 0.05
    sidechain 0.6

    out > highpass(180hz, 0.05) > saturate(0.7) as dirt > lowpass(9khz, 0.05) as lp > limiter(0.5) > autopan(0.3, bars=4) > lowpass(18khz, 0.1) as klp > vowel(a, wet=0) as talk > gain(2.393) as kgain > master
}

midi {
    # Faders: F2 (cc 75) the track's bass, F5 (cc 80) its own voices together;
    # the rest are _keylab.synth's. Keys A# and B: the toggle and the throw
    # that were pads A2 and A3. Knobs: the page `tema`.
    cc 75 > bass level 0..1.5
    cc 75 > gallop level 0..0.64
    cc 80 > acid level
    cc 80 > drone level 0..0.1
    cc 80 > squeal level 0..0.8
    cc 80 > alto level 0..1
    # K1 bass filter: roll and gallop together
    cc 74 > rodillo cutoff 60hz..240hz
    cc 74 > rodillo cutoff_env 600hz..2.2khz
    cc 74 > galope cutoff 70hz..260hz
    cc 74 > galope cutoff_env 900hz..2.8khz
    # K2 the 303 open: what the p-locks leave free
    cc 71 > tb resonance 65%..88%
    cc 71 > tb decay 90ms..320ms
    cc 71 > acid lp cutoff 450hz..9khz
    # K3 the signature: closed growl -> squeal
    cc 76 > chirrido cutoff 150hz..3khz
    cc 76 > chirrido cutoff_env 500hz..2.5khz
    cc 76 > chirrido resonance 55%..84%
    cc 76 > tb_alto cutoff 250hz..1.5khz
    # K4 the drone open
    cc 77 > pozo mod_index 25%..65%
    cc 77 > drone lp cutoff 400hz..2.5khz
    cc 77 > acid reverb_send 0.05..0.5           # and the 303 into the room, which plays in most steps
    # K5 tension: thin from below, the 303 into the echo
    cc 93 > master hp cutoff 20hz..400hz
    cc 93 > acid delay_send 0.2..0.5
    # K6 throw amount
    cc 18 > acid delay_send 0..0.8
    # K7 kick, K8 hats (their pitch: the engine ignores hihat_decay)
    cc 19 > akit kick_decay 10%..32%
    cc 16 > akit hihat_pitch 1.3x..2x
    # K9 dirt: the 303's drive
    cc 17 > acid dirt drive 0.3..2
    # Keys A# and B: the toggle and the throw
    key 46 > toggle bass
    key 47 > throw acid q=1/16
    # Bank B
    pad 44 > play squeal q=1/16
    pad 45 > hold silbido q=beat
    pad 46 > drums crash q=beat
    pad 47 > hold alto q=beat
    pad 48 > repeat 1/32
    pad 49 > throw squeal q=1/16
    pad 50 > toggle acid
}
