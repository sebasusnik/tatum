pattern a4_rest {
    kick:    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -  -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
}

# Build: kick for four bars then out; the snare packs from quarters to ratchets; the last beat is silence
