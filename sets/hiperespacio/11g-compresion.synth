# set: bars=8 phase=11-build energy=7
# set-note: build 2/2: snare and hats pack tighter every bar, the kick back on bar 5, bass down to one note, riser up, the master filter opens; bar 8 is silence
# cue: 5 B2 held · riser
# cue: 7.5 B5 roll 1/32 · let go before the silent bar
# cue: 8 let go of B2 and B5 · silence
use "_t11.synth"

auto master dj cutoff 1200 > 20000 over 7
auto riser level 0.03 > 0.32 over 7
auto haze level 0.088 > 0.11 > 0.0 over 7

track drums { play beat_pack level 0.54 }
track bass  { play roll_pack level 0.6 }
track riser { play rise level 0.03 }
track haze  { play haze_root level 0.088 }
