# set: bars=8 phase=01-ignicion energy=3
# set-note: the ignition: the turbine spins up over eight bars (RPM curve on its ratios, putter speeding into a whine), the hat packs tighter, the wind rises; everything cuts on the last beat
use "_t01.synth"

track drums { play tick_rise level 0.6 }
track wind  { play swell_cut }
track pad   { level 0.15 }
track grind { play grind_ignite level 0.0525 }

# The RPM curve, a point every half bar: it catches, stalls for a moment in
# bar 2, then climbs; the ratios drag the modulators out of tune with the
# carrier, the putter speeds up until it is a whine, the index and the level
# rise with it. The pattern cuts it on the last beat.
auto turbina op1_ratio 0.0323 > 0.0355 > 0.0419 > 0.0371 > 0.0452 > 0.0548 > 0.0645 > 0.0758 > 0.0887 > 0.1032 > 0.1177 > 0.1323 > 0.1484 > 0.1645 > 0.1806 > 0.1935 > 0.1935 over 8
auto turbina op2_ratio 0.0329 > 0.0394 > 0.0525 > 0.0427 > 0.059 > 0.0785 > 0.0981 > 0.1209 > 0.1469 > 0.1763 > 0.2056 > 0.2349 > 0.2675 > 0.3001 > 0.3326 > 0.3587 > 0.3587 over 8
