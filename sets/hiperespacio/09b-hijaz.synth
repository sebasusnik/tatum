# set: bars=16 phase=09-nebulosa energy=6
# set-note: The Hijaz colour arrives: the roll turns to F and walks G#-F-E at the phrase end, the oud pluck enters sparse, the groove gets its clap and shaker.
use "_t09.synth"

track drums { play d_main }
track perc  { play d_main_hats }
track bass  { play roll_hijaz }
track oud   { play oud_sparse level 0.8 }
