# set: bars=4 phase=02-orbita energy=4
# set-note: the snare packs tighter for four bars with no kick; the bass rolls again, still shut, opening; the pluck brightens into it
# cue: 4.5 B5 roll 1/32 · let go of everything on the 1
use "_t02.synth"

track drums  { play o_roll level 0.55 }
track bass   { level 1.3 }
track shaker { level 0 }
track pluck  { play pl_alone level 0.32 delay_send 0.45 }
module bass orb { cutoff 45hz cutoff_env 150hz }
auto orb cutoff 0.12 > 0.19 over 4
auto orb cutoff_env 0.34 > 0.56 over 4
auto orbita mod_index 0.36 > 0.62 over 4
