    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
