# ────────────────────────────────────────────────
# TRACKS (the drums track first: it is the sidechain's kick)
# ────────────────────────────────────────────────

track drums {
    play t3_main
    using tkit
    level 0.9
    velocity 1.0
    out > highpass(28hz, 0.05) > eq(low=1.5, mid=-1, high=1) > drums
}

track clap {
    play cl_main
    using palma
    level 0
    velocity 1.0
    reverb_send 0.32
    sidechain 0
    out > highpass(180hz, 0.05) > lowpass(5khz, 0.05) as room > drums
}

track toms {
    play tm_main
    using cuero
    level 0
    velocity 1.0
    delay_send 0.12
    reverb_send 0.08
    sidechain 0.15
    out > highpass(90hz, 0.05) > lowpass(14khz, 0.05) as skin > autopan(0.35, bars=4) > drums
}

track bass {
    play hol_a
    using hueco
    level 0
    velocity 1.0
    gate 0.6
    sidechain 0.3
    out > highpass(32hz, 0.05) > saturate(0.3) as dirt > eq(low=1, mid=-2, high=0) > master
}

track talk {
    play talk_1
    using lengua
    level 0
    velocity 1.0
    gate 1.0
    pan 0.12
    delay_send 0.15
    reverb_send 0.3
    sidechain 0.5
    out > highpass(220hz, 0.05) > vowel(o, a, bars=1, mix=0.9) as mouth > saturate(0.25) > lowpass(6khz, 0.05) as lp > autopan(0.3, bars=4) > master
}

# ────────────────────────────────────────────────
# PERFORMANCE VOICES: played from the pads only. No step touches them.
# ────────────────────────────────────────────────

# The signature on a pad: the talking drone, quicker to speak than the
# gesture voice so a hit of the pad is heard at once. K3 is its character:
# the modulator walks from unison (a buzz) to a near-octave (a growl) while
# the index and feedback come up with it.
module fm lengua_pad {
    algorithm two_op
    level 1.4
    mod_index 50%
    feedback 40%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.06 0.4 1.0 0.5
    op1_envelope 0.06 0.4 0.8 0.5
    lfo_target mod_index
    lfo_sync bars_2
    lfo_waveform triangle
    lfo_depth 25%
}

# The second figure: the same throat chopped short, a chant in 3-3-2
module fm lengua_corta {
    algorithm two_op
    level 3.0
    mod_index 55%
    feedback 45%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.002 0.14 0.2 0.08
    op1_envelope 0.002 0.10 0.2 0.06
}

# The riser: a dry noise whose pitch climbs through every bar (a saw on
# pitch, one cycle a bar), so holding the pad for two bars is two climbs
module fm viento {
    algorithm pair_plus_two
    level 1.0
    mod_index 85%
    feedback 75%
    waveform abs_sine
    op0_ratio 4.31x
    op1_ratio 1.57x
    op2_ratio 2.93x
    op3_ratio 6.11x
    op0_envelope 0.3 1.0 1.0 0.12
    op1_envelope 0.3 1.0 1.0 0.12
    op2_envelope 0.3 1.0 1.0 0.12
    op3_envelope 0.3 1.0 1.0 0.12
    op0_feedback 60%
    lfo_target pitch
    lfo_sync bar
    lfo_waveform saw
    lfo_depth 70%
}

pattern pad_rest { -*16 }

# A chant on the grid: root, root, the b2 answering, in 3-3-2
pattern canto {
    1.3:0.9 - - 1.3:0.7  - - 2.3:0.8 -  1.3:0.9 - - 1.3:0.7  - - 1.4:0.85 -
}

pattern sopla {
    1.4:0.8  ..  ..  ..   ..  ..  ..  ..   ..  ..  ..  ..   ..  ..  -  -
}

track sig {
    play pad_rest
    using lengua_pad
    level 0.3
    velocity 1.0
    pan -0.3
    delay_send 0.15
    reverb_send 0.3
    sidechain 0.4
    out > highpass(150hz, 0.05) > vowel(a, o, bars=1, mix=0.85) > saturate(0.25) > lowpass(6khz, 0.05) > autopan(0.3, bars=2) > master
}

track canto {
    play canto
    using lengua_corta
    level 0.75
    velocity 1.0
    gate 0.5
    pan 0.25
    delay_send 0.2
    reverb_send 0.15
    sidechain 0.3
    out > highpass(200hz, 0.05) > vowel(i, o, bars=2, mix=0.85) > lowpass(6khz, 0.05) > master
}

track viento {
    play sopla
    using viento
    level 0.55
    velocity 1.0
    gate 1.0
    pan 0.15
    reverb_send 0.3
    sidechain 0
    out > highpass(800hz, 0.05) > lowpass(9khz, 0.05) > autopan(0.6, bars=1) > master
}

# The KeyLab, laid out as CONTROLES.md says. Here the toms are the main
# voice (the tribal record's protagonist), the clap is the perc layer, the
# talking drone's gestures are the second voice and its pad voice the
# signature. The base already maps F7 reverb, F8 echo, F9 DJ filter,
# A4 freeze, A7 prev, A8 next.
midi {
    # Faders: F2 (cc 75) the track's bass, F5 (cc 80) its own voices together;
    # the rest are _keylab.synth's. Keys A# and B: the toggle and the throw
    # that were pads A2 and A3. Knobs: the page `tema`.
    cc 75 > bass level
    cc 80 > toms level 0..0.8
    cc 80 > talk level 0..0.3
    cc 80 > sig level 0..0.45
    cc 80 > canto level 0..0.9
    # K1 bass filter
    cc 74 > hueco cutoff 50hz..700hz
    cc 74 > hueco cutoff_env 250hz..3khz
    cc 74 > hueco resonance 35%..55%
    # K2 toms open: the skin's lowpass and a little more echo
    cc 71 > toms skin cutoff 500hz..14khz
    cc 71 > toms delay_send 0.05..0.25
    # K3 the signature's character: unison buzz -> near-octave growl
    cc 76 > lengua_pad op1_ratio 1x..1.98x
    cc 76 > lengua_pad mod_index 35%..72%
    cc 76 > lengua_pad feedback 25%..60%
    cc 76 > lengua_corta op1_ratio 1x..1.98x
    # K4 second voice open: the drone's index and its lowpass
    cc 77 > lengua mod_index 35%..75%
    cc 77 > talk lp cutoff 1.5khz..8khz
    cc 77 > clap reverb_send 0.05..0.6           # and the clap's room, where the drone is silent
    # K5 tension: thin from below, toms into the echo
    cc 93 > master hp cutoff 20hz..400hz
    cc 93 > toms delay_send 0.12..0.4
    # K6 throw amount
    cc 18 > toms delay_send 0..0.8
    # K7 kick, K8 hats (their pitch: the engine ignores hihat_decay)
    cc 19 > tkit kick_decay 15%..45%
    cc 16 > tkit hihat_pitch 1x..1.8x
    # K9 dirt: the bass's drive
    cc 17 > bass dirt drive 0.15..1.0
    # Keys A# and B: the toggle and the throw
    key 46 > toggle clap
    key 47 > throw toms q=1/16
    # Bank B
    pad 44 > play sig q=1/16
    pad 45 > hold viento q=beat
    pad 46 > drums crash q=beat
    pad 47 > hold canto q=beat
    pad 48 > repeat 1/32
    pad 49 > throw sig q=1/16
    pad 50 > toms tom3
    pad 51 > toms tom
}
