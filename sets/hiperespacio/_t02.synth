# The motif turned: the octave leads, the b2 moves up an octave; still no ratchets
pattern pl_b {
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  1.2:0.7 - 2.3:0.8 -  - - 7.2:0.6 -
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  - 6.2:0.7 - 5.2:0.6  2.3:0.85 - - -
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  1.2:0.7 - 2.3:0.8 -  - 4.2:0.6 - 3.2:0.6
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  - 6.2:0.7 - 7.2:0.7  1.3:0.85 - 2.3:0.8 -
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  1.2:0.7 - 2.3:0.8 -  - - 7.2:0.6 -
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  - 6.2:0.7 - 5.2:0.6  2.3:0.85 - - -
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  1.2:0.7 - 2.3:0.8 -  - 4.2:0.6 - 3.2:0.6
    1.3:0.8 - - 1.2:0.8  - - 5.2:0.8 -  - 6.2:0.7 - 7.2:0.7  1.3:0.85 - 2.3:0.8 -
}

# Release 1: four bars of the pluck alone, long gaps for the echo to fill
pattern pl_alone {
    1.3:0.9 - - -  - - - -  5.2:0.7 - - -  - - - -
    2.3:0.85 - - -  - - - -  - - 1.3:0.6 -  - - - -
    1.3:0.9 - - -  - - - -  5.2:0.7 - - -  7.2:0.6 - - -
    2.3:0.9 - - -  - - 1.3:0.7 -  - - 2.2:0.8 -  - - - -
}

# The drop: the motif with ratchets and octave leaps -- never heard before this
pattern pl_ratchet {
    1.2:0.9 - 1.3:0.7*2 1.3:0.6  - - 5.2:0.85*3 -  1.2:0.7 - 2.3:0.85 2.2:0.7  - - 7.2:0.65*2 -
    1.2:0.9 - 1.3:0.7*2 1.3:0.6  - - 5.2:0.85 -  - 6.2:0.7*2 - 5.3:0.8  2.2:0.9*4 - - -
    1.2:0.9 - 1.3:0.7*2 1.3:0.6  - - 5.2:0.85*3 -  1.2:0.7 - 2.3:0.85 2.2:0.7  - 4.2:0.6*2 - 3.2:0.6
    1.2:0.9 - 1.3:0.7*2 1.3:0.6  - - 5.2:0.85 -  - 6.2:0.7*2 - 7.2:0.75  1.3:0.9*3 - 2.3:0.9 -
    1.2:0.9 - 1.3:0.7*2 1.3:0.6  - - 5.2:0.85*3 -  1.2:0.7 - 2.3:0.85 2.2:0.7  - - 7.2:0.65*2 -
    1.2:0.9 - 1.3:0.7*2 1.3:0.6  - - 5.2:0.85 -  - 6.2:0.7*2 - 5.3:0.8  2.2:0.9*4 - - -
    1.2:0.9 - 1.3:0.7*2 1.2:0.6  1.3:0.8*2 - 5.3:0.85*3 -  1.2:0.7 - 2.3:0.85*2 2.2:0.7  1.3:0.8*3 - 7.2:0.7*2 -
    1.2:0.9*2 1.3:0.8*2 2.3:0.9*3 1.3:0.8*3  5.2:0.9*4 - 2.2:1.0*4 -  - - - -  - - - -
}

# After the drop: the ratchets thinned to their strokes, the echo doing the rest
pattern pl_after {
    1.2:0.9 - 1.3:0.7*2 -  - - 5.2:0.8*3 -  - - - -  - - - -
    1.2:0.9 - - -  - - 5.2:0.8 -  - - - -  2.2:0.85*4 - - -
    1.2:0.9 - 1.3:0.7*2 -  - - 5.2:0.8*3 -  - - - -  - - - -
    1.2:0.9 - - -  - - 5.2:0.8 -  - - - -  2.2:0.85*4 - - -
    1.2:0.9 - 1.3:0.7*2 -  - - 5.2:0.8*3 -  - - - -  - - - -
    1.2:0.9 - - -  - - 5.2:0.8 -  - - - -  2.2:0.85*4 - - -
    1.2:0.9 - 1.3:0.7*2 -  - - 5.2:0.8*3 -  - - - -  - - - -
    1.2:0.9 - 1.3:0.7*2 -  - - 5.2:0.8 -  2.3:0.8*3 - - -  - - - -
}

pattern rest { -*16 }

# B2: four one-bar sweeps, each louder
pattern sweep {
    1.3:0.5 ..*14 -  1.3:0.65 ..*14 -  1.3:0.8 ..*14 -  1.3:1.0 ..*14 -
}

# B4: the motif's ratchets thrown high into the echo
pattern echo_fig {
    1.4:0.8*3 - - -  - - 5.3:0.7*2 -  - - - -  2.4:0.75*3 - - -
    1.4:0.8*3 - - -  - - 5.3:0.7*2 -  - - 7.3:0.6*2 -  2.4:0.85*4 - - -
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play o_intro
    using kit_orb
    level 0.8
    velocity 1.0
    out > highpass(28hz, 0.05) > eq(low=1, mid=-1.5, high=1) > drums
}

track bass {
    play low_a
    using orb
    level 1.35
    velocity 1.0
    gate 0.7
    sidechain 0.35
    out > highpass(30hz, 0.05) > saturate(0.4) as dirt > eq(low=1, mid=-2.5, high=0) > master
}

track shaker {
    play shk_a
    using sonaja
    level 0.12
    velocity 1.0
    gate 0.2
    pan 0.32
    reverb_send 0.1
    sidechain 0.2
    out > highpass(3khz, 0.05) > lowpass(12khz, 0.05) as tone > autopan(0.25, bars=2) > master
}

track pluck {
    play pl_a
    using orbita
    level 0
    velocity 1.0
    gate 0.6
    pan -0.18
    delay_send 0.28
    reverb_send 0.1
    sidechain 0.3
    out > highpass(160hz, 0.05)
        > lowpass(5khz, 0.1, lfo_bars=8, lfo_depth=2500)
        > panenv(0.45, release=250)
        > master
}

# ── played from the KeyLab: never touched by a step ──

# B1: the pluck ringing on a pad, K3 on its character
track sig {
    play rest
    using orbita_pad
    level 0.25
    velocity 1.0
    gate 1.0
    pan 0.22
    delay_send 0.3
    reverb_send 0.12
    sidechain 0.3
    out > highpass(160hz, 0.05) > lowpass(6khz, 0.05) > autopan(0.35, bars=1) > master
}

# B2: the riser, out until held
track riser {
    play sweep
    using barrido
    level 0.07
    pan 0.1
    reverb_send 0.2
    sidechain 0.2
    out > highpass(400hz, 0.05) > lowpass(10khz, 0.05) > autopan(0.5, hz=0.5) > master
}

# B4: the ratchets thrown into the echo, out until held
track eco {
    play echo_fig
    using orbita
    level 0.4
    velocity 1.0
    gate 0.5
    pan 0.4
    delay_send 0.55
    reverb_send 0.15
    sidechain 0.3
    out > highpass(300hz, 0.05) > lowpass(6khz, 0.05) > master
}

# The KeyLab, laid out as CONTROLES.md says. _base.synth has F7 reverb,
# F8 echo, F9 DJ filter, A4 freeze, A7 prev, A8 next. T02 has no second
# voice under the pluck: F5 and K4 go to the echo figure (B4) and the
# shaker's top instead.
midi {
    # faders
    cc 73 > drums level
    cc 75 > shaker level 0..0.25
    cc 79 > bass level 0..1.8
    cc 72 > pluck level 0..0.45
    cc 80 > eco level 0..0.6
    cc 81 > sig level 0..0.6

    # knobs
    cc 74 > orb cutoff 45hz..260hz
    cc 74 > orb cutoff_env 250hz..1.3khz
    cc 74 > orb resonance 30%..48%
    cc 71 > orbita mod_index 25%..68%
    cc 71 > orbita feedback 8%..28%
    cc 76 > orbita_pad op1_ratio 1.41x..4.24x
    cc 76 > orbita_pad mod_index 30%..62%
    cc 77 > shaker tone cutoff 4khz..14khz
    cc 93 > master hp cutoff 20hz..400hz
    cc 93 > pluck delay_send 28%..60%
    cc 18 > pluck delay_send 0%..80%
    cc 19 > kit_orb kick_decay 15%..40%
    cc 16 > kit_orb hihat_pitch 1.01x..1.35x..1.62x    # K8 hats: darker left, the written tuning in the middle (hihat_decay does nothing in the engine yet)
    cc 17 > bass dirt drive 0.2..1.4

    # bank A: performance
    pad 36 > mute drums q=bar
    pad 37 > toggle shaker
    pad 38 > throw pluck q=1/16
    pad 40 > repeat 1/8
    pad 41 > repeat 1/16

    # bank B: the track's sounds
    pad 44 > play sig F q=1/16    #3
    pad 45 > hold riser q=beat
    pad 46 > drums crash q=beat
    pad 47 > hold eco q=beat
    pad 48 > repeat 1/32
    pad 49 > throw sig q=1/16
    pad 50 > play sig C#4      # the fifth above
    pad 51 > mute bass         # the bass out while held, for a hole before a drop
}
