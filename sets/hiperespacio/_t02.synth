pattern o_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - x:0.5   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - x:0.5   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - x:0.5   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    clap:    - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  - x:0.75 - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  - x:0.75 - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  - x:0.75 - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.75 x*2 - x*3
    openhat: - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - x:0.65 -   - - x:0.65 -  - - x:0.65 -  - - x:0.65 -  - - - -
    snare:   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - o:0.3  - - o:0.3 -  - o:0.3 - -  - - - -   - - - -  - - - -  - - o:0.4 -  x:0.5 x*2 x*3 x*4
}

# Release 1: the floor gone; only a far rim every other bar
pattern o_hole {
    snare:   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - o:0.25 -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - o:0.25 -
}

# Four bars of snare packing tighter, no kick; the last sixteenth is empty
pattern o_roll {
    snare:   x:0.45 - - -  x:0.5 - - -  x:0.5 - x:0.45 -  x:0.55 - x:0.5 -   x:0.55 - x:0.5 -  x:0.6 - x:0.55 -  x:0.6 x:0.5 x:0.6 x:0.5  x:0.65 x:0.55 x:0.65 x:0.55   x:0.65 x:0.6 x:0.7 x:0.6  x:0.7 x:0.65 x:0.75 x:0.65  x*2 x*2 x*2 x*2  x*2 x*2 x*2 x*2   X*2 X*2 X*2 X*2  X*3 X*3 X*3 X*3  X*4 X*4 X*4 X*4  X*4 X*4 X*4 -
    hat:     - - x:0.4 -  - - x:0.4 -  - - x:0.4 -  - - x:0.4 -   - - x:0.45 -  - - x:0.45 -  - - x:0.45 -  - - x:0.45 -   - x:0.4 x:0.5 x:0.4  - x:0.4 x:0.5 x:0.4  - x:0.4 x:0.5 x:0.4  - x:0.4 x:0.5 x:0.4   x:0.5 x:0.5 x:0.55 x:0.5  x:0.55 x:0.55 x:0.6 x:0.55  x*2 x*2 x*2 x*2  x*3 x*3 x*3 -
}

# The drop: a crash on each eight, the ghost before the clap, a flam at 8
