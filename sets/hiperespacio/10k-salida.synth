# set: bars=32 phase=10-outro energy=6
# set-note: Stripped for T11 to mix over: kick, hats, open hat, a tom on the turn and the plain A roll; nothing else tonal.
use "_t10.synth"

track drums  { play g_outro level 1.0 }
track perc  { play g_outro_hats level 1.0 }
track bass   { play gal_out level 0.95 }
track acid   { level 0 }
track needle { level 0 }
