# set: bars=24 phase=02-orbita energy=6
# set-note: the drop: the pluck's ratchets and octave leaps for the first time, the bass pushes up the octave, the shaker ratchets, a crash on each eight
# cue: 1 B3 crash · DROP!
# cue: 24.5 low key B: throw the pluck (half bar)
use "_t02.synth"

track drums  { play o_drop }
track shaker { play shk_b level 0.18 }
track bass   { play low_drop level 1.8 }
track pluck  { play pl_ratchet level 0.3 }
module fm orbita { mod_index 58% }
