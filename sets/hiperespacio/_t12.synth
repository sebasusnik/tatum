# T12 estela — F# phrygian, 147 BPM. The exit: the engine winds down.
#
#   kit     the softest kick of the set: low, long, little click, little
#           drive; hats darker and longer, a rim for the turns
#   bass    `rescoldo`: two saws an octave apart, shut down low, a slow
#           filter pluck; its figure thins from the roll to offbeats to a
#           note a bar
#   grinder `rotor`: two modulator pairs on half-sines with a gritty
#           feedback operator and a rattling sample-and-hold on the pitch.
#           All four ratios move together, so falling RPM is falling pitch:
#           the steps draw it spinning DOWN (`auto rotor op*_ratio ... over N`)
#           as three gestures: the long spin-down, a last sputter, a whir far
#           away. Its own timbre: not T01's turbine, not T08's disc
#   pad     T01's hollow FM pad comes back, on the same voicing it opened the
#           hour with (F# C# F#, then G against it): the set ends where it began
#   wind    band-passed noise, lower and slower than T01's, the last thing left
#   room    the biggest of the set: a quarter-note echo and a long hall that
#           swells as the master filter closes over the last 32 bars

use "_base.synth"

tempo 147
scale F# phrygian

delay sync=quarter feedback=0.45 filter=0.45
reverb size=0.88 damp=0.5 predelay=40 sidechain=0.5

delay_return  { in > highpass(400hz, 0.05) > lowpass(5khz, 0.05, lfo_bars=16, lfo_depth=1500) > autopan(0.5, bars=4) > out }
reverb_return { in > highpass(250hz, 0.05) > lowpass(4500, 0.05, lfo_bars=16, lfo_depth=2000) > autopan(0.4, bars=8) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

module beats kit {
    kick_level 0.9
    kick_decay 34%
    kick_pitch 0.9x
    kick_click 30%
    kick_drive 28%
    snare_level 0.45
    snare_decay 3%
    snare_pitch 1.8x
    snare_snap 40%
    snare_drive 15%
    snare_pan -0.3
    hihat_level 0.6
    hihat_decay 22%
    hihat_pitch 1.25x
    hihat_pan 0.28
    clap_level 0.5
    clap_pan 0.1
    tom_pan -0.2
    crash_pan 0.2
}

module bass rescoldo {
    osc1_wave saw
    osc2_wave saw
    osc2_pitch -12st
    cutoff 75hz
    cutoff_env 600hz
    resonance 18%
    keytrack 20%
    glide 0%
    attack 1ms
    decay 150ms
    sustain 0%
    release 50ms
}

# The grinder at full RPM: ratios 2x 3.02x 5.04x 2x. The steps scale all
# four down together (to a quarter at the end), a curve drawn point by point
module fm rotor {
    algorithm dual_mod
    level 1.8
    mod_index 60%
    feedback 25%
    waveform half_sine
    op0_ratio 2x
    op1_ratio 3.02x
    op2_ratio 5.04x
    op3_ratio 2x
    op0_envelope 0.4 0.5 1.0 0.8
    op1_envelope 0.4 0.5 1.0 0.8
    op2_envelope 0.4 0.5 1.0 0.8
    op3_envelope 0.4 0.5 1.0 0.8
    op1_feedback 45%
    lfo_target pitch
    lfo_sync sixteenth
    lfo_waveform sample_hold
    lfo_depth 6%
}

# T01's pad, returning: hollow FM, two stacks, no detune, breathing by its index
module fm vacio {
    algorithm dual_pairs
    level 0.5
    mod_index 24%
    feedback 6%
    waveform sine
    op0_ratio 1x
    op1_ratio 3x
    op2_ratio 2x
    op3_ratio 1x
    op0_envelope 1.8 1.0 0.9 2.0
    op1_envelope 2.0 1.0 0.8 2.0
    op2_envelope 1.6 1.0 0.7 2.0
    op3_envelope 2.0 1.0 0.6 2.0
    lfo_target mod_index
    lfo_sync bars_8
    lfo_waveform triangle
    lfo_depth 40%
}

instrument aliento {
    gain 2.2
    noise() as n
    n > bandpass(600, 0.25, lfo_bars=16, lfo_depth=420) as bp
    bp > lowpass(2400, 0.05) as lp
    lp > adsr(4.0, 1.0, 0.85, 5.0) as amp
    amp > out
}

# ── Pad voices (played from the KeyLab, never by the steps) ──

# The grinder for the hands: the same rotor, answering at once. Its ratios
# sit mid-knob (1.5x 2.265x 3.78x 1.5x); K3 moves all four together, idle
# (a quarter of full RPM) to past full (a quarter over)
module fm rotor_pad {
    algorithm dual_mod
    level 1.8
    mod_index 50%
    feedback 25%
    waveform half_sine
    op0_ratio 1.5x
    op1_ratio 2.265x
    op2_ratio 3.78x
    op3_ratio 1.5x
    op0_envelope 0.08 0.5 1.0 0.5
    op1_envelope 0.08 0.5 1.0 0.5
    op2_envelope 0.08 0.5 1.0 0.5
    op3_envelope 0.08 0.5 1.0 0.5
    op1_feedback 45%
    lfo_target pitch
    lfo_sync sixteenth
    lfo_waveform sample_hold
    lfo_depth 6%
}

# The motor coughing: short bursts of the rotor, on the beat
module fm cough {
    algorithm dual_mod
    level 1.8
    mod_index 55%
    feedback 30%
    waveform half_sine
    op0_ratio 1x
    op1_ratio 1.51x
    op2_ratio 2.52x
    op3_ratio 1x
    op0_envelope 0.005 0.18 0.0 0.1
    op1_envelope 0.005 0.15 0.0 0.1
    op2_envelope 0.005 0.1 0.0 0.08
    op3_envelope 0.005 0.2 0.0 0.1
    op1_feedback 50%
}

# A two-bar swell of breath that restarts while its pad is held
instrument soplo {
    gain 1.6
    noise() as n
    n > bandpass(500, 0.3, ea=3.0, ed=0.1, es=1.0, er=0.2, edepth=3500) as bp
    bp > adsr(2.6, 0.1, 1.0, 0.25) as amp
    amp > out
}

# ────────────────────────────────────────────────
# DRUMS (two-bar cells, chained into 8-bar phrases by the steps)
# ────────────────────────────────────────────────

pattern d_ride {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:     - - x - - - x - - - x - - - x -   - - x - - - x - - - x - - - x o
    openhat: - - - -  - - x:0.4 -  - - - -  - - x:0.4 -   - - - -  - - x:0.4 -  - - - -  - - x:0.4 -
    clap:    - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  x:0.5 - - -
}

pattern d_ride_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    hat:     - - x - - - x - - - x - - - x -   - - x - - - x - - o x o x o x*2 x
    openhat: - - - -  - - x:0.4 -  - - - -  - - x:0.4 -   - - - -  - - x:0.4 -  - - - -  - - - -
    snare:   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  x:0.5 x:0.6 x:0.7 x:0.8
}

pattern d_thin {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:     - - x:0.7 - - - - - - - x:0.7 - - - - -   - - x:0.7 - - - - - - - x:0.7 - - - x:0.5 -
    openhat: - - - -  - - - -  - - - -  - - x:0.35 -   - - - -  - - - -  - - - -  - - x:0.35 -
}

pattern d_thin_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    hat:     - - x:0.7 - - - - - - - x:0.7 - - - - -   - - x:0.7 - - - - - - - x:0.6 - x:0.5 x:0.4 x:0.3
}

# Half the kicks: the motor loses its beat
pattern d_half {
    kick:    X - - -  - - - -  X - - -  - - - -   X - - -  - - - -  X - - -  - - - -
    hat:     - - x:0.6 - - - - - - - x:0.6 - - - - -   - - x:0.6 - - - - - - - - - - - - -
}

pattern d_half_turn {
    kick:    X - - -  - - - -  X - - -  - - - -   X - - -  - - - -  - - - -  - - - -
    hat:     - - x:0.6 - - - - - - - x:0.6 - - - - -   - - x:0.5 - - - - - - - x:0.4 - - - x:0.3 -
}

# No kick: a hat ticking, far away
pattern d_tick {
    hat:     - - x:0.45 - - - - - - - x:0.4 - - - - -   - - x:0.45 - - - - - - - - - - - - -
}

# The last eight bars of drums: the tick, sparser, then nothing
pattern d_last {
    hat:     - - x:0.4 - - - - - - - - - - - - -   - - - - - - - - - - x:0.35 - - - - -   - - x:0.3 - - - - - - - - - - - - -   - - - - - - - - - - - - - - - -   - - x:0.25 - - - - - - - - - - - - -   - - - - - - - - - - - - - - - -   - - - - - - - - - - - - - - - -   - - - - - - - - - - - - - - - -
}

pattern d_rest {
    hat:     - - - - - - - - - - - - - - - -
}

# ────────────────────────────────────────────────
# BASS
# ────────────────────────────────────────────────

pattern b_roll {
    - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75
    - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75
}

pattern b_roll_turn {
    - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75  - 1.1:0.9 1.1:0.65 1.1:0.75
    - 1.1:0.9 1.1:0.65 1.1:0.75  - 2.1:0.9 2.1:0.65 2.1:0.75  - 1.1:0.9 1.1:0.65 -  - 1.1:0.8 - -
}

# Offbeats only: the roll loses two of its three
pattern b_off {
    - - 1.1:0.85 -  - - 1.1:0.8 -  - - 1.1:0.85 -  - - 1.1:0.8 -
    - - 1.1:0.85 -  - - 1.1:0.8 -  - - 1.1:0.85 -  - - 2.1:0.8 -
}

pattern b_sparse {
    - - 1.1:0.8 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - 1.1:0.7 -  - - - -
}

# ────────────────────────────────────────────────
# GRINDER, PAD, WIND
# ────────────────────────────────────────────────

pattern grind_hold {
    F#3:0.8 ..*255
}

pattern grind_8 {
    F#3:0.8 ..*119 -*8
}

# T01's voicing: F# with its fifth and octave, then G pressing on it
pattern void {
    [F#3:0.8 C#4:0.6 F#4:0.5]:0.7 ..*63
    [G3:0.8 C#4:0.6 F#4:0.5]:0.7 ..*31
    [F#3:0.8 C#4:0.6 G4:0.5]:0.7 ..*31
}

# For the end: the open fifth alone, held
pattern void_last {
    [F#3:0.8 C#4:0.6]:0.7 ..*127
}

pattern breath {
    F#4:0.8 ..*127
}

# ── Pad patterns ──

pattern rest {
    -*16
}

pattern swell_2 {
    F#4:0.8 ..*31
}

# Four coughs a bar, each a little weaker, the last bar half of them
pattern cough_bar {
    F#2:0.9 - - -  F#2:0.75 - - -  F#2:0.6 - - -  F#2:0.5 - - -
    F#2:0.85 - - -  - - - -  F#2:0.55 - - -  - - - -
}

# ────────────────────────────────────────────────
# TRACKS (optional voices at level 0)
# ────────────────────────────────────────────────

track drums {
    play d_ride
    using kit
    level 0.78
    velocity 1.0
    out > highpass(28hz, 0.05) > eq(low=1.5, mid=-1, high=0.5) > drums
}

track bass {
    play b_roll
    using rescoldo
    level 0.62
    velocity 1.0
    gate 0.75
    sidechain 0.3
    out > highpass(30hz, 0.05) > saturate(0.25) > eq(low=1, mid=-2, high=-1) > master
}

track grind {
    play grind_hold
    using rotor
    level 0.0
    velocity 1.0
    gate 1.0
    pan 0.2
    reverb_send 0.3
    delay_send 0.1
    sidechain 0.5
    out > highpass(200hz, 0.05) > saturate(0.5) as dirt > lowpass(6khz, 0.05) > autopan(0.45, bars=2) > master
}

track pad {
    play void
    using vacio
    level 0.0
    velocity 1.0
    pan -0.2
    reverb_send 0.5
    delay_send 0.06
    sidechain 0.6
    out > highpass(200hz, 0.05) > phaser(0.35, bars=16) > autopan(0.45, bars=8) > master
}

track wind {
    play breath
    using aliento
    level 0.0
    velocity 1.0
    pan 0.1
    reverb_send 0.35
    out > highpass(250hz, 0.05) > lowpass(2.4khz, 0.05) as open > autopan(0.6, bars=8) > master
}

# ── Pad-only tracks: no step names them, so a fader or a pad is all that moves them ──

# B1/B7/B8 play it; K3 is its RPM
track grind_pad {
    play rest
    using rotor_pad
    level 0.26
    velocity 1.0
    gate 1.0
    pan -0.25
    reverb_send 0.3
    delay_send 0.1
    sidechain 0.5
    out > highpass(70hz, 0.05) > saturate(0.5) as dirt > lowpass(6khz, 0.05) > autopan(0.45, bars=2) > master
}

# B2 holds it: a breath that swells over two bars
track swell {
    play swell_2
    using soplo
    level 0.3
    velocity 1.0
    gate 1.0
    pan 0.15
    reverb_send 0.4
    out > highpass(300hz, 0.05) > lowpass(8khz, 0.05) > autopan(0.5, bars=2) > master
}

# B4 holds it: the motor coughing on the beat
track coughs {
    play cough_bar
    using cough
    level 0.5
    velocity 1.0
    gate 0.5
    pan 0.3
    reverb_send 0.25
    sidechain 0.3
    out > highpass(120hz, 0.05) > saturate(0.4) > master
}

# The KeyLab, laid out as CONTROLES.md (F7 F8 F9, A4 A7 A8 come from _base).
# Main voice = the pad (vacio), second voice = the wind, signature = the
# grinder (rotor; the pads play rotor_pad). No perc layer: F2 is the hats,
# A2 toggles the wind
midi {
    # Faders: F2 (cc 75) the track's bass, F5 (cc 80) its own voices together;
    # the rest are _keylab.synth's. Keys A# and B: the toggle and the throw
    # that were pads A2 and A3. Knobs: the page `tema`.
    cc 75 > bass level
    cc 80 > pad level 0..0.35
    cc 80 > wind level 0..0.4
    cc 80 > grind_pad level 0..0.4

    cc 74 > rescoldo cutoff 45hz..200hz
    cc 74 > rescoldo cutoff_env 300hz..1.5khz
    cc 71 > vacio mod_index 12%..45%
    cc 71 > vacio feedback 3%..20%
    cc 76 > rotor_pad op0_ratio 0.5x..2.5x
    cc 76 > rotor_pad op1_ratio 0.755x..3.775x
    cc 76 > rotor_pad op2_ratio 1.26x..6.3x
    cc 76 > rotor_pad op3_ratio 0.5x..2.5x
    cc 76 > rotor_pad mod_index 35%..62%
    cc 77 > wind open cutoff 500hz..6khz
    cc 93 > master hp cutoff 20hz..400hz
    cc 93 > pad delay_send 0.06..0.5
    cc 18 > pad delay_send 0..0.8
    cc 19 > kit kick_decay 15%..55%
    cc 16 > kit hihat_pitch 0.94x..1.25x..1.5x    # K8 hats: darker left, the written tuning in the middle (hihat_decay does nothing in the engine yet)
    cc 17 > grind dirt drive 0.2..1.4
    cc 17 > grind_pad dirt drive 0.2..1.4

    key 46 > toggle wind
    key 47 > throw pad q=1/16

    pad 44 > play grind_pad F q=1/16    #3
    pad 45 > hold swell q=beat
    pad 46 > drums crash q=beat
    pad 47 > hold coughs q=beat
    pad 48 > repeat 1/32
    pad 49 > throw grind_pad q=1/16
    pad 50 > play grind_pad C#3
    pad 51 > play grind_pad F#2
}
