# set: bars=24 phase=06-hondo energy=7
# set-note: Everything back at once plus what was saved: the roll pulling on the b2 and the low seventh with its filter lifting, the Eb doubled at the octave, the crush at its dirtiest.
# cue: 1 let go of key D
use "_t06.synth"

track drums { play k_clap, k_clap, k_clap, k_clap_turn }
track ride  { play rd_push level 1.8 }
track bass  { play h_pull, h_pull, h_pull, h_roll_turn }
track drone { level 0.12 }
track rub   { play dr_rub_hi level 0.06 }
auto drone.crush wet 0.35 > 0.5 > 0.38 > 0.52 > 0.4 > 0.48 over 24
auto rub.crush wet 0.25 > 0.4 > 0.3 > 0.42 over 24
auto abyss mod_index 0.55 > 0.62 > 0.56 > 0.64 > 0.58 over 24
