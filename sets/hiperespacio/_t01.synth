# The way out: open but plain, one turn at the end of sixteen
pattern roll_strip {
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75
    - 1.1:0.7(cutoff=0.34) 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 1.1:0.7 1.1:0.95 1.1:0.75  - 7.0:0.8 2.1:0.95 1.1:0.75
}

# ── the tok ──

# The tok answers in the gaps of the bass: two bars of call, a turn at 8
pattern tok_a {
    - - - -  - - 1.4:0.7 -  - - - 5.3:0.5  - - 1.4:0.6 -
    - - - -  - - 1.4:0.7 -  - - - -  - 5.3:0.5 - -
    - - - -  - - 1.4:0.7 -  - - - 5.3:0.5  - - 1.4:0.6 -
    - - - -  - - 1.4:0.7 -  - - 2.4:0.6 -  - 5.3:0.5 - 1.4:0.4
    - - - -  - - 1.4:0.7 -  - - - 5.3:0.5  - - 1.4:0.6 -
    - - - -  - - 1.4:0.7 -  - - - -  - 5.3:0.5 - -
    - - - -  - - 1.4:0.7 -  - - - 5.3:0.5  - - 1.4:0.6 -
    - - - -  - - 1.4:0.7 -  - - 5.3*3 -  1.4*2 - 2.4:0.7 -
}

# Busier: a 3-3-2 against the kick, ratchets on the turn
pattern tok_busy {
    - - 5.3:0.5 -  - - 1.4:0.7 -  - 5.3:0.5 - -  - - 1.4:0.6 5.3:0.4
    - - 5.3:0.5 -  - - 1.4:0.7 -  - 5.3:0.5 - 2.4:0.6  - 5.3:0.5 - -
    - - 5.3:0.5 -  - - 1.4:0.7 -  - 5.3:0.5 - -  - - 1.4:0.6 5.3:0.4
    - - 5.3:0.5 -  - - 1.4*2 -  - 5.3:0.5 - 2.4:0.6  1.4*3 - 5.3:0.5 -
    - - 5.3:0.5 -  - - 1.4:0.7 -  - 5.3:0.5 - -  - - 1.4:0.6 5.3:0.4
    - - 5.3:0.5 -  - - 1.4:0.7 -  - 5.3:0.5 - 2.4:0.6  - 5.3:0.5 - -
    - - 5.3:0.5 -  - - 1.4:0.7 -  - 5.3:0.5 - -  - - 1.4:0.6 5.3:0.4
    - - 5.3:0.5 -  - - 1.4*2 -  5.3*3 - 2.4*2 -  1.4*4 - 7.3:0.6 -
}

# ── pad: open fifths, the b2 rubbing, a tritone; no thirds ──
pattern void {
    [F#3:0.8 C#4:0.6 F#4:0.5]:0.7 ..*63
    [G3:0.8 C#4:0.6 F#4:0.5]:0.7 ..*31
    [F#3:0.8 C#4:0.6 G4:0.5]:0.7 ..*27 - - - -
}

# The same breath thinned to fifths, the b2 carrying its own fifth
pattern void_b {
    [F#3:0.8 C#4:0.6]:0.7 ..*63
    [G3:0.8 D4:0.6]:0.7 ..*31
    [F#3:0.8 C#4:0.6 G4:0.5]:0.7 ..*27 - - - -
}

# ── wind ──
pattern swell {
    1.4:0.8 ..*95 -*32
}

# In the spin-up it holds until the cut
pattern swell_cut {
    1.4:0.8 ..*123 - - - -
}

# ── the turbine: three gestures and no more ──
# Idle: it turns over for three bars near the end of 01b and dies (a false start)
pattern grind_cough {
    -*176  F#4:0.8 ..*39  -*40
}

# Ignition: held through the whole spin-up, cut on the last beat
pattern grind_ignite {
    F#4:0.8 ..*123 - - - -
}

# One throttle blip at the far end of a 32-bar phrase
pattern grind_blip {
    -*248 F#4:0.8 ..*5 - -
    -*256
}

pattern rest { -*16 }

# B2: four one-bar sweeps, each a little louder; held, it rises bar by bar
pattern rise {
    1.3:0.5 ..*14 -  1.3:0.65 ..*14 -  1.3:0.8 ..*14 -  1.3:1.0 ..*14 -
}

# B4: the starter: sixteenths cranking with the accent on the beat, the
# second bar catching faster
pattern crank {
    F#5:0.9 F#5:0.4 F#5:0.55 F#5:0.4  F#5:0.9 F#5:0.4 F#5:0.55 F#5:0.4  F#5:0.9 F#5:0.4 F#5:0.55 F#5:0.4  F#5:0.9 F#5:0.4 F#5:0.55 F#5:0.4
    F#5:0.9 F#5:0.5 C#6:0.6 F#5:0.5  F#5:0.9 F#5:0.5 C#6:0.6 F#5:0.5  F#5:0.9*2 F#5:0.5 C#6:0.6*2 F#5:0.5  F#5:1.0*2 F#5:0.6*2 C#6:0.7*3 F#5:0.6*3
}

# ────────────────────────────────────────────────
# TRACKS — optional voices wait at level 0
# ────────────────────────────────────────────────

track drums {
    play tick
    using kit_ign
    level 0.8
    velocity 1.0
    out > highpass(28hz, 0.05) > eq(low=1, mid=-1.5, high=1.5) > drums
}

track bass {
    play roll_shut
    using ign
    level 0
    velocity 1.0
    gate 0.7
    sidechain 0.3
    out > highpass(32hz, 0.05) > saturate(0.3) as dirt > eq(low=1, mid=-2, high=0.5) > master
}

track pad {
    play void
    using vacio
    level 0.2
    velocity 1.0
    pan -0.2
    reverb_send 0.5
    delay_send 0.06
    sidechain 0.6
    out > highpass(200hz, 0.05) > phaser(0.35, bars=16) > autopan(0.45, bars=8) > master
}

track wind {
    play swell
    using viento
    level 0.3
    pan -0.3
    reverb_send 0.35
    sidechain 0.4
    out > highpass(300hz, 0.05) > lowpass(7khz, 0.05) as tone > autopan(0.6, bars=4) > master
}

track grind {
    play rest
    using turbina
    level 0
    velocity 1.0
    gate 1.0
    pan 0.25
    reverb_send 0.2
    sidechain 0.3
    out > highpass(140hz, 0.05) > saturate(0.5) > lowpass(8khz, 0.05) > autopan(0.4, bars=1) > master
}

track perc {
    play tok_a
    using tok
    level 0
    velocity 1.0
    gate 0.3
    pan 0.38
    delay_send 0.12
    reverb_send 0.12
    sidechain 0.15
    out > highpass(250hz, 0.05) > panenv(0.5, release=250) > master
}

# ── played from the KeyLab: never touched by a step ──

# B1: the turbine on a pad, K3 on its RPM
track sig {
    play rest
    using turbina_pad
    level 0.1
    velocity 1.0
    gate 1.0
    pan 0.2
    reverb_send 0.2
    delay_send 0.1
    sidechain 0.3
    out > highpass(140hz, 0.05) > saturate(0.5) > lowpass(8khz, 0.05) > autopan(0.4, bars=1) > master
}

# B2: the riser, out until held
track riser {
    play rise
    using soplo
    level 0.35
    pan -0.1
    reverb_send 0.3
    sidechain 0.2
    out > highpass(300hz, 0.05) > autopan(0.5, hz=0.5) > master
}

# B4: the starter cranking, out until held
track spark {
    play crank
    using chispa
    level 0.3
    velocity 1.0
    gate 0.3
    pan -0.35
    delay_send 0.15
    reverb_send 0.1
    sidechain 0.2
    out > highpass(1.5khz, 0.05) > lowpass(11khz, 0.05) > master
}

# The KeyLab, laid out as CONTROLES.md says. _base.synth has F7 reverb,
# F8 echo, F9 DJ filter, A4 freeze, A7 prev, A8 next.
# The keyboard's lead in this track: its own pad voice (vacio), for the
# lead zone, through the same chain, plus a filter (`klp`) and a vowel
# (`talk`) the wheel and the knobs reach, and its own gain (`kgain`).
track ktema {
    play krest
    using vacio
    level 0.5
    velocity 1.0
    pan -0.2
    reverb_send 0.5
    delay_send 0.06
    sidechain 0.6

    out > highpass(200hz, 0.05) > phaser(0.35, bars=16) > autopan(0.45, bars=8) > lowpass(18khz, 0.1) as klp > vowel(a, wet=0) as talk > gain(1.021) as kgain > master
}

midi {
    # Faders: F2 (cc 75) the track's bass, F5 (cc 80) its own voices together;
    # the rest are _keylab.synth's. Keys A# and B: the toggle and the throw
    # that were pads A2 and A3. Knobs: the page `tema`.
    # faders
    cc 75 > bass level 0..1.2
    cc 80 > pad level 0..0.35
    cc 80 > wind level 0..0.5
    cc 80 > grind level 0..0.15
    cc 80 > sig level 0..0.15

    # knobs
    cc 74 > ign cutoff_env 250hz..1.6khz
    cc 74 > ign resonance 22%..42%
    cc 71 > vacio mod_index 15%..55%
    cc 71 > vacio feedback 0%..18%
    cc 76 > turbina_pad op1_ratio 1x..3.5x
    cc 76 > turbina_pad op2_ratio 1.01x..6.06x
    cc 76 > turbina_pad op3_ratio 1.5x..9.5x
    cc 76 > turbina_pad lfo_rate 4hz..20hz
    cc 76 > turbina_pad lfo_depth 45%..12%
    cc 76 > turbina_pad mod_index 40%..58%
    cc 77 > wind tone cutoff 900hz..9khz
    cc 93 > master hp cutoff 20hz..400hz
    cc 93 > pad delay_send 6%..50%
    cc 18 > pad delay_send 0%..80%
    cc 19 > kit_ign kick_decay 15%..45%
    cc 16 > kit_ign hihat_pitch 1.46x..1.95x..2.0x    # K8 hats: darker left, the written tuning in the middle (hihat_decay does nothing in the engine yet)
    cc 17 > bass dirt drive 0.2..1.4

    # bank A: performance
    key 46 > toggle perc
    key 47 > throw pad q=1/16

    # bank B: the track's sounds
    pad 44 > play sig F q=1/16    #3
    pad 45 > hold riser q=beat
    pad 46 > drums crash q=beat
    pad 47 > hold spark q=beat
    pad 48 > repeat 1/32
    pad 49 > throw sig q=1/16
    pad 50 > play sig G3       # the b2 rubbing against the motor
    pad 51 > mute bass         # the bass out while held, for a hole before a drop
}
