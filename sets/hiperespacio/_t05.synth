# T05 maquina — E phrygian, 142 BPM
#
# The machine room after T04's acid: dry, robotic, relentless. No saws and no
# 303 here. The bass is FM (a sine knocked by a fast modulator, a hollow
# "tok" rather than a buzz), the percussion between the drums is metal ticks
# in 3-3-2, the hats glitch in ratchets, and the one voice with a face is a
# formant robot: a buzzy FM stab through `vowel()`, so each hit says a
# different syllable. It is rhythm, not melody: E and its flat second, F.
# The bitcrushed zaps are the signature and are placed, not laid: a spin-up,
# the landing after the stutter gap, and one last burst.
#
# The room is tiny and dark: a 16th slap and a closet reverb. Nothing tails.

use "_base.synth"

# The track's level in the hour: the whole track -1.0 dB at the end of the
# master, so the set climbs the way the arc says (measured on the full render)
master {
    in > lowpass(20khz, 0.05) as dj
       > highpass(20hz, 0.05) as hp
       > compressor(-12, ratio=2, attack=10, release=80, makeup=0db)
       > eq(low=0.5, mid=-0.5, high=1)
       > gain(0.891) as trim
       > out
}

tempo 142
scale E phrygian

delay sync=sixteenth feedback=0.16 filter=0.35
reverb size=0.14 damp=0.82 predelay=3 sidechain=0.7

delay_return  { in > highpass(700hz, 0.05) > lowpass(5khz, 0.05) > autopan(0.6, bars=1) > out }
reverb_return { in > highpass(500hz, 0.05) > lowpass(3200, 0.05, lfo_bars=8, lfo_depth=800) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# Kick: high, very short and very driven: a knock with a click on it. It
# leaves the whole space after it to the FM bass.
module beats mkit {
    kick_level 1.0
    kick_decay 13%
    kick_pitch 1.16x
    kick_click 85%
    kick_drive 72%
    snare_level 0.5
    snare_decay 3%
    snare_pitch 1.9x
    snare_snap 85%
    snare_drive 20%
    snare_pan -0.15
    hihat_level 0.55
    hihat_decay 6%
    hihat_pitch 1.8x
    hihat_pan -0.2
    clap_level 0.5
    clap_pan 0.08
    crash_pan 0.2
}

# Glitch hats: a second, thinner kit hard to the right, with a tiny rim; its
# stutter is the ratchet the pattern writes
module beats gkit {
    kick_level 0.0
    snare_level 0.35
    snare_decay 0%
    snare_pitch 2x
    snare_snap 95%
    snare_drive 10%
    snare_pan 0.45
    hihat_level 0.9
    hihat_decay 3%
    hihat_pitch 1.95x
    hihat_pan 0.5
}

# FM bass: one sine carrier knocked by a modulator that dies in 35 ms, a
# touch of feedback for the edge. Dry, round and percussive
module fm fbass {
    algorithm two_op
    level 2.6
    mod_index 52%
    feedback 12%
    waveform sine
    op0_ratio 1x
    op1_ratio 2x
    op0_envelope 0.001 0.13 0.0 0.03
    op1_envelope 0.001 0.035 0.0 0.02
}

# The robot: a buzzy FM tone (feedback turns the sine into a near-saw, the
# formants need the harmonics) with a slow index LFO so its grit moves
module fm robo {
    algorithm two_op
    level 2.2
    mod_index 58%
    feedback 62%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.001 0.16 0.0 0.05
    op1_envelope 0.001 0.12 0.1 0.05
    lfo_target mod_index
    lfo_sync bars_4
    lfo_waveform triangle
    lfo_depth 25%
}

# Metal ticks: inharmonic, 25 ms, the 3-3-2 over the straight grid
module fm metal {
    algorithm dual_pairs
    level 1.6
    mod_index 74%
    feedback 30%
    waveform abs_sine
    op0_ratio 1x
    op1_ratio 7.13x
    op2_ratio 1.41x
    op3_ratio 5.27x
    op0_envelope 0.001 0.025 0.0 0.02
    op1_envelope 0.001 0.02 0.0 0.015
    op2_envelope 0.001 0.03 0.0 0.02
    op3_envelope 0.001 0.015 0.0 0.01
}

# Zap: a square LFO on pitch jumps each hit between two tones at 32nds,
# through the crusher -- a broken machine, not warp's falling blip
module fm zap {
    algorithm dual_mod
    level 1.8
    mod_index 80%
    feedback 40%
    waveform sine
    op0_ratio 1x
    op1_ratio 5.5x
    op2_ratio 3.01x
    op0_envelope 0.001 0.06 0.0 0.03
    op1_envelope 0.001 0.05 0.0 0.03
    op2_envelope 0.001 0.02 0.0 0.01
    lfo_target pitch
    lfo_sync sixteenth
    lfo_waveform square
    lfo_depth 60%
}

# ────────────────────────────────────────────────
# DRUMS (2-bar cells; the tracks chain them into 8-bar phrases)
# ────────────────────────────────────────────────

# Stripped: the mix-in and mix-out
pattern m_in {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - x -
    snare: - - - -  - - - -  - - - -  - - - o   - - - -  - - - -  - - - -  - o - o
}

pattern m_in_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    hat:   - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  x x*2 x x*3
    snare: - - - -  - - - -  - - - -  - - - o   - - - -  - - - -  - - - o  - - o -
}

pattern m_main {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
    hat:   o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x x
    snare: - - - -  - - - o  - - - -  - o - -   - - - -  - - - o  - - - -  - o - o
}

pattern m_main_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - x  - - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  - - x*2 -
    hat:   o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  x x x x  x*2 x*2 x*3 x*4
    snare: - - - -  - - - o  - - - -  - o - -   - - - -  - - - o  - o - o  x - o x
}

# Drive: the rim answers every beat, the hats go to sixteenths with fixed accents
pattern m_drive {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - o
    hat:   x o x o  x o x o  x o x o  x o x o   x o x o  x o x o  x o x o  x o x*2 o
    snare: - - - o  - - o -  - - - o  - o - -   - - - o  - - o -  - - - o  - o o -
}

pattern m_drive_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - X -  X X - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  - - - -
    hat:   x o x o  x o x o  x o x o  x o x o   x o x o  x o x o  x*2 o x*2 o  x*3 x*3 x*4 -
    snare: - - - o  - - o -  - - - o  - o - -   - - - o  - - o -  x - x -  x*2 x*2 x*3 x*4
}

# The stutter gap, two bars: the kick fires once, then the machine jams --
# hats packing from 8ths to 32nd ratchets, one beat of nothing, a rim roll
pattern m_stutter {
    kick:  X - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -
    hat:   - - x -  - - x -  - x - x  x x x x   x*2 x*2 x*2 x*2  x*3 x*3 x*3 x*3  - - - -  - - - -
    snare: - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  x*2 x*2 x*3 x*4
}

# ────────────────────────────────────────────────
# GLITCH HATS (their own part: off the grid of the main hats)
# ────────────────────────────────────────────────

pattern g_a {
    hat:   - x*2 - -  - - - x  - - x*3 -  - - - -   - x*2 - -  - - - x  - - - -  - x*3 - -
    snare: - - - -  - - - -  - - - -  - - o -   - - - -  - - - -  - - - -  - - - o
}

pattern g_b {
    hat:   - x*2 - x  - - x*3 x  - x*2 - -  x*4 - - x   - x*2 - x  - - x*3 -  - x - x*2  - x*3 x*2 -
    snare: - - - -  - - o -  - - - -  - - o -   - - - -  - - o -  - - - o  - - o o
}

pattern g_sparse {
    hat:   - - - -  - - - x  - - - -  - - - -   - - - -  - - - x  - - - -  - x*2 - -
    snare: - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - o
}

# ────────────────────────────────────────────────
# METAL TICKS: 3-3-2 against the four
# ────────────────────────────────────────────────

pattern t_332 {
    5.5:0.9 - - 5.5:0.6  - - 5.5:0.7 -   5.5:0.9 - - 5.5:0.6  - - 5.5:0.7 -
    5.5:0.9 - - 5.5:0.6  - - 5.5:0.7 -   5.5:0.9 - - 5.5:0.6  - - 6.5:0.8 -
}

# The same 3-3-2 at double speed on the turn, the accent walking
pattern t_332_turn {
    5.5:0.9 - - 5.5:0.6  - - 5.5:0.7 -   5.5:0.9 - - 5.5:0.6  - - 5.5:0.7 -
    5.5:0.9 - 5.5:0.5 -  5.5:0.9 - 5.5:0.5 -  6.5:0.9 5.5:0.6 5.5:0.7 6.5:0.9  5.5*2 5.5*3 6.5*2 -
}

# Busy: 3-3-2 in eighths plus a second voice in the gaps a fifth down
pattern t_busy {
    5.5:0.9 1.5:0.4 - 5.5:0.6  - 1.5:0.4 5.5:0.7 -   5.5:0.9 - 1.5:0.4 5.5:0.6  - 1.5:0.4 5.5:0.7 1.5:0.5
    5.5:0.9 1.5:0.4 - 5.5:0.6  - 1.5:0.4 5.5:0.7 -   6.5:0.9 - 1.5:0.4 5.5:0.6  5.5*2 - 6.5:0.8 5.5*3
}

# ────────────────────────────────────────────────
# FM BASS: the octave bounce (root, octave, root) between the kicks
# ────────────────────────────────────────────────

pattern b_a {
    - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8
    - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8
}

# The turn: the b2 on beat 2 of the last bar, then a jump up to the fifth
pattern b_a_turn {
    - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8
    - 1.1:0.95 1.2:0.55 1.1:0.8  - 2.1:0.95 2.2:0.55 2.1:0.8  - 1.1:0.95 1.2:0.55 1.1:0.8  - 5.1:0.95 1.2:0.7 2.2:0.9
}

# Held back: one tok per gap, the octave missing
pattern b_sparse {
    - 1.1:0.9 - -  - 1.1:0.9 - -  - 1.1:0.9 - -  - 1.1:0.9 - 1.1:0.6
    - 1.1:0.9 - -  - 1.1:0.9 - -  - 1.1:0.9 - -  - 2.1:0.9 - -
}

# Saved for after the gap: the octave bounce with a ratchet on the last
# sixteenth, so each beat ends in a stutter, and the b2 every second bar
pattern b_mach {
    - 1.1:0.95 1.2:0.55 <1.1:0.7 1.1:0.85>  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 <1.1:0.7 1.1:0.85>  - 1.1:0.95 1.2:0.6 1.1:0.8
    - 1.1:0.95 1.2:0.55 <1.1:0.7 1.1:0.85>  - 1.1:0.95 1.2:0.55 1.1:0.8  - 2.1:0.95 2.2:0.55 <2.1:0.7 2.1:0.85>  - 1.1:0.95 1.2:0.6 1.2:0.8
}

pattern b_mach_turn {
    - 1.1:0.95 1.2:0.55 <1.1:0.7 1.1:0.85>  - 1.1:0.95 1.2:0.55 1.1:0.8  - 1.1:0.95 1.2:0.55 <1.1:0.7 1.1:0.85>  - 1.1:0.95 1.2:0.6 1.1:0.8
    - 2.1:0.95 2.2:0.55 <2.1:0.7 2.1:0.85>  - 2.1:0.95 2.2:0.55 2.1:0.8  - 1.1:0.95 <1.2:0.7 1.2:0.8> 1.1:0.8  - <5.1:0.8 5.1:0.9> 1.2:0.8 <2.2:0.8 2.2:0.9 2.2:1.0>
}

pattern b_rest { -*32 }

# ────────────────────────────────────────────────
# ROBOT STAB: E and F, a fixed mechanical cell; the vowel moves, not the tune
# ────────────────────────────────────────────────

pattern r_a {
    - - 1.3:0.9 -  - - - -  - - 1.3:0.8 -  - - - 1.3:0.7   - - 1.3:0.9 -  - - - -  - - 1.3:0.8 -  - - - -
}

pattern r_a_turn {
    - - 1.3:0.9 -  - - - -  - - 1.3:0.8 -  - - - 1.3:0.7   - - 2.3:0.9 -  - 2.3:0.7 - -  - - 1.3:0.8 -  1.3*3 - - -
}

# The cell with an octave leap and a second hit: denser, same two notes
pattern r_b {
    - - 1.3:0.9 1.3:0.6  - - - 1.4:0.8  - - 1.3:0.8 -  - - - 1.3:0.7   - - 1.3:0.9 1.3:0.6  - - - 1.4:0.8  - - 2.3:0.8 -  - 1.3:0.7 - -
}

pattern r_b_turn {
    - - 1.3:0.9 1.3:0.6  - - - 1.4:0.8  - - 1.3:0.8 -  - - - 1.3:0.7   - - 2.3:0.9 2.3:0.6  - - - 2.4:0.8  1.3*2 - 1.4*3 -  1.3*4 - - -
}

# Transformed: the cell run into sixteenths with ratchets on the leaps
pattern r_c {
    - - 1.3:0.9 1.3:0.5  1.3:0.7 - 1.4*2 1.3:0.5  - - 1.3:0.8 1.3:0.5  1.4:0.8 - 1.3*3 -   - - 1.3:0.9 1.3:0.5  1.3:0.7 - 1.4*2 1.3:0.5  - - 2.3:0.9 2.3:0.5  2.4*2 - 1.3*4 -
}

# The stab in the stutter gap: the cell jammed on one hit
pattern r_jam {
    - - 1.3:0.9 -  - - 1.3*2 -  - - 1.3*3 -  - - 1.3*4 -   1.3*4 1.3*4 1.3*6 1.3*8  - - - -  - - - -  - - - -
}

# ────────────────────────────────────────────────
# ZAPS: gestures only
# ────────────────────────────────────────────────

# Spin-up: fourteen bars of nothing, then two bars that pack from single
# hits to eight-per-step bursts and cut dead before the next section
pattern z_spin_16 {
    -*224
    5.4:0.7 - - -  - - - -  5.4:0.7 - - -  - - 5.4:0.8 -   5.4*2 - - -  5.4*2 - 1.5:0.8 -  5.4*3 - 1.5*2 -  5.4*4 1.5*4 5.4*6 1.5*8
}

# The landing: a burst on the one of the phrase, then sparse answers
pattern z_land_16 {
    <1.5:1.0 5.4:0.9 1.5:0.9 5.4:0.8 1.5:0.8 5.4:0.7> - - -  - - - -  - - - -  - - - -
    -*16
    - - - -  - - - 5.4:0.7  - - - -  - - - -
    -*16
    - - - -  - - - -  - - - -  - - 1.5*3 -
    -*16
    - - - -  - - - 5.4:0.7  - - - -  - - - -
    -*16
    -*128
}

# Last burst: eight bars in, a two-bar roll that spins up and cuts
pattern z_burst_16 {
    -*112
    - - 5.4:0.7 -  - - - 5.4:0.7  - - 1.5*2 -  - - - 5.4*3   - - 5.4*2 -  - 1.5*3 - 5.4*3  5.4*4 - 1.5*4 -  5.4*6 1.5*6 5.4*8 1.5*8
    -*96
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play m_in, m_in, m_in, m_in_turn
    using mkit
    level 0.9
    velocity 1.0
    out > highpass(30hz, 0.05) > eq(low=1, mid=-1, high=1.5) > drums
}

track glitch {
    play g_sparse
    using gkit
    level 0
    velocity 1.0
    delay_send 0.08
    out > highpass(600hz, 0.05) > drums
}

track bass {
    play b_a, b_a, b_a, b_a_turn
    using fbass
    level 0.25
    velocity 1.0
    gate 0.7
    sidechain 0.35
    out > highpass(32hz, 0.05) > lowpass(1400hz, 0.05) as lp > saturate(0.25) as drv > master
}

track ticks {
    play t_332, t_332, t_332, t_332_turn
    using metal
    level 0.4
    velocity 1.0
    gate 0.3
    pan -0.35
    delay_send 0.06
    sidechain 0.15
    out > highpass(900hz, 0.05) > lowpass(11khz, 0.05) > panenv(0.5, release=120) > master
}

track robo {
    play r_a, r_a, r_a, r_a_turn
    using robo
    level 0
    velocity 1.0
    gate 0.45
    pan 0.22
    delay_send 0.12
    reverb_send 0.08
    sidechain 0.35
    out > highpass(180hz, 0.05) > vowel(o, i, bars=1, mix=0.85) > saturate(0.35) > lowpass(8khz, 0.05) > autopan(0.25, bars=2) > master
}

track zap {
    play z_spin_16
    using zap
    level 0
    velocity 1.0
    gate 0.4
    pan 0.3
    delay_send 0.15
    sidechain 0.2
    out > highpass(300hz, 0.05) > bitcrush(6, 0.45, wet=0.7) as crush > lowpass(9khz, 0.05) > panenv(0.7, release=200) > master
}

# ────────────────────────────────────────────────
# PERFORMANCE VOICES (the KeyLab's pads; steps never touch these)
# ────────────────────────────────────────────────

# The zap held: the same broken machine, but it sustains while the pad is
# down, and the square LFO keeps jumping its pitch at sixteenths, so a held
# note chatters like a relay on the grid. K3 is its character: low is a dull
# idle hum, high a crushed scream
module fm zapp {
    algorithm dual_mod
    level 1.6
    mod_index 55%
    feedback 30%
    waveform sine
    op0_ratio 1x
    op1_ratio 2x
    op2_ratio 3.01x
    op0_envelope 0.003 0.25 0.8 0.06
    op1_envelope 0.003 0.3 0.6 0.06
    op2_envelope 0.003 0.12 0.3 0.05
    lfo_target pitch
    lfo_sync sixteenth
    lfo_waveform square
    lfo_depth 45%
}

# Riser: FM noise whose pitch climbs on a two-bar saw, dry and dark
module fm siren {
    algorithm pair_plus_two
    level 1.2
    mod_index 90%
    feedback 85%
    waveform abs_sine
    op0_ratio 5.51x
    op1_ratio 2.27x
    op2_ratio 7.13x
    op3_ratio 1.33x
    op0_envelope 0.2 1.0 0.9 0.3
    op1_envelope 0.2 1.0 0.9 0.3
    op2_envelope 0.2 1.0 0.9 0.3
    op3_envelope 0.2 1.0 0.9 0.3
    lfo_target pitch
    lfo_sync bars_2
    lfo_waveform saw
    lfo_depth 70%
}

pattern rest { -*16 }

pattern siren_hold { 5.4:0.8 ..*31 }

# B4: a one-bar zap figure, packing to a ratchet on beat four
pattern z_fig {
    - - 5.4:0.7 -  - - - 1.5:0.8  - - 5.4:0.7 -  1.5*2 - 5.4*3 1.5*4
}

# B7: the robot jammed, one syllable packing tighter each beat
pattern r_hold {
    - - 1.3:0.9 -  - - 1.3*2 -  - - 1.3*3 -  - - 1.3*4 -
}

track zpad {
    play rest
    using zapp
    level 0.12
    velocity 1.0
    gate 1.0
    pan -0.15
    delay_send 0.12
    sidechain 0.25
    out > highpass(250hz, 0.05) > bitcrush(6, 0.4, wet=0.5) as crush > lowpass(8khz, 0.05) > gain(1.0) as kg > autopan(0.4, bars=1) > master
}

track rise {
    play siren_hold
    using siren
    level 0.45
    velocity 1.0
    gate 1.0
    sidechain 0.3
    out > highpass(700hz, 0.05) > lowpass(9khz, 0.05) > autopan(0.6, hz=0.5) > master
}

track zfig {
    play z_fig
    using zap
    level 0.2
    velocity 1.0
    gate 0.4
    pan -0.3
    delay_send 0.15
    sidechain 0.2
    out > highpass(300hz, 0.05) > bitcrush(6, 0.45, wet=0.7) as crush > lowpass(9khz, 0.05) > panenv(0.7, release=200) > master
}

track rjam {
    play r_hold
    using robo
    level 0.38
    velocity 1.0
    gate 0.45
    pan -0.2
    delay_send 0.15
    sidechain 0.35
    out > highpass(180hz, 0.05) > vowel(o, i, bars=1, mix=0.85) > saturate(0.35) > lowpass(8khz, 0.05) > master
}

# The KeyLab, in the set's fixed layout (CONTROLES.md). The base maps F7 F8 F9,
# A4 freeze, A7 prev and A8 next. Level ranges are written so the top of a
# fader is a little over where the steps run each voice
midi {
    cc 73 > drums level 0..1.0                # F1 drums
    cc 75 > glitch level 0..1.0               # F2 the glitch hats
    cc 79 > bass level 0..0.32                # F3 the FM bass
    cc 72 > robo level 0..0.6                 # F4 the robot
    cc 80 > ticks level 0..0.5                # F5 the metal ticks
    cc 81 > zap level 0..0.35                 # F6 signature: the zaps and the pad voice
    cc 81 > zpad level 0..0.16
    cc 74 > bass lp cutoff 350hz..4khz        # K1 bass: the filter over the FM tok
    cc 74 > fbass mod_index 40%..68%          #    and the knock's brightness
    cc 71 > robo mod_index 40%..78%           # K2 robot: grit
    cc 71 > robo feedback 50%..72%
    cc 76 > zapp op1_ratio 1x..6.5x           # K3 zap pad: RPM / character
    cc 76 > zapp op2_ratio 1.5x..9x
    cc 76 > zapp mod_index 40%..85%
    cc 76 > zapp lfo_depth 25%..60%
    cc 76 > zpad kg gain 1.0..1.7             #    (and a little gain: a bright index reads quieter)
    cc 77 > metal mod_index 50%..90%          # K4 ticks: metal
    cc 93 > master hp cutoff 20hz..400hz      # K5 tension: thin and wash
    cc 93 > robo delay_send 0.12..0.5
    cc 18 > robo delay_send 0..0.8            # K6 throw amount
    cc 19 > mkit kick_decay 9%..30%           # K7 kick
    cc 16 > mkit hihat_pitch 1.35x..1.8x..2.0x    # K8 hats: darker left, the written tuning in the middle (hihat_decay does nothing in the engine yet)
    cc 17 > bass drv drive 0.15..1.0          # K9 dirt: the bass drive and the pad's crusher
    cc 17 > zpad crush wet 0.2..1.0
    pad 36 > mute drums q=bar    # A1 kick out
    pad 37 > toggle glitch                    # A2 glitch hats in/out
    pad 38 > throw robo q=1/16    # A3 robot into the echo
    pad 40 > repeat 1/8                       # A5 roll
    pad 41 > repeat 1/16                      # A6 tighter roll
    pad 44 > play zpad E4 q=1/16    # B1 the zap held
    pad 45 > hold rise q=beat    # B2 riser
    pad 46 > drums crash q=beat    # B3 crash
    pad 47 > hold zfig q=beat    # B4 zap figure
    pad 48 > repeat 1/32                      # B5 stutter
    pad 49 > throw zpad q=1/16    # B6 the zap pad into the echo
    pad 50 > hold rjam                        # B7 the robot jammed
    pad 51 > play zpad F4                     # B8 the zap pad on the flat second
}
