# set: bars=64 phase=06-noche energy=7 blend=16
# set-note: Detroit cambia de armonía (Cm9, Fm9, Bbm9, Ebm9) con su propia línea de bajo; el metal contesta con dos acordes y el ride marca el contratiempo.
use "_rig.synth"
tempo 128

module keys warmth { cutoff 1khz }

module beats kit { kick_decay 34% kick_pitch 0.76x kick_click 30% kick_drive 40% hihat_level 70% }

track beat   { play kick_full16 level 1.01 }
track hats   { play hat_open8 level 1.29 }
track under  { play rest level 0 }
track bass   { play bs_b8 level 0.82 }
track chords { play ch_b level 0.24 }
track mstab  { play mstab_b level 0.14 }
track ride   { play ride_off level 0.04 }
track tick   { play tick_5 level 0.08 }
