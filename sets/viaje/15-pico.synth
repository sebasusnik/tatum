# set: bars=32 phase=pico energy=9
# set-note: El pico: el 303 a pleno, el bajo recorre los acordes y vuelven los acordes y stabs de Detroit encima. Metal en ráfagas.
use "_rig.synth"
tempo 135

module beats kit { kick_decay 28% kick_pitch 0.88x kick_click 46% kick_drive 48% hihat_level 72% }

track beat   { play kick_peak level 1.03 }
track hats   { play hat_16_open level 1 }
track roll   { play roll_peak level 0.59 }
track acid   { play acid_peak level 0.94 }
track chords { play ch_a level 0.23 }
track stabs  { play st_a level 0.31 }
track metal  { play metal_stutter level 0.82 }
