# set: bars=64 phase=melodia energy=6
# set-note: Entra el gancho de Detroit: unas cuerdas con una melodía de dieciséis compases sobre los acordes, la que se tararea. El bajo vuelve a su línea de siempre.
use "_rig.synth"
tempo 127

module beats kit { kick_decay 30% kick_pitch 0.8x kick_click 30% hihat_level 70% hihat_decay 28% }

track bed     { level 0.16 }
track beat    { play kick_clap8 level 1.07 }
track hats    { play hat_off8 level 2 }
track perc    { play perc_detroit8 level 0.7 delay_send 0.15 reverb_send 0.12 }
track under   { play ch_low level 0.06 }
track bass    { play bs_ab16 level 0.95 }
track chords  { play ch_pulse level 0.26 }
track strings { play hook16 level 0.21 }
