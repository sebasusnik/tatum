# set: bars=64 phase=lleno energy=7
# set-note: Detroit a pleno: crash al empezar, stabs que contestan, el hat abierto, remates cada ocho compases y uno largo al final de cada dieciséis.
use "_rig.synth"
tempo 128

module beats kit { kick_decay 28% kick_pitch 0.8x kick_click 34% hihat_level 70% }

track bed    { level 0.12 }
track beat   { play kick_full16 level 1.01 }
track hats   { play hat_open8 level 1.29 }
track perc   { play perc_detroit8 level 0.41 delay_send 0.15 reverb_send 0.12 }
track under  { play ch_low level 0.05 }
track bass   { play bs_ab16 level 0.93 }
track chords { play ch_a level 0.27 }
track stabs  { play st_ab16 level 0.32 }
track chime  { play bl_a level 0.81 }
