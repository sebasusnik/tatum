# set: bars=64 phase=lluvia energy=4
# set-note: Lluvia: rims que caen al azar en las semicorcheas y se multiplican en el eco, sobre el groove dub. El acorde a medio tiempo y más oscuro.
use "_rig.synth"

module keys chord { cutoff 1.5khz }

track bed   { play hiss_swell level 0.34 }
track stab  { play stab_half8 level 0.26 delay_send 0.5 }
track beat  { play kick_dub8 level 0.78 }
track hats  { play hat_ghost8 level 1.6 }
track sub   { play sub_f8 level 0.74 }
track perc  { play perc_rain8 level 0.42 delay_send 0.55 }
