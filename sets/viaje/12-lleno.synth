# set: bars=32 phase=lleno energy=7
# set-note: Detroit a pleno: crash al empezar, stabs que contestan, el hat abierto, remates cada ocho compases y uno largo al final de cada dieciséis.
use "_rig.synth"
tempo 128

module beats kit { kick_decay 34% kick_pitch 0.8x kick_click 34% }

track bed    { level 0.11 }
track beat   { play kick_full16 level 0.94 }
track hats   { play hat_open8 level 0.83 }
track perc   { play perc_detroit8 level 0.38 delay_send 0.15 reverb_send 0.12 }
track under  { play ch_low level 0.09 }
track bass   { play bs_ab16 level 0.87 }
track chords { play ch_a level 0.25 }
track stabs  { play st_ab16 level 0.3 }
track chime  { play bl_a level 0.76 }
