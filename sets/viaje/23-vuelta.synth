# set: bars=16 phase=07-acido energy=5
# set-note: La vuelta: el 303 sigue del respiro y el bombo vuelve de a poco, un golpe por compás, después dos, después cuatro. Los hats y el sub llegan en la segunda mitad; los acordes del respiro siguen sonando.
use "_rig.synth"
tempo 129

module beats kit { kick_decay 32% kick_pitch 0.84x kick_click 38% kick_drive 42% hihat_level 72% }

track beat   { play kick_rise16 level 1.0 }
track hats   { play hat_rise16 level 1.1 }
track sub    { play sub_rise16 level 0.56 }
track chords { play ch_b level 0.18 }
track acid   { play acid_back16 level 0.33 }
