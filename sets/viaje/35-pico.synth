# set: bars=64 phase=11-pico energy=9
# set-note: El pico, lo más fuerte del set: crash al empezar, el 303 a pleno con giros en el 8 y el 16, el bajo recorre los acordes y vuelven los acordes y stabs de Detroit. Metal en ráfagas.
use "_rig.synth"
tempo 135

module beats kit { kick_decay 28% kick_pitch 0.88x kick_click 46% kick_drive 48% hihat_level 72% }

track beat   { play kick_peak16 level 1.2 }
track hats   { play hat_16_open level 1.16 }
track roll   { play roll_peak level 0.69 }
track acid   { play acid_peak16 level 0.61 delay_send 0.08 }
track chords { play ch_a level 0.27 }
track stabs  { play st_ab16 level 0.36 }
track metal  { play metal_stutter level 0.95 }
track shaker { play shake4 level 0.09 }
track ride   { play ride_off level 0.049 }
track tick   { play tick332 level 0.085 }
