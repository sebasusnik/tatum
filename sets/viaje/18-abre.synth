# set: bars=32 phase=abre energy=6
# set-note: Tensión sin cortar el groove: el bajo se aquieta, los acordes se abren, y el pluck queda en tres notas por compás, esperando.
use "_rig.synth"
tempo 127

module fm pluck { mod_index 28% }

module beats kit { kick_decay 30% kick_pitch 0.8x kick_click 32% hihat_level 70% hihat_decay 28% }
module keys warmth { cutoff 2.2khz }

track bed    { play hiss_swell level 0.23 }
track beat   { play kick_clap8 level 1.12 }
track hats   { play hat_off8 level 2.07 }
track perc   { play perc_detroit8 level 0.82 delay_send 0.15 reverb_send 0.12 }
track under  { play ch_low level 0.07 }
track bass   { play bs_intro level 0.82 }
track chords { play ch_a level 0.32 }
track pluck  { play pluck_d level 0.144 delay_send 0.3 }
