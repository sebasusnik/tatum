# set: bars=64 phase=hondo energy=5
# set-note: El dub hondo: el cambio de acorde dos veces por frase, los toms en el eco, y la capa de detalle entera por arriba.
use "_rig.synth"

module keys chord { cutoff 2.1khz }

track bed   { play hiss_swell level 0.28 }
track stab  { play stab_dub8 level 0.27 delay_send 0.5 }
track beat  { play kick_dub8 level 0.8 }
track hats  { play hat_dub8 level 1.12 }
track sub   { play sub_dub8 level 0.76 }
track perc  { play perc_dub8 level 0.45 }
track shaker { play shake4 level 0.06 }
track tick   { play tick332 level 0.085 }
track ride   { play ride_off level 0.035 }
