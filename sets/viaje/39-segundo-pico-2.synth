# set: bars=64 phase=segundo-pico-2 energy=9
# set-note: El segundo pico sigue y vuelve el protagonista de Detroit: el pluck en semicorcheas sobre el 303 y el bajo rodante, el metal contestando, el acorde dub tirado al eco.
use "_rig.synth"
tempo 135

module fm pluck { mod_index 58% }

module beats kit { kick_decay 28% kick_pitch 0.88x kick_click 46% kick_drive 48% hihat_level 72% }

track beat    { play kick_peak16 level 1.15 }
track hats    { play hat_16_open level 1.2 }
track roll    { play roll_peak level 0.66 }
track acid    { play acid_low16 level 0.44 }
track throw   { play throw_dub8 level 0.2 }
track pluck  { play pluck_c level 0.099 }
track mstab  { play mstab_b level 0.13 }
track shaker { play shake4 level 0.09 }
track tick   { play tick332 level 0.085 }
