# set: bars=16 phase=rareza energy=7
# set-note: El momento raro: se va el clap, el 303 queda solo con el bajo rodante y un módem conversa en el costado.
use "_rig.synth"
tempo 132

module beats kit { kick_decay 30% kick_pitch 0.86x kick_click 42% kick_drive 45% hihat_level 72% }

track beat   { play kick_roll level 1.17 }
track hats   { play hat_16 level 1.01 }
track roll   { play roll_f level 0.7 }
track acid   { play acid_riff level 1.09 }
track chirp  { play dialup_scatter level 0.84 }
