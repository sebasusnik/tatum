# set: bars=32 phase=acido energy=6
# set-note: The kick steady, the Detroit hats carrying on, and the 303 opening its filter over sixteen bars: it jumps and ratchets at 8, slides up at 16.
use "_rig.synth"
tempo 130

module beats kit { kick_decay 32% kick_pitch 0.84x kick_click 38% kick_drive 42% hihat_level 72% }

track bed    { level 0.12 }
track beat   { play kick_acid8 level 1.05 }
track hats   { play hat_off8 level 1.24 }
track sub    { play sub_f8 level 0.63 }
track under  { play ch_low level 0.1 }
track chords { play ch_b level 0.15 }
track acid   { play acid_low16 level 0.5 }
