# set: bars=32 phase=dub-eco energy=4
# set-note: Mandan los ecos: el bombo pasa a medio tiempo, el acorde toca poco y lo que suena es su eco; toms que caen y se repiten. Un respiro con groove.
use "_rig.synth"

module keys chord { cutoff 1.8khz }

track bed   { play hiss_swell level 0.4 }
track stab  { play stab_ghost level 0.24 delay_send 0.8 }
track beat  { play kick_thin8 level 0.8 }
track hats  { play hat_ghost8 level 1.5 }
track sub   { play sub_long level 0.5 }
track perc  { play perc_dub8 level 0.5 }
track throw { play throw_dub8 level 0.2 }
