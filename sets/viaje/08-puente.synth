# set: bars=16 phase=puente energy=5
# set-note: Detroit asoma por abajo: el acorde grave de fondo y el bajo que empieza a caminar, sobre el groove dub que sigue en sus frases.
use "_rig.synth"
tempo 124

track bed   { play hiss_swell level 0.26 }
track stab  { play stab_half8 level 0.2 delay_send 0.35 }
track beat  { play kick_dub8 level 0.8 }
track hats  { play hat_dub8 level 1.0 }
track sub   { play sub_f8 level 0.53 }
track perc  { play perc_sparse8 level 0.45 }
track under { play ch_low level 0.12 }
track bass  { play bs_intro level 0.5 }
