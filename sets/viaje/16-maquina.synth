# set: bars=32 phase=maquina energy=7
# set-note: El bajo rueda en semicorcheas, entran el clap y los hats a 16; el 303 se abre y aparece un golpe de metal suelto.
use "_rig.synth"
tempo 132

module beats kit { kick_decay 30% kick_pitch 0.86x kick_click 42% kick_drive 45% hihat_level 72% }

track beat   { play kick_clap level 1.16 }
track hats   { play hat_16 level 1.1 }
track roll   { play roll_move level 0.69 }
track acid   { play acid_riff level 1.08 }
track metal  { play metal_hit level 1.1 }
