# set: bars=32 phase=maquina energy=7
# set-note: The bass rolls, the clap comes in with a roll at the end of each phrase, and sixteenth hats that drop out on the last beat. The 303 riff opens twice and answers with ratchets; a lone metal hit.
use "_rig.synth"
tempo 132

module beats kit { kick_decay 30% kick_pitch 0.86x kick_click 42% kick_drive 45% hihat_level 72% }

track beat   { play kick_acidclap8 level 1.16 }
track hats   { play hat_16_8 level 1.1 }
track roll   { play roll_move level 0.69 }
track acid   { play acid_riff16 level 0.6 }
track metal  { play metal_hit level 1.1 }
