# set: bars=32 phase=pulso energy=2
# set-note: The kick and a long sub come in. Every eight bars the kick takes a breath and a tom or a rim falls into the echo.
use "_rig.synth"

track bed  { play hiss_swell level 0.5 }
track stab { play stab_ghost level 0.14 velocity 0.6 }
track beat { play kick_four8 level 0.6 }
track sub  { play sub_long level 0.51 }
track perc { play perc_sparse8 level 0.5 }
