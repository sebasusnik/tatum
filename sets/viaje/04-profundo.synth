# set: bars=32 phase=profundo energy=4
# set-note: El acorde en cada contratiempo, el rim, los hats completos. El groove dub entero.
use "_rig.synth"

track bed  { level 0.32 }
track stab { play stab_full level 0.29 }
track beat { play kick_rim level 0.76 }
track hats { play hat_dub level 0.8 }
track sub  { play sub_f level 0.54 }
