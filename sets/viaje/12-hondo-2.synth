# set: bars=48 phase=hondo-2 energy=5
# set-note: El dub en su punto más lleno: los hats más ocupados, el sub que camina de F a Ab, Db y Eb, el detalle arriba y el aire de la estática debajo.
use "_rig.synth"

module keys chord { cutoff 2.3khz }

track bed   { play hiss_swell level 0.28 }
track stab  { play stab_dub8 level 0.29 delay_send 0.5 }
track beat  { play kick_dub8 level 0.86 }
track hats  { play hat_dub16 level 1.2 }
track sub   { play sub_move16 level 0.79 }
track perc  { play perc_dub8 level 0.45 }
track shaker { play shake4 level 0.07 }
track tick   { play tick332 level 0.102 }
track ride   { play ride_off level 0.042 }
track static { play static_bed level 0.04 }
