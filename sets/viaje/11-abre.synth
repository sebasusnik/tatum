# set: bars=16 phase=abre energy=6
# set-note: Tensión sin cortar el groove: el bajo se aquieta, los acordes se abren y suben, la campana aparece. El bombo sigue.
use "_rig.synth"
tempo 127

module beats kit { kick_decay 36% kick_pitch 0.8x kick_click 32% }
module keys warmth { cutoff 1.6khz }

track bed    { play hiss_swell level 0.2 }
track beat   { play kick_clap8 level 0.95 }
track hats   { play hat_off8 level 0.9 }
track perc   { play perc_detroit8 level 0.45 delay_send 0.15 reverb_send 0.12 }
track under  { play ch_low level 0.1 }
track bass   { play bs_intro level 0.7 }
track chords { play ch_a level 0.3 }
track chime  { play bl_a level 0.6 }
