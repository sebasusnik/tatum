# set: bars=32 phase=lleno energy=7
# set-note: Detroit a pleno: stabs en el contratiempo, la campana, el hat abierto.
use "_rig.synth"
tempo 128

module beats kit { kick_decay 34% kick_pitch 0.8x kick_click 34% }

track bed    { level 0.12 }
track beat   { play kick_full level 1.0 }
track hats   { play hat_open level 0.88 }
track under  { play ch_low level 0.1 }
track bass   { play bs_a level 0.92 }
track chords { play ch_a level 0.27 }
track stabs  { play st_a level 0.32 }
track chime  { play bl_a level 0.8 }
