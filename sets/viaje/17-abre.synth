# set: bars=32 phase=05-gancho energy=6
# set-note: Tensión sin cortar el groove: el bajo se aquieta, los acordes se abren, y el pluck queda en tres notas por compás, esperando.
use "_rig.synth"
tempo 127

module fm pluck { mod_index 28% }

module beats kit { kick_decay 28% kick_pitch 0.82x kick_click 38% hihat_level 70% hihat_decay 28% }
module keys warmth { cutoff 2.2khz }

track beat   { play kick_gancho8 level 1.24 }
track hats   { play hat_gancho8 level 1.493 }
track perc   { play perc_detroit8 level 0.941 delay_send 0.15 reverb_send 0.12 }
track bass   { play bs_intro level 0.941 }
track pluck  { play pluck_d level 0.165 delay_send 0.3 }
track shaker { play shake_b level 0.08 }
track under  { play ch_drone level 0.08 }
