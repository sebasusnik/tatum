# set: bars=64 phase=02-profundo energy=4
# set-note: El groove dub entero en frases de ocho: el rim contesta, un acorde se corre, un acorde tirado al eco al final de cada frase. Aparece un tick metálico en 3-3-2, bajito.
use "_rig.synth"

track bed   { play hiss_swell level 0.32 }
track stab  { play stab_full8 level 0.25 delay_send 0.4 }
track beat  { play kick_dub8 level 0.76 }
track hats  { play hat_dub8 level 1.1 }
track sub   { play sub_f8 level 0.72 }
track perc  { play perc_sparse8 level 0.5 }
track throw { play throw8 level 0.2 }
track tick   { play tick332 level 0.068 }
