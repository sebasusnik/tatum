# set: bars=32 phase=entra energy=3
# set-note: The chord comes closer at half time and answers late in bar 4; ghost hats that are never the same; the sub steps up once a phrase.
use "_rig.synth"

track bed  { play hiss_swell level 0.44 }
track stab { play stab_half8 level 0.22 delay_send 0.4 }
track beat { play kick_four8 level 0.7 }
track hats { play hat_ghost8 level 0.95 }
track sub  { play sub_f8 level 0.65 }
track perc { play perc_sparse8 level 0.5 }
