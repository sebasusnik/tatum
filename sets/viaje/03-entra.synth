# set: bars=32 phase=entra energy=3
# set-note: El acorde se acerca a medio tiempo, aparecen hats fantasma.
use "_rig.synth"

track bed  { level 0.44 }
track stab { play stab_half level 0.24 }
track beat { play kick_four level 0.7 }
track hats { play hat_ghost level 0.7 }
track sub  { play sub_f level 0.48 }
