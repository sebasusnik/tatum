# set: bars=16 phase=vuelta energy=5
# set-note: The return: the 303 carries on from the breather and the kick comes back bit by bit, one hit a bar, then two, then four. The hats and the sub arrive in the second half; the breather's chords keep sounding.
use "_rig.synth"
tempo 129

module beats kit { kick_decay 32% kick_pitch 0.84x kick_click 38% kick_drive 42% hihat_level 72% }

track bed    { play hiss_swell level 0.2 }
track beat   { play kick_rise16 level 1.0 }
track hats   { play hat_rise16 level 1.1 }
track sub    { play sub_rise16 level 0.56 }
track under  { play ch_low level 0.1 }
track chords { play ch_b level 0.18 }
track chime  { play bl_a level 0.4 }
track acid   { play acid_back16 level 0.33 }
