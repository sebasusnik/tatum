# set: bars=64 phase=07-acido energy=6
# set-note: El bombo firme, los hats de Detroit que siguen y el 303 que abre su filtro a lo largo de dieciséis compases: salta y repica en el 8, sube deslizando en el 16.
use "_rig.synth"
tempo 130

module beats kit { kick_decay 32% kick_pitch 0.84x kick_click 38% kick_drive 42% hihat_level 72% }

track beat   { play kick_acid8 level 1.05 }
track hats   { play hat_acid8 level 1.2 }
track sub    { play sub_f8 level 0.63 }
track acid   { play acid_low16 level 0.5 }
