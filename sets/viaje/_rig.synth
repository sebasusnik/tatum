# The swarm, in bursts: three bars buzzing, one quiet, a rising figure, three quiet.
pattern insect_pulse8 {
    F4:0.38 - F4:0.25 -  F4:0.35 - - F4:0.22  F4:0.38 - F4:0.25 -  F4:0.32 - - -
    F4:0.38 - F4:0.25 -  F4:0.35 - - F4:0.22  F4:0.38 - F4:0.25 -  F4:0.32 - - -
    F4:0.38 - F4:0.25 -  F4:0.35 - - F4:0.22  F4:0.38 - F4:0.25 -  F4:0.32 - - -
    - - - -  - - - -  - - - -  - - - -
    F4:0.38 - F4:0.25 -  Ab4:0.35 - - F4:0.22  C5:0.38 - F4:0.25 -  Eb5:0.32 - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
}

# ── The way out, back to the dub ──

# The 303 on the way down: its envelope closing and its accents softening over 16 bars, still playing.
pattern acid_down16 {
    F3:0.90(edepth=0.84) - F3:0.50(edepth=0.84) -  F4:0.70(edepth=0.84) - F3:0.50(edepth=0.84) -  F3:0.90(edepth=0.84) - Ab3:0.60(edepth=0.84) -  F3:0.70(edepth=0.84) ~Eb3:0.60 - F3:0.50(edepth=0.84)
    F3:0.88(edepth=0.83) - F3:0.49(edepth=0.83) -  F4:0.69(edepth=0.83) - F3:0.49(edepth=0.83) -  F3:0.88(edepth=0.83) - C4:0.59(edepth=0.83) -  Bb3:0.69(edepth=0.83) ~Ab3:0.59 - F3:0.49(edepth=0.83)
    F3:0.86(edepth=0.81) - F3:0.48(edepth=0.81) -  F4:0.67(edepth=0.81) - F3:0.48(edepth=0.81) -  F3:0.86(edepth=0.81) - Ab3:0.58(edepth=0.81) -  F3:0.67(edepth=0.81) ~Eb3:0.58 - F3:0.48(edepth=0.81)
    F3:0.85(edepth=0.80) - F3:0.47(edepth=0.80) -  F4:0.66(edepth=0.80) - F3:0.47(edepth=0.80) -  F3:0.85(edepth=0.80) - C4:0.56(edepth=0.80) -  Bb3:0.66(edepth=0.80) ~Ab3:0.56 - F3:0.47(edepth=0.80)
    F3:0.83(edepth=0.78) - F3:0.46(edepth=0.78) -  F4:0.64(edepth=0.78) - F3:0.46(edepth=0.78) -  F3:0.83(edepth=0.78) - Ab3:0.55(edepth=0.78) -  F3:0.64(edepth=0.78) ~Eb3:0.55 - F3:0.46(edepth=0.78)
    F3:0.81(edepth=0.77) - F3:0.45(edepth=0.77) -  F4:0.63(edepth=0.77) - F3:0.45(edepth=0.77) -  F3:0.81(edepth=0.77) - C4:0.54(edepth=0.77) -  Bb3:0.63(edepth=0.77) ~Ab3:0.54 - F3:0.45(edepth=0.77)
    F3:0.79(edepth=0.75) - F3:0.44(edepth=0.75) -  F4:0.62(edepth=0.75) - F3:0.44(edepth=0.75) -  F3:0.79(edepth=0.75) - Ab3:0.53(edepth=0.75) -  F3:0.62(edepth=0.75) ~Eb3:0.53 - F3:0.44(edepth=0.75)
    F3:0.77(edepth=0.74) - F3:0.43(edepth=0.74) -  F4:0.60(edepth=0.74) - F3:0.43(edepth=0.74) -  F3:0.77(edepth=0.74) - C4:0.52(edepth=0.74) -  Bb3:0.60(edepth=0.74) ~Ab3:0.52 - F3:0.43(edepth=0.74)
    F3:0.76(edepth=0.72) - F3:0.42(edepth=0.72) -  F4:0.59(edepth=0.72) - F3:0.42(edepth=0.72) -  F3:0.76(edepth=0.72) - Ab3:0.50(edepth=0.72) -  F3:0.59(edepth=0.72) ~Eb3:0.50 - F3:0.42(edepth=0.72)
    F3:0.74(edepth=0.71) - F3:0.41(edepth=0.71) -  F4:0.57(edepth=0.71) - F3:0.41(edepth=0.71) -  F3:0.74(edepth=0.71) - C4:0.49(edepth=0.71) -  Bb3:0.57(edepth=0.71) ~Ab3:0.49 - F3:0.41(edepth=0.71)
    F3:0.72(edepth=0.69) - F3:0.40(edepth=0.69) -  F4:0.56(edepth=0.69) - F3:0.40(edepth=0.69) -  F3:0.72(edepth=0.69) - Ab3:0.48(edepth=0.69) -  F3:0.56(edepth=0.69) ~Eb3:0.48 - F3:0.40(edepth=0.69)
    F3:0.70(edepth=0.68) - F3:0.39(edepth=0.68) -  F4:0.55(edepth=0.68) - F3:0.39(edepth=0.68) -  F3:0.70(edepth=0.68) - C4:0.47(edepth=0.68) -  Bb3:0.55(edepth=0.68) ~Ab3:0.47 - F3:0.39(edepth=0.68)
    F3:0.68(edepth=0.66) - F3:0.38(edepth=0.66) -  F4:0.53(edepth=0.66) - F3:0.38(edepth=0.66) -  F3:0.68(edepth=0.66) - Ab3:0.46(edepth=0.66) -  F3:0.53(edepth=0.66) ~Eb3:0.46 - F3:0.38(edepth=0.66)
    F3:0.67(edepth=0.65) - F3:0.37(edepth=0.65) -  F4:0.52(edepth=0.65) - F3:0.37(edepth=0.65) -  F3:0.67(edepth=0.65) - C4:0.44(edepth=0.65) -  Bb3:0.52(edepth=0.65) ~Ab3:0.44 - F3:0.37(edepth=0.65)
    F3:0.65(edepth=0.63) - F3:0.36(edepth=0.63) -  F4:0.50(edepth=0.63) - F3:0.36(edepth=0.63) -  F3:0.65(edepth=0.63) - Ab3:0.43(edepth=0.63) -  F3:0.50(edepth=0.63) ~Eb3:0.43 - F3:0.36(edepth=0.63)
    F3:0.63(edepth=0.62) - F3:0.35(edepth=0.62) -  F4:0.49(edepth=0.62) - F3:0.35(edepth=0.62) -  F3:0.63(edepth=0.62) - C4:0.42(edepth=0.62) -  Bb3:0.49(edepth=0.62) ~Ab3:0.42 - F3:0.35(edepth=0.62)
}

# ── Precision: the pluck, the metal and the detail ──

# The pluck's motif: the root and its octave, Eb and C against it, a slide into Db.
pattern pluck_a {
    F3:0.9 - F4:0.6 -  - F3:0.7 - Eb4:0.8  - - F3:0.9 -  C4:0.7 - ~Db4:0.8 -
    F3:0.9 - F4:0.6 -  - F3:0.7 - Ab3:0.8  - - Bb3:0.8 -  ~C4:0.7 - F3:0.6 -
}

# The motif with ratchets and octave leaps; the Gb is the dark semitone above F.
pattern pluck_b {
    F3:0.9 F4:0.8*2 - Eb4:0.7  - F3:0.6 Ab4:0.9 -  F3:0.9 - C5:0.8 ~Db5:0.7  F3:0.9*3 - F4:0.8 -
    F3:0.9 F4:0.8*2 - Eb4:0.7  - F3:0.6 Ab4:0.9 -  Db5:1.0 ~C5:0.8 - Gb4:0.9*2  F3:0.9 - ~F4:1.0 -
}

# The peak: every sixteenth.
pattern pluck_c {
    F3:0.9 F4:0.6 F3:0.7 Eb4:0.8  F3:0.9 F4:0.6 C5:0.8 F3:0.6  F3:0.9 F4:0.6 F3:0.7 Ab4:0.8  F3:0.9 Db5:0.9*2 F4:0.7 C5:0.9
    F3:0.9 F4:0.6 F3:0.7 Eb4:0.8  F3:0.9 F4:0.6 C5:0.8 F3:0.6  Db5:1.0*3 ~C5:0.9 F4:0.7 Ab4:0.8  F3:0.9 Gb4:1.0*2 ~F4:0.9 F3:0.8
}

# What is left of the motif: three notes a bar.
pattern pluck_d {
    F3:0.9 - - -  - - F4:0.7 -  - - F3:0.8 -  - - - -
    F3:0.9 - - -  - - Eb4:0.7 -  - - ~Gb3:0.8 -  - - - -
}

# Metal answering on the second bar: F, Ab and Db struck together.
pattern mstab_a {
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - [F3 Ab3 Db4]:0.9 -  - - - -  - - [F3 Ab3 Db4]:0.7 -
}

# More of it, and a second chord a step down.
pattern mstab_b {
    - - - -  - - [F3 Ab3 Db4]:0.7 -  - - - -  - - - -
    - - - -  - - [F3 Ab3 Db4]:0.9 -  - - [Eb3 Gb3 C4]:0.75 -  - - [F3 Ab3 Db4]:0.7 -
}

# A metal tick on a 3-3-2 against the four, ghosts coming and going over four bars.
pattern tick332 {
    F6:0.8 - - F6:0.6  - - F6:0.8 -  - F6:0.4 - F6:0.7  - F6:0.35 - -
    F6:0.8 - - F6:0.6  - - F6:0.8 -  - - - F6:0.7  - - - -
    F6:0.8 - - F6:0.6  - - F6:0.8 -  - - - F6:0.7  - - - -
    F6:0.8 - - F6:0.6  - - F6:0.8 -  - F6:0.38 - F6:0.7  - F6:0.42 - -
}

# The shaker: sixteenths, the offbeat eighths accented, the ghosts coming and going.
pattern shake4 {
    C6:0.49 - C6:0.84 -  C6:0.52 C6:0.21 C6:0.82 -  C6:0.50 - C6:0.77 C6:0.37  C6:0.46 C6:0.33 C6:0.87 C6:0.28
    C6:0.58 - C6:0.86 C6:0.23  C6:0.46 C6:0.36 C6:0.78 C6:0.33  C6:0.49 C6:0.21 C6:0.77 C6:0.34  C6:0.50 C6:0.32 C6:0.81 C6:0.36
    C6:0.54 C6:0.31 C6:0.82 C6:0.35  C6:0.48 C6:0.22 C6:0.81 C6:0.23  C6:0.51 - C6:0.84 C6:0.31  C6:0.56 C6:0.34 C6:0.83 C6:0.29
    C6:0.56 C6:0.29 C6:0.84 -  C6:0.54 C6:0.40 C6:0.86 C6:0.28  C6:0.53 - C6:0.82 -  C6:0.46 - C6:0.85 -
}

# The ride on the offbeat.
pattern ride_off {
    - - F5:0.6 -  - - F5:0.5 -  - - F5:0.6 -  - - F5:0.5 -
}

# The air: one note held, the static breathing under a groove.
pattern static_bed { F4:0.6 ..*63 }

# ════════════════════════════════════════════════════════
# BUSES
# ════════════════════════════════════════════════════════

bus drums
drums {
    in > compressor(-14, ratio=2.8, attack=15, release=150, makeup=2db)
       > saturate(0.35)
       > lowpass(9khz, 0.1)
       > master
}

# ════════════════════════════════════════════════════════
# TRACKS — every voice of the set; a step brings them up
# ════════════════════════════════════════════════════════

track beat { play rest using kit level 0.9 sidechain 0.0 out > drums }
track hats { play rest using kit level 0.8 sidechain 0.0 out > drums }

track sub {
    play rest
    using sub
    level 0
    gate 0.92
    sidechain 0.2
    out > saturate(0.3) > lowpass(700hz, 0.1) > highpass(30hz, 0.01) > master
}

track stab {
    play stab_ghost
    using chord
    level 0
    gate 0.16
    velocity 0.75
    pan -0.12
    delay_send 0.5
    reverb_send 0.35
    sidechain 0.5
    out > highpass(300hz, 0.15)
        > lowpass(3.6khz, 0.12, lfo_bars=8, lfo_depth=1400)
        > compressor(-14, ratio=2.0, attack=15, release=200, makeup=3db)
        > saturate(0.2)
        > autopan(0.8, bars=4)
        > master
}

track bed {
    play hiss_hold
    using hiss
    pan -0.38
    level 0
    reverb_send 0.3
    delay_send 0.06
    sidechain 0.35
    out > highpass(300hz, 0.12)
        > lowpass(2.2khz, 0.2, lfo_bars=8, lfo_depth=1400)
        > autopan(0.5, bars=8)
        > master
}

track bass {
    play rest
    using walker
    velocity 0.92
    level 0
    gate 0.62
    sidechain 0.55
    out > saturate(0.7)
        > highpass(32hz, 0.05)
        > compressor(-18db, ratio=4, attack=2ms, release=90ms, makeup=6db)
        > master
}

track chords {
    play rest
    using warmth
    velocity 0.80
    level 0
    gate 1.0
    sidechain 0.42
    delay_send 0.14
    # Its reverb was the loudest thing in the Detroit mix between 120 and
    # 400 Hz: the mud. Less of it, the chord cut higher, and the top let
    # through so it is heard above the bass rather than on top of it.
    reverb_send 0.14
    out > highpass(260hz, 0.05)
        > lowpass(3.6khz, 0.05, lfo_bars=12, lfo_depth=900)
        > eq(low=-1.5, mid=-1, high=1.5)
        > autopan(0.65, bars=9)
        > master
}

track under {
    play rest
    using under
    velocity 0.70
    level 0
    gate 1.0
    sidechain 0.30
    # Dry: a low pad in the reverb is mud.
    out > highpass(45hz, 0.05) > lowpass(320hz, 0.05) > master
}

track stabs {
    play rest
    using stab
    velocity 0.65
    level 0
    gate 0.30
    pan 0.34
    sidechain 0.35
    delay_send 0.28
    reverb_send 0.14
    out > saturate(0.8) > highpass(400hz, 0.05) > master
}

# The keys play this. A pattern of rests: only the hands sound it.
track lead {
    play rest
    using lead
    level 0.5
    pan 0.1
    sidechain 0.3
    delay_send 0.32
    reverb_send 0.22
    out > highpass(120hz, 0.05) > saturate(0.3) > master
}

# ── The acid stretch ──

track acid {
    play rest
    using squelch
    level 0
    gate 0.55
    sidechain 0.35
    delay_send 0.12
    reverb_send 0.06
    # Each hit lands to one side and walks back to the centre.
    out > highpass(120hz, 0.05)
        > saturate(4.5)
        > vowel(a, o, bars=4, mix=0.35)
        > lowpass(6.2khz, 0.1)
        > compressor(-22db, ratio=5, attack=3ms, release=50ms, makeup=6db)
        > panenv(0.5, attack=5ms, release=200ms)
        > eq(low=-1.5, mid=1, high=2.4)
        > master
}

track roll {
    play rest
    using roller
    level 0
    gate 0.5
    sidechain 0.6
    out > saturate(0.3) > highpass(30hz, 0.05) > lowpass(900hz, 0.05) > master
}

track metal {
    play rest
    using metal
    level 0
    gate 0.08
    pan 0.35
    delay_send 0.2
    reverb_send 0.1
    # abs_sine carries DC, and the feedback turns it into rumble.
    out > highpass(150hz, 0.1) > saturate(0.3) > lowpass(12khz, 0.1) > master
}

track chirp {
    play rest
    using dialup
    level 0
    gate 0.04
    pan 0.45
    delay_send 0.22
    reverb_send 0.08
    out > highpass(200hz, 0.1) > saturate(0.25) > master
}

track insects {
    play rest
    using insects
    level 0
    gate 0.5
    pan -0.35
    delay_send 0.2
    reverb_send 0.15
    # half_sine carries DC; take it out before anything else.
    out > highpass(200hz, 0.1) > master
}

track siren {
    play rest
    using siren
    level 0
    pan -0.38
    delay_send 0.15
    reverb_send 0.2
    out > highpass(200hz, 0.1) > master
}

track air {
    play rest
    using air
    level 0
    pan 0.1
    reverb_send 0.25
    out > highpass(300hz, 0.1) > lowpass(4khz, 0.1) > master
}

# ── The dub block ──

# Rim and toms that live in the echo: a few hits a phrase, the repeats do the rest.
track perc {
    play rest
    using kit
    level 0
    pan 0.22
    sidechain 0.0
    delay_send 0.7
    reverb_send 0.25
    out > highpass(180hz, 0.1) > drums
}

# One chord thrown into the echo at the end of a phrase.
track throw {
    play rest
    using chord
    level 0
    gate 0.2
    pan 0.2
    delay_send 0.95
    reverb_send 0.4
    sidechain 0.3
    out > highpass(300hz, 0.15) > lowpass(3khz, 0.12) > master
}

# ── Precision tracks ──

# The pluck: its brightness moves with the step's mod_index; a vowel filter
# that a step can open (wet) makes it talk.
track pluck {
    play rest
    using pluck
    level 0
    velocity 1.0
    gate 0.7
    pan 0.1
    sidechain 0.3
    delay_send 0.18
    reverb_send 0.08
    out > highpass(220hz, 0.05)
        > vowel(a, e, bars=2, wet=0) as talk
        > panenv(0.45, release=250)
        > lowpass(9khz, 0.05)
        > master
}

track mstab {
    play rest
    using mstab
    level 0
    velocity 1.0
    gate 0.4
    pan -0.3
    delay_send 0.22
    reverb_send 0.12
    out > highpass(250hz, 0.05) > master
}

track tick {
    play rest
    using tick
    level 0
    velocity 1.0
    gate 0.2
    pan -0.4
    reverb_send 0.1
    delay_send 0.08
    out > highpass(2khz, 0.05) > lowpass(12khz, 0.05) > master
}

track shaker {
    play rest
    using shaker
    level 0
    velocity 1.0
    gate 0.2
    pan 0.3
    reverb_send 0.06
    out > highpass(6khz, 0.05) > lowpass(14khz, 0.05) > autopan(0.4, hz=0.3) > master
}

track ride {
    play rest
    using ride
    level 0
    velocity 1.0
    gate 0.5
    pan -0.25
    reverb_send 0.1
    out > highpass(3khz, 0.05) > lowpass(12khz, 0.05) > master
}

track static {
    play rest
    using static
    level 0
    velocity 1.0
    sidechain 0.6
    reverb_send 0.15
    out > highpass(900hz, 0.05)
        > lowpass(3.5khz, 0.05, lfo_bars=16, lfo_depth=1500)
        > autopan(0.5, bars=16)
        > master
}

# ════════════════════════════════════════════════════════
# MASTER — glue, and the DJ filter pair the ninth fader sweeps
# ════════════════════════════════════════════════════════

master {
    in > tilt(-0.1)
       > eq(low=1.6, mid=-0.8, high=-1.0)
       > compressor(-8, ratio=1.6, attack=30, release=280, makeup=1db)
       > saturate(0.25)
       > lowpass(20khz, 0.1) as dj
       > highpass(20hz, 0.1) as hp
       > out
}

# ════════════════════════════════════════════════════════
# THE KEYLAB
# ════════════════════════════════════════════════════════

midi {
    # faders
    cc 73 > beat level
    cc 75 > hats level
    cc 79 > bed level 0..0.7
    cc 72 > sub level 0..1.05
    cc 80 > stab level 0..0.45
    cc 81 > bass level 0..0.9
    cc 81 > acid level 0..0.4
    cc 82 > chords level 0..0.3
    cc 83 > delay_mix
    cc 85 > master dj cutoff 150hz..20khz..20khz
    cc 85 > master hp cutoff 20hz..20hz..3khz

    # knobs
    cc 74 > chord cutoff 400hz..3khz
    cc 74 > stab delay_send 20%..95%
    cc 71 > walker cutoff 120hz..900hz
    cc 71 > walker cutoff_env 20%..75%
    cc 71 > walker resonance 10%..45%
    cc 71 > squelch cutoff 110hz..1.4khz
    cc 71 > squelch resonance 60%..88%
    cc 76 > warmth cutoff 400hz..3khz
    cc 77 > lead cutoff 500hz..5khz
    cc 77 > lead resonance 20%..60%
    cc 93 > master tilt -0.3..0.5
    cc 93 > bed reverb_send 30%..80%
    cc 18 > reverb_mix
    cc 19 > kit kick_decay 25%..75%
    cc 16 > kit hihat_decay 8%..55%
    cc 17 > pluck mod_index 15%..70%

    # keys and strips
    keys > lead
    cc 1 > lead resonance 20%..70%

    # pads: bottom row, then top row
    pad 36 > mute beat
    pad 37 > toggle hats
    pad 38 > throw stab
    pad 39 > freeze
    pad 40 > beat clap
    pad 41 > toggle bass
    pad 42 > prev
    pad 43 > next
}
