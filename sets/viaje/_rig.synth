# The acid kick and clap with a ghost rim between them, some there only sometimes.
pattern kick_acidrim8 {
    kick:  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - x:0.45 -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  X - - -  - - - -
    clap:  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.8 - - -  - - - -  x:0.78 - - -  - - - -  x:0.7*2 - x:0.8 x:0.6
    snare: - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - x:0.35 - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - - - o?0.5  - - - o:0.3  - x:0.35 x:0.4 o?0.5  - - - o:0.3
