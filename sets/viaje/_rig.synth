# viaje — the rig for a one-hour set, played on an Arturia KeyLab Essential 49 mk3
#
# The journey starts in dub techno (the wind, one chord and its echoes) and
# grows into Detroit (moving chords, a walking bass, a lead on the keys). Both
# are in F minor, so the chords of one sit under the other. Every voice of the
# whole set is here, most of them at `level 0`: a step is this rig plus what
# it changes, so moving between steps changes a few things and never swaps
# the whole instrument.
#
#   tatum set play sets/viaje --midi keylab
#
# Faders, left to right                 Knobs, left to right
#   1 drums (kick, rim, clap)             1 dub chord: opens and throws into the echo
#   2 hats                                2 the bass playing: walker or 303
#   3 wind                                3 Detroit chords: open
#   4 sub                                 4 lead: filter and resonance
#   5 dub chord                           5 tension: brighter master, more wind
#   6 walking bass / 303                  6 reverb amount
#   7 Detroit chords                      7 kick length
#   8 echo amount                         8 hat length
#   9 DJ filter: centre open, down dark, up thin
#                                         9 bell
#
# Pads, bottom row: drums out while held · hats in/out · dub chord into the
# echo while held · reverb frozen while held.
# Top row: clap · walking bass in/out · previous step · next step.
# The keys play the lead, sliding between held keys; the pitch strip bends it.
#
# The KeyLab's knobs are endless and count from zero at power-up: the first
# touch jumps a knob to where it physically is. The DJ filter is on a fader
# for that reason: a fader's position is always the sound's.

tempo 122
meter 4/4
scale F minor
swing 0.52
humanize 0.06 timing 0.012
sidechain 0.42 attack=2ms release=130ms

# The sends are half the instrument in dub: a dark dotted-eighth echo that
# loses its top on every repeat, and a big room that breathes with the kick.
# The echo is short-lived on purpose (feedback 0.55, not dub_techno's 0.74):
# over most of an hour a long one wears the ear out. The `dub` step is where
# it gets pushed.
delay sync=dotted_eighth feedback=0.55 filter=0.3 sidechain=0.35
reverb size=0.82 damp=0.45 predelay=32 sidechain=0.5

delay_return {
    in > highpass(210hz, 0.2)
       > lowpass(6khz, 0.1, lfo_bars=8, lfo_depth=2000)
       > autopan(0.5, bars=8)
       > out
}
reverb_return {
    in > highpass(260hz, 0.15)
       > lowpass(6.5khz, 0.1, lfo_bars=8, lfo_depth=2200)
       > autopan(0.32, bars=8)
       > out
}

# ════════════════════════════════════════════════════════
# MODULES
# ════════════════════════════════════════════════════════

# ── From dub_techno ──

# The chord: detuned, chorused, filtered to a mumble; what you hear is
# mostly its echoes.
module keys chord {
    voice_mode poly
    detune 22%
    chorus_mix 55%
    cutoff 1.7khz
    resonance 26%
    attack 14ms
    decay 210ms
    sustain 6%
    release 260ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 14%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

# Sub: almost a sine.
module bass sub {
    cutoff 165hz
    cutoff_env 90hz
    resonance 8%
    glide 24%
    osc1_wave saw
    osc2_wave saw
    osc2_pitch -12st
    keytrack 18%
    attack 10ms
    decay 450ms
    sustain 72%
    release 320ms
}

# One kit for the whole set: the deep dub kick, a rim (the snare, tuned up
# and short), the 909 clap and the hats. Steps retune it as the set warms.
module beats kit {
    kick_level 100%
    kick_decay 55%
    kick_pitch 0.62x
    kick_click 14%
    kick_drive 30%
    kick_pan 0%
    snare_level -13db
    snare_decay 5%
    snare_pitch 1.75x
    snare_drive 10%
    snare_snap 58%
    snare_pan -38%
    clap_level 70%
    clap_pan -14%
    hihat_level 50%
    hihat_decay 18%
    hihat_pitch 1.4x
    hihat_pan 36%
}

# The wind: band-passed noise that swells rather than starts.
instrument hiss {
    gain 0.9
    noise() as n
    n > bandpass(760, 0.22) as bp
    bp > adsr(2.5, 1.0, 0.8, 3.0) as amp
    amp > out
}

# ── From detroit ──

module keys warmth {
    voice_mode poly
    detune 16%
    chorus_mix 16%
    cutoff 796.214hz
    resonance 0.06
    attack 82ms
    decay 205ms
    sustain 82%
    release 277ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_4
    lfo_depth 10%
    vibrato_rate 20%
    vibrato_depth 2%
}

module keys stab {
    voice_mode poly
    detune 18%
    chorus_mix 20%
    cutoff 1.26khz
    resonance 0.12
    attack 1ms
    decay 96ms
    sustain 10%
    release 31ms
}

module keys under {
    voice_mode poly
    detune 3%
    cutoff 316.98hz
    resonance 0.05
    attack 205ms
    decay 238ms
    sustain 85%
    release 437ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 8%
}

module bass walker {
    cutoff 158.866hz
    cutoff_env 46%
    resonance 0.15
    glide 5%
    osc1_wave saw
    osc2_wave square
    osc2_pitch 0st
    osc3_pitch -12st
    keytrack 35%
    attack 1.2ms
    decay 71ms
    sustain 55%
    release 8ms
    vel_env 40%
}

module fm bell {
    algorithm two_op
    waveform sine
    mod_index 34%
    feedback 10%
    op0_ratio 0.996x
    op1_ratio 2.0035x
    op0_envelope 0.004 0.86 0.0 0.80
    op1_envelope 0.002 0.55 0.0 0.40
    vibrato_rate 25%
    vibrato_depth 3%
}

# ── New: the lead the keys play ──

# Two saws a hair apart through a resonant filter that opens on every note,
# sliding between held keys. Mono, so a held key under a new one is where it
# falls back to.
module bass lead {
    cutoff 900hz
    cutoff_env 55%
    resonance 38%
    glide 22%
    osc1_wave saw
    osc2_wave saw
    osc2_pitch 0.12st
    keytrack 60%
    attack 4ms
    decay 380ms
    sustain 55%
    release 220ms
    vel_env 35%
}

# ── From hitech_psy: the acid stretch ──

# The 303: one saw into a resonant filter that a big envelope snaps open on
# every note, slides where the pattern writes `~`. A slow LFO opens and closes
# it over 16 bars so it breathes with no hand on it; knob 2 sets where.
module bass squelch {
    cutoff 340hz
    cutoff_env 3.4khz
    resonance 70%
    glide 14%
    osc1_wave saw
    osc2_wave saw
    osc2_pitch 0.1st
    keytrack 30%
    attack 1ms
    decay 170ms
    sustain 18%
    release 30ms
    vel_env 55%
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_16
    lfo_depth 16%
}

# The rolling bass: short, round, three sixteenths after every kick.
module bass roller {
    cutoff 130hz
    cutoff_env 700hz
    resonance 28%
    glide 2%
    osc1_wave saw
    osc2_wave square
    osc2_pitch -12st
    keytrack 20%
    attack 1ms
    decay 95ms
    sustain 12%
    release 18ms
}

# The weird ones, each for a moment and not a bed.
module fm metal {
    algorithm pair_plus_two
    mod_index 0.95
    feedback 0.70
    waveform abs_sine
    op0_ratio 6.235x
    op1_ratio 2.205x
    op2_ratio 4.065x
    op3_ratio 1.585x
    op0_envelope 0.001 0.08 0.0 0.10
    op1_envelope 0.001 0.12 0.0 0.15
    op2_envelope 0.001 0.06 0.0 0.08
    op3_envelope 0.001 0.10 0.0 0.12
    op0_feedback 0.65
    op1_feedback 0.55
    op2_feedback 0.70
}

# A modem shaking hands.
module fm dialup {
    algorithm pair_plus_two
    mod_index 0.92
    feedback 0.70
    waveform sine
    op0_ratio 5.925x
    op1_ratio 1.895x
    op2_ratio 3.91x
    op3_ratio 2.67x
    op0_envelope 0.001 0.03 0.0 0.02
    op1_envelope 0.001 0.04 0.0 0.03
    op2_envelope 0.001 0.02 0.0 0.02
    op3_envelope 0.001 0.05 0.0 0.04
    op0_feedback 0.45
    op1_feedback 0.55
    op2_feedback 0.40
    lfo_rate 2.488hz
    lfo_depth 0.25
    lfo_target mod_index
    lfo_waveform square
}

module fm siren {
    algorithm dual_pairs
    mod_index 0.60
    feedback 0.25
    waveform sine
    op0_ratio 2.515x
    op1_ratio 1.5075x
    op0_envelope 0.3 0.5 0.50 0.6
    op1_envelope 0.2 0.4 0.60 0.5
    vibrato_rate 4.3hz
    vibrato_depth 0.15
    lfo_rate 1.692hz
    lfo_depth 0.18
    lfo_target mod_index
    lfo_waveform sine
}

# Noise with a pitch somewhere in it: the air before a peak.
module fm air {
    algorithm pair_plus_two
    mod_index 1.0
    feedback 1.0
    waveform abs_sine
    op0_ratio 7.785x
    op1_ratio 2.515x
    op2_ratio 5.305x
    op3_ratio 1.43x
    op0_envelope 0.001 2.0 0.15 1.5
    op1_envelope 0.001 1.8 0.20 1.3
    op2_envelope 0.001 1.6 0.18 1.2
    op3_envelope 0.001 2.2 0.12 1.8
    op0_feedback 0.90
    op1_feedback 0.85
    op2_feedback 0.88
    op3_feedback 0.80
    lfo_target mod_index
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 22%
}

# ════════════════════════════════════════════════════════
# PATTERNS
# ════════════════════════════════════════════════════════

pattern rest { -*16 }

# ── Drums, split into the hits and the hats so a pad can take the hats out ──

pattern kick_four { kick: X - - -  x - - -  X - - -  x - - - }
pattern kick_rim {
    kick:  X - - -  x - - -  X - - -  x - - -    X - - -  x - - -  X - - -  x - - -
    snare: - - - -  - - - -  - - - -  - - - -    - - - -  - - o -  - - - -  - - - -
}
pattern kick_dub {
    kick:  X - - -  x - - -  X - - -  x - - -    X - - -  x - - -  X - - -  x - - -
    snare: - - - -  - - o -  - - - -  - - - -    - - - -  - - - -  - - - -  - - o:0.3 -
}
pattern kick_clap {
    kick: X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap: - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.80 - - -
}
pattern kick_full {
    kick: X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - x:0.5
    clap: - - - -  x:0.78 - - -  - - - -  x:0.78 - - -   - - - -  x:0.78 - - -  - - - -  x:0.85 - - o
}

pattern hat_ghost { hat: - - - -  - - o -  - - - -  - - o - }
pattern hat_dub {
    hat: - - o -  - - x -  - - o -  - - x -    - - o -  - - x -  - - o -  - - x:0.5 -
}
pattern hat_off {
    hat: - - x:0.46 -  - - x:0.42 -  - - x:0.46 -  - - x:0.42 -   - - x:0.46 -  - - x:0.42 -  - - x:0.46 -  - - x:0.48 -
}
pattern hat_open {
    hat:     - - x:0.48 -  - - x:0.44 -  - - x:0.48 -  - - x:0.44 -   - - x:0.48 -  - - x:0.44 -  - - x:0.48 -  - - x:0.50 -
    openhat: - - - -  - - - -  - - - -  - - x:0.42 -   - - - -  - - - -  - - - -  - - x:0.48 -
}

# ── The dub chord, on the offbeat. Fm9 = F Ab C Eb G ──

pattern stab_ghost { -  -  Fm9:0.6   -    -  -  -  -    -  -  -  -    -  -  -  - }
pattern stab_half  { -  -  Fm9:0.68  -    -  -  -  -    -  -  Fm9:0.52  -    -  -  -  - }
pattern stab_full  { -  -  Fm9:0.72  -    -  -  Fm9:0.55  -    -  -  Fm9:0.66  -    -  -  Fm9:0.5   - }
pattern stab_dub {
    -  -  Fm9:0.7   -    -  -  Fm9:0.5   -    -  -  Fm9:0.64  -    -  -  Fm9:0.46  -
    -  -  Fm9:0.7   -    -  -  Fm9:0.5   -    -  -  Fm9:0.64  -    -  -  -  -
    -  -  Fm9:0.68  -    -  -  Fm9:0.5   -    -  -  Fm9:0.62  -    -  -  Fm9:0.44  -
    -  -  Dbmaj9:0.66 -  -  -  Dbmaj9:0.5 -   -  -  Dbmaj9:0.6 -   -  -  -  -
}

# ── Sub ──

pattern sub_long { F1:0.7  ..*15 }
pattern sub_f    { F1:0.8  ..*7   -*8 }
pattern sub_dub {
    F1:0.8  ..*7   -*8
    F1:0.8  ..*7   -*8
    F1:0.8  ..*7   -*8
    Db1:0.75 ..*7  -*8
}

# ── The wind: one held note ──

pattern hiss_hold { C3:0.7  ..*15 }

# ── Detroit ──

pattern ch_a {
    Fm9:0.62     ..*31
    Bbm9:0.60    ..*31
    Eb9:0.58     ..*31
    Abmaj9:0.62  ..*31
}
pattern ch_b {
    Cm9:0.60   ..*31
    Fm9:0.60   ..*31
    Bbm9:0.58  ..*31
    Ebm9:0.58  ..*31
}
pattern ch_low {
    [F2 C3]:0.55   ..*31
    [Bb2 F3]:0.55  ..*31
    [Eb2 Bb2]:0.52 ..*31
    [Ab2 Eb3]:0.55 ..*31
}
pattern ch_drone { [F2 C3]:0.5 ..*15 }
pattern bs_intro {
    F1:0.85 -  -  -    -  -  -  -    -  -  C2:0.50 -    -  -  -  -
    F1:0.80 -  -  -    -  -  -  -    -  -  -  -    -  -  Ab1:0.45 -
}
pattern bs_a {
    F1:0.90  -  -  -    -  -  -  Ab1:0.55    -  -  C2:0.70  -    -  -  -  -
    F1:0.82  -  -  -    -  -  Eb2:0.58 -     -  -  F1:0.50  -    -  -  -  -
    Bb1:0.90 -  -  -    -  -  -  Db2:0.55    -  -  F1:0.70  -    -  -  -  -
    Bb1:0.82 -  -  -    -  -  Ab1:0.58 -     -  -  Bb1:0.50 -    -  -  -  -
    Eb2:0.88 -  -  -    -  -  -  Db2:0.55    -  -  Bb1:0.70 -    -  -  -  -
    Eb2:0.80 -  -  -    -  -  G1:0.58  -     -  -  Eb2:0.50 -    -  -  -  -
    Ab1:0.90 -  -  -    -  -  -  C2:0.55     -  -  Eb2:0.70 -    -  -  -  -
    Ab1:0.82 -  -  -    -  -  G1:0.58  -     -  -  Ab1:0.50 -    -  -  -  -
}
pattern st_a {
    -  -  -  -    -  -  Fm9/4:0.50 -       -  -  -  -    -  -  Fm9/4:0.40 -
    -  -  -  -    -  -  -  -                -  -  Fm9/4:0.45 -    -  -  -  -
    -  -  -  -    -  -  Bbm9/4:0.50 -      -  -  -  -    -  -  Bbm9/4:0.40 -
    -  -  -  -    -  -  -  -                -  -  Bbm9/4:0.45 -   -  -  -  -
    -  -  -  -    -  -  Eb9/4:0.48 -       -  -  -  -    -  -  Eb9/4:0.38 -
    -  -  -  -    -  -  -  -                -  -  Eb9/4:0.44 -    -  -  -  -
    -  -  -  -    -  -  Abmaj9/4:0.50 -    -  -  -  -    -  -  Abmaj9/4:0.42 -
    -  -  -  -    -  -  -  -                -  -  -  -    -  -  -  -
}
pattern bl_a {
    -  -  -  -    -  -  -  -    -  -  -  -    Ab4:0.50 -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    -  -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    Db5:0.48 -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    -  -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    Bb4:0.46 -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    -  -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    C5:0.50  -  -  -
    -  -  -  -    -  -  -  -    -  -  -  -    -  -  Eb5:0.40 -
}

# ── The dub block, in 8-bar phrases: something turns at the end of every one ──

# Four on the floor; bar 8 leaves its last beat out.
pattern kick_four8 {
    kick: X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  - - - -
}

# The dub groove in 8-bar phrases: the rim answers on 4 and turns on 8.
pattern kick_dub8 {
    kick:  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  - - - -
    snare: - - - -  - - - -  - - - -  - - - -  - - - -  - - o -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - o -  - - - -  - - o:0.25 -  - - - -  - - - -  - - - -  - - - -  - - - -  - - o -  - - - -  - - - -  - - - -  - - - -  - - - o?0.5  - - - -  - - - -  - - o -  - - - -  - x:0.4 - o
}

# Offbeat hats; ghost sixteenths come and go, an open hat closes the phrase.
pattern hat_dub8 {
    hat:     - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 o?0.3  - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 o?0.5  - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 o?0.3  - - o o?0.3  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 -  - - o -  - - x:0.55 o
    openhat: - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - x:0.45 -
}

# Ghost hats, not quite the same twice.
pattern hat_ghost8 {
    hat: - - - -  - - o -  - - - -  - - - -  - - - -  - - o -  - - - -  - - o?0.4 -  - - - -  - - o -  - - - -  - - - -  - - - -  - - o -  - - o?0.5 -  - - - -  - - - -  - - o -  - - - -  - - - -  - - - -  - - o -  - - - -  - - o?0.4 -  - - - -  - - o -  - - - -  - - - -  - - - -  - - o -  - - o?0.5 -  - - - -
}

# Into the echo: a tom at the end of bar 4, a rim at the end of the phrase.
pattern perc_sparse8 {
    snare: - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - x:0.5 -  - - - -
    tom:   - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - x:0.45 -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -
}

# More of it for the dub: toms falling across the phrase.
pattern perc_dub8 {
    snare: - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - x:0.45 -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - o?0.5  - - - -  - - x:0.5 -  - - - -
    tom:   - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - x:0.4 -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - x:0.45 -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -
    tom2:  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - x:0.4 - x:0.5
}

# The break: twelve bars without the kick, then it comes back a beat at a time.
pattern kick_back16 {
    kick: - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  x:0.6 - - -  - - - -  - - - -  - - - -  x:0.7 - - -  - - - -  x:0.6 - - -  - - - -  x:0.8 - - -  - - - -  x:0.7 - - -  x:0.6 - - -  X - - -  x - - -  X - - -  x:0.8 - x:0.5 -
}

# The chord at half time; bar 4 answers late, bar 8 leaves room.
pattern stab_half8 {
    - - Fm9:0.68 -  - - - -  - - Fm9:0.52 -  - - - -
    - - Fm9:0.64 -  - - - -  - - - -  - - - -
    - - Fm9:0.68 -  - - - -  - - Fm9:0.5 -  - - - -
    - - Fm9:0.62 -  - - - Fm9:0.4  - - - -  - - - -
    - - Fm9:0.68 -  - - - -  - - Fm9:0.52 -  - - - -
    - - Fm9:0.64 -  - - - -  - - - -  - - - -
    - - Fm9:0.68 -  - - - -  - - Fm9:0.5 -  - - - -
    - - Fm9:0.6 -  - - - -  - - - -  - - - -
}

# Every offbeat; bar 4 pushes a hit late, bar 8 plays one and lets the throw answer.
pattern stab_full8 {
    - - Fm9:0.72 -  - - Fm9:0.55 -  - - Fm9:0.66 -  - - Fm9:0.5 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - Fm9:0.64 -  - - Fm9:0.46 -
    - - Fm9:0.72 -  - - Fm9:0.55 -  - - Fm9:0.66 -  - - Fm9:0.5 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - - Fm9:0.6  - - - -
    - - Fm9:0.72 -  - - Fm9:0.55 -  - - Fm9:0.66 -  - - Fm9:0.5 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - Fm9:0.64 -  - - Fm9:0.46 -
    - - Fm9:0.72 -  - - Fm9:0.55 -  - - Fm9:0.66 -  - - Fm9:0.5 -
    - - Fm9:0.7 -  - - - -  - - - -  - - - -
}

# The one chord change, Fm9 to Dbmaj9, now twice a phrase.
pattern stab_dub8 {
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - Fm9:0.64 -  - - Fm9:0.46 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - Fm9:0.64 -  - - Fm9:0.46 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - Fm9:0.64 -  - - - -
    - - Dbmaj9:0.66 -  - - Dbmaj9:0.5 -  - - Dbmaj9:0.6 -  - - Dbmaj9:0.44 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - Fm9:0.64 -  - - Fm9:0.46 -
    - - Fm9:0.7 -  - - Fm9:0.5 -  - - - Fm9:0.6  - - - -
    - - Dbmaj9:0.66 -  - - Dbmaj9:0.5 -  - - Dbmaj9:0.6 -  - - Dbmaj9:0.44 -
    - - Dbmaj9:0.66 -  - - - -  - - Dbmaj9:0.5 -  - - - -
}

# One chord at the end of the phrase, thrown into the echo.
pattern throw8 {
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - Fm9:0.7 -  - - - -
}

# Two throws a phrase in the dub.
pattern throw_dub8 {
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - Fm9:0.6 -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - Dbmaj9:0.7 -  - - - -
}

# The sub on the root, stepping up to Ab once a phrase.
pattern sub_f8 {
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - Ab1:0.6 ..  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
}

# Under the chord change, walking back up through Eb.
pattern sub_dub8 {
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    Db1:0.75 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    F1:0.8 .. .. ..  .. .. .. ..  - - - -  - - - -
    Db1:0.75 .. .. ..  .. .. .. ..  - - - -  - - - -
    Db1:0.75 .. .. ..  - - - -  Eb1:0.6 .. .. ..  - - - -
}

# The wind, struck again every 8 bars: it swells at each phrase.
pattern hiss_swell { C3:0.7 ..*111 -*16 }

# The dub's hook: a few bell notes, the echo does the rest.
pattern motif_dub {
    - - Ab4:0.5 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - G4:0.42 -  - - - -  - - F4:0.46 -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - Ab4:0.5 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - C5:0.44 -  - - - -  - - Bb4:0.4 -  - - - -
    - - - -  - - - -  - - - -  - - - -
}


# ── The acid stretch ──

pattern kick_roll { kick: X - - -  X - - -  X - - -  X - - - }
pattern kick_peak {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x:0.8 - - -  - - - -  x:0.8 - - -   - - - -  x:0.8 - - -  - - - -  x:0.85 - - -
    snare: - - - x:0.2  - - - -  - - x:0.18 -  - - - x:0.22   - - - x:0.2  - - - -  - - x:0.18 -  - x:0.2 - x:0.26
}
pattern hat_16 {
    hat:     x:0.55 x:0.28 x:0.66 x:0.3  x:0.55 x:0.28 x:0.66 x:0.3  x:0.55 x:0.28 x:0.66 x:0.3  x:0.55 x:0.28 x:0.66 x:0.34
    openhat: - - - -  - - - -  - - - -  - - x:0.4 -
}
pattern hat_16_open {
    hat:     x:0.58 x:0.3 x:0.7 x:0.32  x:0.58 x:0.3 x:0.7 x:0.32  x:0.58 x:0.3 x:0.7 x:0.32  x:0.58 x:0.3 x:0.7 x:0.36
    openhat: - - x:0.44 -  - - x:0.4 -  - - x:0.44 -  - - x:0.46 -
}

# The 303. `~` slides into the note without a new attack.
pattern acid_low {
    F3:0.9  -  F3:0.5  -    F4:0.7  -  F3:0.5  -    F3:0.9  -  Ab3:0.6  -    F3:0.7  ~Eb3:0.6  -  F3:0.5
    F3:0.9  -  F3:0.5  -    F4:0.7  -  F3:0.5  -    F3:0.9  -  C4:0.6   -    Bb3:0.7 ~Ab3:0.6  -  F3:0.5
}
pattern acid_riff {
    F3:0.95 ~F3:0.6  F4:0.8  -        F3:0.7  Eb4:0.75  -  ~F4:0.7    F3:0.9  -  C4:0.75  F3:0.5     Ab3:0.8  -  ~Bb3:0.7  F3:0.6
    F3:0.95 -        F4:0.8  ~Eb4:0.7 -       C4:0.75   F3:0.6  -     Db4:0.8 -  ~C4:0.7  F3:0.6     F3:0.9   Ab3:0.6  -  ~C4:0.75
}
pattern acid_peak {
    F3:0.95 F3:0.5  F4:0.85 ~Eb4:0.7  F3:0.6  C4:0.8  F3:0.5  ~F4:0.75    F3:0.9  Ab3:0.6  C4:0.8  ~Db4:0.7   F3:0.6  F4:0.85  -  ~Eb4:0.7
    F3:0.95 F3:0.5  Ab3:0.8 ~Bb3:0.7  F3:0.6  Eb4:0.8 F3:0.5  ~F4:0.75    Db4:0.9 ~C4:0.7  F3:0.6 Ab3:0.7     F3:0.6  C4:0.85  F4:0.7 ~Eb4:0.75
}

# Rolling: the kick on one, the bass on the three sixteenths after it.
pattern roll_f {
    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64
}
pattern roll_move {
    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64
    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  Ab1:0.78 Ab1:0.5 C2:0.66
}
pattern roll_stutter {
    -  F1:0.8  F1:0.8  -    -  F1:0.8  F1:0.8  -    -  F1:0.8  F1:0.8  -    -  F1:0.8  F1:0.8  F1:0.5
}
pattern roll_peak {
    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64
    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  F1:0.5  F1:0.64    -  F1:0.78  Ab1:0.5  C2:0.66
    -  Bb1:0.78  Bb1:0.5  Bb1:0.64    -  Bb1:0.78  Bb1:0.5  Bb1:0.64    -  Bb1:0.78  Bb1:0.5  Bb1:0.64    -  Bb1:0.78  Bb1:0.5  Bb1:0.64
    -  Bb1:0.78  Bb1:0.5  Bb1:0.64    -  Bb1:0.78  Bb1:0.5  Bb1:0.64    -  Bb1:0.78  Bb1:0.5  Bb1:0.64    -  Bb1:0.78  Db2:0.5  F1:0.66
    -  Eb2:0.78  Eb2:0.5  Eb2:0.64    -  Eb2:0.78  Eb2:0.5  Eb2:0.64    -  Eb2:0.78  Eb2:0.5  Eb2:0.64    -  Eb2:0.78  Eb2:0.5  Eb2:0.64
    -  Eb2:0.78  Eb2:0.5  Eb2:0.64    -  Eb2:0.78  Eb2:0.5  Eb2:0.64    -  Eb2:0.78  Eb2:0.5  Eb2:0.64    -  Eb2:0.78  G1:0.5  Bb1:0.66
    -  Ab1:0.78  Ab1:0.5  Ab1:0.64    -  Ab1:0.78  Ab1:0.5  Ab1:0.64    -  Ab1:0.78  Ab1:0.5  Ab1:0.64    -  Ab1:0.78  Ab1:0.5  Ab1:0.64
    -  Ab1:0.78  Ab1:0.5  Ab1:0.64    -  Ab1:0.78  Ab1:0.5  Ab1:0.64    -  Ab1:0.78  Ab1:0.5  Ab1:0.64    -  Ab1:0.78  C2:0.5  Eb2:0.66
}

pattern metal_hit {
    F4:0.55  -  -  -    -  -  -  F4:0.38    -  -  -  -    F4:0.48  -  -  -
    -  -  -  -          -  -  -  -          -  -  -  -    -  -  -  -
}
pattern metal_stutter {
    F4:0.52  F4:0.3  -  F4:0.38    -  -  -  -    F4:0.48  F4:0.28  -  F4:0.35    -  -  -  F4:0.4
}
pattern dialup_scatter {
    3.5:0.38  -  7.3:0.30  -    -  5.4:0.35  -  2.4:0.28    6.3:0.32  -  -  4.5:0.30    -  1.4:0.35  -  -
}
pattern siren_hold { F3:0.5 ..*63 }
pattern air_hold { F3:0.5 ..*63 }

# ════════════════════════════════════════════════════════
# BUSES
# ════════════════════════════════════════════════════════

bus drums
drums {
    in > compressor(-14, ratio=2.8, attack=15, release=150, makeup=2db)
       > saturate(0.35)
       > lowpass(9khz, 0.1)
       > master
}

# ════════════════════════════════════════════════════════
# TRACKS — every voice of the set; a step brings them up
# ════════════════════════════════════════════════════════

track beat { play rest using kit level 0.9 sidechain 0.0 out > drums }
track hats { play rest using kit level 0.8 sidechain 0.0 out > drums }

track sub {
    play rest
    using sub
    level 0
    gate 0.92
    sidechain 0.55
    out > lowpass(200hz, 0.12) > saturate(0.18) > master
}

track stab {
    play stab_ghost
    using chord
    level 0
    gate 0.16
    velocity 0.75
    pan -0.12
    delay_send 0.5
    reverb_send 0.60
    sidechain 0.5
    out > highpass(300hz, 0.15)
        > lowpass(3.6khz, 0.12, lfo_bars=8, lfo_depth=1400)
        > compressor(-14, ratio=2.0, attack=15, release=200, makeup=3db)
        > saturate(0.2)
        > master
}

track bed {
    play hiss_hold
    using hiss
    pan -0.38
    level 0
    reverb_send 0.3
    delay_send 0.06
    sidechain 0.35
    out > highpass(300hz, 0.12)
        > lowpass(2.2khz, 0.2, lfo_bars=8, lfo_depth=1400)
        > autopan(0.5, bars=8)
        > master
}

track bass {
    play rest
    using walker
    velocity 0.92
    level 0
    gate 0.62
    sidechain 0.55
    out > saturate(0.7)
        > highpass(32hz, 0.05)
        > compressor(-18db, ratio=4, attack=2ms, release=90ms, makeup=6db)
        > master
}

track chords {
    play rest
    using warmth
    velocity 0.80
    level 0
    gate 1.0
    sidechain 0.42
    delay_send 0.14
    reverb_send 0.30
    out > highpass(190hz, 0.05)
        > lowpass(2.6khz, 0.05, lfo_bars=12, lfo_depth=700)
        > eq(mid=-1.5, high=0.8)
        > autopan(0.65, bars=9)
        > master
}

track under {
    play rest
    using under
    velocity 0.70
    level 0
    gate 1.0
    sidechain 0.30
    reverb_send 0.12
    out > highpass(45hz, 0.05) > lowpass(320hz, 0.05) > master
}

track stabs {
    play rest
    using stab
    velocity 0.65
    level 0
    gate 0.30
    pan 0.34
    sidechain 0.35
    delay_send 0.28
    reverb_send 0.14
    out > saturate(0.8) > highpass(400hz, 0.05) > master
}

track chime {
    play rest
    using bell
    velocity 0.60
    level 0
    gate 0.90
    pan -0.50
    sidechain 0.25
    delay_send 0.34
    reverb_send 0.36
    out > highpass(500hz, 0.05) > master
}

# The keys play this. A pattern of rests: only the hands sound it.
track lead {
    play rest
    using lead
    level 0.5
    pan 0.1
    sidechain 0.3
    delay_send 0.32
    reverb_send 0.22
    out > highpass(120hz, 0.05) > saturate(0.3) > master
}

# ── The acid stretch ──

track acid {
    play rest
    using squelch
    level 0
    gate 0.55
    pan 0.12
    sidechain 0.35
    delay_send 0.12
    reverb_send 0.06
    out > saturate(0.45)
        > highpass(90hz, 0.05)
        > eq(low=0.6, mid=1.2, high=1.1)
        > master
}

track roll {
    play rest
    using roller
    level 0
    gate 0.5
    sidechain 0.6
    out > saturate(0.3) > highpass(30hz, 0.05) > lowpass(900hz, 0.05) > master
}

track metal {
    play rest
    using metal
    level 0
    gate 0.08
    pan 0.35
    delay_send 0.2
    reverb_send 0.1
    # abs_sine carries DC, and the feedback turns it into rumble.
    out > highpass(150hz, 0.1) > saturate(0.3) > lowpass(12khz, 0.1) > master
}

track chirp {
    play rest
    using dialup
    level 0
    gate 0.04
    pan 0.45
    delay_send 0.22
    reverb_send 0.08
    out > highpass(200hz, 0.1) > saturate(0.25) > master
}

track siren {
    play rest
    using siren
    level 0
    pan -0.38
    delay_send 0.15
    reverb_send 0.2
    out > highpass(200hz, 0.1) > master
}

track air {
    play rest
    using air
    level 0
    pan 0.1
    reverb_send 0.25
    out > highpass(300hz, 0.1) > lowpass(4khz, 0.1) > master
}

# ── The dub block ──

# Rim and toms that live in the echo: a few hits a phrase, the repeats do the rest.
track perc {
    play rest
    using kit
    level 0
    pan 0.22
    sidechain 0.0
    delay_send 0.7
    reverb_send 0.25
    out > highpass(180hz, 0.1) > drums
}

# One chord thrown into the echo at the end of a phrase.
track throw {
    play rest
    using chord
    level 0
    gate 0.2
    pan 0.2
    delay_send 0.95
    reverb_send 0.4
    sidechain 0.3
    out > highpass(300hz, 0.15) > lowpass(3khz, 0.12) > master
}

# ════════════════════════════════════════════════════════
# MASTER — glue, and the DJ filter pair the ninth fader sweeps
# ════════════════════════════════════════════════════════

master {
    in > tilt(-0.1)
       > eq(low=1.6, mid=-0.8, high=-1.0)
       > compressor(-8, ratio=1.6, attack=30, release=280, makeup=1db)
       > lowpass(20khz, 0.1) as dj
       > highpass(20hz, 0.1) as hp
       > out
}

# ════════════════════════════════════════════════════════
# THE KEYLAB
# ════════════════════════════════════════════════════════

midi {
    # faders
    cc 73 > beat level
    cc 75 > hats level
    cc 79 > bed level 0..0.7
    cc 72 > sub level 0..0.8
    cc 80 > stab level 0..0.45
    cc 81 > bass level 0..0.9
    cc 81 > acid level 0..0.7
    cc 82 > chords level 0..0.3
    cc 83 > delay_mix
    cc 85 > master dj cutoff 150hz..20khz..20khz
    cc 85 > master hp cutoff 20hz..20hz..3khz

    # knobs
    cc 74 > chord cutoff 400hz..3khz
    cc 74 > stab delay_send 20%..95%
    cc 71 > walker cutoff 120hz..900hz
    cc 71 > walker cutoff_env 20%..75%
    cc 71 > walker resonance 10%..45%
    cc 71 > squelch cutoff 110hz..1.4khz
    cc 71 > squelch resonance 60%..88%
    cc 76 > warmth cutoff 400hz..3khz
    cc 77 > lead cutoff 500hz..5khz
    cc 77 > lead resonance 20%..60%
    cc 93 > master tilt -0.3..0.5
    cc 93 > bed reverb_send 30%..80%
    cc 18 > reverb_mix
    cc 19 > kit kick_decay 25%..75%
    cc 16 > kit hihat_decay 8%..55%
    cc 17 > chime level 0..0.9

    # keys and strips
    keys > lead
    cc 1 > lead resonance 20%..70%

    # pads: bottom row, then top row
    pad 36 > mute beat
    pad 37 > toggle hats
    pad 38 > throw stab
    pad 39 > freeze
    pad 40 > beat clap
    pad 41 > toggle bass
    pad 42 > prev
    pad 43 > next
}
