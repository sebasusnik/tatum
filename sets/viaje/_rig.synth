# viaje — the rig for a one-hour set, played on an Arturia KeyLab Essential 49 mk3
#
# The journey starts in dub techno (the wind, one chord and its echoes) and
# grows into Detroit (moving chords, a walking bass, a lead on the keys). Both
# are in F minor, so the chords of one sit under the other. Every voice of the
# whole set is here, most of them at `level 0`: a step is this rig plus what
# it changes, so moving between steps changes a few things and never swaps
# the whole instrument.
#
#   tatum set play sets/viaje --midi keylab
#
# Faders, left to right                 Knobs, left to right
#   1 drums (kick, rim, clap)             1 dub chord: opens and throws into the echo
#   2 hats                                2 the bass playing: walker or 303
#   3 wind                                3 Detroit chords: open
#   4 sub                                 4 lead: filter and resonance
#   5 dub chord                           5 tension: brighter master, more wind
#   6 walking bass / 303                  6 reverb amount
#   7 Detroit chords                      7 kick length
#   8 echo amount                         8 hat length
#   9 DJ filter: centre open, down dark, up thin
#                                         9 pluck: brightness
#
# Pads, bottom row: drums out while held · hats in/out · dub chord into the
# echo while held · reverb frozen while held.
# Top row: clap · walking bass in/out · previous step · next step.
# The keys play the lead, sliding between held keys; the pitch strip bends it.
#
# The KeyLab's knobs are endless and count from zero at power-up: the first
# touch jumps a knob to where it physically is. The DJ filter is on a fader
# for that reason: a fader's position is always the sound's.

tempo 122
meter 4/4
scale F minor
# A straight grid, no swing and no humanize: every hit where the clock says.
# The precision is the style; the dub feel comes from the echoes, not from
# loose timing.
swing 0.5
humanize 0.0 timing 0.0
sidechain 0.42 attack=1ms release=100ms

# The sends are half the instrument in dub: a dark dotted-eighth echo that
# loses its top on every repeat, and a big room that breathes with the kick.
# The echo is short-lived on purpose (feedback 0.55, not dub_techno's 0.74):
# over most of an hour a long one wears the ear out. The `dub` step is where
# it gets pushed.
delay sync=dotted_eighth feedback=0.5 filter=0.35 sidechain=0.35
reverb size=0.62 damp=0.6 predelay=20 sidechain=0.5

delay_return {
    in > highpass(320hz, 0.2)
       > lowpass(6khz, 0.1, lfo_bars=8, lfo_depth=2000)
       > autopan(0.5, bars=8)
       > out
}
reverb_return {
    in > highpass(420hz, 0.15)
       > lowpass(6.5khz, 0.1, lfo_bars=8, lfo_depth=2200)
       > autopan(0.32, bars=8)
       > out
}

# ════════════════════════════════════════════════════════
# MODULES
# ════════════════════════════════════════════════════════

# ── From dub_techno ──

# The chord: detuned, chorused, filtered to a mumble; what you hear is
# mostly its echoes.
module keys chord {
    voice_mode poly
    detune 22%
    chorus_mix 55%
    cutoff 1.7khz
    resonance 26%
    attack 14ms
    decay 210ms
    sustain 6%
    release 260ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 14%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

# Sub: almost a sine. Dry on purpose, as in dub_techno: a fast attack and
# a filter pluck on each note, a short release, the track's filter open to
# 700 Hz so the attack is heard, and a light sidechain so the kick does not
# swallow it. Its old roughness came from its oscillators drifting out of
# phase; with that gone it was all round.
module bass sub {
    cutoff 165hz
    cutoff_env 700hz
    resonance 8%
    glide 24%
    osc1_wave saw
    osc2_wave saw
    osc2_pitch -12st
    keytrack 18%
    attack 2ms
    decay 220ms
    sustain 40%
    release 120ms
}

# One kit for the whole set: the deep dub kick, a rim (the snare, tuned up
# and short), the 909 clap and the hats. Steps retune it as the set warms.
module beats kit {
    kick_level 100%
    kick_decay 55%
    kick_pitch 0.62x
    kick_click 14%
    kick_drive 30%
    kick_pan 0%
    snare_level -13db
    snare_decay 5%
    snare_pitch 1.75x
    snare_drive 10%
    snare_snap 58%
    snare_pan -38%
    clap_level 70%
    clap_pan -14%
    hihat_level 50%
    hihat_decay 18%
    hihat_pitch 1.4x
    hihat_pan 36%
}

# The wind: band-passed noise that swells rather than starts.
instrument hiss {
    gain 0.9
    noise() as n
    n > bandpass(760, 0.22) as bp
    bp > adsr(2.5, 1.0, 0.8, 3.0) as amp
    amp > out
}

# ── From detroit ──

module keys warmth {
    voice_mode poly
    detune 8%
    chorus_mix 0%
    cutoff 1.25khz
    resonance 0.06
    attack 82ms
    decay 205ms
    sustain 82%
    release 277ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_4
    lfo_depth 10%
    vibrato_rate 0%
    vibrato_depth 0%
}

module keys stab {
    voice_mode poly
    detune 18%
    chorus_mix 20%
    cutoff 1.26khz
    resonance 0.12
    attack 1ms
    decay 96ms
    sustain 10%
    release 31ms
}

module keys under {
    voice_mode poly
    detune 3%
    cutoff 316.98hz
    resonance 0.05
    attack 205ms
    decay 238ms
    sustain 85%
    release 437ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 8%
}

# The walking bass. A saw and a square on the same note, in phase since the
# bass fix, so its bite comes from the filter pluck on each note (700 Hz,
# as dub_techno's sub) rather than from the oscillators drifting apart.
module bass walker {
    cutoff 158.866hz
    cutoff_env 700hz
    resonance 0.15
    glide 5%
    osc1_wave saw
    osc2_wave square
    osc2_pitch 0st
    osc3_pitch -12st
    keytrack 35%
    attack 1.2ms
    decay 71ms
    sustain 55%
    release 8ms
    vel_env 40%
}

# ── Precision: the protagonist and the detail, all FM and short ──

# The protagonist of Detroit and the way out: an FM pluck. An inharmonic
# modulator (1.73) gives each note a metallic attack that decays into a warm
# body; its brightness is the modulation index, which each step sets, and in
# FM the velocity is brightness too, so the accents shape it.
module fm pluck {
    algorithm two_op
    level 2.0
    mod_index 42%
    feedback 12%
    waveform sine
    op0_ratio 1x
    op1_ratio 1.73x
    op0_envelope 0.001 0.24 0.0 0.1
    op1_envelope 0.001 0.06 0.05 0.04
}

# Struck metal in a chord, answering the pluck.
module fm mstab {
    algorithm dual_pairs
    level 1.8
    mod_index 72%
    feedback 22%
    waveform sine
    op0_ratio 1x
    op1_ratio 2.83x
    op2_ratio 1x
    op3_ratio 4.62x
    op0_envelope 0.001 0.16 0.0 0.09
    op1_envelope 0.001 0.09 0.0 0.05
    op2_envelope 0.001 0.13 0.0 0.07
    op3_envelope 0.001 0.05 0.0 0.04
}

# A tiny metal tick, high and short.
module fm tick {
    algorithm two_op
    level 1.6
    mod_index 70%
    feedback 25%
    waveform sine
    op0_ratio 1x
    op1_ratio 3.17x
    op0_envelope 0.001 0.03 0.0 0.02
    op1_envelope 0.001 0.018 0.0 0.01
}

# A shaker: a burst of FM noise, cut short and bright.
module fm shaker {
    algorithm pair_plus_two
    level 1.2
    mod_index 100%
    feedback 100%
    waveform sine
    op0_ratio 6.7x
    op1_ratio 5.1x
    op2_ratio 9.3x
    op3_ratio 2.63x
    op0_envelope 0.002 0.04 0.0 0.03
    op1_envelope 0.002 0.04 0.0 0.03
    op2_envelope 0.002 0.04 0.0 0.03
    op3_envelope 0.002 0.04 0.0 0.03
    op0_feedback 90%
}

# A ride: inharmonic, a long shimmering tail.
module fm ride {
    algorithm two_op
    level 1.4
    mod_index 62%
    feedback 20%
    waveform sine
    op0_ratio 1x
    op1_ratio 4.61x
    op0_envelope 0.001 0.5 0.0 0.35
    op1_envelope 0.001 0.22 0.0 0.18
}

# Static: filtered feedback noise held for bars, the air under a groove.
module fm static {
    algorithm pair_plus_two
    level 1.0
    mod_index 100%
    feedback 100%
    waveform sine
    op0_ratio 5.3x
    op1_ratio 2.51x
    op2_ratio 7.1x
    op3_ratio 1.43x
    op0_envelope 1.0 1.0 1.0 1.0
    op1_envelope 1.0 1.0 1.0 1.0
    op2_envelope 1.0 1.0 1.0 1.0
    op3_envelope 1.0 1.0 1.0 1.0
    op0_feedback 90%
    lfo_target mod_index
    lfo_sync bars_4
    lfo_waveform triangle
    lfo_depth 25%
}

# ── New: the lead the keys play ──

# Two saws a hair apart through a resonant filter that opens on every note,
# sliding between held keys. Mono, so a held key under a new one is where it
# falls back to.
module bass lead {
    cutoff 900hz
    cutoff_env 55%
    resonance 38%
    glide 22%
    osc1_wave saw
    osc2_wave saw
    osc2_pitch 0.12st
    keytrack 60%
    attack 4ms
    decay 380ms
    sustain 55%
    release 220ms
    vel_env 35%
}

# ── From hitech_psy: the acid stretch ──

# The 303: a saw and a square an octave above into a resonant filter that
# a big envelope snaps open on every note, slides where the pattern writes
# `~`. The track drives it hard and filters what screams; a vowel filter
# makes it talk. A slow LFO opens and closes it over 16 bars so it breathes
# with no hand on it; knob 2 sets where.
module bass squelch {
    cutoff 280hz
    cutoff_env 3.4khz
    resonance 86%
    glide 14%
    osc1_wave saw
    osc2_wave square
    osc2_pitch 12st
    keytrack 30%
    attack 1ms
    decay 130ms
    sustain 18%
    release 30ms
    vel_env 55%
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_16
    lfo_depth 16%
}

# The rolling bass: short, round, three sixteenths after every kick.
module bass roller {
    cutoff 130hz
    cutoff_env 700hz
    resonance 28%
    glide 2%
    osc1_wave saw
    osc2_wave square
    osc2_pitch -12st
    keytrack 20%
    attack 1ms
    decay 95ms
    sustain 12%
    release 18ms
}

# The weird ones, each for a moment and not a bed.
module fm metal {
    algorithm pair_plus_two
    mod_index 0.95
    feedback 0.70
    waveform abs_sine
    op0_ratio 6.235x
    op1_ratio 2.205x
    op2_ratio 4.065x
    op3_ratio 1.585x
    op0_envelope 0.001 0.08 0.0 0.10
    op1_envelope 0.001 0.12 0.0 0.15
    op2_envelope 0.001 0.06 0.0 0.08
    op3_envelope 0.001 0.10 0.0 0.12
    op0_feedback 0.65
    op1_feedback 0.55
    op2_feedback 0.70
}

# An insect swarm, from hitech_psy: the set's second weird moment.
module fm insects {
    algorithm additive
    mod_index 0.85
    feedback 0.58
    waveform half_sine
    op0_ratio 4.995x
    op1_ratio 1.585x
    op0_envelope 0.1 0.3 0.50 0.4
    op1_envelope 0.05 0.2 0.60 0.3
    op0_feedback 0.50
    op1_feedback 0.45
    lfo_rate 2.886hz
    lfo_depth 0.30
    lfo_target mod_index
    lfo_waveform square
}

# A modem shaking hands.
module fm dialup {
    algorithm pair_plus_two
    mod_index 0.92
    feedback 0.70
    waveform sine
    op0_ratio 5.925x
    op1_ratio 1.895x
    op2_ratio 3.91x
    op3_ratio 2.67x
    op0_envelope 0.001 0.03 0.0 0.02
    op1_envelope 0.001 0.04 0.0 0.03
    op2_envelope 0.001 0.02 0.0 0.02
    op3_envelope 0.001 0.05 0.0 0.04
    op0_feedback 0.45
    op1_feedback 0.55
    op2_feedback 0.40
    lfo_rate 2.488hz
    lfo_depth 0.25
    lfo_target mod_index
    lfo_waveform square
}

module fm siren {
    algorithm dual_pairs
    mod_index 0.60
    feedback 0.25
    waveform sine
    op0_ratio 2.515x
    op1_ratio 1.5075x
    op0_envelope 0.3 0.5 0.50 0.6
    op1_envelope 0.2 0.4 0.60 0.5
    vibrato_rate 4.3hz
    vibrato_depth 0.15
    lfo_rate 1.692hz
    lfo_depth 0.18
    lfo_target mod_index
    lfo_waveform sine
}

# Noise with a pitch somewhere in it: the air before a peak.
module fm air {
    algorithm pair_plus_two
    mod_index 1.0
    feedback 1.0
    waveform abs_sine
    op0_ratio 7.785x
    op1_ratio 2.515x
    op2_ratio 5.305x
    op3_ratio 1.43x
    op0_envelope 0.001 2.0 0.15 1.5
    op1_envelope 0.001 1.8 0.20 1.3
    op2_envelope 0.001 1.6 0.18 1.2
    op3_envelope 0.001 2.2 0.12 1.8
    op0_feedback 0.90
    op1_feedback 0.85
    op2_feedback 0.88
    op3_feedback 0.80
    lfo_target mod_index
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 22%
}

# ════════════════════════════════════════════════════════
# PATTERNS
# ════════════════════════════════════════════════════════

pattern rest { -*16 }

# ── Drums, split into the hits and the hats so a pad can take the hats out ──

pattern kick_four { kick: X - - -  x - - -  X - - -  x - - - }
pattern kick_rim {
    kick:  X - - -  x - - -  X - - -  x - - -    X - - -  x - - -  X - - -  x - - -
    snare: - - - -  - - - -  - - - -  - - - -    - - - -  - - o -  - - - -  - - - -
}
pattern kick_dub {
    kick:  X - - -  x - - -  X - - -  x - - -    X - - -  x - - -  X - - -  x - - -
    snare: - - - -  - - o -  - - - -  - - - -    - - - -  - - - -  - - - -  - - o:0.3 -
}
pattern kick_clap {
    kick: X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap: - - - -  x:0.75 - - -  - - - -  x:0.75 - - -   - - - -  x:0.75 - - -  - - - -  x:0.80 - - -
}
pattern kick_full {
    kick: X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - x:0.5
    clap: - - - -  x:0.78 - - -  - - - -  x:0.78 - - -   - - - -  x:0.78 - - -  - - - -  x:0.85 - - o
}

pattern hat_ghost { hat: - - - -  - - o -  - - - -  - - o - }
pattern hat_dub {
    hat: - - o -  - - x -  - - o -  - - x -    - - o -  - - x -  - - o -  - - x:0.5 -
}
pattern hat_off {
    hat: - - x:0.46 -  - - x:0.42 -  - - x:0.46 -  - - x:0.42 -   - - x:0.46 -  - - x:0.42 -  - - x:0.46 -  - - x:0.48 -
}
pattern hat_open {
    hat:     - - x:0.48 -  - - x:0.44 -  - - x:0.48 -  - - x:0.44 -   - - x:0.48 -  - - x:0.44 -  - - x:0.48 -  - - x:0.50 -
    openhat: - - - -  - - - -  - - - -  - - x:0.42 -   - - - -  - - - -  - - - -  - - x:0.48 -
}

# ── The dub chord, on the offbeat. Fm9 = F Ab C Eb G ──

pattern stab_ghost { -  -  Fm9:0.6   -    -  -  -  -    -  -  -  -    -  -  -  - }
pattern stab_half  { -  -  Fm9:0.68  -    -  -  -  -    -  -  Fm9:0.52  -    -  -  -  - }
pattern stab_full  { -  -  Fm9:0.72  -    -  -  Fm9:0.55  -    -  -  Fm9:0.66  -    -  -  Fm9:0.5   - }
pattern stab_dub {
    -  -  Fm9:0.7   -    -  -  Fm9:0.5   -    -  -  Fm9:0.64  -    -  -  Fm9:0.46  -
    -  -  Fm9:0.7   -    -  -  Fm9:0.5   -    -  -  Fm9:0.64  -    -  -  -  -
    -  -  Fm9:0.68  -    -  -  Fm9:0.5   -    -  -  Fm9:0.62  -    -  -  Fm9:0.44  -
    -  -  Dbmaj9:0.66 -  -  -  Dbmaj9:0.5 -   -  -  Dbmaj9:0.6 -   -  -  -  -
}

# ── Sub ──

pattern sub_long { F1:0.7  ..*15 }
pattern sub_f    { F1:0.8  ..*7   -*8 }
pattern sub_dub {
    F1:0.8  ..*7   -*8
    F1:0.8  ..*7   -*8
    F1:0.8  ..*7   -*8
    Db1:0.75 ..*7  -*8
}

# ── The wind: one held note ──

pattern hiss_hold { C3:0.7  ..*15 }

# ── Detroit ──

pattern ch_a {
    Fm9:0.62     ..*31
    Bbm9:0.60    ..*31
    Eb9:0.58     ..*31
    Abmaj9:0.62  ..*31
}
pattern ch_b {
    Cm9:0.60   ..*31
    Fm9:0.60   ..*31
    Bbm9:0.58  ..*31
    Ebm9:0.58  ..*31
}
pattern ch_low {
    [F2 C3]:0.55   ..*31
    [Bb2 F3]:0.55  ..*31
    [Eb2 Bb2]:0.52 ..*31
    [Ab2 Eb3]:0.55 ..*31
}
pattern ch_drone { [F2 C3]:0.5 ..*15 }
pattern bs_intro {
    F1:0.85 -  -  -    -  -  -  -    -  -  C2:0.50 -    -  -  -  -
    F1:0.80 -  -  -    -  -  -  -    -  -  -  -    -  -  Ab1:0.45 -
}
pattern bs_a {
    F1:0.90  -  -  -    -  -  -  Ab1:0.55    -  -  C2:0.70  -    -  -  -  -
    F1:0.82  -  -  -    -  -  Eb2:0.58 -     -  -  F1:0.50  -    -  -  -  -
    Bb1:0.90 -  -  -    -  -  -  Db2:0.55    -  -  F1:0.70  -    -  -  -  -
    Bb1:0.82 -  -  -    -  -  Ab1:0.58 -     -  -  Bb1:0.50 -    -  -  -  -
    Eb2:0.88 -  -  -    -  -  -  Db2:0.55    -  -  Bb1:0.70 -    -  -  -  -
    Eb2:0.80 -  -  -    -  -  G1:0.58  -     -  -  Eb2:0.50 -    -  -  -  -
    Ab1:0.90 -  -  -    -  -  -  C2:0.55     -  -  Eb2:0.70 -    -  -  -  -
    Ab1:0.82 -  -  -    -  -  G1:0.58  -     -  -  Ab1:0.50 -    -  -  -  -
}
pattern st_a {
    -  -  -  -    -  -  Fm9/4:0.50 -       -  -  -  -    -  -  Fm9/4:0.40 -
    -  -  -  -    -  -  -  -                -  -  Fm9/4:0.45 -    -  -  -  -
    -  -  -  -    -  -  Bbm9/4:0.50 -      -  -  -  -    -  -  Bbm9/4:0.40 -
    -  -  -  -    -  -  -  -                -  -  Bbm9/4:0.45 -   -  -  -  -
    -  -  -  -    -  -  Eb9/4:0.48 -       -  -  -  -    -  -  Eb9/4:0.38 -
    -  -  -  -    -  -  -  -                -  -  Eb9/4:0.44 -    -  -  -  -
    -  -  -  -    -  -  Abmaj9/4:0.50 -    -  -  -  -    -  -  Abmaj9/4:0.42 -
    -  -  -  -    -  -  -  -                -  -  -  -    -  -  -  -
}
# ── The dub block, in 8-bar phrases: something turns at the end of every one ──

# Four on the floor; bar 8 leaves its last beat out.
pattern kick_four8 {
    kick: X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  - - - -
}

# The dub groove in 8-bar phrases: the rim answers on 4 and turns on 8.
pattern kick_dub8 {
    kick:  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  x - - -  X - - -  - - - -
    snare: - - - -  - - - -  - - - -  - - - -  - - - -  - - o -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - - -  - - o -  - - - -  - - o:0.25 -  - - - -  - - - -  - - - -  - - - -  - - - -  - - o -  - - - -  - - - -  - - - -  - - - -  - - - o?0.5  - - - -  - - - -  - - o -  - - - -  - x:0.4 - o
}

# Offbeat hats; ghost sixteenths come and go, an open hat closes the phrase.
pattern hat_dub8 {
