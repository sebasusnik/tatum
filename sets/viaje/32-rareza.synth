# set: bars=32 phase=rareza energy=7
# set-note: Se va el clap: el 303 y el bajo rodante solos, y un módem que conversa en el costado.
use "_rig.synth"
tempo 133

module beats kit { kick_decay 30% kick_pitch 0.86x kick_click 42% kick_drive 45% hihat_level 72% }

track beat   { play kick_acid8 level 1.17 }
track hats   { play hat_16_8 level 1.01 }
track roll   { play roll_f level 0.7 }
track acid   { play acid_riff16 level 0.61 }
track chirp  { play dialup_scatter level 0.84 }
