# set: bars=32 phase=10-tunel energy=7
# set-note: Se va el clap: el 303 y el bajo rodante solos, y un módem que conversa en el costado.
use "_rig.synth"
tempo 133

module beats kit { kick_decay 20% kick_pitch 1.0x kick_click 60% kick_drive 55% hihat_level 72% hihat_decay 12% hihat_pitch 1.7x }

track beat   { play kick_acid8 level 1.17 }
track hats   { play hat_16_8 level 1.01 }
track roll   { play roll_f_bb level 0.7 }
track acid   { play acid_riff16_bb level 0.61 }
track chirp  { play dialup_scatter level 0.84 }
