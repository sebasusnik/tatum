# set: bars=64 phase=dub-vuelta energy=6
# set-note: De vuelta al dub, a 128: el bombo profundo y el rim, el acorde dub con su cambio a Dbmaj9, los toms en el eco. El viaje empieza a cerrar el círculo.
use "_rig.synth"
tempo 128

track bed   { play hiss_swell level 0.3 }
track stab  { play stab_dub8 level 0.27 delay_send 0.6 }
track beat  { play kick_dub8 level 0.82 }
track hats  { play hat_dub8 level 1.15 }
track sub   { play sub_dub8 level 0.62 }
track perc  { play perc_dub8 level 0.45 }
track throw { play throw_dub8 level 0.2 }
track tick   { play tick332 level 0.085 }
track shaker { play shake4 level 0.05 }
