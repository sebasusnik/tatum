# set: bars=32 phase=detalle energy=4
# set-note: El dub se afila: el shaker en semicorcheas con sus fantasmas, el tick en 3-3-2 y un ride en el contratiempo, cada uno en su banda, arriba. El acorde a medio tiempo y oscuro.
use "_rig.synth"

module keys chord { cutoff 1.5khz }

track bed   { play hiss_swell level 0.34 }
track stab  { play stab_half8 level 0.26 delay_send 0.5 }
track beat  { play kick_dub8 level 0.78 }
track hats  { play hat_ghost8 level 1.6 }
track sub   { play sub_f8 level 0.74 }
track shaker { play shake4 level 0.07 }
track tick   { play tick332 level 0.072 }
track ride   { play ride_off level 0.035 }
