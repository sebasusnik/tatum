# set: bars=32 max=2 phase=01-niebla energy=4
# set-note: The chord arrives: Cm9 struck on the offbeat, three stabs in four bars and the echo carrying the rest; its filter shut, opening a little over the step. The rim steps out to leave it the air.
# cue: 13 F8 arriba: el único acorde de estos cuatro compases se queda en el eco
# cue: 25 K3 despacio a la derecha: la niebla se levanta
use "_t01.synth"

track drums  { play n_main, n_main, n_main, n_main, n_main, n_main, n_main, n_main_turn }
track rim    { level 0 }
track chords { play c_niebla, c_niebla, c_niebla, c_fade level 0.5 }
auto dubc cutoff 0.16 > 0.27 over 32      # 420 Hz to 700 Hz
