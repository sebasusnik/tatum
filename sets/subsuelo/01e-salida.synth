# set: bars=32 phase=01-niebla energy=4
# set-note: Stripped for T02 to mix over: the kick, the plain offbeat hat, the rim, the bass on its root; the chord is gone, the tape hiss thins out.
# cue: 1 tecla B (47): el último Cm9 al eco mientras se va
use "_t01.synth"

track drums { play n_out, n_out, n_out, n_out, n_out, n_out, n_out, n_in_turn }
track rim   { level 0.4 }
track sub   { play low_plain }
track bass  { play low_plain }
auto hiss level 0.05 > 0.02 over 32
