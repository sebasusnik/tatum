# set: bars=32 phase=02-rhodes energy=5
# set-note: Played differently: the bass pushes into the gaps with its octave, the comping takes a closer voicing with the eleventh on top, the bongos answer in the gaps; the line comes back changed, from the Ab falling, only in the second half of each phrase.
# cue: 9 B2 (pad 45) en el uno del compás: el Abmaj7#11 al eco
# cue: 13 F8 arriba: la línea del Rhodes se queda en el eco
use "_t02.synth"

track drums  { play r_main, r_main, r_main, r_main, r_main, r_main, r_main, r_main_turn }
track shaker { play s_main }
track bongo  { play bg_b level 0.22 }
track bass   { play b_b, b_b, b_b, b_b_turn }
track chords { play cp_b, cp_b, cp_b, cp_b_turn level 0.3 }
track rhodes { play rl_rest, rl_rest, rl_c, rl_c_turn level 0.26 }
auto rhodes mod_index 0.22 > 0.32 > 0.22 over 32
