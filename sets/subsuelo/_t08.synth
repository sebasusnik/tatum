    - - - -  - - - -  - - - -  - - - -
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

# The kick is dry: no sends
track drums {
    play e_in, e_in, e_in, e_in, e_in, e_in, e_in, e_in_turn
    using s8kit
    level 0.82
    velocity 1.0
    out > highpass(25hz, 0.05) > eq(high=-1) > drums
}

track rim {
    play r_a
    using s8rim
    level 0
    velocity 1.0
    reverb_send 0.3
    delay_send 0.25
    out > highpass(300hz, 0.05) as hp > lowpass(6khz, 0.05) as lp > drums
}

track dust {
    play dust_a
    using s8dust
    level 0
    velocity 1.0
    reverb_send 0.05
    sidechain 0
    out > highpass(1800hz, 0.1) as hp > lowpass(7khz, 0.1) as lp > autopan(0.6, bars=2) > master
}

track hiss {
    play hiss_hold
    using s8hiss
    level 0.08
    velocity 1.0
    pan -0.3
    reverb_send 0.3
    sidechain 0.35
    out > highpass(300hz, 0.12) as hp > lowpass(2.2khz, 0.2, lfo_bars=8, lfo_depth=1400) as lp > autopan(0.5, bars=8) > master
}

track sub {
    play sub_c
    using s8sub
    level 0.13
    velocity 1.0
    gate 0.9
    sidechain 0.3
    out > highpass(28hz, 0.05) > lowpass(120hz, 0.05) > low
}

track bass {
    play b8_plain
    using s8dub
    level 0.5
    velocity 1.0
    gate 0.9
    sidechain 0.25
    out > highpass(55hz, 0.05) > saturate(0.3) as drv > lowpass(700hz, 0.1) > low
}

track chords {
    play st_half
    using s8chord
    level 0
    velocity 0.75
    gate 0.18
    pan -0.12
    delay_send 0.5
    reverb_send 0.6
    sidechain 0.5
    out > highpass(300hz, 0.15) > lowpass(3.6khz, 0.12, lfo_bars=8, lfo_depth=1400) as lp > saturate(0.2) as sat > master
}

# ────────────────────────────────────────────────
# PERFORMANCE VOICES (the KeyLab's pads; steps never touch these)
# ────────────────────────────────────────────────

# B1: the Cm11 stab on the offbeats while held
track stab1 {
    play st_full
    using s8chord
    level 0.26
    velocity 0.75
    gate 0.18
    pan 0.2
    delay_send 0.55
    reverb_send 0.6
    sidechain 0.5
    out > highpass(300hz, 0.15) > lowpass(3.6khz, 0.12) > saturate(0.2) > master
}

# B2: the Db lean while held
track stabdb {
    play st_db
    using s8chord
    level 0.26
    velocity 0.75
    gate 0.18
    pan 0.2
    delay_send 0.55
    reverb_send 0.6
    sidechain 0.5
    out > highpass(300hz, 0.15) > lowpass(3.6khz, 0.12) > saturate(0.2) > master
}

# B3: a rim fill
track rimfill {
    play r_fill
    using s8rim
    level 0.35
    velocity 1.0
    reverb_send 0.3
    delay_send 0.2
    out > highpass(300hz, 0.05) > lowpass(6khz, 0.05) > drums
}

# B5: the needle in a scratch
track dustb {
    play dust_b
    using s8dust
    level 0.4
    velocity 1.0
    sidechain 0
    out > highpass(1800hz, 0.1) > lowpass(7khz, 0.1) > autopan(0.6, bars=1) > master
}

# B6: the dub tom, into the echo
track dubtom {
    play t_dub
    using s8rim
    level 0.4
    velocity 1.0
    delay_send 0.6
    reverb_send 0.3
    out > highpass(90hz, 0.05) > lowpass(4khz, 0.05) > master
}

# The keyboard's lead: the chord's voice through the chord's chain, plus the
# filter (`klp`), the vowel (`talk`) and the level (`kgain`) the keylab reaches
# The keys' own voice: `s8chord` as written, under another name, so a knob
# on it (the `teclas` page) moves only what the hands play, and the tema's
# `auto` lines on `s8chord` leave it alone.
module keys kvoz {
    voice_mode poly
    detune 22%
    chorus_mix 55%
    cutoff 1.2khz
    resonance 26%
    attack 14ms
    decay 220ms
    sustain 6%
    release 300ms
    lfo_target cutoff
    lfo_sync bars_8
    lfo_waveform triangle
    lfo_depth 14%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

track ktema {
    play krest
    using kvoz
    level 0.26
    velocity 0.75
    gate 0.18
    pan -0.12
    delay_send 0.5
    reverb_send 0.6
    sidechain 0.5
    out > highpass(300hz, 0.15) > lowpass(3.6khz, 0.12, lfo_bars=8, lfo_depth=1400) > saturate(0.2) > lowpass(18khz, 0.1) as klp > vowel(a, wet=0) as talk > gain(1.0) as kgain > master
}

midi {
    # Faders
    cc 75 > bass level 0..1.0                 # F2 the bass (written 0.5 at half)
    cc 80 > rim level 0..0.9                  # F5 the rim, the crackle and the air
    cc 80 > dust level 0..1.0
    cc 80 > hiss level 0..0.2
    cc 83 > chords delay_send 0..90%          # F8 the chord into the echo

    # The tema page (K1-K9)
    cc 74 > bass cutoff 70hz..800hz           # K1 the bass: hum to growl
    cc 71 > s8chord detune 5%..22%..45%       # K2 the chord's colour: tight to smeared
    cc 71 > s8chord chorus_mix 15%..55%..85%
    cc 76 > s8chord cutoff 500hz..1.2khz..4khz    # K3 the chord opening out of the murk
    cc 76 > chords lp cutoff 1.2khz..3.6khz..9khz
    cc 77 > dust level 0..0.5..1.0           # K4 the vinyl: the crackle and the air
    cc 77 > hiss lp cutoff 600hz..2.2khz..5khz
    cc 93 > master hp cutoff 20hz..300hz      # K5 tension: the floor thins, the chord further into the room
    cc 93 > chords reverb_send 60%..95%
    cc 18 > rim delay_send 0..80%             # K6 the throw: the rim and the tom into the echo
    cc 18 > dubtom delay_send 0..90%
    cc 19 > drums kick_decay 25%..48%..75%    # K7 the kick's body
    cc 16 > drums hihat_pitch 0.9x..1.4x..1.9x    # K8 the hats: darker, or brighter
    cc 17 > reverb_mix 0.3..1.0               # K9 the room

    # ── This tema's pages, after `master`: Tab passes over them while they rest ──
    # The chord: Cm11 swallowed by the room. Its module's cutoff is the steps'
    # `auto`; K1 here is the chain's filter, which leaves that sweep alone
    page acorde {
        cc 74 > chords lp cutoff 1.2khz..3.6khz..9khz # K1 the chord's brightness, over the sweep
        cc 71 > chords resonance 5%..26%..55%         # K2 the chord's resonance
        cc 76 > chords lfo_depth 0%..14%..40%         # K3 the filter's breathing
        cc 77 > chords decay 80ms..220ms..900ms       # K4 the stab's length
        cc 77 > chords release 100ms..300ms..1.2s     #    and its tail
        cc 93 > chords sat drive 0..0.2..1.2          # K5 tension: the chord's grit
        cc 18 > chords detune 5%..22%..45%            # K6 its colour: tight to smeared
        cc 19 > chords chorus_mix 15%..55%..85%       # K7 its chorus
        cc 16 > chords vibrato_depth 0%..3%..12%      # K8 its warble
        cc 17 > chords sustain 0%..6%..40%            # K9 struck to held
        # The faders: the chord's strip
        cc 73 > chords level 0..0.52                  # F1 the chord (0.26 at half)
        cc 75 > chords delay_send 0..90%              # F2 its echo
        cc 79 > chords reverb_send 0..100%            # F3 its room
        cc 72 > chords pan -0.7..0.7                  # F4 where it sits
    }
    # The vinyl: the crackle and the air under it
    page polvo {
        cc 74 > dust lp cutoff 3khz..7khz..12khz      # K1 the crackle's top
        cc 71 > dust hihat_pitch 1.2x..2x             # K2 the clicks: duller to finer
        cc 76 > dust hp cutoff 600hz..1800hz..4khz    # K3 the crackle thinned
        cc 77 > dust snare_level 0..1.5..2            # K4 the pops under the clicks
        cc 93 > hiss lp cutoff 600hz..2.2khz..5khz    # K5 tension: the air opening
        cc 18 > hiss hp cutoff 120hz..300hz..1.2khz   # K6 the air thinned
        cc 19 > dust snare_pitch 1.2x..2x             # K7 the pops' pitch
        cc 16 > dust hihat_pan -0.6..0.2..0.6         # K8 the clicks across
        cc 17 > dust hihat_level 0.5..2               # K9 the clicks' density
        # The faders: the crackle's strip, then the air's
        cc 73 > dust level 0..1                       # F1 the crackle (0.5 at half)
        cc 75 > dust delay_send 0..40%                # F2 its echo
        cc 79 > dust reverb_send 0..30%               # F3 its room
        cc 72 > dust pan -0.7..0.7                    # F4 where it sits
        cc 80 > hiss level 0..0.22                    # F5 the air (0.11 at half)
        cc 81 > hiss reverb_send 0..60%               # F6 the air into the room
        cc 82 > hiss delay_send 0..50%                # F7 the air into the echo
        cc 83 > hiss pan -0.7..0.7                    # F8 where the air sits
    }
    # The rim in its one place
    page rim {
        cc 74 > rim lp cutoff 1.5khz..6khz..10khz     # K1 the rim's top
        cc 71 > rim snare_pitch 1.3x..1.75x..2x       # K2 the rim's pitch
        cc 76 > rim snare_pan -0.6..0.6               # K3 the rim across
        cc 77 > rim snare_snap 20%..58%..90%          # K4 the rim's crack
        cc 93 > rim snare_drive 0%..10%..50%          # K5 tension: the rim's grit
        cc 18 > rim delay_send 0..60%                 # K6 the throw: the rim into the echo
        cc 19 > rim tom_pan -0.6..0.6                 # K7 the dub tom across
        cc 16 > rim snare_level 0..0.5..1             # K8 the rim's hit
        cc 17 > rim hp cutoff 100hz..300hz..800hz     # K9 the rim thinned
        # The faders: the rim's strip
        cc 73 > rim level 0..0.9                      # F1 the rim (0.45 at half)
        cc 75 > rim delay_send 0..60%                 # F2 its echo
        cc 79 > rim reverb_send 0..60%                # F3 its room
        cc 72 > rim pan -0.7..0.7                     # F4 where it sits
    }

    key 46 > toggle dust                      # A# the crackle in and out
    key 47 > throw chords q=1/16              # B  the chord into the echo, on the grid

    # Pads, bank B
    pad 44 > hold stab1 q=1/16                # B1 the Cm11 stab, by hand
    pad 45 > hold stabdb q=1/16               # B2 the Db lean
    pad 46 > hold rimfill q=beat              # B3 a rim fill
    pad 47 > throw rim q=1/16                 # B4 the rim into the echo
    pad 48 > hold dustb q=beat                # B5 the needle in a scratch
    pad 49 > hold dubtom q=beat               # B6 the dub tom into the echo
    pad 50 > throw stab1 q=1/16               # B7 the hand's stab into the echo
    pad 51 > drums openhat q=1/16             # B8 an open hat
}
