# T08 ceniza — C minor, 124 BPM, the close of the set
#
# Ash after the peak. Dub techno: a shorter, higher kick than T07's (a knock
# with a little click, the body gone), dark offbeat hats, a rim always in the
# same place, and under it a sine sub and a round dub bass, two saws an octave
# apart filtered into a hum, long notes that start off the beat.
#
# The signature is one chord, Cm11 voiced open above C3, struck short on the
# offbeat through a detuned chorused voice and swallowed by a big room: the
# reverb, more than the echo, is most of what is heard. Vinyl crackle runs
# under it from `firma` to the very end. Three placed moments: the chord
# arrives sparse in `firma`, its filter opening; in `variacion` it leans to
# Db (the bII, the bass under it) and the kick thins; in `final` it thins
# to a last stab on bar 15 that the room freezes and holds while the master
# filter closes over the 32 bars. The energy falls from 6 to 3 on purpose:
# this is the end of the set.

use "_base.synth"

# The tema's level in the set: +0.5 dB, its shorter kick sits a little
# under T07's floor (measured on the render)
master {
    in > lowpass(20khz, 0.05) as dj
       > highpass(20hz, 0.05) as hp
       > eq(low=2, mid=-1, high=-1.5)
       > gain(1.06) as trim
       > gain(1.0) as vol
       > out
}

tempo 124
scale C minor
swing 0.52

# The room is the instrument: a big hall that breathes with the kick, an echo
# that darkens on every repeat
delay sync=dotted_eighth feedback=0.55 filter=0.3 sidechain=0.3
reverb size=0.93 damp=0.5 predelay=40 sidechain=0.45

delay_return  { in > highpass(260hz, 0.15) > lowpass(4khz, 0.1, lfo_bars=8, lfo_depth=1500) > autopan(0.5, bars=8) > out }
reverb_return { in > highpass(280hz, 0.12) > lowpass(5khz, 0.1, lfo_bars=8, lfo_depth=1800) > autopan(0.3, bars=8) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# A shorter, higher kick than T07's, a touch of click; dark offbeat hats
module beats s8kit {
    kick_level 1.0
    kick_decay 48%
    kick_pitch 0.82x
    kick_click 15%
    kick_drive 34%
    hihat_level 0.3
    hihat_decay 10%
    hihat_pitch 1.4x
    hihat_pan 0.4
}

# The rim (a very short high snare) and the dub tom
module beats s8rim {
    kick_level 0.0
    snare_level 0.5
    snare_decay 5%
    snare_pitch 1.75x
    snare_snap 58%
    snare_drive 10%
    snare_pan -0.35
    tom_pan 0.3
}

# Vinyl crackle: the hat and the snare cut to clicks, tuned to the top
module beats s8dust {
    level 2.0
    kick_level 0.0
    hihat_level 2.0
    hihat_decay 0%
    hihat_pitch 2x
    hihat_pan 0.2
    snare_level 1.5
    snare_decay 0%
    snare_pitch 2x
    snare_snap 100%
    snare_drive 0%
    snare_pan -0.25
}

module fm s8sub {
    algorithm two_op
    level 2.0
    mod_index 0%
    feedback 0%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.002 1.0 1.0 0.12
    op1_envelope 0.002 1.0 1.0 0.12
}

# The dub bass: two saws an octave apart, filtered to a hum, a slow pluck
module bass s8dub {
    osc1_wave saw
    osc2_wave saw
    osc2_pitch -12st
    cutoff 165hz
    cutoff_env 600hz
    resonance 8%
    glide 24%
    keytrack 18%
    attack 2ms
    decay 220ms
    sustain 40%
    release 120ms
}

# The chord: detuned, chorused, filtered down to a murmur; short, so what is
# heard is mostly the room
module keys s8chord {
    voice_mode poly
    detune 22%
    chorus_mix 55%
    cutoff 1.2khz
    resonance 26%
    attack 14ms
    decay 220ms
    sustain 6%
    release 300ms
    lfo_target cutoff
    lfo_sync bars_8
    lfo_waveform triangle
    lfo_depth 14%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

# The air: band-passed noise that swells rather than starts
instrument s8hiss {
    gain 0.9
    noise() as n
    n > bandpass(760, 0.22) as bp
    bp > adsr(2.5, 1.0, 0.8, 3.0) as amp
    amp > out
}

# ────────────────────────────────────────────────
# DRUMS
# ────────────────────────────────────────────────

pattern e_in {
    kick:  X - - -  x - - -  X - - -  x - - -   X - - -  x - - -  X - - -  x - - -
    hat:   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - x -
}

pattern e_in_turn {
    kick:  X - - -  x - - -  X - - -  x - - -   X - - -  x - - -  X - - -  x - - -
    hat:   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - x -  o - x o
}

pattern e_main {
    kick:  X - - -  x - - -  X - - -  x - - -   X - - -  x - - -  X - - -  x - - -
    hat:   - - o -  - - x -  - - o -  - - x -   - - o -  - - x -  - - o -  - - x:0.5 -
}

pattern e_main_turn {
    kick:  X - - -  x - - -  X - - -  x - - -   X - - -  x - - -  X - - -  x - - -
    hat:   - - o -  - - x -  - - o -  - - x -   - - o -  - - x -  - - o o  - - x o
}

# Thinner: the kick on one and three, the ghost before the three
pattern e_thin {
    kick:  X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - o
    hat:   - - - -  - - o -  - - - -  - - o -   - - - -  - - o -  - - - -  - - o -
}

# ────────────────────────────────────────────────
# THE RIM, always in the same place; the dub tom
# ────────────────────────────────────────────────

pattern r_a {
    snare: - - - -  - - - -  - - - -  - - - -   - - - -  - - x -  - - - -  - - - -
}

pattern r_b {
    snare: - - - -  - - - -  - - - -  - - x:0.6 -   - - - -  - - x -  - - - -  - - - -
}

# A pad's fill: the rim on the eighths, then the last beat in sixteenths
pattern r_fill {
    snare: - - x -  - - x -  - - x -  x x x x
}

pattern t_dub {
    tom:   - - - -  - - x -  - - - -  - - - -
}

# ────────────────────────────────────────────────
# THE CRACKLE: clicks on a chance, never the same twice in a bar
# ────────────────────────────────────────────────

pattern dust_a {
    hat:   x?0.3 - x?0.2 -  - x?0.25 - x?0.15  x?0.3 - - x?0.2  - x?0.25 x?0.15 -   - x?0.3 - x?0.2  x?0.15 - x?0.3 -  - x?0.2 - x?0.25  x?0.3 - - x?0.2
    snare: - - - x?0.12  - - - -  - - x?0.1 -  - - - -   - x?0.12 - -  - - - -  - - - -  x?0.1 - - -
}

# A pad's burst: the needle in a deep scratch
pattern dust_b {
    hat:   x?0.7 x?0.5 x?0.7 x?0.5  x?0.7 x?0.5 x?0.7 x?0.5  x?0.7 x?0.5 x?0.7 x?0.5  x?0.7 x?0.5 x?0.7 x?0.5
    snare: x?0.4 - x?0.4 -  x?0.4 - x?0.4 -  x?0.4 - x?0.4 -  x?0.4 - x?0.4 -
}

pattern hiss_hold {
    C3:0.7 ..*15
}

# ────────────────────────────────────────────────
# THE LOW END
# ────────────────────────────────────────────────

pattern sub_c {
    - - C2:0.85 ..*9  - - - -
}

# Three bars on C, the fourth on the flat second
pattern sub_db {
    - - C2:0.85 ..*9   - - - -
    - - C2:0.8 ..*9    - - - -
    - - C2:0.85 ..*9   - - - -
    - - Db2:0.85 ..*9  - - - -
}

pattern b8_plain {
    - - C2:0.8 .. .. - - -  - - C2:0.7 .. .. - - -
}

pattern b8_long {
    - - C2:0.8 .. .. .. .. -  - - C2:0.6 .. - - - -
    - - C2:0.8 .. .. .. - -  - - Bb1:0.65 .. .. - - -
}

pattern b8_long_turn {
    - - C2:0.8 .. .. .. .. -  - - C2:0.6 .. - - - -
    - - C2:0.8 .. .. .. - -  - - G1:0.65 .. .. - ~Bb1:0.6 -
}

pattern b8_db {
    - - C2:0.8 .. .. .. .. -  - - C2:0.6 .. - - - -
    - - C2:0.8 .. .. .. - -  - - Bb1:0.65 .. .. - - -
    - - C2:0.8 .. .. .. .. -  - - C2:0.6 .. - - - -
    - - Db2:0.8 .. .. .. - -  - - Ab1:0.65 .. .. - - -
}

# ────────────────────────────────────────────────
# THE CHORD: Cm11 open above C3, Db for the lean
# ────────────────────────────────────────────────

# Sparse: the "and" of one and of three
pattern st_half {
    - - [C3 G3 Bb3 Eb4 F4]:0.68 -  - - - -  - - [C3 G3 Bb3 Eb4 F4]:0.52 -  - - - -
}

# Every offbeat but the last, the velocity breathing
pattern st_full {
    - - [C3 G3 Bb3 Eb4 F4]:0.7 -  - - [C3 G3 Bb3 Eb4 F4]:0.5 -  - - [C3 G3 Bb3 Eb4 F4]:0.62 -  - - - -
}

# Three bars of Cm11, the fourth leans on Db and comes back
pattern st_dub {
    - - [C3 G3 Bb3 Eb4 F4]:0.7 -  - - [C3 G3 Bb3 Eb4 F4]:0.5 -  - - [C3 G3 Bb3 Eb4 F4]:0.62 -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.7 -  - - - -  - - [C3 G3 Bb3 Eb4 F4]:0.6 -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.68 -  - - [C3 G3 Bb3 Eb4 F4]:0.5 -  - - [C3 G3 Bb3 Eb4 F4]:0.6 -  - - - -
    - - [Db3 Ab3 C4 F4]:0.68 -  - - [Db3 Ab3 C4 F4]:0.5 -  - - [Db3 Ab3 C4 F4]:0.62 -  - - - -
}

# A pad's lean: the Db chord on the offbeats while held
pattern st_db {
    - - [Db3 Ab3 C4 F4]:0.7 -  - - [Db3 Ab3 C4 F4]:0.5 -  - - [Db3 Ab3 C4 F4]:0.62 -  - - - -
}
# The close (08d-final), 32 bars: the chord thins to its last stab on bar 15
# for the room to freeze; the kick thins to nothing by bar 17; the sub and
# the bass fade out over the first sixteen
pattern st_out {
    - - [C3 G3 Bb3 Eb4 F4]:0.6 -  - - - -  - - - -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.5 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.48 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.42 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.38 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.34 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - [C3 G3 Bb3 Eb4 F4]:0.42 ..  .. - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
}

pattern e_out {
    kick: X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  x - - -  - - - -   X - - -  - - - -  o - - -  - - - -   X - - -  - - - -  o - - -  - - - -   X - - -  - - - -  o - - -  - - - -   X - - -  - - - -  o - - -  - - - -   x - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   x - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -
    hat: - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - o -  - - o -  - - o -  - - o -   - - - -  - - o -  - - - -  - - o -   - - - -  - - o -  - - - -  - - o -   - - - -  - - o -  - - - -  - - o -   - - - -  - - o -  - - - -  - - o -   - - - -  - - - -  - - - -  - - o -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - o -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -
}

pattern sub_out {
    - - C2:0.85 ..*9  - - - -
    - - C2:0.82 ..*9  - - - -
    - - C2:0.8 ..*9  - - - -
    - - C2:0.77 ..*9  - - - -
    - - C2:0.75 ..*9  - - - -
    - - C2:0.72 ..*9  - - - -
    - - C2:0.7 ..*9  - - - -
    - - C2:0.67 ..*9  - - - -
    - - C2:0.65 ..*9  - - - -
    - - C2:0.62 ..*9  - - - -
    - - C2:0.6 ..*9  - - - -
    - - C2:0.57 ..*9  - - - -
    - - C2:0.55 ..*9  - - - -
    - - C2:0.52 ..*9  - - - -
    - - C2:0.5 ..*9  - - - -
    - - C2:0.47 ..*9  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
}

pattern b8_out {
    - - C2:0.85 .. .. .. - -  - - - -  - - - -
    - - C2:0.82 .. .. .. - -  - - - -  - - - -
    - - C2:0.8 .. .. .. - -  - - - -  - - - -
    - - C2:0.77 .. .. .. - -  - - - -  - - - -
    - - C2:0.75 .. .. .. - -  - - - -  - - - -
    - - C2:0.72 .. .. .. - -  - - - -  - - - -
    - - C2:0.7 .. .. .. - -  - - - -  - - - -
    - - C2:0.67 .. .. .. - -  - - - -  - - - -
    - - C2:0.65 .. .. .. - -  - - - -  - - - -
    - - C2:0.62 .. .. .. - -  - - - -  - - - -
    - - C2:0.6 .. .. .. - -  - - - -  - - - -
    - - C2:0.57 .. .. .. - -  - - - -  - - - -
    - - C2:0.55 .. .. .. - -  - - - -  - - - -
    - - C2:0.52 .. .. .. - -  - - - -  - - - -
    - - C2:0.5 .. .. .. - -  - - - -  - - - -
    - - C2:0.47 .. .. .. - -  - - - -  - - - -
    - - - -  - - - -  - - - -  - - - -
