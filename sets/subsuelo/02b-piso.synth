# set: bars=16 max=2 phase=02-rhodes energy=4
# set-note: The groove opens: clap on two and four, the shaker in sixteenths, the bongos in their place, the bass's line between Cm11 and Abmaj7#11 and the comping Rhodes on the offbeat.
# cue: 9 tecla A# (46): las bongós afuera
# cue: 13 tecla A# (46): las bongós vuelven
use "_t02.synth"

track drums  { play r_main, r_main, r_main, r_main, r_main, r_main, r_main, r_main_turn slow 2 }
track shaker { play s_main }
track bongo  { level 0.22 }
track chords { level 0.3 }
