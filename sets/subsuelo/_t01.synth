# T01 niebla — C minor, 118 BPM
#
# The set opens in fog, Basic Channel style. A soft round kick with almost no
# click, a dark hat, tape hiss breathing in the room. Under it a rubber
# bass (a saw and a square, a resonant filter plucked hard) on a sine sub; long notes that start on the
# offbeat and leave the kick alone. A dark wooden rim, always in the same
# place.
#
# The signature is one chord, Cm9, struck short on the offbeat and answered
# by a long dark echo that is most of what you hear. It arrives in `firma`,
# leans to Fm9 (the iv, the bass under it) in `variacion` in two placed
# moments, and leaves before the `salida`. Its filter opens over the tema:
# shut in `firma`, a little brighter in `variacion` (and K3 is that filter).
#
# The room is the deepest of the set: the echo feeds back long and darkens on
# every repeat, the reverb is big and damped. Nothing bright anywhere.

use "_base.synth"

# The tema's level in the set (measured on the render)
master {
    in > lowpass(20khz, 0.05) as dj
       > highpass(20hz, 0.05) as hp
       > eq(low=2, mid=-1, high=-1.5)
       > gain(1.0) as trim
       > gain(1.0) as vol
       > out
}

tempo 118
scale C minor
swing 0.54

# Fog: the echo feeds back long and loses its top on every repeat
delay sync=dotted_eighth feedback=0.62 filter=0.28
reverb size=0.9 damp=0.72 predelay=40 sidechain=0.5

delay_return  { in > highpass(320hz, 0.1) > lowpass(2200hz, 0.1, lfo_bars=16, lfo_depth=900) > autopan(0.55, bars=8) > out }
reverb_return { in > highpass(380hz, 0.05) > lowpass(3200hz, 0.05, lfo_bars=16, lfo_depth=800) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# Kick: round and soft, the body long, almost no click; a dark low hat; a
# clap so soft it is more air than hit
module beats niebla {
    kick_level 1.0
    kick_decay 55%
    kick_pitch 0.8x
    kick_click 8%
    kick_drive 18%
    clap_level 0.35
    clap_pan -0.05
    hihat_level 0.5
    hihat_decay 12%
    hihat_pitch 0.82x
    hihat_pan 0.25
}

# Rim: a dark wooden knock, short, to the left
module beats nrim {
    kick_level 0.0
    snare_level 0.55
    snare_decay 2%
    snare_pitch 1.35x
    snare_snap 10%
    snare_drive 8%
    snare_pan -0.25
}

# Sub: a pure sine
module fm nsub {
    algorithm two_op
    level 2.0
    mod_index 0%
    feedback 0%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.002 1.0 1.0 0.12
    op1_envelope 0.002 1.0 1.0 0.12
}

# Bass: rubber, a saw and a square beating slowly, a resonant low filter
# plucked hard; slides between notes
module bass rondo {
    osc1_wave saw
    osc2_wave square
    osc2_pitch 0.07st
    cutoff 110hz
    cutoff_env 750hz
    resonance 55%
    keytrack 30%
    vel_env 40%
    glide 25%
    attack 1ms
    decay 150ms
    sustain 15%
    release 80ms
}

# The chord: detuned and chorused, filtered down to a mumble, short; the
# echo does the rest. Its filter breathes over 16 bars
module keys dubc {
    voice_mode poly
    cutoff 520hz
    resonance 30%
    detune 18%
    chorus_mix 40%
    attack 8ms
    decay 240ms
    sustain 4%
    release 280ms
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 18%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

# The same chord played backwards: it swells over a bar and stops dead
module keys swellv {
    voice_mode poly
    cutoff 700hz
    resonance 20%
    detune 18%
    chorus_mix 40%
    attack 2s
    decay 2s
    sustain 100%
    release 15ms
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

# Tape hiss: band-passed noise, swelling in rather than starting
instrument hiss {
    gain 0.9
    noise() as n
    n > bandpass(900, 0.2) as bp
    bp > adsr(2.5, 1.0, 0.8, 3.0) as amp
    amp > out
}

# A dub tom: a low sine knocked by a short modulator, its pitch falling
module fm ntom {
    algorithm two_op
    level 2.0
    mod_index 18%
    waveform sine
    op0_ratio 1x
    op1_ratio 1.5x
    op0_envelope 0.001 0.3 0.0 0.15
    op1_envelope 0.001 0.03 0.0 0.02
    lfo_target pitch
    lfo_sync quarter
    lfo_waveform saw
    lfo_depth 8%
}

# ────────────────────────────────────────────────
# DRUMS (2-bar cells; the tracks chain eight into a 16-bar phrase)
# ────────────────────────────────────────────────

# The opening: the kick and one soft hat on the offbeat
pattern n_in {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   - - o -  - - x -  - - o -  - - x -   - - o -  - - x -  - - o -  - - x -
}

pattern n_in_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    hat:   - - o -  - - x -  - - o -  - - x -   - - o -  - - x -  - - x -  - - x x
}

# The floor: a soft clap on two and four, the hat with a ghost after it
pattern n_main {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
    hat:   - - x -  - - x o  - - x -  - - x o   - - x -  - - x o  - - x -  - - x o
}

pattern n_main_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
    hat:   - - x -  - - x o  - - x -  - - x o   - - x -  - - x o  - - x o  x o x x
}

# The hats in sixteenths, the accent on the offbeat: the variacion's push
pattern n_drive {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
    hat:   o o x o  o o x o  o o x o  o o x o   o o x o  o o x o  o o x o  o o x o
}

# Out: the clap gone, the hat plain on the offbeat
pattern n_out {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - x -
}

# Rim: always in the same place, the "and" of four; the variacion adds the
# "and" of two
pattern rim_a {
    snare: - - - -  - - - -  - - - -  - - x -   - - - -  - - - -  - - - -  - - x -
}

pattern rim_b {
    snare: - - - -  - - x -  - - - -  - - x -   - - - -  - - x -  - - - -  - - x -
}

# A fill on the grid, swelling: the pad's
pattern rim_fill {
    snare: o - o -  o - x -  o o x o  x o x x
}

# ────────────────────────────────────────────────
# LOW END (4-bar cells)
# ────────────────────────────────────────────────

# On the root, a fifth below at the end of the cell
pattern low_a {
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - - -  C2:0.7 .. - -
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - G1:0.8 .. .. - Bb1:0.6 -
}

pattern low_a_turn {
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - - -  C2:0.7 .. - -
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. - - Eb2:0.7   .. - G1:0.8 .. .. - ~Bb1:0.6 ..
}

# Under the Fm9 lean: the third bar goes to F
pattern low_b {
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - - -  Eb2:0.7 .. - -
    - - F1:0.9 .. .. .. .. -   - - F1:0.7 .. .. - Ab1:0.6 -
    - - C2:0.9 .. .. .. .. -   - - G1:0.8 .. .. - Bb1:0.6 -
}

pattern low_b_turn {
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - - -  Eb2:0.7 .. - -
    - - F1:0.9 .. .. .. .. -   - - F1:0.7 .. .. - Ab1:0.6 -
    - - F1:0.9 .. .. - - G1:0.7   .. - - - G1:0.8 .. ~Bb1:0.6 ..
}

# Plain: the root only, for the mix-in and the mix-out
pattern low_plain {
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - C2:0.7 .. .. - - -
    - - C2:0.9 .. .. .. .. -   - - - - - - - -
}

pattern rest4 { -*64 }

# ────────────────────────────────────────────────
# THE CHORD (4-bar cells)
# ────────────────────────────────────────────────

# Cm9 on the offbeat, three stabs in four bars; the fourth bar is the echo's
pattern c_niebla {
    - - Cm9:0.8 -  - - - -  - - - -  - - - -
    - - - -  - - - -  - - Cm9:0.6 -  - - - -
    - - Cm9:0.75 -  - - - -  - - - -  - - - -
    -*16
}

# One stab, three bars of its echo
pattern c_fade {
    - - Cm9:0.8 -  - - - -  - - - -  - - - -
    -*16
    -*16
    -*16
}

# The lean: Cm9, then Fm9 over the bass's F, back
pattern c_lean {
    - - Cm9:0.8 -  - - - -  - - Cm9:0.55 -  - - - -
    - - - -  - - Cm9:0.65 -  - - - -  - - - -
    - - Fm9:0.8 -  - - - -  - - Fm9:0.5 -  - - - -
    - - - -  - - Cm9:0.6 -  - - - -  - - - -
}

pattern c_rest { -*64 }

# ────────────────────────────────────────────────
# TEXTURE AND HAND VOICES
# ────────────────────────────────────────────────

pattern hiss_bed { C4:0.6 ..*63 }

# A dub tom figure: the root, then the fifth below, a beat apart
pattern tom_fig {
    - - C3:0.8 -  - - - -  - - G2:0.6 -  - - - -
}

# One chord a beat, on its offbeat: the pads' stab
pattern chit_cm { - - Cm9:0.8 -  - - - -  - - Cm9:0.6 -  - - - - }
pattern chit_fm { - - Fm9:0.8 -  - - - -  - - Fm9:0.6 -  - - - - }

# The backwards chord: held for the whole bar, so it swells into the next one
pattern swell_cm { Cm9:0.7 ..*15 }

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

# The kit: dry, no sends
track drums {
    play n_in, n_in, n_in, n_in, n_in, n_in, n_in, n_in_turn
    using niebla
    level 0.85
    velocity 1.0
    out > highpass(28hz, 0.05) > drums
}

track rim {
    play rim_a
    using nrim
    level 0
    velocity 1.0
    reverb_send 0.2
    delay_send 0.15
    out > highpass(300hz, 0.05) as hp > lowpass(5khz, 0.05) as lp > drums
}

track sub {
    play low_a, low_a, low_a, low_a_turn
    using nsub
    level 0.13
    velocity 1.0
    gate 0.85
    sidechain 0.3
    out > highpass(28hz, 0.05) > lowpass(120hz, 0.05) > low
}

track bass {
    play low_a, low_a, low_a, low_a_turn
    using rondo
    level 0.5
    velocity 1.0
    gate 0.85
    sidechain 0.3
    out > highpass(60hz, 0.05) > saturate(0.4) as drv > lowpass(1500hz, 0.05) as lp > low
}

track chords {
    play c_niebla, c_niebla, c_niebla, c_fade
    using dubc
    level 0
    velocity 1.0
    gate 0.4
    pan -0.15
    delay_send 0.55
    reverb_send 0.3
    sidechain 0.5
    out > highpass(220hz, 0.05) > autopan(0.25, bars=8) > master
}

track hiss {
    play hiss_bed
    using hiss
    level 0.05
    velocity 1.0
    reverb_send 0.15
    sidechain 0.25
    out > highpass(600hz, 0.05) as hp > lowpass(5khz, 0.05, lfo_bars=16, lfo_depth=2500) as lp > autopan(0.6, bars=16) > master
}

# ────────────────────────────────────────────────
# PERFORMANCE VOICES (the pads and the keyboard; steps never touch these)
# ────────────────────────────────────────────────

track chit {
    play chit_cm
    using dubc
    level 0.5
    velocity 1.0
    gate 0.4
    pan 0.15
    delay_send 0.7
    reverb_send 0.3
    sidechain 0.5
    out > highpass(220hz, 0.05) > master
}

track chitf {
    play chit_fm
    using dubc
    level 0.5
    velocity 1.0
    gate 0.4
    pan 0.15
    delay_send 0.7
    reverb_send 0.3
    sidechain 0.5
    out > highpass(220hz, 0.05) > master
}

track swell {
    play swell_cm
    using swellv
    level 0.2
    velocity 1.0
    gate 1.0
    reverb_send 0.4
    sidechain 0.3
    out > highpass(250hz, 0.05) > master
}

track rimfill {
    play rim_fill
    using nrim
    level 0.45
    velocity 1.0
    reverb_send 0.2
    out > highpass(300hz, 0.05) > lowpass(5khz, 0.05) > drums
}

track tom {
    play tom_fig
    using ntom
    level 0.3
    velocity 1.0
    gate 0.6
    pan 0.2
    delay_send 0.5
    reverb_send 0.2
    sidechain 0.2
    out > highpass(90hz, 0.05) > master
}

# The keyboard's lead: the chord's own voice, through the chord's chain
# The keys' own voice: `dubc` as written, under another name, so a knob
# on it (the `teclas` page) moves only what the hands play, and the tema's
# `auto` lines on `dubc` leave it alone.
module keys kvoz {
    voice_mode poly
    cutoff 520hz
    resonance 30%
    detune 18%
    chorus_mix 40%
    attack 8ms
    decay 240ms
    sustain 4%
    release 280ms
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 18%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

track ktema {
    play krest
    using kvoz
    level 0.5
    velocity 1.0
    gate 0.4
    pan -0.15
    delay_send 0.55
    reverb_send 0.3
    sidechain 0.5
    out > highpass(220hz, 0.05) > autopan(0.25, bars=8) > lowpass(18khz, 0.1) as klp > vowel(a, wet=0) as talk > gain(1.0) as kgain > master
}

midi {
    # Faders
    cc 75 > bass level 0..1.0                 # F2 the bass (written 0.5 at half)
    cc 80 > rim level 0..0.9                  # F5 the rim and the tape
    cc 80 > hiss level 0..0.1
    cc 83 > chords delay_send 0..80%          # F8 the chord into the echo

    # The tema page (K1-K9)
    cc 74 > rondo cutoff 60hz..900hz          # K1 the rubber bass: dark to biting
    cc 71 > dubc decay 120ms..900ms           # K2 the chord's length: a click to a bloom
    cc 71 > dubc sustain 0%..25%
    cc 76 > dubc cutoff 300hz..3khz           # K3 the fog lifting: the chord's filter
    cc 76 > dubc resonance 20%..45%
    cc 77 > nrim snare_pitch 0.9x..1.35x..1.9x    # K4 the rim: lower wood to a higher knock
    cc 77 > rim delay_send 0..50%
    cc 93 > master hp cutoff 20hz..300hz      # K5 tension: the floor thins, the chord goes further out
    cc 93 > chords delay_send 55%..85%
    cc 18 > rim delay_send 0..80%             # K6 the rim's throw (and the tom's)
    cc 18 > tom delay_send 0..90%
    cc 19 > niebla kick_decay 30%..55%..80%   # K7 the kick's body
    cc 16 > niebla hihat_pitch 0.65x..0.82x..1.3x   # K8 the hats: darker, or brighter
    cc 17 > hiss level 0..0.12                # K9 the room: tape hiss and the bass's grit
    cc 17 > bass drv drive 0.2..1.6

    key 46 > toggle rim                       # A# the rim in and out
    key 47 > throw chords q=1/16              # B  the chord into the echo

    # Pads, bank B
    pad 44 > hold chit q=beat                 # B1 the Cm9 stab, by hand
    pad 45 > hold chitf q=beat                # B2 the Fm9 lean
    pad 46 > hold rimfill q=beat              # B3 a rim fill
    pad 47 > hold swell q=bar                 # B4 the chord backwards into the next bar
    pad 48 > hold tom q=beat                  # B5 the dub tom
    pad 49 > throw rim q=1/16                 # B6 the rim into the echo
    pad 50 > throw chit q=1/16                # B7 the hand's stab into the echo
    pad 51 > drums clap q=beat                # B8 a soft clap

    # The chord's page: the Cm9 itself, and the hand's stabs on F5-F8
    page acorde {
        cc 74 > chords cutoff 300hz..520hz..3khz      # K1 the chord's filter: fog to glass
        cc 71 > chords chorus_mix 10%..80%            # K2 its colour: dry to a wide smear
        cc 71 > chords detune 5%..40%
        cc 76 > chords lfo_depth 0%..45%              # K3 the filter breathing over 16 bars
        cc 77 > chords decay 80ms..1s                 # K4 its length: a click to a bloom
        cc 77 > chords release 100ms..1200ms
        cc 93 > chords resonance 10%..60%             # K5 tension: the filter starts to sing
        cc 18 > chords attack 1ms..200ms              # K6 the stab softened into a swell
        cc 19 > chords sustain 0%..30%                # K7 the chord held under its echo
        cc 16 > chords vibrato_depth 0%..15%          # K8 the tape wobble
        cc 17 > chords vibrato_rate 0.5hz..3hz        # K9 how fast it wobbles
        cc 73 > chords level 0..1.0                   # F1 the chord (written 0.5 at half)
        cc 75 > chords delay_send 0..90%              # F2 its echo
        cc 79 > chords reverb_send 0..60%             # F3 its room
        cc 72 > chords pan -0.7..0.7                  # F4 where it sits
        cc 80 > chit level 0..1.0                     # F5 the hand's Cm9 stab
        cc 81 > chitf level 0..1.0                    # F6 the hand's Fm9 lean
        cc 82 > chit delay_send 0..90%                # F7 the stabs into the echo
        cc 82 > chitf delay_send 0..90%
        cc 83 > swell level 0..0.4                    # F8 the backwards chord
    }
    # The rim's page: the dark wooden knock, its fill and the dub tom
    page rim {
        cc 74 > rim lp cutoff 1500hz..5khz..9khz      # K1 the rim's top: wood to a click
        cc 71 > nrim snare_pitch 0.9x..1.35x..1.9x    # K2 its pitch: low wood to a high knock
        cc 76 > nrim snare_snap 0%..40%               # K3 the crack in it
        cc 93 > nrim snare_drive 0%..40%              # K5 tension: grit on the wood
        cc 18 > rim hp cutoff 100hz..300hz..900hz     # K6 its body: full to thin
        cc 19 > nrim snare_pan -0.6..0.6              # K7 where it knocks
        cc 73 > rim level 0..0.9                      # F1 the rim (written 0.45 at half)
        cc 75 > rim delay_send 0..60%                 # F2 its echo
        cc 79 > rim reverb_send 0..50%                # F3 its room
        cc 72 > rim pan -0.7..0.7                     # F4 where it sits
        cc 80 > rimfill level 0..0.9                  # F5 the rim fill (pad B3)
        cc 81 > tom level 0..0.6                      # F6 the dub tom (pad B5)
        cc 82 > tom delay_send 0..90%                 # F7 the tom into the echo
    }
    # The tape's page: the hiss breathing in the room
    page cinta {
        cc 74 > hiss lp cutoff 1500hz..5khz..9khz     # K1 the tape's top: muffled to airy
        cc 71 > hiss hp cutoff 200hz..600hz..2khz     # K2 its floor: a low rush to a thin hiss
        cc 73 > hiss level 0..0.1                     # F1 the tape (written 0.05 at half)
        cc 75 > hiss delay_send 0..50%                # F2 into the echo
        cc 79 > hiss reverb_send 0..50%               # F3 into the room
        cc 72 > hiss pan -0.7..0.7                    # F4 where it sits
    }
}
