# T04 hipnosis — C minor, 121 BPM, release 1 of the set
#
# examples/deephouse.synth grown into a tema. Back to C and to the big dark
# room after T03's dry organ: the deepest, longest kick so far, a sine sub
# under a growl (a saw and its octave plucked through a low filter), dub
# chords Cm11 / Dbmaj7 that live on their dotted-eighth echo, tape hiss in
# the air. The harmony leans on the phrygian Db and comes back down.
#
# The signature is the sequence: eight notes turning in sixteenths, a
# resonant pluck whose filter takes sixteen bars to breathe. Three placed
# moments: it arrives in 04c-firma and opens over 32 bars (the chords thin
# out to make room); in 04d-hueco it is what is left with the pad and the
# low choir when the floor goes, closing, and 04e-subida opens it again in
# eight bars; in 04f-estallido it comes back with the Db bar written into it
# (hypno_db), the one thing not heard before, with the choir now over the
# kick. The salida takes it away with everything tonal.
#
# K3 is the sequence's filter and resonance; pad B1 holds it wide open.

use "_base.synth"

# The tema's level in the set: `trim`, set by measurement.
master {
    in > lowpass(20khz, 0.05) as dj
       > highpass(20hz, 0.05) as hp
       > eq(low=2, mid=-1, high=-1.5)
       > gain(1.0) as trim
       > gain(1.0) as vol
       > out
}

tempo 121
scale C minor
swing 0.54

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# A deep kick: tuned low, a long body, almost no click
module beats deep {
    kick_level 1.0
    kick_decay 60%
    kick_pitch 0.74x
    kick_click 12%
    kick_drive 30%
    clap_level 0.5
    clap_pan 0.05
    hihat_level 0.42
    hihat_decay 18%
    hihat_pitch 0.9x
    hihat_pan 0.3
    crash_pan -0.25
}

# Rimshot: a dark wooden click in 3-3-2
module beats rim {
    kick_level 0.0
    snare_level 0.6
    snare_decay 3%
    snare_pitch 1.5x
    snare_snap 15%
    snare_drive 10%
    snare_pan -0.3
}

# Sub: a pure sine, an FM carrier with no modulation
module fm sub4 {
    algorithm two_op
    level 2.0
    mod_index 0%
    feedback 0%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.002 1.0 1.0 0.12
    op1_envelope 0.002 1.0 1.0 0.12
}

# The growl on top of the sub: a saw and its octave plucked through a low
# filter; the pluck says where each note starts
module bass growl {
    osc1_wave saw
    osc2_wave saw
    osc2_pitch 12st
    cutoff 180hz
    cutoff_env 1200hz
    resonance 28%
    glide 10%
    attack 1ms
    decay 80ms
    sustain 20%
    release 100ms
}

# Dub chords: short and dark, most of what you hear is their echo
module keys dub {
    voice_mode poly
    cutoff 700hz
    resonance 35%
    detune 8%
    chorus_mix 0%
    attack 3ms
    decay 280ms
    sustain 5%
    release 300ms
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 20%
}

# The sequence: a resonant pluck in sixteenths; its filter breathes over 16 bars
module keys seq {
    voice_mode poly
    cutoff 600hz
    resonance 40%
    detune 5%
    chorus_mix 0%
    attack 4ms
    decay 150ms
    sustain 0%
    release 250ms
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 35%
}

# The same pluck held wide open, for the pad
module keys seqo {
    voice_mode poly
    cutoff 2400hz
    resonance 55%
    detune 5%
    chorus_mix 0%
    attack 4ms
    decay 170ms
    sustain 0%
    release 250ms
    lfo_target cutoff
    lfo_sync bars_2
    lfo_waveform triangle
    lfo_depth 15%
}

# Pad: a dark bed, slow in and slow out, only for the break
module keys murk {
    voice_mode poly
    cutoff 800hz
    resonance 20%
    detune 25%
    chorus_mix 30%
    attack 2s
    decay 1s
    sustain 85%
    release 1s
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 15%
    vibrato_rate 0.5hz
    vibrato_depth 4%
}

# Choir: a low unison voice; the vowel filter turns it from "oh" to "uh"
module keys choir {
    voice_mode unison
    cutoff 1800hz
    resonance 10%
    detune 18%
    chorus_mix 0%
    attack 800ms
    decay 1s
    sustain 80%
    release 1.2s
    vibrato_rate 4.5hz
    vibrato_depth 6%
}

# Tape: feedback noise kept low and filtered, the air in the room
module fm tape {
    algorithm pair_plus_two
    level 1.0
    mod_index 100%
    feedback 100%
    waveform sine
    op0_ratio 5.3x
    op1_ratio 2.51x
    op2_ratio 7.1x
    op3_ratio 1.43x
    op0_envelope 1.0 1.0 1.0 1.0
    op1_envelope 1.0 1.0 1.0 1.0
    op2_envelope 1.0 1.0 1.0 1.0
    op3_envelope 1.0 1.0 1.0 1.0
    op0_feedback 90%
    lfo_target mod_index
    lfo_sync bars_8
    lfo_waveform triangle
    lfo_depth 20%
}

# ────────────────────────────────────────────────
# DRUMS (2-bar cells; the tracks chain eight into a 16-bar phrase)
# ────────────────────────────────────────────────

pattern h_intro {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:     - - x -  - - x -  - - x -  - - x o   - - x -  - - x -  - - x -  - - x o
}

pattern h_intro_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  - - - -
    hat:     - - x -  - - x -  - - x -  - - x o   - - x -  - - x -  - - x -  x o x x
}

pattern h_main {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  X - - -  - - - -  X - - -   - - - -  X - - -  - - - -  X - - -
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x o
}

pattern h_main_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  X - - -  - - - -  X - - -   - - - -  X - - -  - - - -  X - X x
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  x x x x
}

# The peak: a ghost clap pushing into every other bar
pattern h_peak {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  X - - -  - - - -  X - - -   - - - -  X - - -  - - - -  X - - o
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x o
}

pattern h_peak_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  X - - -  - - - -  X - - -   - - - -  X - - -  - - - -  X - X x
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  x x x x  x x x x
}

# The break: no kick, the hats alone
pattern h_break {
    hat:     - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - x -
}

# The climb, eight bars: hats to sixteenths, the clap from quarters to
# eighths to sixteenths on the grid, the kick only on the last beat
pattern h_rise_a {
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x o
    clap:    - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
}

pattern h_rise_b {
    hat:     x o x o  x o x o  x o x o  x o x o   x o x o  x o x o  x o x o  x o x o
    clap:    x - - -  x - - -  x - - -  x - - -   x - x -  x - x -  x - x -  x - x -
}

pattern h_rise_c {
    hat:     x x x x  x x x x  x x x x  x x x x   x x x x  x x x x  x x x x  x x x x
    clap:    x - x -  x - x -  x - x -  x - x -   x x x x  x x x x  x x x x  x x x x
}

pattern h_rise_d {
    hat:     x x x x  x x x x  x x x x  x x x x   x x x x  x x x x  x x x x  - - - -
    clap:    x x x x  x x x x  x x x x  x x x x   x x x x  x x x x  x x x X  - - - -
}

# Stripped for the next tema
pattern h_out {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x o
}

pattern h_out_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:     o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  - - x -  - - x o
}

pattern rim_332 {
    snare:   - - - x  - - x -  - - - x  - - x -
}

# The fill pad: the rim's 3-3-2 run into sixteenths on the grid
pattern rim_roll {
    snare:   - - - x  - - x -  x - x x  x x x X
}

# ────────────────────────────────────────────────
# LOW END (4-bar phrases)
# ────────────────────────────────────────────────

# The pedal: C only, for the mix-in and the mix-out
pattern sub_plain {
    - - C2:0.9 ..  .. .. - C2:0.7   .. .. - -  C2:0.8 .. .. -
    - - C2:0.9 ..  .. .. - C2:0.7   .. .. - -  C2:0.8 .. .. -
    - - C2:0.9 ..  .. .. - C2:0.7   .. .. - -  C2:0.8 .. .. -
    - - C2:0.9 ..  .. .. - C2:0.7   .. .. - -  G1:0.8 .. .. -
}

# Cm11 for two bars, the phrygian Db for one, back to C
pattern sub_line {
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -  C2:0.8 .. .. -
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -  G1:0.8 .. .. -
    - - Db2:0.9 ..  .. .. - Db2:0.7  .. .. - -  Db2:0.8 .. .. -
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -  ~Bb1:0.8 .. ~G1:0.8 -
}

pattern sub_line_turn {
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -  C2:0.8 .. .. -
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -  G1:0.8 .. .. -
    - - Db2:0.9 ..  .. .. - Db2:0.7  .. .. - -  Db2:0.8 .. .. -
    - - Db2:0.9 ..  .. .. - C2:0.7   .. .. - -  - - - -
}

# The break: the sub alone, long roots under the pad
pattern sub_break {
    C2:0.8 ..*31
    Db2:0.8 ..*15
    C2:0.8 ..*15
}

# ────────────────────────────────────────────────
# HARMONY AND TEXTURE
# ────────────────────────────────────────────────

# One or two chords a bar; the dotted-eighth echo fills in the rest
pattern dub_chords {
    - - - -  - - [C3 Eb3 G3 Bb3 F4]:0.8 -   - - - -  - - - -
    - - - -  - - [C3 Eb3 G3 Bb3 F4]:0.7 -   - - - [C3 Eb3 G3 Bb3 F4]:0.5  - - - -
    - - - -  - - [Db3 F3 Ab3 C4]:0.8 -      - - - -  - - - -
    - - - -  - - [C3 Eb3 G3 Bb3 F4]:0.7 -   - - - -  - - - -
}

pattern dub_chords_turn {
    - - - -  - - [C3 Eb3 G3 Bb3 F4]:0.8 -   - - - -  - - - -
    - - - -  - - [C3 Eb3 G3 Bb3 F4]:0.7 -   - - - [C3 Eb3 G3 Bb3 F4]:0.5  - - - -
    - - - -  - - [Db3 F3 Ab3 C4]:0.8 -      - - - [Db3 F3 Ab3 C4]:0.55  - - - -
    - - - -  - - - -   - - - -  - - - -
}

# Thinned for the sequence: one stab every other bar
pattern dub_sparse {
    - - - -  - - [C3 Eb3 G3 Bb3 F4]:0.7 -   - - - -  - - - -
    - - - -  - - - -   - - - -  - - - -
    - - - -  - - [Db3 F3 Ab3 C4]:0.7 -      - - - -  - - - -
    - - - -  - - - -   - - - -  - - - -
}

# The sequence: the same eight notes turning
pattern hypno {
    C3:0.8 G3:0.5 Eb3:0.6 C3:0.5   Bb2:0.7 G3:0.5 C3:0.6 Eb3:0.5   C3:0.8 G3:0.5 Eb3:0.6 Bb3:0.5   G3:0.7 Eb3:0.5 C3:0.6 G2:0.5
}

# Four bars, the third one bent onto the Db: the drop's new sequence
pattern hypno_db {
    C3:0.8 G3:0.5 Eb3:0.6 C3:0.5    Bb2:0.7 G3:0.5 C3:0.6 Eb3:0.5    C3:0.8 G3:0.5 Eb3:0.6 Bb3:0.5    G3:0.7 Eb3:0.5 C3:0.6 G2:0.5
    C3:0.8 G3:0.5 Eb3:0.6 C3:0.5    Bb2:0.7 G3:0.5 C3:0.6 Eb3:0.5    C3:0.8 G3:0.5 Eb3:0.6 Bb3:0.5    G3:0.7 Eb3:0.5 C3:0.6 G2:0.5
    Db3:0.8 Ab3:0.5 F3:0.6 Db3:0.5  C3:0.7 Ab3:0.5 Db3:0.6 F3:0.5    Db3:0.8 Ab3:0.5 F3:0.6 C4:0.5    Ab3:0.7 F3:0.5 Db3:0.6 Ab2:0.5
    C3:0.8 G3:0.5 Eb3:0.6 C3:0.5    Bb2:0.7 G3:0.5 C3:0.6 Eb3:0.5    C3:0.8 G3:0.5 Eb3:0.6 Bb3:0.5    G3:0.7 Eb3:0.5 Db3:0.6 G2:0.5
}

# No root: the sub has it. The pad lives above, on the sevenths and ninths
pattern murk_prog {
    [G3 Bb3 D4 Eb4]:0.6 ..*31
    [Ab3 C4 Eb4 F4]:0.6 ..*15
    [G3 Bb3 D4 Eb4]:0.6 ..*15
}

pattern choir_line {
    G3:0.7 ..*31
    Ab3:0.7 ..*15
    G3:0.7 ..*15
}

pattern tape_bed {
    C4:0.6 ..*63
}

# One bar of three dub stabs, for the pad: a throw written out
pattern dub_figure {
    - - [C3 Eb3 G3 Bb3 F4]:0.75 -  - - - [C3 Eb3 G3 Bb3 F4]:0.6  - - - -  - - [Db3 F3 Ab3 C4]:0.7 -
}

pattern krest4 { -*16 }

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play h_intro, h_intro, h_intro, h_intro, h_intro, h_intro, h_intro, h_intro_turn
    using deep
    level 0.8
    velocity 1.0
    out > highpass(25hz, 0.05) > drums
}

track rim {
    play rim_332
    using rim
    level 0
    velocity 1.0
    reverb_send 0.2
    delay_send 0.12
    out > highpass(300hz, 0.05) > lowpass(6khz, 0.05) > drums
}

track sub {
    play sub_plain
    using sub4
    level 0.11
    velocity 1.0
    gate 0.85
    sidechain 0.3
    out > highpass(28hz, 0.05) > lowpass(120hz, 0.05) > low
}

track bass {
    play sub_plain
    using growl
    level 0.5
    velocity 1.0
    gate 0.8
    sidechain 0.25
    out > highpass(100hz, 0.05) > saturate(0.9) as drv > lowpass(1800hz, 0.05) > highpass(55hz, 0.01) > low
}

track chords {
    play dub_chords, dub_chords, dub_chords, dub_chords_turn
    using dub
    level 0
    velocity 1.0
    gate 0.4
    pan -0.2
    delay_send 0.45
    reverb_send 0.25
    sidechain 0.5
    out > highpass(220hz, 0.05) > master
}

track seq {
    play hypno
    using seq
    level 0
    velocity 1.0
    gate 0.5
    pan 0.3
    delay_send 0.25
    reverb_send 0.15
    sidechain 0.45
    out > highpass(300hz, 0.05) > autopan(0.3, bars=8) > master
}

track pad {
    play murk_prog
    using murk
    level 0
    velocity 1.0
    reverb_send 0.45
    sidechain 0.55
    out > highpass(350hz, 0.05) > eq(low=-6) > autopan(0.4, bars=8) > master
}

track choir {
    play choir_line
    using choir
    level 0
    velocity 1.0
    pan -0.1
    reverb_send 0.5
    delay_send 0.15
    sidechain 0.4
    out > highpass(300hz, 0.05) > vowel(o, u, bars=4, mix=0.8) as vox > master
}

track tape {
    play tape_bed
    using tape
    level 0.04
    velocity 1.0
    reverb_send 0.2
    sidechain 0.3
    out > highpass(500hz, 0.05) > lowpass(2500hz, 0.05, lfo_bars=16, lfo_depth=1200) > autopan(0.6, bars=16) > master
}

# ── The pads' voices (bank B); steps never touch these ──

track seqx {
    play hypno
    using seqo
    level 0.13
    velocity 1.0
    gate 0.5
    pan -0.3
    delay_send 0.35
    reverb_send 0.15
    sidechain 0.45
    out > highpass(300hz, 0.05) > autopan(0.4, bars=1) > master
}

track dubx {
    play dub_figure
    using dub
    level 0.3
    velocity 1.0
    gate 0.4
    pan 0.2
    delay_send 0.7
    reverb_send 0.3
    sidechain 0.5
    out > highpass(220hz, 0.05) > master
}

track rimx {
    play rim_roll
    using rim
    level 0.5
    velocity 1.0
    reverb_send 0.2
    delay_send 0.1
    out > highpass(300hz, 0.05) > lowpass(6khz, 0.05) > drums
}

# The choir from the pads: one note a pad, over whatever plays
track kchoir {
    play krest4
    using choir
    level 0.35
    velocity 1.0
    pan 0.15
    reverb_send 0.5
    delay_send 0.15
    sidechain 0.4
    out > highpass(300hz, 0.05) > vowel(o, u, bars=4, mix=0.8) as vox > master
}

# The keyboard's lead: the sequence's pluck, through the sequence's chain
# The keys' own voice: `seq` as written, under another name, so a knob
# on it (the `teclas` page) moves only what the hands play, and the tema's
# `auto` lines on `seq` leave it alone.
module keys kvoz {
    voice_mode poly
    cutoff 600hz
    resonance 40%
    detune 5%
    chorus_mix 0%
    attack 4ms
    decay 150ms
    sustain 0%
    release 250ms
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 35%
}

track ktema {
    play krest
    using kvoz
    level 0.5
    velocity 1.0
    gate 0.5
    pan 0.3
    delay_send 0.25
    reverb_send 0.15
    sidechain 0.45
    out > highpass(300hz, 0.05) > autopan(0.3, bars=8) > lowpass(18khz, 0.1) as klp > vowel(a, wet=0) as talk > gain(1.0) as kgain > master
}

midi {
    cc 75 > bass level 0..1.0                   # F2 the growl (0.5 at half)
    cc 80 > rim level 0..0.9                    # F5 the colour: the rim,
    cc 80 > tape level 0..0.1                   #    the tape
    cc 80 > choir level 0..1.0                  #    and the choir where it sings
    cc 83 > chords delay_send 0..80%            # F8 the dub send: the chords

    # ── page tema ──
    cc 74 > growl cutoff 80hz..900hz            # K1 the growl's filter
    cc 71 > dub cutoff 300hz..3khz              # K2 the chords' colour
    cc 76 > seq cutoff 250hz..3khz              # K3 the sequence breathing: closed to open
    cc 76 > seq resonance 25%..65%              #    and ringing as it opens
    cc 77 > murk cutoff 400hz..3khz             # K4 the pad and the choir: dark to open
    cc 77 > choir cutoff 600hz..4khz
    cc 93 > master hp cutoff 20hz..300hz        # K5 tension: the floor thins
    cc 93 > seq reverb_send 0.15..0.6           #    and the sequence goes to the room
    cc 18 > seq delay_send 0..80%               # K6 throw: the sequence into the echo
    cc 19 > deep kick_decay 35%..80%            # K7 the kick: short to long
    cc 16 > deep hihat_pitch 0.6x..0.9x..1.4x   # K8 hats: darker left, written in the middle
    cc 17 > bass drv drive 0.3..2.0             # K9 dirt: the growl driven
    cc 17 > tape level 0.02..0.12               #    and the tape hiss up

    key 46 > toggle rim                         # A# the rim in and out
    key 47 > throw seq q=1/16                   # B  the sequence into the echo

    pad 44 > hold seqx q=bar                    # B1 the sequence wide open while held
    pad 45 > hold dubx q=bar                    # B2 three dub stabs into the echo
    pad 46 > hold rimx q=beat                   # B3 rim fill
    pad 47 > drums crash q=beat                 # B4 crash
    pad 48 > play kchoir G3 q=1/16              # B5 the choir: G,
    pad 49 > play kchoir Ab3 q=1/16             # B6 the bVI's Ab,
    pad 50 > play kchoir Eb3 q=1/16             # B7 Eb
    pad 51 > throw chords q=1/16                # B8 the chords into the echo

    # The sequence's page: the resonant pluck, and its open twin on pad B1
    page secuencia {
        cc 74 > seq cutoff 250hz..600hz..3khz         # K1 the pluck's filter: closed to open
        cc 71 > seq resonance 20%..40%..70%           # K2 its colour: soft to ringing
        cc 76 > seq lfo_depth 0%..35%..60%            # K3 the filter breathing over 16 bars
        cc 77 > seq decay 60ms..150ms..500ms          # K4 its length: a tick to a pluck that rings
        cc 93 > seq detune 0%..5%..30%                # K5 tension: the voices drift apart
        cc 18 > seq release 80ms..250ms..800ms        # K6 its tail
        cc 19 > seq chorus_mix 0%..40%                # K7 width
        cc 16 > seq attack 1ms..4ms..40ms             # K8 the pluck softened
        cc 17 > seqo cutoff 1khz..2400hz..6khz        # K9 the open sequence's filter (pad B1)
        cc 73 > seq level 0..0.32                     # F1 the sequence (written 0.16 at half)
        cc 75 > seq delay_send 0..60%                 # F2 its echo
        cc 79 > seq reverb_send 0..40%                # F3 its room
        cc 72 > seq pan -0.7..0.7                     # F4 where it sits
        cc 80 > seqx level 0..0.26                    # F5 the open sequence (pad B1)
        cc 81 > seqx delay_send 0..70%                # F6 the open one into the echo
    }
    # The dub chords' page: Cm11 / Dbmaj7 and the three stabs on pad B2
    page dub {
        cc 74 > chords cutoff 300hz..700hz..3khz      # K1 the chords' filter: fog to glass
        cc 71 > chords resonance 15%..35%..65%        # K2 its colour: the filter sings
        cc 76 > chords lfo_depth 0%..20%..50%         # K3 the filter breathing over 16 bars
        cc 77 > chords decay 100ms..280ms..900ms      # K4 its length: a chop to a bloom
        cc 77 > chords release 120ms..300ms..1s
        cc 93 > chords detune 0%..8%..30%             # K5 tension: the voices drift apart
        cc 18 > chords sustain 0%..5%..35%            # K6 the chord held under its echo
        cc 19 > chords chorus_mix 0%..50%             # K7 width
        cc 16 > chords attack 1ms..3ms..120ms         # K8 the stab softened into a swell
        cc 73 > chords level 0..0.6                   # F1 the chords (written 0.3 at half)
        cc 75 > chords delay_send 0..90%              # F2 its echo
        cc 79 > chords reverb_send 0..50%             # F3 its room
        cc 72 > chords pan -0.7..0.7                  # F4 where it sits
        cc 80 > dubx level 0..0.6                     # F5 the three stabs (pad B2)
        cc 81 > dubx delay_send 0..100%               # F6 the stabs into the echo
    }
    # The pad's page: the dark bed of the hueco on the knobs, the low choir beside it
    page pad {
        cc 74 > pad cutoff 300hz..800hz..3khz         # K1 the pad's filter: dark to open
        cc 71 > pad detune 5%..25%..50%               # K2 its colour: thin to a wide smear
        cc 76 > pad lfo_depth 0%..15%..45%            # K3 the filter breathing over 16 bars
        cc 77 > pad attack 200ms..2s                  # K4 its swell: quicker in, slower out
        cc 77 > pad release 300ms..1s..2s
        cc 93 > pad resonance 0%..20%..50%            # K5 tension: the filter starts to sing
        cc 18 > pad chorus_mix 0%..30%..70%           # K6 its width
        cc 19 > choir cutoff 600hz..1800hz..4khz      # K7 the choir's filter
        cc 16 > choir vox position 0..1               # K8 the choir's vowel, a to u
        cc 17 > choir vibrato_depth 0%..6%..20%       # K9 the choir's vibrato
        cc 73 > pad level 0..0.28                     # F1 the pad (written 0.14 at half)
        cc 75 > pad delay_send 0..40%                 # F2 its echo
        cc 79 > pad reverb_send 0..90%                # F3 its room
        cc 72 > pad pan -0.7..0.7                     # F4 where it sits
        cc 80 > choir level 0..0.9                    # F5 the choir (0.4-0.5 as written)
        cc 81 > choir reverb_send 0..100%             # F6 the choir's room
        cc 82 > kchoir level 0..0.7                   # F7 the choir on the pads (B5-B7)
        cc 83 > choir pan -0.7..0.7                   # F8 where the choir sits
    }
}
