# set: bars=32 max=2 phase=08-ceniza energy=4
# set-note: The kick thins to one and three, the chord fills the offbeats and leans to Db every fourth bar with the sub and the bass under it (gesture 2); the room grows, the crackle and the air come forward.
# cue: 13 B6 el tom dub al eco, una vez
# cue: 29 K3 abajo despacio: el acorde se oscurece hacia el final
use "_t08.synth"

track drums  { play e_thin }
track rim    { play r_b level 0.45 }
track dust   { level 0.6 }
track hiss   { level 0.11 }
track sub    { play sub_db }
track bass   { play b8_db }
track chords { play st_dub level 0.26 reverb_send 0.7 }

auto s8chord cutoff 0.45 > 0.37 over 32
