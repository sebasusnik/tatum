# set: bars=32 max=2 phase=07-subsuelo energy=7
# set-note: The 303 surfaces under the sub for sixteen bars (9-24), its filter shut and opening a hair, then sinks again (gesture 1).
# cue: 9 el 303 aparece bajo el sub: no toques K3 todavía, dejalo abrir solo
# cue: 21 F8 un toque arriba y abajo: una cola del 303 al eco
use "_t07.synth"

track drums { play d_main, d_main, d_main, d_main, d_main, d_main, d_main, d_main_turn }
track sub   { play s_a, s_a, s_a, s_turn }
track bass  { play b_main, b_main, b_main, b_main, b_main, b_main, b_main, b_turn }
track perc  { level 0.45 }
track acid  { play ac_rest, ac_rest, ac_a, ac_a, ac_a, ac_turn, ac_rest, ac_rest level 0.32 }

auto s7tb cutoff 0.27 > 0.36 over 32
