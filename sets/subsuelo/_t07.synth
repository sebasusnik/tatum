# T07 subsuelo — C minor, 123 BPM, release 2: the peak of the set
#
# The basement under the floor. The deepest kick of the set (tuned down, a
# long body, no click), a sine sub, and above it a short square pluck that
# plays a syncopated line in the gaps between the kicks. Tight 16th hats with
# their ghosts, a clap on two and four, a wooden rim always on the "and" of
# two and four with a low tom answering it.
#
# The signature is a 303 kept under the sub: its filter shut, its low end cut
# away, so what is heard is the resonance squelching beneath the bass. It is
# placed, not laid: it surfaces for sixteen bars in `firma` and sinks again;
# in `hueco` it is the only thing left, alone with its echo; `subida` hammers
# its root as the filter climbs; in `estallido` it comes back open on a new
# riff, steps out for sixteen bars to let the floor and the new pad breathe,
# and returns for the last phrase. Every opening is an `auto` on its cutoff,
# and K3 is that cutoff: the performer can take it over at any moment.
#
# The room is smaller than T06's: a short damped reverb, the echo dotted and
# dark. The pad (`chords`, Cm11 leaning to Db) is heard only at the peak.

use "_base.synth"

# The tema's level in the set (measured on the render)
master {
    in > lowpass(20khz, 0.05) as dj
       > highpass(20hz, 0.05) as hp
       > eq(low=2, mid=-1, high=-1.5)
       > gain(1.0) as trim
       > gain(1.0) as vol
       > out
}

tempo 123
scale C minor
swing 0.54

delay sync=dotted_eighth feedback=0.48 filter=0.32
reverb size=0.62 damp=0.72 predelay=18 sidechain=0.55

delay_return  { in > highpass(280hz, 0.05) > lowpass(2800hz, 0.05, lfo_bars=8, lfo_depth=900) > autopan(0.5, bars=4) > out }
reverb_return { in > highpass(420hz, 0.05) > lowpass(3500hz, 0.05) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# The deepest kick of the set: tuned down, long body, almost no click
module beats s7kit {
    kick_level 1.0
    kick_decay 64%
    kick_pitch 0.7x
    kick_click 6%
    kick_drive 24%
    clap_level 0.5
    clap_pan -0.05
    hihat_level 0.42
    hihat_decay 12%
    hihat_pitch 1.08x
    hihat_pan 0.25
    crash_pan -0.25
}

# The rim (a short high snare) and a low tom: the wood that answers
module beats s7perc {
    kick_level 0.0
    snare_level 0.55
    snare_decay 3%
    snare_pitch 1.62x
    snare_snap 22%
    snare_drive 12%
    snare_pan -0.3
    tom_pan 0.35
}

# Sub: a sine, an FM carrier with no modulation
module fm s7sub {
    algorithm two_op
    level 2.0
    mod_index 0%
    feedback 0%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.002 1.0 1.0 0.12
    op1_envelope 0.002 1.0 1.0 0.12
}

# The bass: a square and its octave, plucked short through a low filter; a
# knock in the gaps, not a hum
module bass s7pulse {
    osc1_wave square
    osc2_wave square
    osc2_pitch 12st
    cutoff 210hz
    cutoff_env 900hz
    resonance 18%
    glide 8%
    attack 1ms
    decay 110ms
    sustain 0%
    release 60ms
}

# The 303. Its filter starts shut (140 Hz, a small envelope); the steps open
# it with `auto ... cutoff`, and K3 takes it over by hand
module bass s7tb {
    osc1_wave saw
    cutoff 140hz
    cutoff_env 700hz
    resonance 80%
    glide 14%
    keytrack 15%
    attack 1ms
    decay 170ms
    sustain 10%
    release 40ms
    vel_env 55%
}

# The 303 held, for the pads: it sustains, a slow wobble on the filter
module bass s7tbh {
    osc1_wave saw
    cutoff 260hz
    cutoff_env 900hz
    resonance 74%
    glide 10%
    keytrack 15%
    attack 2ms
    decay 300ms
    sustain 55%
    release 140ms
    vel_env 40%
    lfo_target cutoff
    lfo_sync quarter
    lfo_waveform triangle
    lfo_depth 12%
}

# The peak's pad: slow in, slow out, its filter breathing over 16 bars
module keys s7veil {
    voice_mode poly
    cutoff 850hz
    resonance 22%
    detune 18%
    chorus_mix 20%
    attack 1.2s
    decay 1s
    sustain 80%
    release 1.5s
    lfo_target cutoff
    lfo_sync bars_16
    lfo_waveform triangle
    lfo_depth 25%
    vibrato_rate 0.5hz
    vibrato_depth 4%
}

# The pad's chord struck short, for a pad on the controller
module keys s7stab {
    voice_mode poly
    cutoff 900hz
    resonance 30%
    detune 12%
    chorus_mix 0%
    attack 3ms
    decay 300ms
    sustain 5%
    release 350ms
}

# ────────────────────────────────────────────────
# DRUMS (two-bar cells; the tracks chain them into 16-bar phrases)
# ────────────────────────────────────────────────

# The mix-in and mix-out: the kick and the offbeat hat, a ghost before the one
pattern d_in {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - x o
}

pattern d_in_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  o x x o
}

# The floor: the clap on two and four, sixteenth hats with ghosts
pattern d_main {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
    hat:   o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x o
}

# The turn: a clap pickup into the next phrase, on the grid
pattern d_main_turn {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - o x
    hat:   o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o x x o  x x x o
}

# The peak: the open hat on every offbeat over the sixteenths
pattern d_peak {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - - -
    hat:     o o - o  o o - o  o o - o  o o - o   o o - o  o o - o  o o - o  o o - o
    openhat: - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - x -
}

pattern d_peak_turn {
    kick:    X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  x - - -  - - - -  x - - -   - - - -  x - - -  - - - -  x - o x
    hat:     o o - o  o o - o  o o - o  o o - o   o o - o  o o - o  o x x o  x x x o
    openhat: - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - - -
}

# The breakdown: nothing on the floor
pattern d_rest {
    hat:   - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - - - -
}

# The build, eight bars in four cells: the kick and eighth hats; sixteenths
# and a clap on every beat; the kick gone, the clap in eighths; the clap
# packing to ratchets and one beat of nothing
pattern d_b1 {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   - - x -  - - x -  - - x -  - - x -   - - x -  - - x -  - - x -  - - x -
}

pattern d_b2 {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    clap:  x - - -  x - - -  x - - -  x - - -   x - - -  x - - -  x - - -  x - - -
    hat:   o o x o  o o x o  o o x o  o o x o   o o x o  o o x o  o o x o  o o x o
}

pattern d_b3 {
    clap:  x - x -  x - x -  x - x -  x - x -   x - x -  x - x -  x - x -  x - x -
    hat:   o o x o  o o x o  o o x o  o o x o   o o x o  o o x o  o o x o  o o x o
}

pattern d_b4 {
    clap:  x x x x  x x x x  x x x x  x x x x   x*2 x*2 x*2 x*2  x*2 x*2 x*2 x*2  x*3 x*3 x*3 x*3  - - - -
    hat:   x x x x  x x x x  x x x x  x x x x   x x x x  x x x x  x x x x  - - - -
}

# ────────────────────────────────────────────────
# THE WOOD: the rim always on the "and" of two and four, a low tom answering
# ────────────────────────────────────────────────

pattern p_a {
    snare: - - - -  - - x -  - - - -  - - x -   - - - -  - - x -  - - - -  - - x -
    tom:   - - - -  - - - -  - - - x  - - - -   - - - -  - - - -  - - - -  - - - -
}

# The peak: the tom on every bar, a second tom closing the cell
pattern p_b {
    snare: - - - -  - - x -  - - - -  - - x -   - - - -  - - x -  - - - -  - - x -
    tom:   - - - -  - - - -  - - - x  - - - -   - - - -  - - - -  - - - x  - - - -
    tom2:  - - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - - -  - x - -
}

# A pad's fill: one bar of toms falling, the rim on the last beat
pattern p_fill {
    snare: - - - -  - - - -  - - - -  x x x x
    tom2:  x x x x  - - - -  - - - -  - - - -
    tom:   - - - -  x x x x  x x x x  - - - -
}

# ────────────────────────────────────────────────
# THE LOW END: the sub holds the roots, the pluck knocks in the gaps
# ────────────────────────────────────────────────

pattern s_plain {
    - - C2:0.85 ..  .. .. - -  - - C2:0.8 ..  .. .. - -
}

pattern s_a {
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -   - - C2:0.8 ..
    .. .. - -       - - C2:0.9 ..    .. - - -    Bb1:0.75 .. .. -
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -   - - C2:0.8 ..
    .. .. - -       - - C2:0.9 ..    .. - - -    G1:0.75 .. .. -
}

# The turn: the last two bars lean on the flat second and fall back
pattern s_turn {
    - - C2:0.9 ..   .. .. - C2:0.7   .. .. - -   - - C2:0.8 ..
    .. .. - -       - - C2:0.9 ..    .. - - -    Bb1:0.75 .. .. -
    - - Db2:0.9 ..  .. .. - Db2:0.7  .. .. - -   - - Db2:0.8 ..
    .. .. - -       - - Db2:0.9 ..   .. - - -    ~C2:0.8 .. .. -
}

# The build: the root held through the first half, then nothing under the clap
pattern s_pedal {
    - - C2:0.9 ..*13  - - C2:0.85 ..*13  - - C2:0.85 ..*13  - - C2:0.8 ..*13
    -*64
}

pattern b_plain {
    - - C2:0.85 -  - - C2:0.6 -  - - C2:0.85 -  - - C2:0.6 -
}

pattern b_main {
    - - - C2:0.85  - - C2:0.55 -  - - - C3:0.7   - - Bb1:0.6 -
    - - - C2:0.85  - - C2:0.55 -  - - - Eb2:0.75 - G1:0.55 - -
}

pattern b_turn {
    - - - Db2:0.85  - - Db2:0.55 -  - - - Db3:0.7  - - Ab1:0.6 -
    - - - Db2:0.85  - - Db2:0.55 -  - - - Ab1:0.75  - - ~G1:0.7 -
}

# The peak: the octave answering every gap
pattern b_peak {
    - - C3:0.6 C2:0.85  - - C2:0.55 C3:0.6  - - - C3:0.75   - C2:0.6 Bb1:0.65 -
    - - C3:0.6 C2:0.85  - - C2:0.55 C3:0.6  - - - Eb2:0.75  - G1:0.6 - C2:0.5
}

pattern b_peak_turn {
    - - Db3:0.6 Db2:0.85  - - Db2:0.55 Db3:0.6   - - - Db3:0.75  - Db2:0.6 Ab1:0.65 -
    - - Db3:0.6 Db2:0.85  - - Db2:0.55 Db3:0.6   - - - Ab1:0.75  - - ~G1:0.7 -
}

# ────────────────────────────────────────────────
# THE 303: C minor with the flat second rubbing; four-bar cells
# ────────────────────────────────────────────────

pattern ac_rest { -*64 }

pattern ac_a {
    C2:0.95 C2:0.5 C3:0.8 C2:0.5  - C2:0.7 ~Eb2:0.85 C2:0.5  C2:0.9 - Bb1:0.7 C2:0.5  Db2:0.85 - C2:0.6 ~G1:0.8
    C2:0.95 - C2:0.6 G1:0.8  C2:0.7 ~C3:0.9 - C2:0.55  Bb1:0.8 C2:0.9 - C2:0.55  ~Eb2:0.8 Db2:0.7 C2:0.6 -
    C2:0.95 C2:0.5 C3:0.8 C2:0.5  - C2:0.7 ~Eb2:0.85 C2:0.5  C2:0.9 - Bb1:0.7 C2:0.5  Db2:0.85 - C2:0.6 ~G1:0.8
    C2:0.95 - C2:0.6 G1:0.8  C2:0.7 ~C3:0.9 - C2:0.55  Bb1:0.8 C2:0.9 Eb2:0.6 C2:0.55  ~G2:0.85 F2:0.7 Eb2:0.6 Db2:0.75
}

pattern ac_turn {
    C2:0.95 C2:0.5 C3:0.8 C2:0.5  - C2:0.7 ~Eb2:0.85 C2:0.5  C2:0.9 - Bb1:0.7 C2:0.5  Db2:0.85 - C2:0.6 ~G1:0.8
    C2:0.95 - C2:0.6 G1:0.8  C2:0.7 ~C3:0.9 - C2:0.55  Bb1:0.8 C2:0.9 - C2:0.55  ~Eb2:0.8 Db2:0.7 C2:0.6 -
    C2:0.95 C2:0.5 C3:0.8 C2:0.5  - C2:0.7 ~Eb2:0.85 C2:0.5  C2:0.9 - Bb1:0.7 C2:0.5  Db2:0.85 - C2:0.6 ~G1:0.8
    C2:0.95 C3:0.8 C2:0.6*2 ~Db3:0.9  C2:0.7 - G2:0.85 ~F2:0.7  C3:1.0*3 - Bb2:0.8 C2:0.6  <C2:0.7 Eb2:0.8 G2:0.9 Bb2:1.0> C3:1.0 ~Db3:0.9 -
}

# The breakdown: a few notes, room for the echo to answer
pattern ac_hollow {
    C2:0.9 - - C2:0.5  - - C3:0.7 -  - ~Eb2:0.8 - -  C2:0.6 - - -
    C2:0.9 - - -  Db2:0.7 - - C2:0.5  - - ~G1:0.7 -  - - C2:0.55 -
    C2:0.9 - - C2:0.5  - - C3:0.7 -  - ~Eb2:0.8 - -  C2:0.6 - - -
    C2:0.9 - - -  Db2:0.7 - - C2:0.5  - - ~Bb1:0.7 -  - ~C2:0.6 - -
}

# The build: the root in sixteenths, the octave on the offbeats, ratchets in
# the last bar and one beat of nothing
pattern ac_rise {
    C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.75 C2:0.5
    C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 Db2:0.6 C3:0.75 C2:0.5
    C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.7 C2:0.5  C2:0.9 C2:0.5 C3:0.75 C2:0.5
    C2:0.9 C2:0.6 C3:0.8 C2:0.6  C2:0.9 C2:0.6 C3:0.8 C2:0.6  Db2:0.9 Db2:0.6 Db3:0.8 Db2:0.6  Db2:0.9 Db2:0.6 Db3:0.85 Db2:0.6
    C2:0.9 C2:0.55 C3:0.7 C2:0.55  C2:0.9 C2:0.55 C3:0.7 C2:0.55  C2:0.9 C2:0.55 C3:0.7 C2:0.55  C2:0.9 C2:0.55 C3:0.8 C2:0.55
    C2:0.9 C2:0.6 C3:0.8 C2:0.6  C2:0.9 C2:0.6 C3:0.8 C2:0.6  Db2:0.9 Db2:0.6 Db3:0.8 Db2:0.6  Db2:0.9 Db2:0.6 Db3:0.85 Db2:0.6
    C2:0.9*2 C3:0.8 C2:0.9*2 C3:0.8  C2:0.9*2 C3:0.85 C2:0.9*2 C3:0.85  C2:1.0*3 C3:0.9 C2:1.0*3 C3:0.9  C2:1.0*4 C3:1.0*2 C2:1.0*4 C3:1.0*2
    C2:1.0*3 C3:1.0*3 C2:1.0*3 C3:1.0*3  C2:1.0*4 C3:1.0*4 C2:1.0*4 C3:1.0*4  <C2:1.0 Eb2:1.0 G2:1.0 Bb2:1.0> <C3:1.0 Eb3:1.0 G3:1.0 Bb3:1.0> C3:1.0*4 C3:1.0*4  - - - -
}

# The drop's riff: octave leaps, the run up to the flat second on top
pattern ac_open {
    C2:1.0 C3:0.8 C2:0.6 ~Eb3:0.9  C2:0.6 C3:0.85 G2:0.7 ~Bb2:0.85  C2:1.0 C3:0.8 C2:0.6 ~Db3:0.95  C2:0.6 <C3:0.9 Eb3:0.9> C2:0.6 G2:0.8
    C2:1.0 - C2:0.6 G1:0.8  C2:0.7 ~C3:0.9 - C2:0.55  C3:1.0*2 C2:0.6 ~Bb2:0.8 C2:0.6  <G2:0.8 Bb2:0.85> C3:1.0 ~Db3:0.95 C2:0.6
    C2:1.0 C3:0.8 C2:0.6 ~Eb3:0.9  C2:0.6 C3:0.85 G2:0.7 ~Bb2:0.85  C2:1.0 C3:0.8 C2:0.6 ~Db3:0.95  C2:0.6 <C3:0.9 Eb3:0.9> C2:0.6 G2:0.8
    C2:1.0 - C2:0.6 G1:0.8  C2:0.7 ~C3:0.9 - C2:0.55  C3:1.0*2 C2:0.6 ~Bb2:0.8 C2:0.6  <G2:0.8 Bb2:0.85> C3:1.0 ~Db3:0.95 C2:0.6
}

# The riff turned over: it starts on the octave and falls
pattern ac_open2 {
    C3:1.0 C2:0.6 C3:0.8 ~Eb3:0.95  C2:0.6 C2:0.6*2 G2:0.8 C2:0.6  C3:1.0*2 C2:0.6 ~Bb2:0.85 C2:0.6  <C2:0.8 C3:0.9> ~Eb3:0.95 C2:0.6 C3:0.9
    C3:1.0 C2:0.6 C3:0.8 ~Db3:0.95  C2:0.6 C2:0.6*2 G2:0.8 C2:0.6  Eb3:1.0*3 C3:0.9 ~Db3:0.95 C2:0.6  <Bb2:0.8 G2:0.8 F2:0.85 Eb2:0.9> C2:0.7 C3:1.0*2 -
    C3:1.0 C2:0.6 C3:0.8 ~Eb3:0.95  C2:0.6 C2:0.6*2 G2:0.8 C2:0.6  C3:1.0*2 C2:0.6 ~Bb2:0.85 C2:0.6  <C2:0.8 C3:0.9> ~Eb3:0.95 C2:0.6 C3:0.9
    C3:1.0 C2:0.6 C3:0.8 ~Db3:0.95  C2:0.6 C2:0.6*2 G2:0.8 C2:0.6  Eb3:1.0*3 C3:0.9 ~Db3:0.95 C2:0.6  <Bb2:0.8 G2:0.8 F2:0.85 Eb2:0.9> C2:0.7 C3:1.0*2 -
}

pattern ac_open_turn {
    C2:1.0 C3:0.8 C2:0.6 ~Eb3:0.9  C2:0.6 C3:0.85 G2:0.7 ~Bb2:0.85  C2:1.0 C3:0.8 C2:0.6 ~Db3:0.95  C2:0.6 <C3:0.9 Eb3:0.9> C2:0.6 G2:0.8
    C2:1.0 - C2:0.6 G1:0.8  C2:0.7 ~C3:0.9 - C2:0.55  C3:1.0*2 C2:0.6 ~Bb2:0.8 C2:0.6  <G2:0.8 Bb2:0.85> C3:1.0 ~Db3:0.95 C2:0.6
    C2:1.0 C3:0.8 C2:0.6 ~Eb3:0.9  C2:0.6 C3:0.85 G2:0.7 ~Bb2:0.85  C2:1.0 C3:0.8 C2:0.6 ~Db3:0.95  C2:0.6 <C3:0.9 Eb3:0.9> C2:0.6 G2:0.8
    <C2:0.8 Eb2:0.85 G2:0.9 Bb2:0.95> <C3:0.9 Db3:0.95 Eb3:1.0 G3:1.0> Eb3:1.0*3 C3:1.0*3  C2:0.7 ~C3:1.0 ~Db3:1.0 C2:0.6  C3:1.0*2 - Bb2:0.8 G2:0.7  ~Db3:0.9 C3:0.8 - -
}

# A pad's figure: one bar of the open riff
pattern ac_fig {
    C2:1.0 C3:0.8 C2:0.6 ~Eb3:0.9  C2:0.6 C3:0.85 G2:0.7 ~Bb2:0.85  C3:1.0*2 C2:0.6 ~Db3:0.95 C2:0.6  <G2:0.8 Bb2:0.85> C3:1.0 ~Db3:0.95 -
}

# ────────────────────────────────────────────────
# THE PEAK'S PAD: no root (the sub has it); Cm11 above C3, Db for the turn
# ────────────────────────────────────────────────


pattern ch_a {
    [Eb3 G3 Bb3 F4]:0.6 ..*63
    [Eb3 G3 Bb3 F4]:0.55 ..*63
    [Eb3 G3 Bb3 D4]:0.6 ..*63
    [Eb3 G3 Bb3 D4]:0.55 ..*31
    [Db3 F3 Ab3 C4]:0.6 ..*31
}

# The pad's chord struck once a bar on the "and" of two, for a pad
pattern ch_stab {
    - - - -  - - [Eb3 G3 Bb3 F4]:0.8 -  - - - -  - - - -
}

# The salida: the kick, the sixteenth hats, no clap
pattern d_out {
    kick:  X - - -  X - - -  X - - -  X - - -   X - - -  X - - -  X - - -  X - - -
    hat:   o - x o  o - x o  o - x o  o - x o   o - x o  o - x o  o - x o  o - x o
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

# The kick is dry: no sends
track drums {
    play d_in, d_in, d_in, d_in, d_in, d_in, d_in, d_in_turn
    using s7kit
    level 0.85
    velocity 1.0
    out > highpass(25hz, 0.05) > drums
}

track perc {
    play p_a
    using s7perc
    level 0
    velocity 1.0
    reverb_send 0.15
    delay_send 0.08
    out > highpass(250hz, 0.05) as hp > lowpass(7khz, 0.05) as lp > drums
}

track sub {
    play s_plain
    using s7sub
    level 0.13
    velocity 1.0
    gate 0.85
    sidechain 0.3
    out > highpass(28hz, 0.05) > lowpass(120hz, 0.05) > low
}

track bass {
    play b_plain
    using s7pulse
    level 0.6
    velocity 1.0
    gate 0.6
    sidechain 0.25
    out > highpass(70hz, 0.05) > saturate(0.5) as drv > lowpass(1600hz, 0.05) > low
}

# The 303 under the sub: its own low end cut, the squelch left
track acid {
    play ac_rest
    using s7tb
    level 0
    velocity 1.0
    gate 0.55
    pan 0.15
    delay_send 0.25
    reverb_send 0.08
    sidechain 0.5
    out > highpass(95hz, 0.05) > saturate(0.8) as dirt > lowpass(7khz, 0.05) as lp > autopan(0.25, bars=4) > master
}

track chords {
    play ch_a
    using s7veil
    level 0
    velocity 1.0
    pan -0.1
    delay_send 0.2
    reverb_send 0.45
    sidechain 0.6
    out > highpass(350hz, 0.05) > phaser(0.3, bars=8) as ph > autopan(0.4, bars=8) > master
}

# ────────────────────────────────────────────────
# PERFORMANCE VOICES (the KeyLab's pads; steps never touch these)
# ────────────────────────────────────────────────

# B1 / B5: the 303 held on the root, or on the flat second
track acidh {
    play krest
    using s7tbh
    level 0.3
    velocity 1.0
    gate 1.0
    pan -0.15
    delay_send 0.3
    reverb_send 0.08
    sidechain 0.5
    out > highpass(95hz, 0.05) > saturate(0.8) > lowpass(7khz, 0.05) > autopan(0.3, bars=1) > master
}

# B2: one bar of the open riff while held
track afig {
    play ac_fig
    using s7tb
    level 0.32
    velocity 1.0
    gate 0.55
    pan 0.2
    delay_send 0.35
    sidechain 0.5
    out > highpass(95hz, 0.05) > saturate(0.8) > lowpass(7khz, 0.05) > master
}

# B4: the toms falling
track tomfill {
    play p_fill
    using s7perc
    level 0.45
    velocity 1.0
    reverb_send 0.2
    out > highpass(150hz, 0.05) > lowpass(7khz, 0.05) > drums
}

# B6: the pad's chord struck, into the echo
track cstab {
    play ch_stab
    using s7stab
    level 0.22
    velocity 1.0
    gate 0.4
    pan 0.25
    delay_send 0.55
    reverb_send 0.3
    sidechain 0.5
    out > highpass(300hz, 0.05) > master
}

# The keyboard's lead: the 303, through the acid's chain, plus the filter
# (`klp`), the vowel (`talk`) and the level (`kgain`) the keylab reaches
track ktema {
    play krest
    using s7tb
    level 0.35
    velocity 1.0
    gate 0.55
    pan 0.15
    delay_send 0.25
    reverb_send 0.08
    sidechain 0.5
    out > highpass(95hz, 0.05) > saturate(0.8) as dirt > lowpass(7khz, 0.05) > autopan(0.25, bars=4) > lowpass(18khz, 0.1) as klp > vowel(a, wet=0) as talk > gain(1.0) as kgain > master
}

midi {
    # Faders
    cc 75 > bass level 0..1.2                 # F2 the bass (written 0.6 at half)
    cc 80 > perc level 0..0.9                 # F5 the wood and the peak's pad
    cc 80 > chords level 0..0.3
    cc 83 > acid delay_send 0..80%            # F8 the 303 into the echo

    # The tema page (K1-K9)
    cc 74 > bass cutoff 80hz..1200hz          # K1 the bass: a thud to a knock
    cc 71 > acid resonance 45%..92%           # K2 the 303's bite
    cc 71 > acidh resonance 45%..90%
    cc 76 > acid cutoff 100hz..2200hz         # K3 the 303 opening: under the sub to wide open
    cc 76 > acid cutoff_env 300hz..3500hz
    cc 76 > acidh cutoff 120hz..2500hz
    cc 77 > perc snare_pitch 1.2x..1.62x..2x  # K4 the wood (and the pad's filter)
    cc 77 > chords cutoff 400hz..3khz
    cc 93 > master hp cutoff 20hz..300hz      # K5 tension: the floor thins, the 303 into the room
    cc 93 > acid reverb_send 8%..50%
    cc 18 > perc delay_send 0..70%            # K6 the throw: the wood and the pad into the echo
    cc 18 > chords delay_send 0..80%
    cc 19 > drums kick_decay 40%..64%..85%    # K7 the kick's body
    cc 16 > drums hihat_pitch 0.8x..1.08x..1.6x   # K8 the hats: darker, or brighter
    cc 17 > acid dirt drive 0.2..2.5          # K9 dirt: the 303 and the bass
    cc 17 > bass drv drive 0.2..1.6

    # ── This tema's pages, after `master`: Tab passes over them while they rest ──
    # The 303: K3 here is its envelope, not its cutoff (the steps' `auto` owns that,
    # and the tema page's K3 takes it over by hand)
    page acid {
        cc 74 > acid lp cutoff 1200hz..7khz           # K1 the 303's top: muffled to as written
        cc 71 > acid resonance 45%..92%               # K2 the 303's resonance: the squelch
        cc 76 > acid cutoff_env 300hz..3500hz         # K3 the 303's env mod: how far each note opens
        cc 77 > acid decay 80ms..600ms                # K4 the 303's decay: a blip to a wah
        cc 93 > acid dirt drive 0.2..2.5              # K5 tension: the 303's drive
        cc 18 > acid vel_env 20%..90%                 # K6 the accent: loud notes open further
        cc 19 > acid glide 4%..40%                    # K7 the slides: slow to snapped
        cc 16 > acid sustain 0%..50%                  # K8 sustain: plucked to held
        cc 17 > acid keytrack 0%..45%                 # K9 the filter following the notes up
        # The faders: the 303's strip
        cc 73 > acid level 0..1                       # F1 the 303 (0.32 at the peak, 1.0 alone in hueco)
        cc 75 > acid delay_send 0..80%                # F2 its echo
        cc 79 > acid reverb_send 0..50%               # F3 its room
        cc 72 > acid pan -0.7..0.7                    # F4 where it sits
    }
    # The peak's pad (estallido): Cm11 breathing over sixteen bars
    page pad {
        cc 74 > chords cutoff 400hz..3khz             # K1 the pad's brightness
        cc 71 > chords resonance 5%..55%              # K2 the pad's resonance
        cc 76 > chords lfo_depth 0%..50%              # K3 the filter's breathing
        cc 77 > chords attack 200ms..2s               # K4 envelope: the swell in
        cc 77 > chords release 400ms..2s              #    and the tail out
        cc 93 > chords detune 5%..40%                 # K5 tension: the voices apart
        cc 18 > chords chorus_mix 0%..60%             # K6 its chorus
        cc 19 > chords vibrato_depth 0%..12%          # K7 its vibrato
        cc 16 > chords sustain 40%..100%              # K8 sustain
        cc 17 > chords ph wet 0%..100%                # K9 the phaser in and out
        # The faders: the pad's strip
        cc 73 > chords level 0..0.24                  # F1 the pad (0.12 at the peak, half way)
        cc 75 > chords delay_send 0..50%              # F2 its echo
        cc 79 > chords reverb_send 0..90%             # F3 its room
        cc 72 > chords pan -0.7..0.7                  # F4 where it sits
    }
    # The wood: the rim on the "and" of two and four, the low tom
    page perc {
        cc 74 > perc lp cutoff 1500hz..7khz           # K1 the wood's top
        cc 71 > perc snare_pitch 1.2x..2x             # K2 the rim's pitch: a log to a stick
        cc 76 > perc snare_pan -0.6..0.6              # K3 the rim across
        cc 77 > perc snare_snap 5%..60%               # K4 the rim's crack
        cc 93 > perc snare_drive 0%..50%              # K5 tension: the rim's grit
        cc 18 > perc delay_send 0..60%                # K6 the throw: the wood into the echo
        cc 19 > perc tom_pan -0.6..0.6                # K7 the tom across
        cc 16 > perc snare_level 0..1.1               # K8 the rim against the tom
        cc 17 > perc hp cutoff 80hz..600hz            # K9 the tom thinned away
        # The faders: the wood's strip
        cc 73 > perc level 0..0.9                     # F1 the wood (0.45 at half)
        cc 75 > perc delay_send 0..60%                # F2 its echo
        cc 79 > perc reverb_send 0..50%               # F3 its room
        cc 72 > perc pan -0.7..0.7                    # F4 where it sits
    }

    key 46 > toggle perc                      # A# the wood in and out
    key 47 > throw acid q=1/16                # B  the 303 into the echo

    # Pads, bank B
    pad 44 > play acidh C2 q=1/16             # B1 the 303 held on the root (K3 opens it)
    pad 45 > hold afig q=beat                 # B2 a bar of the open riff
    pad 46 > drums crash q=beat               # B3 crash
    pad 47 > hold tomfill q=beat              # B4 the toms falling
    pad 48 > play acidh Db2 q=1/16            # B5 the 303 held on the flat second
    pad 49 > hold cstab q=beat                # B6 the peak's chord, struck into the echo
    pad 50 > repeat 1/16                      # B7 a sixteenth roll
    pad 51 > drums openhat q=1/16             # B8 an open hat
}
