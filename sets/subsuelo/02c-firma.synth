# set: bars=32 max=2 phase=02-rhodes energy=5
# set-note: The Rhodes line arrives: a few low notes with room between them, the echo answering a beat later, twelve bars of each phrase; the comping thins to one chord a bar to leave it the air.
# cue: 9 K3 despacio a la derecha: el tine del Rhodes empieza a ladrar
# cue: 15 tecla B (47): la última nota de la línea al eco
use "_t02.synth"

track drums  { play r_main, r_main, r_main, r_main, r_main, r_main, r_main, r_main_turn }
track shaker { play s_main }
track bongo  { level 0.22 }
track chords { play cp_thin level 0.3 }
track rhodes { play rl_a, rl_b, rl_a, rl_rest level 0.26 }
