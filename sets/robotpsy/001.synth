# set: bars=8 phase=pulse energy=3
# set-note: The pulse arrives from below — sub_hold in at 0.14 and drums stepping up to beat_min, while noise_swell drops out to zero to keep the count at six.

use "../../examples/rigs/robot_psy_rig.synth"

track roll  { play roll_main using roll_osc level 0.0 gate 0.3 sidechain 0.8 out > highpass(44hz, 0.02) as hp > saturate(0.7) as grind > eq(low=-1.5, mid=-0.5, high=-2.0) as tone > lowpass(2.6khz, 0.02, wet=0.0) as lp > master }

track seq   { play seq_a using seq_osc level 0.12 pan 0.18 gate 0.45 sidechain 0.55 delay_send 0.3 reverb_send 0.12 out > highpass(260, 0.02) as hp > bitcrush(9, wet=0.0) as crush > autopan(0.35, bars=4, wet=0.0) as pan > master }

track voc   { play voc_a using voc_keys level 0.10 pan 0.35 sidechain 0.5 delay_send 0.2 reverb_send 0.3 out > highpass(280, 0.02) as hp > vowel(a, o, bars=8, wet=0.0) as vox > autopan(0.3, bars=6, wet=0.0) as pan > master }

track bleep { play bleep_a using bleep_fm level 0.08 pan -0.5 gate 0.12 sidechain 0.5 delay_send 0.45 reverb_send 0.2 out > highpass(900, 0.02) as hp > autopan(0.6, bars=3, wet=0.0) as pan > master }

track pad   { play pad_low using pad_keys level 0.12 pan -0.45 sidechain 0.5 reverb_send 0.35 delay_send 0.08 out > highpass(160hz, 0.02) as hp > eq(low=0.5, mid=-3.5, high=0.5) as tone > vowel(o, u, bars=16, wet=1.0) as vox > master }
