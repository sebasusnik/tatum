# Arp Keys — canonical arpeggiator example.
#
# Mirrors core/tests/arp_demo.rs::test_arp_keys_solo: a single Keys voice,
# no drums/bass, playing a held Cm7 chord that the track arpeggiator cycles
# through up/down across two octaves. Delay and reverb sends add space.
#
# Note on octaves: arp_demo.rs calls arp.set_octave_range(0.66) and comments
# "// 3 octaves", but ArpProcessor::set_octave_range does
# `1 + (value * 3.0) as u8` with truncating (not rounding) integer
# conversion, so 0.66 -> 1 + (1.98 as u8 == 1) -> octave_range 2, not 3.
# `octaves=2` below reproduces the demo's actual behavior, not its comment.
tempo 125
scale C minor

module keys pad {
    cutoff 3169.8hz
    resonance 8%
    chorus_mix 0.0          # the arp lifts this chord an octave (octaves=2)
                             # and plays it one note at a time, so the top
                             # note reaches A#4 -> 932 Hz once lifted. A
                             # chorus's ~3.8% detune beats there at 35 Hz,
                             # which is roughness, not width, and there is
                             # no chord sounding underneath to bury it.
                             # autopan on the track carries the width instead.
    attack 1.07897ms
    decay 4.57305ms
    sustain 0.4
    release 3.1272ms
}

# C minor 7 (degrees 1 3 5 7 = C Eb G Bb), held for the whole bar via ties.
# The arp reads whatever the pattern holds, so one chord + 15 ties is enough
# to keep it running continuously for as many bars as the arrangement plays.
pattern cm7_hold {
    [1.4 3.4 5.4 7.4]:1.0  ..  ..  ..  ..  ..  ..  ..
    ..  ..  ..  ..  ..  ..  ..  ..
}

track keys {
    play cm7_hold using pad
    level 0.55               # was 0.85: removing chorus_mix let the raw
                              # (uncancelled) peaks through, so the level came
                              # down to put the same ~0.45 peak into master
                              # that the old chorused version had (measured:
                              # 0.45 in -> 0.66 out, same as before the fix)
    arp updown rate=16 gate=0.5 octaves=2
    delay_send 0.25  reverb_send 0.30
    out > autopan(0.75, bars=2) > master
    # depth 0.75 over a 2-bar cycle (4 cycles across the 8-bar render):
    # depth is what drives the width here, not the cycle length -- measured
    # width above 300 Hz at depth 0.45 stayed ~9% whether the cycle was 1, 2
    # or 8 bars, and only came back up to the pre-chorus ~18% by raising
    # depth to 0.75. bars=2 keeps the movement audible rather than one slow
    # sweep across the whole clip.
}

master { in > eq(low=1.5, mid=-1.0, high=0.5) > compressor(-10, ratio=2, makeup=4db) > out }

scene main {
    track keys { play cm7_hold using pad }
}

# 8 bars, same as arp_demo.rs's 8-bar render.
arrange { main x8 }
