# Jungle '93 -- F minor, 165 BPM.
#
# The break carries the song. It is written out, not generated: four-bar
# phrases of an amen-style chop where the ghost snares between the backbeats
# are what makes it roll, and the fourth bar of each phrase turns it round.
# A second, lighter kit plays sixteenth hats on top, the way two breaks were
# layered on the sampler. Under it a sub that slides, and the synths of the
# year: a string pad, a rave stab, the hoover, a dub siren and, later, the reese.

tempo 165
meter 4/4
scale F minor
swing 0.53
humanize 0.10
sidechain 0.20 attack=1ms release=90ms

delay sync=dotted_eighth feedback=0.42 filter=0.45
reverb size=0.62 damp=0.5 predelay=18 sidechain=0.3
# The kick's share of the reverb is only mud under the sub.
reverb_return { in > highpass(250hz, 0.05) > out }

# The break sits back: the snare a hair behind the grid, the ride pushed
# into the swing. Nudges are a fraction of a sixteenth.
groove chop {
    snare nudge 0.03
    hat swing 0.56 nudge 0.01
}

# ── Modules ─────────────────────────────────────

# The main break: a short thumping kick, a snare with its body at 175-225 Hz
# and the crack under 4 kHz, the amen's "pap" rather than a hiss,
# the hat left ringing to stand in for the ride.
module beats amen {
    kick_level 1.0
    kick_decay 0.30
    kick_pitch 1.08x
    kick_click 0.45
    kick_drive 0.35
    snare_level 0.85
    snare_decay 0.36
    snare_pitch 1.0x
    snare_snap 0.55
    snare_drive 0.45
    snare_pan -0.05
    hihat_level 0.45
    hihat_decay 0.55
    hihat_pitch 1.2x
    hihat_pan 0.2
    crash_pan -0.25
}

# The second break: only its hats, tight and bright, on the other side.
module beats tops {
    hihat_level 0.55
    hihat_decay 0.18
    hihat_pitch 1.45x
    hihat_pan -0.3
    snare_level 0.5
    snare_pitch 1.6x
    snare_decay 0.10
    snare_snap 0.9
    snare_pan 0.3
}

# Sub: three saws closed right down, so what is left is the fundamental and
# a little of the second harmonic to find it on small speakers. Glides.
module bass sub {
    cutoff 115hz
    cutoff_env 60hz
    resonance 0.05
    glide 0.22
    attack 2ms
    decay 400ms
    sustain 0.9
    release 90ms
}

# Reese: two saws a sixth of a semitone apart beating against each other,
# an octave-down third one for the weight, a slow filter breathing on it.
module bass reese {
    osc2_pitch 0.16st
    osc3_pitch -12st
    cutoff 620hz
    cutoff_env 380hz
    resonance 0.22
    glide 0.12
    attack 3ms
    decay 500ms
    sustain 0.85
    release 120ms
    lfo_target cutoff
    lfo_sync bars_2
    lfo_waveform triangle
    lfo_depth 0.12
}

# Hoover: two of them, one a side, each three saws with an octave-down one
# and its own slow detune, gliding. No chorus: a chorus on saws wobbles every
# harmonic and reads as grain, where two voices beating slowly against each
# other read as breath. The envelope filter is on the hoover's bus, so one
# follower hears all four layers: the Q-Balls move, the resonance jumping on
# each attack and swinging back once a beat, like a bent sheet. Held in: 350
# Hz to under 2 kHz, so it colours the hoover instead of sweeping the mix.
module bass hoover_l {
    osc2_pitch -12st
    osc3_pitch 0.11st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

module bass hoover_r {
    osc2_pitch -12.07st
    osc3_pitch -0.09st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}
# The pulse layers: two squares a fifth of a semitone apart beat like a pulse
# width that moves, the hoover's PWM, one with a saw an octave down and one
# with a saw an octave up. They glide with the saws, so the dives stay whole.
module bass hoover_pl {
    osc1_wave square
    osc2_wave square
    osc3_wave saw
    osc2_pitch 0.23st
    osc3_pitch -12.15st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

module bass hoover_pr {
    osc1_wave square
    osc2_wave square
    osc3_wave saw
    osc2_pitch -0.21st
    osc3_pitch 12.1st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}


# Rave stab: a minor chord that is all attack.
module keys stab {
    voice_mode poly
    attack 1ms
    decay 230ms
    sustain 0
    release 180ms
    detune 0.22
    cutoff 2.6khz
    resonance 0.18
    chorus_mix 0.25
}

# Strings: slow in, slow out, the filter drifting over eight bars.
module keys strings {
    voice_mode poly
    attack 900ms
    decay 1.5s
    sustain 0.8
    release 1.6s
    detune 0.35
    chorus_mix 0.55
    cutoff 1.3khz
    resonance 0.28
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 0.10
    vibrato_rate 0.5hz
    vibrato_depth 0.05
}

# Dub siren: a sine swept up and down a fifth by a triangle.
module fm siren {
    algorithm two_op
    mod_index 0.2
    feedback 0.1
    attack 20ms
    sustain 1.0
    release 900ms
    lfo_target pitch
    lfo_waveform triangle
    lfo_rate 1.6hz
    lfo_depth 0.29
    level 1.6
}

# ── Drums ───────────────────────────────────────
# Every lane is four bars. Bars are split by `|` only in these comments.

# The main roll. Bar 4 pulls the kick forward and doubles the last ghosts.
pattern roll {
    kick:  X - X -  - - - -  - - X x:0.7  - - - -   X - - -  - - - -  - - X -  - - - -   X - X -  - - - -  - - X x:0.7  - - - -   - - X X  - - - -  - - X -  - - x:0.6 -
    snare: - - - -  X - - o  - o - -  X - - o   - o - -  X - - o  - o - -  X - - o   - - - -  X - - o  - o - -  X - - o   - o - -  X - - o  - o - o  X - o x
    hat:   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 -   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 -   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 -   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 x:0.5
}

# The two-step: kick on one and the and-of-three, the snare answering off
# the beat. Bar 4 is a chop: the snare pushes into the next phrase.
pattern step {
    kick:  X - - -  - - - -  - - X -  - - - -   - - X -  - - - -  - - X -  - - - x:0.6   X - - -  - - - -  - - X -  - - - -   - - X -  - - - -  X - - -  - - - -
    snare: - - - -  X - - o  - o - -  X - - o   - o - -  X - - o  - - o -  X - o -   - - - -  X - - o  - o - -  X - - o   - o - -  X - o -  - o X -  o x:0.6 X o
    hat:   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 -   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 -   x - x:0.6 -  x - x:0.6 -  x - x:0.6 -  x - x:0.6 -   x - x:0.6 -  x - x:0.6 -  x - - -  - - - -
}

# The darker chop for the second drop: kicks off the grid, snares doubled
# and moved, less ride and more space.
pattern chop {
    kick:  X - - x:0.7  - - X -  - - X -  - - - -   X - X -  - - - -  - x:0.7 - -  - - X -   X - - x:0.7  - - X -  - - X -  - - - -   - - X -  - - X -  - - - -  X - - -
    snare: - - o -  X - - o  - o - o  X - - -   - o - -  X - o -  X - - o  - X - o   - - o -  X - - o  - o - o  X - - -   - o - o  X - - o  - - X -  o X o x:0.7
    hat:   x - - -  x - x:0.5 -  x - - -  x - x:0.5 -   x - - -  x - x:0.5 -  x - - -  x - x:0.5 -   x - - -  x - x:0.5 -  x - - -  x - x:0.5 -   x - - -  x - x:0.5 -  - - - -  - - - -
}

# Half time: the breakdown's pulse, and the switch in the middle of drop 2.
pattern half {
    kick:  X - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - X -  - - - -   X - - -  - - - -  - - - -  - - - -   - - - -  - - - -  - - X -  - - - -
    snare: - - - -  - - - -  X - - -  - - - o   - - - -  - - - -  X - - -  - - - -   - - - -  - - - -  X - - -  - - - o   - - - -  - - - -  X - - -  - o - o
    hat:   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -
}

# Ride alone, for the intro and under the strings.
pattern ride {
    hat:   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -   x - x:0.5 -  x - x:0.5 -  x - x:0.5 -  x - x:0.5 -
}

# One bar into each drop: sixteenths climbing to the accent. Written out,
# not ratcheted: a roll of identical retriggers is a machine gun, not a drummer.
pattern fill {
    kick:  X - - -  - - - -  X - - -  - - - -
    snare: - - o -  X - o o  x:0.5 o x:0.6 o  x:0.65 x:0.72 x:0.8 X
    hat:   x - x -  - - - -  - - - -  - - - -
    crash: - - - -  - - - -  - - - -  - - - -
}

# The crash marks where a drop lands, once. The kit's cymbal is a 909 one
# with a tail of nearly four seconds and no knob to shorten it. It stays out
# of the sampler bus, where the drive and the crusher turned it into a broken
# hiss, and above 2.2 kHz, where its square-wave partials are gone and what
# is left is air.
pattern crash_once {
    crash: X -*15  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16  -*16
}

# The second break's hats: sixteenths with the accents off the beat.
pattern tops16 {
    hat:   o x:0.55 o x:0.4  o x:0.55 o x:0.45  o x:0.55 o x:0.4  o x:0.55 o x:0.5   o x:0.55 o x:0.4  o x:0.55 o x:0.45  o x:0.55 o x:0.4  o x:0.55 x:0.6 o
    snare: -*16  - - - -  - - - -  - - - -  - - - o
}

# ── Bass ────────────────────────────────────────

# Four bars. The sub holds and slides; the gaps are where the kick is heard.
pattern sub_line {
    F1:0.95 ..*9  - -  F1:0.7 ..  Ab1:0.8 ..
    ~F1:0.9 ..*7  - -  - -  Eb2:0.8 .. .. ..
    Db2:0.95 ..*9  - -  Db2:0.7 ..  C2:0.8 ..
    ~Bb1:0.9 ..*5  - -  C2:0.85 ..  ~Db2 ..  ~C2 .. .. ..
}

# The breakdown: one root, let go.
pattern sub_hold {
    F1:0.85 ..*31
    Db2:0.85 ..*15  C2:0.8 ..*15
}

# Drop 2: the same four bars, the reese on top pushing on the offbeats.
pattern reese_line {
    F2:0.95 ..*5  - -  F2:0.8 .. ~Ab2 ..  - -  F2:0.8 -
    ~Eb2:0.9 ..*7  - -  F2:0.75 -  - -  Eb2:0.8 ..
    Db2:0.95 ..*5  - -  Db2:0.8 .. ~F2 ..  - -  Db2:0.8 -
    ~C2:0.9 ..*5  - -  C2:0.8 -  ~Db2 ..  ~C2 ..  Bb1:0.8 ..
}

# The switch: the reese alone on the root, bending.
pattern reese_switch {
    F2:0.95 ..*11  ~Gb2 .. ~F2 ..
    ..*8  - -  F2:0.7 -  ~Eb2 .. .. ..
}

# ── Synths ──────────────────────────────────────

# The hoover calls once at the top of a drop, two bars, then it is gone.
# Every struck note dives in from an octave up, the hoover's signature, and
# the rhythm is what the envelope filter bends to.
pattern hoover_once {
    <F4:1.0 ~F3> .. .. ..  F3:0.8 .. ~E3 ..  ~F3 .. .. ..  <C4:0.9 ~C3> .. ~Db3 ..
    .. .. .. <Db4:0.85 ~Db3>  .. ~C3 .. ..  .. .. C3:0.75 ..  .. .. .. ..
    -*32  -*32  -*32  -*32  -*32  -*32  -*32
}



pattern stabs {
    - - - -  - - Fm/4:0.9 -  - - - -  Fm/4:0.7 - - -
    - - Fm/4:0.8 -  - - - -  - - Dbmaj7/4:0.85 -  - - - -
    - - - -  - - Fm/4:0.9 -  - - - -  Fm/4:0.7 - - -
    - - Fm/4:0.8 -  - - - -  - - Ebmaj7/4:0.85 -  - - Cm7/4:0.7 -
}

# Four bars, following the sub: two on the root, then Db and Bb.
pattern chords {
    Fm9:0.6 ..*31
    Dbmaj9:0.6 ..*15
    Bbm9:0.6 ..*15
}

pattern siren_call {
    C5:0.9 ..*31
    -*32
}

# The switch hears it once, at its top.
pattern siren_once {
    C5:0.9 ..*31
    -*32
    -*32
    -*32
}

pattern rest { -*16 }

# ── Tracks ──────────────────────────────────────

bus kit
# The kit through a sampler of the year: squashed, driven, ten bits at a
# lowered rate, and nothing left above 9 kHz. It is what hides that these
# drums are synthesised, and what the breaks of '93 sounded like.
kit { in > compressor(-18, ratio=5, attack=2, release=40, makeup=4db)
        > saturate(0.8) > bitcrush(10, 0.03) > lowpass(9khz, 0.08)
        > highpass(45hz, 0.05) > master }

track brk {
    play ride
    using amen
    level 1.0
    reverb_send 0.05
    sidechain 0
    out > highpass(35hz, 0.05) > kit
}

track tops {
    play rest
    using tops
    level 1.8
    reverb_send 0.06
    sidechain 0
    out > highpass(2.5khz, 0.05) > kit
}

track crash {
    play rest
    using amen
    level 0.22
    reverb_send 0.12
    sidechain 0
    out > highpass(2.2khz, 0.05) > lowpass(9khz, 0.05) > master
}


track sub {
    play rest
    using sub
    level 0.5
    gate 0.95
    sidechain 0.3
    out > lowpass(160hz, 0.05) > master
}

track reese {
    play rest
    using reese
    level 0.42
    gate 0.95
    sidechain 0.25
    delay_send 0.04
    out > saturate(0.45) > highpass(140hz, 0.05) > lowpass(3.5khz, 0.05) > master
}

bus hoover
hoover { in > autowah(0.03, base=350hz, range=1500hz, peak=0.7, attack=6, release=300, wobble=300, wobble_hz=2.75, lowpass, wet=0.85)
           > highpass(200hz, 0.05) > lowpass(5khz, 0.05) > master }

track hoover_l {
    play rest
    using hoover_l
    level 0.34
    pan -0.6
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover
}

track hoover_r {
    play rest
    using hoover_r
    level 0.34
    pan 0.6
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover
}

track hoover_pl {
    play rest
    using hoover_pl
    level 0.26
    pan -0.25
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover
}

track hoover_pr {
    play rest
    using hoover_pr
    level 0.22
    pan 0.25
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover
}

track stab {
    play rest
    using stab
    level 0.6
    pan 0.25
    delay_send 0.32
    reverb_send 0.18
    out > highpass(300hz, 0.05) > saturate(0.3) > master
}

track pad {
    play rest
    using strings
    level 0.32
    reverb_send 0.3
    sidechain 0.35
    out > highpass(260hz, 0.05) > phaser(0.3, bars=8) > autopan(0.35, bars=8) > master
}

track siren {
    play rest
    using siren
    level 0.08
    pan -0.3
    delay_send 0.5
    reverb_send 0.35
    out > highpass(400hz, 0.05) > master
}

master {
    in > compressor(-10, ratio=2.5, attack=10, release=80, makeup=2db)
       > eq(low=1.5, mid=0, high=1.0)
       > lowpass(20000, 0.05)
       > out
}

# ── Scenes ──────────────────────────────────────

# The strings and the ride, filtered, opening up.
scene intro {
    auto master cutoff 900 > 6000
    track pad  { play chords using strings }
    track brk  { play ride using amen }
}

# The break comes in behind the filter; the sub arrives halfway.
scene intro_break {
    auto master cutoff 1500 > 18000
    track pad  { play chords using strings }
    track brk  { play roll using amen }
    track tops { play tops16 using tops }
}

scene intro_sub {
    track pad  { play chords using strings }
    track brk  { play roll using amen }
    track tops { play tops16 using tops }
    track sub  { play sub_line using sub }
}

scene roll_in {
    track brk  { play fill using amen }
    track sub  { play rest using sub }
}

# Drop 1: the full break, the sub and the stabs; the crash and the hoover
# where it lands.
scene drop1 {
    track brk    { play roll using amen }
    track tops   { play tops16 using tops }
    track crash  { play crash_once using amen }
    track sub    { play sub_line using sub }
    track stab   { play stabs using stab pan 0.25 }
    track hoover_l  { play hoover_once using hoover_l pan -0.6 }
    track hoover_r  { play hoover_once using hoover_r pan 0.6 }
    track hoover_pl { play hoover_once using hoover_pl pan -0.25 }
    track hoover_pr { play hoover_once using hoover_pr pan 0.25 }
}

scene drop1_step {
    track brk   { play step using amen }
    track tops  { play tops16 using tops }
    track crash { play crash_once using amen }
    track sub   { play sub_line using sub }
    track stab  { play stabs using stab pan 0.25 }
    track pad   { play chords using strings level 0.22 }
}

# Breakdown: half time, the strings, and the siren once.
scene breakdown_siren {
    track brk   { play half using amen }
    track sub   { play sub_hold using sub }
    track pad   { play chords using strings }
    track siren { play siren_call using siren pan -0.3 }
}

scene breakdown {
    track brk { play half using amen }
    track sub { play sub_hold using sub }
    track pad { play chords using strings }
}

# The break comes back behind the filter under the strings.
scene build {
    auto master cutoff 1200 > 18000
    track brk  { play roll using amen }
    track tops { play tops16 using tops }
    track pad  { play chords using strings }
}

# Drop 2: the reese under the chopped break, the hoover once more.
scene drop2 {
    track brk    { play chop using amen }
    track tops   { play tops16 using tops }
    track crash  { play crash_once using amen }
    track sub    { play sub_line using sub }
    track reese  { play reese_line using reese }
    track stab   { play stabs using stab pan 0.25 }
    track hoover_l  { play hoover_once using hoover_l pan -0.6 }
    track hoover_r  { play hoover_once using hoover_r pan 0.6 }
    track hoover_pl { play hoover_once using hoover_pl pan -0.25 }
    track hoover_pr { play hoover_once using hoover_pr pan 0.25 }
}

# The switch: half time, the reese bending on its own.
scene switch {
    track brk   { play half using amen }
    track sub   { play sub_hold using sub }
    track reese { play reese_switch using reese }
    track siren { play siren_once using siren pan -0.3 }
}

scene drop2_peak {
    track brk   { play step using amen }
    track tops  { play tops16 using tops }
    track crash { play crash_once using amen }
    track sub   { play sub_line using sub }
    track reese { play reese_line using reese }
    track stab  { play stabs using stab pan 0.25 }
    track pad   { play chords using strings level 0.22 }
}

# Out the way it came in: the strings, the roll, the filter closing.
scene outro {
    auto master cutoff 18000 > 1500
    track brk  { play roll using amen }
    track tops { play tops16 using tops }
    track sub  { play sub_line using sub }
    track pad  { play chords using strings }
}

scene tail {
    auto master cutoff 1500 > 500
    track brk { play ride using amen }
    track pad { play chords using strings }
}

arrange {
    intro x8
    intro_break x8
    intro_sub x7
    roll_in x1
    drop1 x16
    drop1_step x15
    roll_in x1
    breakdown_siren x4
    breakdown x12
    build x7
    roll_in x1
    drop2 x16
    switch x8
    drop2_peak x16
    outro x8
    tail x8
}
