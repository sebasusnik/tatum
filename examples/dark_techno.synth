# Dark Techno — F minor, 132 BPM, robotic
# Few elements, each one exact. A dry kick with no room at all; an FM bass
# that rolls the three sixteenths after every kick; a machine that bleeps a
# sixteen-step code; a metal knock on a five-step cycle sliding against it;
# and, only at the peak, a robot voice made of formants. No melody, no pad.
# Nothing breathes that should not: no reverb on the kick, a short and light
# sidechain, and the reverb tails are never ducked, so nothing comes and goes.
tempo 132
meter 4/4
scale F minor
swing 0.5
humanize 0.0 timing 0.0
sidechain 0.25 attack=1ms release=60ms

delay sync=eighth feedback=0.3 filter=0.4
reverb size=0.35 damp=0.6 predelay=10 sidechain=0

reverb_return { in > highpass(500hz, 0.05) > lowpass(6khz, 0.05) > out }
delay_return  { in > highpass(600hz, 0.05) > lowpass(5khz, 0.05) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# The kick: a long tonal body and no room. The body is the kick's own tail,
# tuned low, about 210 ms to -40 dB; there is no reverb on it, so nothing
# comes and goes. Barely driven: the weight is the tail, not the distortion.
# The rim is the snare cut to a click; the hats are short and bright
module beats machine {
    kick_level 1.0
    kick_decay 55%
    kick_pitch 0.78x
    kick_click 35%
    kick_drive 30%
    hihat_level 0.55
    hihat_decay 10%
    hihat_pitch 1.5x
    hihat_pan 0.15
    clap_level 0.5
    clap_pan 0.0
    snare_level 0.5
    snare_decay 5%
    snare_pitch 1.6x
    snare_snap 30%
    snare_pan -0.2
    stutter_drum hihat
    stutter_rate 0%
}

# Bass: FM, one carrier and one modulator at the same ratio -- a saw-like
# tone whose brightness is the modulator's envelope, so each note is a
# pluck. One oscillator path, so its level never wanders over the song
module fm roller {
    algorithm two_op
    level 2.0
    mod_index 45%
    feedback 10%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.002 0.18 0.3 0.05
    op1_envelope 0.001 0.06 0.1 0.04
}

# Machine: a square-ish FM bleep, hard and short
module fm bleep {
    algorithm two_op
    level 1.6
    mod_index 70%
    feedback 15%
    waveform quarter_sine
    op0_ratio 1x
    op1_ratio 2x
    op0_envelope 0.001 0.06 0.0 0.03
    op1_envelope 0.001 0.04 0.0 0.02
}

# Knock: struck metal, inharmonic, very short
module fm knock {
    algorithm two_op
    level 1.8
    mod_index 75%
    feedback 20%
    waveform sine
    op0_ratio 1x
    op1_ratio 2.76x
    op0_envelope 0.001 0.09 0.0 0.05
    op1_envelope 0.001 0.05 0.0 0.03
}

# Voice: a buzz with the vowel filter racing through its formants, a
# machine trying to speak
module fm buzz {
    algorithm two_op
    level 1.6
    mod_index 60%
    feedback 50%
    waveform sine
    op0_ratio 1x
    op1_ratio 1x
    op0_envelope 0.005 0.15 0.5 0.06
    op1_envelope 0.005 0.15 0.5 0.06
}

# Static: filtered feedback noise, only for the break
module fm static {
    algorithm pair_plus_two
    level 1.0
    mod_index 100%
    feedback 100%
    waveform sine
    op0_ratio 5.3x
    op1_ratio 2.51x
    op2_ratio 7.1x
    op3_ratio 1.43x
    op0_envelope 1.0 1.0 1.0 1.0
    op1_envelope 1.0 1.0 1.0 1.0
    op2_envelope 1.0 1.0 1.0 1.0
    op3_envelope 1.0 1.0 1.0 1.0
    op0_feedback 90%
    lfo_target mod_index
    lfo_sync bars_4
    lfo_waveform triangle
    lfo_depth 25%
}

# ────────────────────────────────────────────────
# DRUMS
# ────────────────────────────────────────────────

pattern beat_intro {
    kick:    X - - -  X - - -  X - - -  X - - -
    hat:     - - x -  - - x -  - - x -  - - x -
}

pattern beat_main {
    kick:    X - - -  X - - -  X - - -  X - - -
    hat:     o o x o  o o x o  o o x o  o o x o
    snare:   - - - -  - - - x  - - - -  - - x -
}

pattern beat_peak {
    kick:    X - - -  X - - -  X - - -  X - - -
    clap:    - - - -  X - - -  - - - -  X - - -
    hat:     o o x o  o o x o  o o x o  o o x o
    openhat: - - x -  - - x -  - - x -  - - x -
    snare:   - - - -  - - - x  - - - -  - - x -
}

pattern beat_break {
    hat:     - - x -  - - x -  - - x -  - - x -
    snare:   - - - -  - - - x  - - - -  - - x -
}

# ────────────────────────────────────────────────
# BASS AND MACHINES
# ────────────────────────────────────────────────

# On the off-beats, out of the kick's body: kick and bass take turns
# instead of sitting on each other. A sixteenth pickup every other bar
pattern roll {
    - - F1:0.9 -   - - F1:0.8 -   - - F1:0.9 -   - - F1:0.8 -
    - - F1:0.9 -   - - F1:0.8 -   - - F1:0.9 -   - - F1:0.8 Ab1:0.6
}

# A sixteen-step code on the tones of F minor
pattern code {
    F4:0.9 - - C5:0.6   - Ab4:0.7 - -   F4:0.9 - Eb5:0.6 -   - C5:0.7 - F4:0.5
}

# Five steps against sixteen: it lands somewhere else every bar
pattern knock_5 {
    C4:0.9 - - F3:0.6 -
}

# The voice: three syllables every eight bars
pattern speak {
    - - - -  - - - -  C3:0.9 C3:0.7 - C3:0.9  - - - -
    -*112
}

pattern static_bed {
    F4:0.6 ..*63
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play beat_main
    using machine
    level 0.8
    velocity 1.0
    out > highpass(28hz, 0.05) > master
}

track bass {
    play roll
    using roller
    level 0.26
    velocity 1.0
    gate 0.7
    sidechain 0.5
    out > highpass(30hz, 0.05) > saturate(0.5) > lowpass(3khz, 0.05) > master
}

track bleep {
    play code
    using bleep
    level 0.5
    velocity 1.0
    gate 0.4
    pan 0.25
    delay_send 0.15
    reverb_send 0.08
    out > highpass(300hz, 0.05) > bitcrush(10, 0.2, wet=0.35) > master
}

track knock {
    play knock_5
    using knock
    level 0.2
    velocity 1.0
    gate 0.3
    pan -0.3
    reverb_send 0.12
    out > highpass(150hz, 0.05) > master
}

track voice {
    play speak
    using buzz
    level 0.55
    velocity 1.0
    gate 0.8
    pan 0.05
    delay_send 0.2
    reverb_send 0.1
    out > highpass(200hz, 0.05) > vowel(o, i, hz=6, mix=1) > saturate(0.8) > master
}

track static {
    play static_bed
    using static
    level 0.1
    velocity 1.0
    reverb_send 0.2
    out > highpass(1500hz, 0.05) > lowpass(5khz, 0.05, lfo_bars=8, lfo_depth=2500) > autopan(0.6, bars=4) > master
}

master {
    in > lowpass(20000, 0.05) > eq(low=1, high=0.5) > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

scene intro {
    track drums { play beat_intro using machine }
}

# The roller enters dark and brightens over sixteen bars
scene bass {
    auto roller mod_index 0.2 > 0.45
    track drums { play beat_main using machine }
    track bass  { play roll using roller }
}

scene machine {
    auto roller mod_index 0.45 > 0.55 > 0.45
    track drums { play beat_main using machine }
    track bass  { play roll using roller }
    track bleep { play code using bleep pan 0.25 }
    track knock { play knock_5 using knock pan -0.3 }
}

# No kick. The roller keeps turning under the static and the code
scene break {
    auto roller mod_index 0.45 > 0.2
    track drums  { play beat_break using machine }
    track bass   { play roll using roller }
    track bleep  { play code using bleep pan 0.25 }
    track static { play static_bed using static }
}

# The kick returns and the hats stutter faster into the peak
scene rebuild {
    auto machine stutter_rate 0.1 > 0.8
    auto roller mod_index 0.2 > 0.55
    track drums { play beat_main using machine }
    track bass  { play roll using roller }
    track bleep { play code using bleep pan 0.25 }
}

scene peak {
    auto machine stutter_rate 0 > 0
    auto roller mod_index 0.55 > 0.65 > 0.55
    track drums { play beat_peak using machine }
    track bass  { play roll using roller }
    track bleep { play code using bleep pan 0.25 }
    track knock { play knock_5 using knock pan -0.3 }
    track voice { play speak using buzz pan 0.05 }
}

scene strip {
    auto roller mod_index 0.55 > 0.3
    track drums { play beat_main using machine }
    track bass  { play roll using roller }
    track knock { play knock_5 using knock pan -0.3 }
}

scene outro {
    track drums { play beat_intro using machine }
    track bass  { play roll using roller level 0.0 }
}

arrange {
    intro x16
    bass x16
    machine x32
    break x16
    rebuild x8
    peak x32
    strip x16
    outro x16
}
