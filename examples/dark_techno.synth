# dark_techno.synth — Dark Techno (Sunn O))) drone x Sven Vaeth groove)
# 132 BPM, E phrygian, 48 bars. Straight sixteenths: swing is a house tell.
# Section map: intro(8) kick_enter(8) groove(8) breakdown(8) drop(12) outro(4)

tempo 132
meter 4/4
scale E phrygian
swing 0.5
sidechain 0.5
# Mix exactly as written: the automatic 1/sqrt(active tracks) compensation was
# making the two-track intro louder than the four-track groove.

reverb size=0.9 damp=0.3 predelay=30 sidechain=0.5
reverb_return { in > lowpass(2200, 0.3, lfo_bars=16, lfo_depth=900) > autopan(0.35, bars=12) > out }
delay sync=dotted_eighth feedback=0.35 filter=0.4

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# Sunn O))) drone: stacked square/saw across three octaves, low cutoff, high
# resonance, a 16-bar filter LFO so it never sits still even when "static".
module bass drone {
    # Sunn O))) lives in the low-mids, not the sub: the cutoff has to be open
    # enough for the square/saw harmonics to reach the distortion stages.
    cutoff 0.42
    cutoff_env 0.0
    resonance 0.7
    osc1_wave square
    osc2_wave saw
    osc2_pitch 0.25
    osc3_wave square
    osc3_pitch 7st   # the fifth of the power chord the patterns ask for
    attack 0.32
    decay 0.4
    sustain 0.95
    release 0.85
    glide 0.1
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_16
    lfo_depth 0.35
}

# The fundamental. Heavy distortion turns a fundamental into a harmonic
# series, so the weight of the wall has to come from a clean layer underneath.
module bass subwall {
    cutoff 0.12
    cutoff_env 0.0
    resonance 0.12
    osc1_wave saw
    osc2_pitch 0.5
    osc3_pitch 0.5
    attack 0.25
    decay 0.5
    sustain 1.0
    release 0.8
}

# Atmosphere: a metallic, slow-blooming FM texture. Sparse and drenched, it
# is what keeps the drone-only stretches from being just a drone.
module fm atmos {
    algorithm two_op
    waveform half_sine
    mod_index 0.55
    feedback 0.42
    op0_ratio 0.065
    op1_ratio 0.29
    op0_envelope 0.35 0.9 0.3 0.95
    op1_envelope 0.2 0.6 0.15 0.8
    level 2.2
    lfo_target mod_index
    lfo_waveform triangle
    lfo_sync bars_12
    lfo_depth 0.28
}

# Doom-organ overtones an octave above the drone: fifth voicing,
# saturated and phased for movement.
module keys doomorgan {
    voice_mode poly
    cutoff 0.44
    resonance 0.45
    detune 0.6          # wide: the two oscillators beat against each other
    chorus_mix 0.25
    attack 0.55
    decay 0.5
    sustain 0.9
    release 0.9
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 0.12
    vibrato_rate 0.2
    vibrato_depth 0.05
}

# Sven Vaeth kit: hard, dry, driven kick.
module beats kit {
    kick_level 1.0
    kick_decay 0.36     # enough body to read under the wall
    kick_pitch 0.3
    kick_click 0.9      # the transient is what makes a kick audible, not more low end
    kick_drive 1.0
    snare_level 0.5
    snare_decay 0.18
    snare_snap 0.55
    snare_pan -0.15
    hihat_level 0.6
    hihat_decay 0.2
    hihat_pitch 0.44
    hihat_pan 0.25
}

# Rolling 16th-note sub bassline that answers the kick.
module bass pulse {
    cutoff 0.34
    cutoff_env 0.62
    resonance 0.5
    glide 0.03
    osc1_wave saw
    osc2_wave square
    osc2_pitch 0.25     # one octave down: the weight
    osc3_wave saw
    osc3_pitch 0.5
    attack 0.0
    decay 0.18
    sustain 0.3
    release 0.14
}

# Tight metallic FM stab, interjecting between kicks in the drop.
module fm stab {
    algorithm two_op
    waveform sine
    mod_index 0.32
    feedback 0.1
    op0_envelope 0.001 0.12 0.0 0.08
    op1_envelope 0.001 0.08 0.0 0.05
}

# ────────────────────────────────────────────────
# PATTERNS
# ────────────────────────────────────────────────

# Drone roots — one per scene, held with ties for the whole section.
#
# These used to read `E5/1`, written in the belief that the parser could not
# take "5" as a power chord. It can: `E5/1` compiles to [E1, B1]. The drone
# is a `bass`, which has one voice, so the chord arrived as two note-ons and
# only the last survived -- the drone has been sitting on B this whole time,
# a fifth above the sub, which plays E. `chord_into_mono_voice` covers `bass`
# now and says so.
#
# The fifth comes from the oscillator instead, which is how a monosynth plays
# a power chord anyway: `osc3_pitch 7st` on the module below.
pattern drone_em8    { E1:0.75   ..*127 }
pattern drone_cm8    { C1:0.75   ..*127 }
pattern drone_edrop12 { G1:0.78   ..*191 }
pattern drone_em4    { E1:0.6    ..*63 }

pattern sub_em8      { E1:0.9  ..*127 }
pattern sub_cm8      { C1:0.9  ..*127 }
pattern sub_edrop12  { G0:0.95 ..*191 }
pattern sub_em4      { E1:0.7  ..*63 }

pattern atmos_a  { B3:0.5 ..*47  - -*15  E4:0.42 ..*47  - -*15 }
pattern atmos_b  { E4:0.45 ..*31 - -*15  G3:0.5 ..*31 - -*15  B3:0.4 ..*15 - -*15 }
pattern atmos_low { G3:0.35 ..*63  - -*63 }

pattern organ_em8    { Em/2:0.5      ..*127 }
pattern organ_cm8    { Cm/2:0.5      ..*127 }
pattern organ_edrop12 { G/2:0.55       ..*191 }
pattern organ_em4    { Em/2:0.35     ..*63 }

# Drums
pattern beat_enter {
    kick: X - - - X - - - X - - - X - - -
    hat:  x:0.4 - x:0.22 -  x:0.35 - x:0.22 -  x:0.4 - x:0.22 -  x:0.35 - x:0.22 x:0.3
}

pattern beat_groove {
    kick:    X - - - X - - - X - - - X - - -
    hat:     x:0.5 - x:0.25 o?0.5  x:0.4 - x:0.28 -  x:0.5 - x:0.25 o?0.5  x:0.4 - x:0.28 x:0.35
    openhat: - - - -  - - - -  - - - -  - - x:0.4 -
    snare:   - - - -  - - - -  - - - -  - - - o:0.3
}

pattern beat_drop {
    kick:    X - - - X - - - X - - - X - - -
    hat:     x:0.4 x?0.4 x:0.22 o?0.5  x:0.32 x?0.4 x:0.22 -  x:0.4 x?0.4 x:0.22 o?0.5  x:0.32 x?0.4 x:0.22 x*2
    openhat: - - - -  - - - -  - - - -  - - x:0.45 -
    snare:   - - - -  - - - o:0.3  - - - -  - - x:0.45 o:0.35
}

# Rolling 16th-note bass, root-heavy with passing tones.
pattern bass_pulse_groove {
    1.2:0.95 - - 1.2:0.6   - - 1.2:0.7 -   1.2:0.95 - - 1.2:0.6   - ~5.1:0.75 - -
}

pattern bass_pulse_drop {
    1.2:1.0 - ~1.2:0.7 -   - 1.2:0.75 - -   1.2:1.0 - ~1.2:0.7 -   ~5.1:0.8 - 1.2:0.65 -
}

# FM stab, answers the kick on the off-beats (the "&" of 2 and the "&" of 4).
pattern stab_answer {
    - - - - - - 1.4:0.75 - - - 7.3:0.6 - - - 1.4:0.7 -
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track bassdrone {
    play drone_em8
    using drone
    velocity 0.9
    level 0.19
    gate 1.0
    reverb_send 0.3
    sidechain 0.8
    out > highpass(95, 0.2)   # the kick owns 50-95 Hz; the clean subwall keeps below
        > saturate(2.2)
        > lowpass(1600, 0.3, lfo_bars=12, lfo_depth=500)
        > saturate(1.0)
        > lowpass(2400, 0.2)   # speaker cab: kills the fizz the last stage adds
        > gain(0.55) > master
}

track subwall {
    play sub_em8
    using subwall
    velocity 0.95
    level 0.14
    gate 1.0
    sidechain 0.75
    out > lowpass(150, 0.1) > saturate(0.5) > master
}

track organ {
    play organ_em8
    using doomorgan
    pan -0.50
    velocity 0.85
    level 0.09238
    gate 1.0
    reverb_send 0.42
    delay_send 0.15
    sidechain 0.8
    out > saturate(1.25)
        > lowpass(2600, 0.25)
        > phaser(0.35, bars=14)
        > lowpass(3400, 0.2)
        > gain(0.42) > master
}

track atmos {
    play atmos_a
    using atmos
    pan 0.34
    velocity 0.8
    level 0.3
    gate 0.9
    reverb_send 0.75
    delay_send 0.35
    sidechain 0.5
    out > highpass(380, 0.2)
        > lowpass(2600, 0.25)
        > phaser(0.3, bars=9) > master
}

track drums {
    play beat_enter
    using kit
    velocity 1.0
    level 0.84
    reverb_send 0.06
    out > compressor(-14, ratio=4, attack=3, release=70, makeup=1.5)
        > saturate(0.55)
        > eq(low=2.5, mid=-1.0, high=0.5)
        > master
}

track bassline {
    play bass_pulse_groove
    using pulse
    velocity 0.9
    level 1.35
    gate 0.4
    sidechain 0.65
    out > saturate(1.3)
        > eq(low=3.5, mid=1.5, high=-0.5)
        > lowpass(3000, 0.2) > master
}

track stab {
    play stab_answer
    using stab
    velocity 0.85
    level 0.55
    gate 0.25
    pan -0.38
    delay_send 0.2
    reverb_send 0.25
    sidechain 0.5
    out > saturate(0.7) > lowpass(2600, 0.25) > master
}

# ────────────────────────────────────────────────
# MASTER
# ────────────────────────────────────────────────

master {
    in > tilt(-0.08)
       > eq(low=1.0, mid=-1.5, high=1.0)
       > compressor(-10, ratio=3.0, attack=15, release=110, makeup=0.874)
       > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# 1. Drone-only intro — nothing else. No drums here, so sidechain is inert
# (synth_check warning); levels are set low on purpose since this must be
# the quietest section in the render.
scene intro {
    track bassdrone { play drone_em8 using drone level 0.19 reverb_send 0.3 sidechain 0.8 }
    track subwall   { play sub_em8 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_em8 using doomorgan level 0.09238 reverb_send 0.42 sidechain 0.8 pan -0.50 }
}

# 2. Kick enters, drone holds.
scene intro_b {
    track bassdrone { play drone_em8 using drone level 0.19 reverb_send 0.3 sidechain 0.8 }
    track subwall   { play sub_em8 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_em8 using doomorgan level 0.09238 reverb_send 0.42 sidechain 0.8 pan -0.50 }
    track atmos { play atmos_a using atmos level 0.3 reverb_send 0.75 delay_send 0.35 sidechain 0.5 pan 0.34 }
}

scene kick_enter {
    track bassdrone { play drone_em8 using drone level 0.19 reverb_send 0.3 sidechain 0.8 }
    track subwall   { play sub_em8 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_em8 using doomorgan level 0.09238 reverb_send 0.42 sidechain 0.8 pan -0.50 }
    track atmos { play atmos_low using atmos level 0.22 reverb_send 0.7 delay_send 0.3 sidechain 0.5 pan 0.34 }
    track drums     { play beat_enter using kit level 0.78 reverb_send 0.06 }
}

# 3. Groove with bass — drone moves to Cm, claps and ghost hats enter.
scene groove {
    track bassdrone { play drone_cm8 using drone level 0.19 reverb_send 0.3 sidechain 0.8 }
    track subwall   { play sub_cm8 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_cm8 using doomorgan level 0.09238 reverb_send 0.42 sidechain 0.8 pan -0.50 }
    track drums     { play beat_groove using kit level 0.95 reverb_send 0.06 }
    track bassline  { play bass_pulse_groove using pulse level 1.15 gate 0.4 sidechain 0.65 }
}

# 4. Breakdown — kick and bassline drop out, drone rises, reverb freezes.
# No drums here either, so sidechain is inert (synth_check warning); levels
# sit below the groove's ducked-but-louder mix so the breakdown reads as a
# dip in energy, not a volume spike, even though the filter is opening up.
scene breakdown {
    reverb_freeze = 1
    auto drone cutoff 0.40 > 0.50
    auto doomorgan cutoff 0.46 > 0.54

    track bassdrone { play drone_em8 using drone level 0.19 reverb_send 0.3 sidechain 0.8 }
    track subwall   { play sub_em8 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_em8 using doomorgan level 0.09238 reverb_send 0.42 sidechain 0.8 pan -0.50 }
    track atmos { play atmos_b using atmos level 0.38 reverb_send 0.8 delay_send 0.4 sidechain 0.5 pan 0.34 }
}

# 5. The drop — everything, master brightens.
scene drop {
    auto drone cutoff 0.50 > 0.42
    auto doomorgan cutoff 0.54 > 0.46
    auto master tilt -0.12 > 0.02

    track bassdrone { play drone_edrop12 using drone level 0.19 reverb_send 0.26 sidechain 0.8 }
    track subwall   { play sub_edrop12 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_edrop12 using doomorgan level 0.09238 reverb_send 0.38 sidechain 0.8 pan -0.50 }
    track drums     { play beat_drop using kit level 0.85 reverb_send 0.06 }
    track bassline  { play bass_pulse_drop using pulse level 1.15 gate 0.4 sidechain 0.7 }
    track atmos { play atmos_low using atmos level 0.24 reverb_send 0.7 delay_send 0.3 sidechain 0.5 pan 0.34 }
    track stab { play stab_answer using stab level 0.62 gate 0.25 delay_send 0.2 reverb_send 0.25 sidechain 0.5 pan -0.38 }
}

# 6. Outro — drone alone, dying. No drums here, so sidechain is inert
# (synth_check warning); starts already below the drop's level and fades to
# near-silence so it lands as the quietest moment alongside the intro.
scene outro {
    auto drone cutoff 0.42 > 0.1
    auto doomorgan cutoff 0.46 > 0.14
    auto subwall level 0.14 > 0.02
    auto bassdrone level 0.19 > 0.03
    auto organ level 0.16 > 0.02

    track bassdrone { play drone_em4 using drone level 0.19 reverb_send 0.3 sidechain 0.8 }
    track subwall   { play sub_em4 using subwall level 0.14 sidechain 0.75 }
    track organ { play organ_em4 using doomorgan level 0.09238 reverb_send 0.42 sidechain 0.8 pan -0.50 }
    track atmos { play atmos_low using atmos level 0.24 reverb_send 0.75 delay_send 0.3 sidechain 0.5 pan 0.34 }
}

# ────────────────────────────────────────────────
# ARRANGEMENT — 48 bars
# ────────────────────────────────────────────────

arrange {
    intro x4
    intro_b x4
    kick_enter x8
    groove x8
    breakdown x8
    drop x12
    outro x4
}
