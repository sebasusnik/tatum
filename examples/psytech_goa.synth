# psytech_goa.synth — Psytech / Hi-Tech Goa (1000ug school)
# 148 BPM, E phrygian, 68 bars. Dry, percussive, hypnotic: groove and texture,
# not melody. The rolling bass never lands on the downbeat — the kick owns it.
# Section map: intro(8) build1(8) drop1(12) bridge(6) breakdown(8) build2(6)
#              drop2(14) outro(6)

tempo 148
meter 4/4
scale E phrygian
swing 0.5
sidechain 0.6 attack=1ms release=70ms
humanize 0.03 timing 0.006
# Levels exactly as written: automatic 1/sqrt(active tracks) compensation makes
# the thin intro as loud as the full drop, which destroys the arrangement shape.
gain_comp 0

# Hi-tech ambience is short and dark: a long tail smears the 16ths.
reverb size=0.42 damp=0.65 predelay=12 sidechain=0.6
reverb_return { in > highpass(340, 0.02) > lowpass(3200, 0.02, lfo_bars=12, lfo_depth=900) > autopan(0.35, bars=8) > out }
delay sync=sixteenth feedback=0.3 filter=0.55
delay_return  { in > highpass(420, 0.02) > lowpass(7khz, 0.02) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# Kick: short, clicky, driven. Decay is the only lever on the pitch-drop
# length in the beats module, so it is set tight rather than 909-long.
module beats kit {
    kick_level 1.0
    kick_decay 0.30
    kick_pitch 0.47
    kick_click 0.82
    kick_drive 0.85
    kick_pan 0.0

    snare_level 0.45
    snare_decay 0.10
    snare_pitch 0.42
    snare_snap 0.72
    snare_drive 0.45
    snare_pan -0.22

    hihat_level 0.92
    hihat_decay 0.24
    hihat_pitch 0.74
    hihat_pan 0.3

    clap_level 0.7
    clap_pan 0.12
    tom_pan -0.35
    crash_pan 0.3
}

# The rolling bass. Tight envelope, low cutoff, square sub-octave underneath
# osc1 so the saturation has a fundamental to chew on.
module bass roll {
    cutoff 290hz
    cutoff_env 0.44
    resonance 52%
    glide 0.02
    keytrack 0.4
    osc1_wave saw
    osc2_wave square
    osc2_pitch -12st
    osc3_wave saw
    osc3_pitch 0st
    attack 1ms
    decay 70ms
    sustain 0.22
    release 25ms
}

# Clean sub under the distorted roll: distortion trades the fundamental for
# harmonics, so the weight has to come from a layer that is never driven.
module bass sub {
    cutoff 120hz
    cutoff_env 0.05
    resonance 8%
    osc1_wave saw
    osc2_pitch 0st
    osc3_pitch 0st
    attack 2ms
    decay 130ms
    sustain 0.85
    release 45ms
}

# Acid: high resonance, deep envelope, slow synced filter LFO so it moves even
# between the per-scene cutoff sweeps.
module bass squelch {
    cutoff 600hz      # la automatizacion lo barre 120hz..3.2khz
    cutoff_env 0.66
    resonance 87%
    glide 0.07
    keytrack 0.55
    vel_env 0.55
    osc1_wave saw
    osc2_wave saw
    osc2_pitch 0.3st
    attack 1ms
    decay 90ms
    sustain 0.18
    release 30ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_2
    lfo_depth 0.22
}

# Metallic FM clank: high mod index, inharmonic ratios, envelopes in the tens
# of milliseconds. This is the percussion that is not in the drum kit.
module fm clank {
    algorithm pair_plus_two
    mod_index 0.9
    feedback 0.55
    waveform abs_sine
    op0_ratio 0.41
    op1_ratio 0.13
    op2_ratio 0.27
    op3_ratio 0.08
    op0_envelope 0.001 0.07 0.0 0.09
    op1_envelope 0.001 0.11 0.0 0.13
    op2_envelope 0.001 0.05 0.0 0.07
    op3_envelope 0.001 0.09 0.0 0.10
    op0_feedback 0.6
    op2_feedback 0.65
    chorus_mix 0.0
}

# Glitch zaps: near-instant envelopes, sample-and-hold LFO on pitch so no two
# hits are the same chirp.
module fm zap {
    algorithm dual_pairs
    mod_index 0.95
    feedback 0.65
    waveform sine
    op0_ratio 0.33
    op1_ratio 0.1
    op0_envelope 0.001 0.03 0.0 0.02
    op1_envelope 0.001 0.04 0.0 0.03
    lfo_target pitch
    lfo_waveform sample_hold
    lfo_sync sixteenth
    lfo_depth 0.2
}

# The dark layer. Not a pad: a detuned, low-passed cluster with an 8-bar filter
# LFO and slow vibrato, so it drifts rather than sits.
module keys murk {
    voice_mode poly
    detune 0.42
    chorus_mix 0.18
    cutoff 500hz      # la automatizacion lo barre 240hz..1.1khz
    resonance 8%
    attack 1.0
    decay 0.8
    sustain 0.6
    release 0.9
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 0.2
    vibrato_rate 0.12
    vibrato_depth 0.05
    level 0.42
}

# Feed for the resample bus. Dark and low: half-speed playback drops it another
# octave, so what the breakdown hears is a reversed sub swell.
module fm smear {
    algorithm two_op
    waveform half_sine
    mod_index 0.62
    feedback 0.4
    op0_ratio 0.032
    op1_ratio 0.129
    op0_envelope 0.005 0.5 0.25 0.5
    op1_envelope 0.003 0.35 0.2 0.35
    lfo_target mod_index
    lfo_waveform triangle
    lfo_sync bars_4
    lfo_depth 0.35
}

# Noise riser: maximum feedback FM is the cheapest hiss there is.
module fm hiss {
    algorithm pair_plus_two
    mod_index 0.62
    feedback 0.35
    waveform abs_sine
    op0_ratio 0.49
    op1_ratio 0.17
    op2_ratio 0.35
    op3_ratio 0.07
    op0_envelope 0.001 1.6 0.25 1.2
    op1_envelope 0.001 1.4 0.30 1.0
    op2_envelope 0.001 1.2 0.28 0.9
    op3_envelope 0.001 1.8 0.20 1.4
    op0_feedback 0.25
    op1_feedback 0.2
    lfo_target mod_index
    lfo_waveform triangle
    lfo_sync bars_2
    lfo_depth 0.4
}

# ────────────────────────────────────────────────
# PATTERNS
# ────────────────────────────────────────────────

# ── Drums ──

pattern beat_gap {
    crash: x:0.45  -*31
    kick:  X  -*31
    snare: -*24  o:0.16  -  o:0.22  -  o:0.3  -  x:0.38  x*4
}

pattern beat_open {
    hat:  x:0.16  x:0.26  x:0.18  x:0.28  x:0.16  x:0.26  x:0.18  x:0.28  x:0.18  x:0.28  x:0.2  x:0.3  x:0.2  x:0.3  x:0.24  x:0.36
    tom:  -  -  -  x:0.14  -  -  -  x:0.16  -  -  -  x:0.18  -  -  x:0.2  x:0.22
}

pattern beat_intro {
    kick: X  -  -  -  X  -  -  -  X  -  -  -  X  -  -  -
    hat:  -  -  x:0.28  -  -  -  x:0.28  -  -  -  x:0.28  -  -  -  x:0.34  -
}

pattern beat_main {
    kick:    X  -  -  -  X  -  -  -  X  -  -  -  X  -  -  -
    hat:     x:0.42  x:0.3  x:0.46  x:0.32  x:0.42  x:0.3  x:0.46  x:0.32  x:0.42  x:0.3  x:0.46  x:0.32  x:0.42  x:0.3  x:0.48  x:0.36
    tom:     -  -  -  x:0.16  -  -  -  x:0.18  -  -  -  x:0.16  -  -  -  x:0.2
    openhat: -  -  -  -  -  -  -  x:0.3  -  -  -  -  -  -  -  x:0.3
    snare:   -  o:0.14  -  -  -  -  -  -  -  o:0.16  o:0.25  -  -  -  o:0.18  -
}

# Two bars: the second answers the first, which is what stops a 148 BPM loop
# from reading as a metronome.
pattern beat_drop {
    kick:    X  -  -  -  X  -  -  -  X  -  -  -  X  -  -  -   X  -  -  -  X  -  -  -  X  -  -  -  X  -  -  -
    clap:    -  -  -  -  X  -  -  -  -  -  -  -  X  -  -  -   -  -  -  -  X  -  -  -  -  -  -  -  X  -  -  -
    hat:     x:0.44  x:0.34  x:0.48  x:0.34  x:0.44  x:0.34  x:0.48  x:0.34  x:0.44  x:0.34  x:0.48  x:0.34  x:0.44  x:0.34  x:0.5  x:0.4   x:0.44  x:0.34  x:0.48  x:0.34  x:0.44  x:0.34  x:0.48  x:0.34  x:0.44  x:0.34  x:0.48  x:0.34  x:0.44  x:0.36  x:0.5  x*3
    tom:     -  -  -  x:0.2  -  -  -  x:0.22  -  -  -  x:0.2  -  -  -  x:0.24   -  -  -  x:0.2  -  -  -  x:0.22  -  -  -  x:0.2  -  x:0.18  -  x:0.26
    openhat: -  -  -  -  -  -  -  x:0.32  -  -  -  -  -  -  -  x:0.32   -  -  -  -  -  -  -  x:0.32  -  -  -  -  -  -  x:0.36  -
    snare:   -  o:0.16  o:0.22  -  -  o:0.14  -  -  -  o:0.16  o:0.24  -  -  o:0.14  -  o:0.28   -  o:0.16  o:0.22  -  -  o:0.14  -  o:0.2  -  o:0.16  o:0.24  -  -  o:0.18  -  o:0.3
    crash:   x:0.22  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -   -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
}

pattern beat_build {
    kick:    X  -  -  -  X  -  -  -  X  -  -  -  X  -  X  -
    hat:     x:0.4  x:0.3  x:0.42  x:0.3  x:0.4  x:0.3  x:0.42  x:0.3  x:0.42  x:0.32  x:0.44  x:0.32  x:0.44  x:0.34  x:0.48  x:0.38
    tom:     -  -  -  x:0.16  -  -  -  x:0.18  -  -  -  x:0.2  -  -  x:0.22  -
    snare:   -  o:0.14  -  -  -  o:0.14  -  o:0.2  -  o:0.16  -  o:0.24  -  o:0.3  x:0.4  x*3
}

# No kick: the breakdown. A beats track is still present so the ticking keeps
# time under the ghosts.
pattern beat_break {
    hat:   x:0.28  -  x:0.2  x:0.16  -  x:0.28  -  x:0.18  x:0.28  -  x:0.2  x:0.16  -  x:0.28  x:0.18  x:0.24
    snare: -  -  -  -  -  -  -  o:0.24  -  -  -  -  -  -  o:0.28  -
    tom:   -  -  -  -  -  -  -  -  x:0.35  -  -  -  -  -  -  -
}

pattern beat_out {
    kick:  X  -  -  -  -  -  -  -  X  -  -  -  -  -  -  -
    hat:   -  -  x:0.24  -  -  -  x:0.2  -  -  -  x:0.24  -  -  -  x:0.2  -
}

# ── Rolling bass: the 2nd, 3rd and 4th sixteenth of every beat, never the 1st ──

pattern bass_roll {
    -  1.1:0.95  1.1:0.6  1.1:0.8
    -  1.1:0.92  1.1:0.58  1.1:0.78
    -  1.1:0.95  1.1:0.6  1.1:0.8
    -  1.1:0.92  1.1:0.58  1.1:0.78
}

pattern bass_v1 {
    -  1.1:0.95  1.1:0.6  1.1:0.8
    -  1.1:0.92  1.1:0.58  1.1:0.78
    -  1.1:0.95  1.1:0.6  1.1:0.8
    -  1.1:0.92  1.1:0.58  ~5.0:0.82
}

pattern bass_v2 {
    -  1.1:0.95  1.1:0.6  2.1:0.78
    -  1.1:0.92  1.1:0.58  1.1:0.78
    -  1.1:0.95  7.0:0.6  1.1:0.8
    -  1.1:0.92  1.1:0.58  ~5.0:0.82
}

# Peak roll: octave jump and a slide out of every second bar.
pattern bass_v3 {
    -  1.1:0.98  1.1:0.6  1.2:0.7
    -  1.1:0.95  2.1:0.64  1.1:0.78
    -  1.1:0.98  1.1:0.6  ~4.1:0.72
    -  1.1:0.95  7.0:0.58  ~5.0:0.85
    -  1.1:0.98  1.1:0.6  1.1:0.8
    -  1.1:0.95  1.2:0.66  1.1:0.78
    -  1.1:0.98  2.1:0.62  1.1:0.8
    -  1.1:0.95  ~7.0:0.6  ~1.2:0.86
}

pattern bass_stut {
    -  1.1:0.9  1.1:0.9  1.1:0.58
    -  1.1:0.9  1.1:0.9  1.1:0.58
    -  1.1:0.92  1.1:0.92  1.1:0.62
    1.1:0.7  1.1:0.8  1.1:0.9  1.1:1.0
}

# ── Sub: same grid, half the notes, an octave below ──

pattern sub_hold { 1.0:0.85  ..*31 }

pattern sub_roll {
    -  1.0:0.9  -  1.0:0.74
    -  1.0:0.9  -  1.0:0.74
    -  1.0:0.9  -  1.0:0.74
    -  1.0:0.9  -  1.0:0.74
}

pattern sub_drop {
    -  1.0:0.92  -  1.0:0.76
    -  1.0:0.9  -  1.0:0.74
    -  1.0:0.92  -  1.0:0.76
    -  1.0:0.9  -  ~5.0:0.78
}

# ── Acid ──

pattern acid_a {
    1.2:0.8  -  ~1.2:0.55  -
    -  1.2:0.68  -  ~5.2:0.62
    1.2:0.8  -  ~2.2:0.55  -
    -  1.2:0.68  -  -
}

pattern acid_b {
    1.2:0.85  ~1.2:0.5  -  1.2:0.68
    ~5.2:0.64  -  1.2:0.58  -
    ~7.1:0.68  -  1.2:0.62  ~1.3:0.58
    -  1.2:0.68  -  ~2.2:0.54
}

pattern acid_c {
    1.2:0.9  1.2:0.48  ~1.3:0.68  1.2:0.52
    ~5.2:0.68  -  1.2:0.6  ~2.2:0.58
    1.2:0.85  ~7.1:0.54  1.2:0.68  -
    ~1.3:0.74  1.2:0.48  ~5.2:0.64  1.2:0.58
}

pattern acid_ghost {
    1.2:0.6  -  -  ~5.2:0.44
    -  -  1.2:0.48  -
    -  -  -  -
    ~2.2:0.44  -  -  -
}

# ── Metallic clanks ──

pattern clank_a {
    -  -  1.4:0.5  -
    -  -  -  -
    1.4:0.4  -  -  -
    -  -  -  1.5:0.34
}

pattern clank_b {
    -  1.4:0.45  -  1.5:0.3
    -  -  1.4:0.4  -
    1.5:0.34  -  -  1.4:0.5
    -  1.4:0.28  -  -
}

pattern clank_c {
    -  1.4:0.48  -  1.5:0.32
    1.3:0.36  -  1.4:0.42  -
    1.5:0.36  -  1.3:0.3  1.4:0.52
    -  1.4:0.3  -  1.5:0.28
    1.4:0.5  -  -  1.3:0.34
    -  1.5:0.3  1.4:0.44  -
    -  -  1.4:0.4  -
    1.3:0.32  1.4:0.46  -  1.5:0.3
}

pattern clank_break {
    -  -  -  -
    1.4:0.42  -  -  -
    -  -  -  1.3:0.3
    -  -  -  -
}

# ── Zaps ──

pattern zap_a {
    -  -  -  -
    3.4:0.34  -  -  -
    -  -  -  7.3:0.28
    -  -  -  -
}

pattern zap_b {
    -  5.4:0.3  -  -
    -  -  2.4:0.32  -
    7.3:0.28  -  -  4.4:0.3
    -  1.5:0.26  -  -
}

pattern zap_c {
    3.4:0.34  -  7.3:0.26  -
    -  5.4:0.3  -  2.4:0.28
    6.3:0.28  -  -  4.4:0.32
    -  1.5:0.26  -  7.3:0.24
    -  4.4:0.3  -  -
    2.4:0.3  -  5.4:0.26  -
    -  -  3.4:0.32  -
    7.3:0.28  -  -  1.5:0.3
}

# ── The dark layer: held clusters, four bars each ──

pattern murk_dark { [1.1 5.1 2.2]:0.55  ..*63 }
pattern murk_lift { [1.1 4.1 7.1]:0.55  ..*63 }

# ── Resample feed: two bars of stabs are what capture() records ──

pattern ghost_stab {
    1.2:0.8  -  -  1.2:0.5
    -  -  5.1:0.6  -
    -  1.2:0.45  -  -
    2.2:0.55  -  -  1.2:0.4
    -  -  1.2:0.6  -
    5.1:0.5  -  -  2.2:0.45
    -  1.2:0.55  -  -
    -  -  ~7.1:0.5  -
}

pattern ghost_hold { [1.1 2.2]:0.55  ..*63 }

# ── Riser ──

pattern riser_up { 1.3:0.55  ..*63 }

# ────────────────────────────────────────────────
# BUSES
# ────────────────────────────────────────────────

# The resample gesture. capture() records bars 28-30 (the bridge) and from bar
# 30 replaces whatever is routed here with that window, reversed and at half
# speed: two bars become four, an octave down. Buses only run while something
# feeds them, so the `ghost` track feeds it through the bridge,
# the breakdown and the outro, and is simply absent everywhere else. An unfed
# bus is skipped whole, so the loop stops the moment nothing plays into it.
bus rsmp
rsmp { in > capture(2, start=34, speed=0.5, reverse=1, mix=0.88)
          > highpass(55, 0.02)
          > lowpass(1400, 0.02, lfo_bars=8, lfo_depth=600)
          > saturate(0.5)
          > gain(2.0)
          > master }

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play beat_main
    using kit
    velocity 1.0
    level 0.9186
    reverb_send 0.05
    out > compressor(-12, ratio=4, attack=3, release=45, makeup=2db)
        > saturate(0.5)
        > eq(low=0.5, mid=-1.0, high=2.2)
        > master
}

track bass {
    play bass_roll
    using roll
    velocity 1.0
    level 1.121
    gate 0.3
    sidechain 0.82
    out > highpass(44hz, 0.02)
        > saturate(1.1)
        > eq(low=-2.0, mid=-0.5, high=-2.5)
        > lowpass(2600, 0.02)
        > compressor(-12, ratio=3, attack=1, release=20, makeup=1.5db)
        > master
}

track sub {
    play sub_roll
    using sub
    velocity 1.0
    level 0.4771
    gate 0.55
    sidechain 0.85
    out > lowpass(190hz, 0.02) > saturate(0.4) > master
}

track acid {
    play acid_a
    using squelch
    velocity 1.0
    level 1.196
    gate 0.42
    pan 0.12
    sidechain 0.55
    delay_send 0.22
    reverb_send 0.08
    out > highpass(220hz, 0.02)
        > saturate(0.9)
        > eq(low=-6.0, mid=1.5, high=0.5)
        # A resonance 87% squelch has a crest factor of 34: single-cycle spikes were
        # what drove the master input to 1.19, so the master limiter was working for
        # one track and everything else paid for it. Catching them here costs the
        # acid 0.6 dB of RMS and gives the whole mix 1.8 dB of headroom.
        > limiter(0.5)
        > lowpass(8khz, 0.02)
        > autopan(0.3, bars=4)
        > master
}

track clank {
    play clank_a
    using clank
    velocity 1.0
    level 0.7254
    gate 0.1
    pan -0.6
    sidechain 0.5
    delay_send 0.2
    reverb_send 0.12
    out > saturate(0.25) > highpass(1.4khz, 0.02) > eq(low=0, mid=-3.5, high=0.5) > lowpass(6.5khz, 0.02) > master
}

track zap {
    play zap_a
    using zap
    velocity 1.0
    level 0.2288
    gate 0.06
    pan 0.55
    sidechain 0.5
    delay_send 0.26
    reverb_send 0.1
    out > gain(0.9) > highpass(2khz, 0.02) > lowpass(8khz, 0.02) > master
}

track murk {
    play murk_dark
    using murk
    pan -0.45
    velocity 0.9
    level 0.1551
    gate 1.0
    # Breathes with the bass, not the kick: the kick already owns the low end,
    # and following the roll makes the layer feel like part of the groove.
    sidechain 0.55 from=bass
    reverb_send 0.4
    delay_send 0.12
    out > highpass(110hz, 0.02)
        > eq(low=1.5, mid=-4.0, high=0.5)
        > lowpass(3200, 0.02, lfo_bars=8, lfo_depth=900)
        > phaser(0.3, bars=8)
        > autopan(0.3, bars=8)
        > master
}

track ghost {
    play ghost_stab
    using smear
    pan 0.35
    velocity 0.9
    level 0.3406
    gate 0.5
    sidechain 0.45
    out > highpass(70hz, 0.02) > lowpass(240hz, 0.02) > saturate(0.7) > rsmp
}

track riser {
    play riser_up
    using hiss
    velocity 0.9
    level 0.2
    gate 1.0
    pan 0.5
    sidechain 0.5
    reverb_send 0.22
    delay_send 0.1
    out > gain(10) > gain(1.6) > bandpass(5000, 0.35, lfo_bars=4, lfo_depth=2000) > lowpass(10khz, 0.02) > master
}

# ────────────────────────────────────────────────
# MASTER
# ────────────────────────────────────────────────

master {
    in > tilt(-0.02)
       > eq(low=-0.5, mid=-0.8, high=2.6)
       > compressor(-9, ratio=2.5, attack=8, release=60, makeup=1.5db)
       > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# 0. Four bars of air before anything hits, so the kick is an arrival.
scene open {
    # 0.18 > 0.46 put these four bars 20 dB under the drops. Air, not silence.
    auto murk cutoff 0.10 > 0.21
    auto drums level 0.33 > 0.55
    track drums { play beat_open using kit level 0.492 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
}

# 1. Drums and atmosphere. No bass yet, so the roll lands as an event.
scene intro {
    auto drums level 0.44 > 0.62
    auto murk cutoff 0.088 > 0.246
    track drums { play beat_intro using kit level 0.5741 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
    track zap { play zap_a using zap level 0.3157 pan 0.55 }
}

# 2. Build: the roll enters stuttered, the acid opens, the riser climbs.
scene build1 {
    auto squelch cutoff 0.271 > 0.634
    auto riser level 0.05 > 0.42      # was 0.01 > 0.16: 29 dB under the mix, inaudible
    auto murk cutoff 0.246 > 0.327
    track drums { play beat_build using kit level 0.7118 }
    track bass { play bass_stut using roll level 0.7686 }
    track sub { play sub_roll using sub level 0.3321 }
    track acid { play acid_a using squelch level 0.5616 pan 0.12 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
    track clank { play clank_a using clank level 0.2687 pan -0.6 }
    track riser { play riser_up using hiss level 0.09 pan 0.5 }
}

# 2b. Two bars of air with one hit, so the drop lands on something.
scene gap {
    auto murk cutoff 0.246 > 0.1
    track drums { play beat_gap using kit level 0.6631 }
    track sub { play sub_hold using sub level 0.28 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
}

# 3. First drop: the groove, nothing decorative.
scene drop1 {
    auto squelch cutoff 0.371 > 0.68 > 0.434
    auto murk cutoff 0.327 > 0.161
    track drums { play beat_drop using kit level 0.7463 }
    track bass { play bass_v1 using roll level 1.111 }
    track sub { play sub_drop using sub level 0.4431 }
    track acid { play acid_b using squelch level 1.196 pan 0.12 }
    track clank { play clank_b using clank level 0.5481 pan -0.6 }
    track zap { play zap_b using zap level 0.373 pan 0.55 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
}

# 4. Bridge: the ghost stabs enter, routed into the capture bus. Bars 28-30
# pass through and are recorded; from bar 30 the bus plays them back reversed
# at half speed, on top of the groove, and carries that into the breakdown.
scene bridge {
    auto squelch cutoff 0.434 > 0.593
    track drums { play beat_main using kit level 0.6545 }
    track bass { play bass_v2 using roll level 1.121 }
    track sub { play sub_roll using sub level 0.4771 }
    track murk { play murk_lift using murk level 0.1551 pan -0.45 }
    track acid { play acid_b using squelch level 1.037 pan 0.12 }
    track clank { play clank_b using clank level 0.6448 pan -0.6 }
    track ghost { play ghost_stab using smear level 0.3406 pan 0.35 }
}

# 5. Breakdown: no kick. The reversed loop is the lead; the ghost holds a tone
# to keep the bus running under it.
scene breakdown {
    reverb_mix = 0.55
    auto squelch cutoff 0.593 > 0.36 > 0.534
    auto murk cutoff 0.161 > 0.37
    track drums { play beat_break using kit level 0.666 }
    # No kick is the point, but with the bass gone too there was nothing at all
    # under 200 Hz for eight bars and the section measured 13 dB below the drop.
    track sub { play sub_hold using sub level 0.24 }
    track murk { play murk_lift using murk level 0.1551 pan -0.45 }
    track ghost { play ghost_hold using smear level 0.3406 pan 0.35 }
    track acid { play acid_ghost using squelch level 1.099 pan 0.12 }
    track clank { play clank_break using clank level 0.4836 pan -0.6 }
    track zap { play zap_a using zap level 0.3157 pan 0.55 }
}

# 6. Second build: kick back, bass stutters, riser and acid climb together.
scene build2 {
    auto squelch cutoff 0.333 > 0.705
    auto riser level 0.06 > 0.5
    auto murk cutoff 0.37 > 0.272
    track drums { play beat_build using kit level 0.7118 }
    track bass { play bass_stut using roll level 1.195 }
    track sub { play sub_roll using sub level 0.4914 }
    track acid { play acid_b using squelch level 1.116 pan 0.12 }
    track clank { play clank_b using clank level 0.5481 pan -0.6 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
    track riser { play riser_up using hiss level 0.09 pan 0.5 }
}

# 7. Second drop: everything, the widest bass roll, the busiest clanks.
scene drop2 {
    auto squelch cutoff 0.401 > 0.735 > 0.466
    auto murk cutoff 0.272 > 0.151
    track drums { play beat_drop using kit level 0.93 }
    track bass { play bass_v3 using roll level 1.393 }
    track sub { play sub_drop using sub level 0.554 }
    track acid { play acid_c using squelch level 1.403 pan 0.12 }
    track clank { play clank_c using clank level 0.6448 pan -0.6 }
    track zap { play zap_c using zap level 0.4301 pan 0.55 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
}

# 8. Outro: the kick thins to half time, the acid dies into its own filter.
scene outro {
    auto squelch cutoff 0.466 > 0.259
    auto acid level 0.589 > 0.0
    auto drums level 0.52 > 0.15
    auto murk cutoff 0.151 > 0.04
    track drums { play beat_out using kit level 0.5971 }
    track acid { play acid_ghost using squelch level 1.116 pan 0.12 }
    track murk { play murk_dark using murk level 0.1551 pan -0.45 }
    track zap { play zap_a using zap level 0.2858 pan 0.55 }
    track ghost { play ghost_hold using smear level 0.3406 pan 0.35 }
}

# ────────────────────────────────────────────────
# ARRANGEMENT — 68 bars
# ────────────────────────────────────────────────

arrange {
    open x4
    intro x8
    gap x2
    build1 x8
    drop1 x12
    bridge x6
    breakdown x8
    build2 x6
    drop2 x14
    outro x6
}
