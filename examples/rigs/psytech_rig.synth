# psytech_rig — a rig for a hi-tech / psytech set.
#
# Nine voices, each with its own part and two or three variants of it, so a set
# has something to switch to. The first rig written for this skill had eight
# tracks sharing four patterns and the relay could only ever change volumes.
#
# Two levers apply inside the bar, no swap, no voice restart:
#   level 0 -> level 0.4     bring a voice in (muted tracks are skipped whole)
#   wet=0   -> wet=1         switch an effect in (bypassed nodes are not processed)
# Switching `play` to another pattern is a swap, lands on the bar line, and is
# how the set actually moves. Every effect is named with `as` so a scene can
# sweep it: `auto acid.wah wet 0 > 1`.
#
# 148 BPM, E phrygian. The kick owns the downbeat and the rolling bass never
# lands on it.

tempo 148
meter 4/4
scale E phrygian
swing 0.5
sidechain 0.6 attack=1ms release=70ms
humanize 0.03 timing 0.006

# Hi-tech ambience is short and dark: a long tail smears the 16ths.
reverb size=0.42 damp=0.65 predelay=12 sidechain=0.6
delay sync=sixteenth feedback=0.3 filter=0.55
reverb_return { in > highpass(340, 0.02) > lowpass(3200, 0.02, lfo_bars=12, lfo_depth=900) > autopan(0.35, bars=8) > out }
delay_return  { in > highpass(420, 0.02) > lowpass(7khz, 0.02) > out }

# ──────────────────────────────── voices

module beats kit {
    kick_level 1.0  kick_decay 0.30  kick_pitch 1.205x  kick_click 0.82  kick_drive 0.85
    snare_level 0.45  snare_decay 0.10  snare_pitch 1.13x  snare_snap 0.72  snare_pan -0.22
    hihat_level 0.92  hihat_decay 0.24  hihat_pitch 1.61x  hihat_pan 0.3
    clap_level 0.7  clap_pan 0.12  tom_pan -0.35  crash_pan 0.3
}

# Clean sub under the distorted roll: distortion trades the fundamental for
# harmonics, so the weight comes from a layer that is never driven.
module bass sub_osc {
    cutoff 120hz  cutoff_env 26.9857hz  resonance 8%
    osc1_wave saw  osc2_pitch 0st  osc3_pitch 0st
    attack 2ms  decay 130ms  sustain 0.85  release 45ms
}

module bass roll_osc {
    cutoff 290hz  cutoff_env 279.214hz  resonance 52%  glide 0.02  keytrack 0.4
    osc1_wave saw  osc2_wave square  osc2_pitch -12st  osc3_wave saw  osc3_pitch 0st
    attack 1ms  decay 70ms  sustain 0.22  release 25ms
}

module bass squelch {
    cutoff 600hz  cutoff_env 1043.25hz  resonance 87%  glide 0.07  keytrack 0.55  vel_env 0.55
    osc1_wave saw  osc2_wave saw  osc2_pitch 0.3st
    attack 1ms  decay 90ms  sustain 0.18  release 30ms
    lfo_target cutoff  lfo_waveform triangle  lfo_sync bars_2  lfo_depth 0.22
}

module fm clank_fm {
    algorithm pair_plus_two  mod_index 0.9  feedback 0.55  waveform abs_sine
    op0_ratio 6.855x  op1_ratio 2.515x  op2_ratio 4.685x  op3_ratio 2.05x
    op0_envelope 0.001 0.18 0.0 0.12
    op1_envelope 0.001 0.12 0.0 0.09
}

module fm zap_fm {
    algorithm two_op  mod_index 0.75  feedback 0.4  waveform half_sine
    op0_ratio 4.995x  op1_ratio 9.025x
    op0_envelope 0.001 0.08 0.0 0.05
    op1_envelope 0.001 0.05 0.0 0.04
}

module fm lead_fm {
    algorithm dual_pairs  mod_index 0.5  feedback 0.2  waveform sine
    op0_ratio 0.996x  op1_ratio 2.515x  op2_ratio 0.996x  op3_ratio 4.995x
    op0_envelope 0.02 0.4 0.3 0.3
    op1_envelope 0.01 0.3 0.2 0.25
    chorus_mix 0.25
    lfo_target mod_index  lfo_sync bars_4  lfo_depth 0.15
}

module keys murk_pad {
    voice_mode poly  detune 0.22  chorus_mix 0.25  cutoff 796.214hz  resonance 0.18
    attack 437.345ms  decay 935.25ms  sustain 0.9  release 2000ms
    lfo_target cutoff  lfo_waveform sine  lfo_sync bars_8  lfo_depth 0.12
}

module fm hiss_fm {
    algorithm pair_plus_two  mod_index 0.62  feedback 0.35  waveform abs_sine
    op0_ratio 8.095x  op1_ratio 3.135x  op2_ratio 5.925x  op3_ratio 1.585x
    op0_envelope 0.001 1.6 0.25 1.2
    op1_envelope 0.001 1.4 0.30 1.0
}

# ──────────────────────────────── parts, two or three each

pattern beat_sparse  { kick: X - - - - - - - X - - - - - - -
                       hat:  - - x - - - x - - - x - - - x - }
pattern beat_main    { kick: X - - - X - - - X - - - X - - -
                       hat:  - - x - - - x - - - x - o - x -
                       snare: - - - - - - - - - - - - X - - - }
pattern beat_rolling { kick: X - - - X - - - X - - - X - x -
                       hat:  x - x o x - x o x - x o x - x o
                       clap: - - - - - - - - X - - - - - - - }
pattern beat_fill    { kick: X - - - - - - - - - - - - - - -
                       snare: - - x - x - x x X x X x X X X X
                       hat:  x x - x - x - - - - - - - - - - }
pattern beat_half    { kick: X - - - - - - - - - - - - - - -
                       snare: - - - - - - - - X - - - - - - -
                       hat:  x - - - x - - - x - - - x - - - }

pattern sub_hold  { E1:0.8 ..*15 }
pattern sub_pulse { E1:0.85 .. .. -  - - - -  E1:0.8 .. .. -  - - - - }
pattern sub_roll  { E1:0.85 .. - -  E1:0.7 .. - -  E1:0.85 .. - -  E1:0.7 .. - - }

# The roll never lands on 1: the kick owns it.
pattern roll_main    { - - E1:0.8 E1:0.7  - - E1:0.8 E1:0.7  - - E1:0.8 E1:0.7  - - E1:0.8 E1:0.7 }
pattern roll_stut    { - - E1:0.8 -  - - E1:0.7 E1:0.7  - - E1:0.8 -  - E1:0.6 E1:0.8 E1:0.7 }
pattern roll_octave  { - - E1:0.8 E2:0.6  - - E1:0.8 E2:0.6  - - E2:0.7 E1:0.8  - - E1:0.8 E2:0.6 }

pattern acid_a     { E2:0.7 - - F2:0.5  - - G2:0.6 -  - A2:0.5 - -  B2:0.6 - - - }
pattern acid_b     { E2:0.8 - E2:0.4 F2:0.6  - G2:0.7 - A2:0.5  B2:0.7 - A2:0.4 G2:0.6  - F2:0.5 - E2:0.7 }
pattern acid_ghost { E3:0.5 - - -  - - - -  - - B2:0.4 -  - - - - }

pattern clank_a     { - - - Bb3:0.6  - - - -  - Db4:0.5 - -  - - - - }
pattern clank_b     { - Bb3:0.6 - -  Db4:0.5 - - Bb3:0.4  - - Eb4:0.6 -  - Bb3:0.5 - - }
pattern clank_break { - - - -  - - - Bb3:0.7  - - - -  - - - - }

pattern zap_a { - - - -  - - - -  - - - -  - - E5:0.5 - }
pattern zap_b { - - E5:0.4 -  - - - -  - E5:0.5 - -  - - E5:0.6 G5:0.4 }

pattern lead_a { E4:0.6 .. .. -  - - - -  G4:0.55 .. - -  - - - - }
pattern lead_b { E4:0.6 - G4:0.5 -  A4:0.55 - B4:0.6 -  - A4:0.5 - G4:0.55  - E4:0.6 - - }

pattern murk_low  { [E2 B2]:0.5 ..*15 }
pattern murk_lift { [E3 G3 B3]:0.45 ..*15 }

pattern hiss_swell { E4:0.4 ..*15 }
pattern hiss_up    { E4:0.5 ..*63 }

# ──────────────────────────────── the rig
#
# Three voices in, six waiting. Every chain on one line, every node named.

track drums { play beat_main using kit level 0.72 reverb_send 0.05 out > compressor(-12, ratio=4, attack=3, release=45, makeup=2db) as glue > saturate(0.5) as grit > eq(low=0.5, mid=-1.0, high=2.2) as tone > master }
track sub   { play sub_hold using sub_osc level 0.45 sidechain 0.85 out > lowpass(190hz, 0.02) as lp > saturate(0.4, wet=0.0) as drive > master }
track roll  { play roll_main using roll_osc level 0.5 gate 0.3 sidechain 0.82 out > highpass(44hz, 0.02) as hp > saturate(1.1) as grind > eq(low=-2.0, mid=-0.5, high=-2.5) as tone > lowpass(2600, 0.02, wet=0.0) as lp > master }

track acid  { play acid_a using squelch level 0.0 pan 0.12 gate 0.42 sidechain 0.55 delay_send 0.22 reverb_send 0.08 out > highpass(220hz, 0.02) as hp > saturate(0.9) as grind > autowah(0.85, base=500hz, range=3000hz, peak=0.4, wet=0.0) as wah > limiter(0.5) as tame > autopan(0.3, bars=4, wet=0.0) as pan > master }
track clank { play clank_a using clank_fm level 0.0 pan -0.6 gate 0.1 sidechain 0.5 delay_send 0.2 reverb_send 0.12 out > highpass(1.4khz, 0.02) as hp > bitcrush(7, wet=0.0) as crush > lowpass(6.5khz, 0.02) as lp > master }
track zap   { play zap_a using zap_fm level 0.0 pan 0.55 gate 0.06 sidechain 0.5 delay_send 0.26 reverb_send 0.1 out > highpass(2khz, 0.02) as hp > autopan(0.6, bars=3, wet=0.0) as pan > master }
track lead  { play lead_a using lead_fm level 0.0 pan -0.2 sidechain 0.5 delay_send 0.3 reverb_send 0.25 out > highpass(300, 0.02) as hp > phaser(0.4, bars=6, wet=0.0) as ph > lowpass(7khz, 0.02) as lp > master }
track murk  { play murk_low using murk_pad level 0.0 pan -0.45 sidechain 0.55 reverb_send 0.4 delay_send 0.12 out > highpass(110hz, 0.02) as hp > eq(low=1.5, mid=-4.0, high=0.5) as tone > vowel(o, a, bars=12, wet=0.0) as vow > autopan(0.3, bars=8, wet=0.0) as pan > master }
track hiss  { play hiss_swell using hiss_fm level 0.0 pan 0.5 sidechain 0.5 reverb_send 0.22 delay_send 0.1 out > gain(6) as up > bandpass(5000, 0.35, lfo_bars=4, lfo_depth=2000) as bp > lowpass(10khz, 0.02) as lp > master }

master { in > tilt(-0.02) > eq(low=-0.5, mid=-0.8, high=2.6) > compressor(-9, ratio=2.5, attack=8, release=60, makeup=1.5db) > out }
