# Primus Mud -- D, 96 BPM.
#
# The bass is the band. It plays the riff, the groove and the lead: a heavy
# lurching line with octave pops, a slap section where the thumb, the muted
# ghost notes and the popped octaves are three voices of one instrument, and
# a tapped figure up the neck. It goes through an envelope filter, the Mu-Tron
# move, so every note says "wow" as hard as it is played.
#
# The drums are dry and busy on the toms. The guitar is not a part: it is
# three squeals off the whammy bar, dissonant, and then it is gone again.

tempo 96
meter 4/4
scale D minor
swing 0.52
humanize 0.12

reverb size=0.28 damp=0.6 predelay=8
delay sync=dotted_eighth feedback=0.35 filter=0.4

# ── Modules ─────────────────────────────────────

# The bass: a saw and a square at the same pitch, hollow and growling, bright
# on the attack and quick to close, so each note is a pluck. Nothing under
# the fundamental: the tone is in the mids, where it talks. Velocity opens the
# filter: a thumb at 1.0 barks, a ghost at 0.3 is a thud.
module bass claypool {
    osc1_wave saw
    osc2_wave square
    osc2_pitch 0st
    osc3_pitch 0.06st
    cutoff 380hz
    cutoff_env 2.8khz
    resonance 0.32
    vel_env 0.8
    glide 0.01
    attack 1ms
    decay 170ms
    sustain 0.45
    release 60ms
    keytrack 0.3
}

# Dry kit: a round kick with little click, a snare that is mostly drum, hats
# that are closed and short, and the toms up front.
module beats kit {
    kick_level 1.0
    kick_decay 0.28
    kick_pitch 0.95x
    kick_click 0.35
    kick_drive 0.25
    snare_level 0.9
    snare_decay 0.32
    snare_pitch 1.0x
    snare_snap 0.5
    snare_drive 0.3
    snare_pan 0.05
    hihat_level 0.5
    hihat_decay 0.3
    hihat_pitch 1.05x
    hihat_pan 0.3
    tom_pan -0.2
    crash_pan -0.35
}

# The guitar: a square and a saw a hair apart, screaming, with the slowest
# glide there is, so a slide is a whammy dive.
module bass squeal {
    osc1_wave square
    osc2_wave saw
    osc2_pitch 0.3st
    osc3_pitch 7st
    cutoff 2.2khz
    cutoff_env 1.5khz
    resonance 0.45
    glide 0
    attack 5ms
    decay 900ms
    sustain 0.8
    release 400ms
    vibrato_rate 6hz
    vibrato_depth 0.25
}

# ── Bass ────────────────────────────────────────

# The riff. Two bars that lurch: the root, a pop an octave up, a step down,
# then a chromatic crawl that never lands where the ear expects it.
pattern mud {
    D2:1.0 - D2:0.5 D3:0.9   - C3:0.8 - D2:0.95   ~Eb2:0.85 .. D2:0.6 -   A2:0.9 - Ab2:0.85 G2:0.8
    D2:1.0 - D2:0.5 D3:0.9   - C3:0.8 - D2:0.95   F2:0.9 .. ~E2 ..   Eb2:0.85 - D2:0.7 -
}

# The same riff with the last beat turned into a fill, for the fourth bar of
# a phrase.
pattern mud_turn {
    D2:1.0 - D2:0.5 D3:0.9   - C3:0.8 - D2:0.95   ~Eb2:0.85 .. D2:0.6 -   A2:0.9 - Ab2:0.85 G2:0.8
    D2:1.0 - D2:0.5 D3:0.9   - C3:0.8 - D2:0.95   F2:0.9 F2:0.4(gate=0.2) Ab2:0.9 A2:0.95   C3:0.9 D3:1.0 ~Eb3 ..
}

# Slap: thumb on the root, muted ghosts between (short gate, low velocity),
# the octave popped. Sixteenths, and the ghosts are what makes it funk.
pattern slap {
    D2:1.0 D2:0.3(gate=0.2) D3:0.95 D2:0.3(gate=0.2)   D2:0.85 D2:0.3(gate=0.2) C3:0.9 D2:0.3(gate=0.2)   F2:0.95 D2:0.3(gate=0.2) G2:0.9 D2:0.3(gate=0.2)   Ab2:0.95 A2:0.85 D3:1.0 D2:0.3(gate=0.2)
    D2:1.0 D2:0.3(gate=0.2) D3:0.95 D2:0.3(gate=0.2)   D2:0.85 D2:0.3(gate=0.2) C3:0.9 D2:0.3(gate=0.2)   Bb1:0.95 Bb1:0.3(gate=0.2) Bb2:0.9 A1:0.85   A2:0.95 A1:0.3(gate=0.2) ~Ab2 G2:0.8
}

# Tapping up the neck: a D minor shape with a flat fifth in it, in triplet
# runs inside the sixteenths so it rolls rather than marches.
pattern tap {
    <D3:0.8 A3:0.7 D4:0.9> -  <F3:0.7 A3:0.7 D4:0.8> -   <D3:0.8 Ab3:0.75 D4:0.9> -  <F3:0.7 Ab3:0.7 C4:0.8> -   <D3:0.8 A3:0.7 D4:0.9> -  <F3:0.7 A3:0.7 D4:0.8> -   <C3:0.8 G3:0.7 C4:0.9> -  <Eb3:0.75 G3:0.7 Bb3:0.8> -
    <D3:0.8 A3:0.7 D4:0.9> -  <F3:0.7 A3:0.7 D4:0.8> -   <D3:0.8 Ab3:0.75 D4:0.9> -  <F3:0.7 Ab3:0.7 C4:0.8> -   <Bb2:0.8 F3:0.7 Bb3:0.9> -  <A2:0.8 E3:0.7 A3:0.9> -   <Ab2:0.85 Eb3:0.8 Ab3:0.9> -  D2:1.0 ..
}

# The stomp: half time, the root held and dragged down a semitone at a time.
pattern stomp {
    D2:1.0 .. .. ..   - - D2:0.85 ..   ~Db2:0.9 .. .. ..   C2:1.0 .. - -
    D2:1.0 .. .. ..   - - D2:0.85 ..   Eb2:0.95 .. ~D2 ..   ~Db2 .. ~C2 ..
}

# The last bar: three hits and out.
pattern ending {
    D2:1.0 - - -   D2:1.0 - - -   D1:1.0 ..*7
}

# ── Guitar ──────────────────────────────────────

# Four bars, one gesture: a high tritone, then a dive off the bar.
pattern squeal_dive {
    Ab5:0.9 ..*7  ~A5 ..*3  ~G#5 ..*3
    ..*8  ~D5 ..*3  ~A4 ..*3
    ..*6  - -  -*8
    -*16
}

# The stomp's answer: two dissonant screams a semitone apart, eight bars.
pattern squeal_stomp {
    -*8  Eb5:0.9 ..*5 ~D5 ..
    ..*8  - -  -*6
    -*16  -*16
    -*8  A5:0.85 ..*5 ~Ab5 ..
    ..*4 ~Eb5 ..*3  - -  -*6
    -*16  -*16
}

# ── Drums ───────────────────────────────────────

# The verse beat: the kick follows the bass's accents, the snare on two and
# four with a ghost before each, the toms answering the riff's crawl.
pattern verse {
    kick:  X - - -  - - - x   - - x -  - x - -   X - - -  - - - x   - - X -  - - - -
    snare: - - - -  X - - o   - - - -  X - o -   - - - -  X - - o   - - - -  X - - o
    hat:   x - x -  x - x -   x - x -  x - x -   x - x -  x - x -   x - x -  x - x -
    tom:   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    tom2:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    tom3:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    crash: - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
}

# The same with the second bar's back half rolled round the toms.
pattern verse_fill {
    kick:  X - - -  - - - x   - - x -  - x - -   X - - -  - - - x   - - - -  - - - -
    snare: - - - -  X - - o   - - - -  X - o -   - - - -  X - - o   - - - -  - - - -
    hat:   x - x -  x - x -   x - x -  x - x -   x - x -  x - x -   - - - -  - - - -
    tom:   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   X - x -  - - - -
    tom2:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - x  X - x -
    tom3:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - x
    crash: - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
}

# Under the slap: a tight funk beat, sixteenth hats with the accents moving.
pattern funk {
    kick:  X - - -  - - x -   - - X -  - - - -   X - - -  - - x -   - x - -  - - - -
    snare: - - - -  X - - o   - o - -  X - - o   - - - -  X - - o   - o - -  X - o -
    hat:   x o x o  x o x o   x o x o  x o x o   x o x o  x o x o   x o x o  x o x o
    tom:   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    tom2:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    tom3:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    crash: - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
}

# Under the tapping: the toms carry it, the kick and snare step back.
pattern toms {
    kick:  X - - -  - - - -   - - - -  - - - -   X - - -  - - - -   - - - -  - - - -
    snare: - - - -  - - - -   X - - -  - - - -   - - - -  - - - -   X - - -  - - o o
    hat:   - - x -  - - x -   - - x -  - - x -   - - x -  - - x -   - - x -  - - x -
    tom:   - - - x  - - - -   - - - -  - x - -   - - - x  - - - -   - - - -  - x - -
    tom2:  - - - -  - x - -   - - - x  - - - -   - - - -  - x - -   - - - x  - - - -
    tom3:  - - - -  - - - x   - - - -  - - - x   - - - -  - - - x   - - - -  - - - -
    crash: - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
}

# Half time for the stomp: the kick doubling the bass, one crash a phrase.
pattern heavy {
    kick:  X - - -  - - X -   - - - -  X - - -   X - - -  - - X -   - - - -  X - x -
    snare: - - - -  - - - -   X - - -  - - - -   - - - -  - - - -   X - - -  - - - -
    hat:   x - - -  x - - -   x - - -  x - - -   x - - -  x - - -   x - - -  x - - -
    tom:   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    tom2:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    tom3:  - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
    crash: - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
}

# The intro's drums: toms alone, answering the bass.
pattern tom_intro {
    tom3:  X - - -  - - - -   - - - -  - - - -   X - - -  - - - -   - - x -  x - x -
    tom2:  - - - -  - - x -   - - - -  - - - -   - - - -  - - x -   - - - -  - - - -
    hat:   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -   - - - -  - - - -
}

pattern hits {
    kick:  X - - -  X - - -   X - - -  - - - -
    snare: X - - -  X - - -   X - - -  - - - -
    crash: X - - -  X - - -   X - - -  - - - -
}

# One crash where the stomp lands, and nowhere else in it.
pattern crash_once {
    crash: X -*15  -*16  -*16  -*16  -*16  -*16  -*16  -*16
}

pattern rest { -*16 }

# ── Tracks ──────────────────────────────────────

track bass {
    play rest
    using claypool
    level 0.8
    gate 0.9
    sidechain 0
    reverb_send 0.04
    out > highpass(40hz, 0.05)
        > autowah(0.005, base=250hz, range=1600hz, peak=0.65, attack=3, release=140, lowpass)
        > saturate(0.9) > eq(low=1.0, mid=2.5, high=-1.0) > master
}

track drums {
    play rest
    using kit
    level 1.0
    reverb_send 0.12
    sidechain 0
    out > compressor(-12, ratio=3, attack=8, release=70, makeup=2db) > master
}

track crash {
    play rest
    using kit
    level 0.45
    reverb_send 0.15
    sidechain 0
    out > highpass(1.5khz, 0.05) > lowpass(9khz, 0.05) > master
}

track guitar {
    play rest
    using squeal
    level 0.25
    pan 0.4
    gate 0.95
    delay_send 0.3
    reverb_send 0.25
    sidechain 0
    out > saturate(2.5) > autowah(0.3, base=600hz, range=2500hz, peak=0.7, bandpass, wet=0.6)
        > highpass(300hz, 0.05) > lowpass(6khz, 0.05) > master
}

master {
    in > compressor(-6, ratio=2, attack=25, release=120, makeup=1db)
       > eq(low=0.5, mid=0, high=0.5)
       > out
}

# ── Scenes ──────────────────────────────────────

scene intro_bass {
    track bass { play mud using claypool }
}

scene intro_toms {
    track bass  { play mud using claypool }
    track drums { play tom_intro using kit }
}

scene verse {
    track bass  { play mud using claypool }
    track drums { play verse using kit }
}

scene verse_turn {
    track bass  { play mud_turn using claypool }
    track drums { play verse_fill using kit }
}

scene slap {
    track bass  { play slap using claypool }
    track drums { play funk using kit }
}

scene stomp {
    track bass   { play stomp using claypool }
    track drums  { play heavy using kit }
    track crash  { play crash_once using kit }
    track guitar { play squeal_stomp using squeal pan 0.4 }
}

scene tapping {
    track bass  { play tap using claypool velocity 0.7 }
    track drums { play toms using kit }
}

# The one place the guitar gets the room: over the riff, a dive.
scene dive {
    track bass   { play mud using claypool }
    track drums  { play verse using kit }
    track guitar { play squeal_dive using squeal pan 0.4 }
}

scene out {
    track bass  { play ending using claypool }
    track drums { play hits using kit }
}

arrange {
    intro_bass x4
    intro_toms x4
    verse x6
    verse_turn x2
    slap x8
    stomp x8
    verse x6
    verse_turn x2
    tapping x8
    dive x4
    slap x8
    stomp x8
    out x1
}
