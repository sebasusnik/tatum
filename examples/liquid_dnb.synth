# Liquid DnB — "Glass Water"
# Calibre / LTJ Bukem / High Contrast: two-step break, clean sub, jazz voicings, air.
tempo 174
meter 4/4
scale F minor
swing 0.54
humanize 0.12 timing 0.06
sidechain 0.22

# Global sends. The reverb tail is an instrument here, not a garnish.
reverb size=0.86 damp=0.32 predelay=35 sidechain=0.45
delay sync=dotted_eighth feedback=0.42 filter=0.55

# Movement lives on the returns so the tail itself breathes.
reverb_return { in > highpass(260, 0.06) > lowpass(3400, 0.12, lfo_bars=16, lfo_depth=1500) > autopan(0.35, bars=8) > out }
delay_return  { in > highpass(420, 0.06) > lowpass(4500, 0.08) > out }

groove liquid {
    hat   swing 0.57 nudge 0.006
    snare nudge 0.009
    kick  nudge -0.004
}

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# The break: round kick, cracking-but-not-gated snare, dry small hats.
module beats brk {
    kick_level 0.92
    kick_decay 0.30
    kick_pitch 0.84995x       # 0.85x pitch
    kick_click 0.32
    kick_drive 0.18
    kick_pan 0.0

    snare_level 0.85
    snare_decay 0.44
    snare_pitch 1.02005x      # 1.02x pitch
    snare_drive 0.22
    snare_snap 0.58
    snare_pan -0.07

    hihat_level 0.40
    hihat_decay 0.26
    hihat_pitch 1.14995x      # 1.15x pitch
    hihat_pan 0.24

    clap_level 0.42
    clap_pan 0.14
}

# Sub: a filtered saw that is effectively a sine. No drive anywhere near it.
module bass sub {
    osc1_wave saw
    osc2_pitch -0st          # unison
    osc3_pitch -0st
    cutoff 110.01hz           # 110 Hz: the note passes, the harmonics do not
    cutoff_env 20hz          # no filter movement at all
    resonance 0.04
    glide 0.05
    keytrack 0.0
    attack 4.9984ms           # 5 ms
    decay 400.13ms            # 400 ms
    sustain 0.94
    release 139.959ms          # 140 ms
    vel_env 0.0
}

# The cloud: unison jazz voicings, two-second attack, nothing transient.
module keys cloud {
    voice_mode poly
    detune 0.42
    chorus_mix 0.55
    cutoff 620.055hz           # 620 Hz
    resonance 4%
    attack 1200.05ms           # 1.2 s, no transient
    decay 899.69ms            # 900 ms
    sustain 0.86
    release 1799.47ms          # 1.8 s
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_16
    lfo_depth 0.11
    vibrato_rate 0.89995hz     # 0.9 Hz
    vibrato_depth 0.04
}

# The plate (`chapa`). It was an FM Rhodes; now it is the source for an
# envelope filter, and the filter gives it its character, not the timbre. So
# there are no inharmonic ratios and no feedback here: feedback in FM is a noise
# generator, and with `chorus_mix` there were two choruses in series (one here
# and one in the chain), which is what rasped -- a chorus is a detuned copy,
# and detuning is beating. Roughness measured on the track alone: 34.9% of the
# modulation before, 6.3% after taking both out.
module fm chapa {
    algorithm two_op
    level 2.0
    mod_index 0.66          # the attack's brightness comes from here: a shelf
                            # after a high-Q resonant filter does not get through, it eats it
    feedback 0.0
    waveform sine
    op0_ratio 1x      # 1x, carrier
    op1_ratio 2x      # 2x harmonic: clean
    op0_attack 2.0001ms       # 2 ms, the hit that triggers the follower
    op0_decay 619.93ms        # 620 ms
    op0_sustain 0.12        # falls fast: dry, not sustained
    op0_release 299.98ms      # 300 ms
    op1_attack 1ms          # 1 ms
    op1_decay 379.975ms        # 380 ms
    op1_sustain 0.10
    op1_release 240.09ms      # 240 ms
    chorus_mix 0.0
    vibrato_rate 0.8002hz     # 0.8 Hz
    vibrato_depth 0.02
    lfo_target mod_index
    lfo_sync bars_8
    lfo_depth 0.0           # only the filter moves
}

# Air: the high drone that makes the record sound wide.
module fm air {
    algorithm dual_pairs
    level 2.0
    mod_index 0.22
    feedback 0.05
    waveform sine
    op0_ratio 1x      # 1x
    op1_ratio 3x       # 3x
    op0_attack 1599.48ms       # 1.6 s
    op0_decay 1500.55ms        # 1.5 s
    op0_sustain 0.72
    op0_release 2000ms         # 2 s
    op1_attack 1200.05ms       # 1.2 s
    op1_decay 1200.05ms        # 1.2 s
    op1_sustain 0.55
    op1_release 1599.48ms      # 1.6 s
    chorus_mix 0.60
    lfo_target mod_index
    lfo_sync bars_16
    lfo_depth 0.22
    vibrato_rate 0.59975hz     # 0.6 Hz
    vibrato_depth 0.05
}

# Glass: the arpeggiated sparkle over the drops.
module fm glass {
    algorithm two_op
    level 2.0
    mod_index 0.40
    feedback 0.10
    waveform sine
    op0_ratio 1x      # 1x
    op1_ratio 7x      # 7x
    op0_attack 2.0001ms       # 2 ms
    op0_decay 260.036ms        # 260 ms
    op0_sustain 0.0
    op0_release 240.09ms      # 240 ms
    op1_attack 1ms          # 1 ms
    op1_decay 139.959ms        # 140 ms
    op1_sustain 0.0
    op1_release 120.038ms      # 120 ms
    chorus_mix 0.25
    lfo_target mod_index
    lfo_sync bars_8
    lfo_depth 0.16
}

# Lead: soulful single-note line, only in the back half.
module fm lead {
    algorithm additive
    level 2.0
    mod_index 0.30
    feedback 0.12
    waveform sine
    op0_ratio 1x      # 1x
    op1_ratio 2x      # 2x
    op0_attack 44.994ms       # 45 ms
    op0_decay 599.99ms        # 600 ms
    op0_sustain 0.46
    op0_release 700.1ms      # 700 ms
    op1_attack 30.006ms       # 30 ms
    op1_decay 400.13ms        # 400 ms
    op1_sustain 0.30
    op1_release 499.945ms      # 500 ms
    chorus_mix 0.25
    vibrato_rate 4.50045hz     # 4.5 Hz
    vibrato_depth 0.08
    lfo_target mod_index
    lfo_sync bars_4
    lfo_depth 0.12
}

# ────────────────────────────────────────────────
# PATTERNS — the break
# ────────────────────────────────────────────────

# Two bars, never the same twice: kick on 1 and the "and" of 3, snare on 2 and 4,
# ghosts filling the sixteenths.
pattern brk_main {
    kick:    X  -  -  -   -  -  -  -   -  -  X  -   -  -  -  -      X  -  -  -   -  -  o  -   -  -  X  -   -  -  x:0.5  -
    snare:   -  -  o  -   X  -  -  o   -  o  -  -   X  -  -  o      -  -  o  -   X  -  o  -   -  -  -  o   X  -  o  -
    hat:     x  -  o  x   -  o  x  -   x  o  -  x   -  x  o  -      x  -  o  x   -  o  x  -   x  o  -  x   -  x  o  x
    openhat: -  -  -  -   -  -  -  x:0.35   -  -  -  -   -  -  -  -      -  -  -  -   -  -  -  -   -  -  -  x:0.35   -  -  -  -
}

pattern brk_var {
    kick:    X  -  -  o   -  -  -  -   -  -  X  -   -  -  -  -      X  -  -  -   -  -  -  -   -  -  X  -   o  -  -  -
    snare:   -  -  -  o   X  -  o  -   -  o  -  -   X  -  o  o      -  o  -  -   X  -  -  o   -  -  o  -   X  -  o  -
    hat:     x  o  -  x   o  -  x  o   -  x  o  -   x  o  -  x      x  o  -  x   o  -  x  o   -  x  o  -   x  o  x  -
    openhat: -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  x:0.3      -  -  -  -   -  -  -  x:0.3   -  -  -  -   -  -  -  -
}

# Four bars: the break assembling itself, last bar rolls into the drop.
pattern brk_build {
    kick:    X  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -      X  -  -  -   -  -  -  -   -  -  X  -   -  -  -  -      X  -  -  -   -  -  -  -   -  -  X  -   -  -  -  -      X  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    snare:   -  -  -  -   X  -  -  -   -  -  -  -   X  -  -  -      -  -  -  -   X  -  -  o   -  -  -  -   X  -  -  o      -  -  o  -   X  -  -  o   -  o  -  -   X  -  -  o      -  -  o  -   X  -  o  -   x  -  x  x*2   X  x*2  X*2  X*2
    hat:     -  o  -  -   o  -  -  o   -  -  o  -   -  o  -  -      x  -  o  -   -  o  x  -   x  -  o  -   -  x  o  -      x  -  o  x   -  o  x  -   x  o  -  x   -  x  o  -      x  -  o  x   -  o  x  -   x  -  -  -   -  -  -  -
    openhat: -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -      -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  x:0.3      -  -  -  -   -  -  -  x:0.3   -  -  -  -   -  -  -  -      -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
}

# Just texture: shakers under the intro lift, no kick at all.
# Four bars for the last drop: the busiest the break ever gets, then it lands
# back on the main two bars so sixteen bars never read as one loop.
pattern brk_peak {
    kick:    X  -  -  o   -  -  -  -   -  -  X  -   -  -  o  -      X  -  -  -   -  -  o  -   -  -  X  -   -  o  x:0.5  -      X  -  -  -   -  -  -  -   -  -  X  -   -  -  -  -      X  -  -  -   -  -  o  -   -  -  X  -   -  -  x:0.5  -
    snare:   -  o  o  -   X  -  o  o   -  o  -  o   X  -  o  o      -  o  o  -   X  -  o  -   -  o  o  o   X  -  o  x:0.5      -  -  o  -   X  -  -  o   -  o  -  -   X  -  -  o      -  -  o  -   X  -  o  -   -  -  o  o   X  -  o  x*2
    hat:     x  o  x  o   x  o  x  o   x  o  x  o   x  o  x  o      x  o  x  o   x  o  x  o   x  o  x  o   x  o  x  x      x  -  o  x   -  o  x  -   x  o  -  x   -  x  o  -      x  -  o  x   -  o  x  -   x  o  -  x   -  x  o  x
    openhat: -  -  -  -   -  -  -  x:0.35   -  -  -  -   -  -  -  -      -  -  -  -   -  -  -  -   -  -  -  x:0.35   -  -  -  -      -  -  -  -   -  -  -  x:0.35   -  -  -  -   -  -  -  -      -  -  -  -   -  -  -  -   -  -  -  x:0.35   -  -  -  -
}

pattern brk_air {
    hat:     -  o  -  -   o  -  -  o   -  -  o  -   -  o  -  -      -  o  -  o   -  -  o  -   -  o  -  -   o  -  -  o
    openhat: -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  x:0.25      -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
}

pattern brk_thin {
    kick:    X  -  -  -   -  -  -  -   -  -  X  -   -  -  -  -      X  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
    snare:   -  -  -  -   X  -  -  o   -  -  -  -   X  -  -  -      -  -  o  -   X  -  -  -   -  -  -  -   X  -  -  o
    hat:     x  -  o  -   -  o  x  -   x  -  o  -   -  x  o  -      x  -  o  -   -  o  x  -   x  -  -  -   -  -  -  -
}

# ────────────────────────────────────────────────
# PATTERNS — harmony
# ────────────────────────────────────────────────
# F minor. Fm9 / Dbmaj9 / Bbm11 / Eb11 — every one of them diatonic,
# every one of them an extension, nothing that resolves too hard.

# Sparse: one chord, then thirty-two beats of nothing so the reverb can
# bloom and decay. Feeding it continuously gives a wash, not a tail.
pattern voice_intro {
    Fm9:0.52     ..*63
    Dbmaj9:0.52  ..*63
}

pattern voice_a {
    Fm9:0.55     ..*31
    Dbmaj9:0.55  ..*31
    Bbm11:0.50   ..*31
    Eb11:0.50    ..*31
}

pattern voice_b {
    Abmaj9:0.52  ..*31
    Eb11:0.50    ..*31
    Fm9:0.55     ..*31
    Dbmaj9:0.52  ..*31
}

pattern voice_break {
    Bbm11:0.50   ..*63
    Abmaj9:0.50  ..*63
}

# Rhodes: the chords again, syncopated, landing off the kick.
pattern rhodes_a {
    -  -  Fm9/4:0.45  ..   -  -  -  -    -  -  -  Fm9/4:0.40   ..  -  -  -
    -  -  -  Fm9/4:0.42  Fm9/4:0.32  ..  -  -  Fm9/4:0.32  ..  -  -  -  -  -  -
    -  -  Dbmaj9/4:0.45  ..   -  -  -  -    -  -  -  Dbmaj9/4:0.40   ..  -  -  -
    -  -  -  Dbmaj9/4:0.42  Dbmaj9/4:0.32  ..  -  -  Dbmaj9/4:0.32  ..  -  -  -  -  -  -
    -  -  Bbm11/3:0.42  ..   -  -  -  -    -  -  -  Bbm11/3:0.38   ..  -  -  -
    -  -  -  Bbm11/3:0.40  Bbm11/3:0.30  ..  -  -  Bbm11/3:0.30  ..  -  -  -  -  -  -
    -  -  Eb11/3:0.42  ..   -  -  -  -    -  -  -  Eb11/3:0.38   ..  -  -  -
    -  -  -  Eb11/3:0.40  Eb11/3:0.30  ..  -  -  Eb11/3:0.30  ..  -  -  -  -  -  -
}

pattern rhodes_b {
    -  -  -  Abmaj9/4:0.44   ..  -  -  -    -  -  Abmaj9/4:0.38  ..   -  -  -  -
    -  -  -  Abmaj9/4:0.40  Abmaj9/4:0.30  ..  -  -  Abmaj9/4:0.30  ..  -  -  -  -  -  -
    -  -  -  Eb11/3:0.42   ..  -  -  -    -  -  Eb11/3:0.38  ..   -  -  -  -
    -  -  -  Eb11/3:0.40  Eb11/3:0.30  ..  -  -  Eb11/3:0.30  ..  -  -  -  -  -  -
    -  -  -  Fm9/4:0.46   ..  -  -  -    -  -  Fm9/4:0.40  ..   -  -  -  -
    -  -  -  Fm9/4:0.42  Fm9/4:0.32  ..  -  -  Fm9/4:0.32  ..  -  -  -  -  -  -
    -  -  -  Dbmaj9/4:0.44   ..  -  -  -    -  -  Dbmaj9/4:0.38  ..   -  -  -  -
    -  -  -  Dbmaj9/4:0.40  Dbmaj9/4:0.30  ..  -  -  Dbmaj9/4:0.30  ..  -  -  -  -  -  -
}

# Fed into the tape bus so the echo chamber has something to chew on.
pattern ghost_hold {
    Bbm11/4:0.50  ..*31
    Abmaj9/4:0.50 ..*31
}

# Arpeggiated sparkle — one held chord per two bars, the arp does the work.
pattern glass_a {
    Fm9/5:0.34     ..*31
    Dbmaj9/5:0.34  ..*31
    Bbm11/4:0.30   ..*31
    Eb11/4:0.30    ..*31
}

pattern glass_b {
    Abmaj9/5:0.32  ..*31
    Eb11/4:0.30    ..*31
    Fm9/5:0.34     ..*31
    Dbmaj9/5:0.32  ..*31
}

# Air: wide held dyads, four bars each.
pattern air_low {
    [F5 C6 Ab6]:0.30   ..*63
    [Db5 Ab5 F6]:0.30  ..*63
}

pattern air_high {
    [Ab5 Eb6 C7]:0.28  ..*63
    [F5 C6 Ab6]:0.28   ..*63
}

# ────────────────────────────────────────────────
# PATTERNS — sub and lead
# ────────────────────────────────────────────────
# F, Db, Bb, Eb kept inside one octave so the weight never moves.

pattern sub_a {
    F1:0.95   ..*9   F1:0.80   ..*5
    F1:0.90   ..*9   F1:0.78   ..*5
    Db2:0.95  ..*9   Db2:0.80  ..*5
    Db2:0.90  ..*9   Db2:0.78  ..*5
    Bb1:0.95  ..*9   Bb1:0.80  ..*5
    Bb1:0.90  ..*9   Bb1:0.78  ..*5
    Eb2:0.95  ..*9   Eb2:0.80  ..*5
    Eb2:0.90  ..*9   Eb2:0.78  ..*5
}

pattern sub_b {
    Ab1:0.95  ..*9   Ab1:0.80  ..*5
    Ab1:0.90  ..*9   Ab1:0.78  ..*5
    Eb2:0.95  ..*9   Eb2:0.80  ..*5
    Eb2:0.90  ..*9   Eb2:0.78  ..*5
    F1:0.95   ..*9   F1:0.80   ..*5
    F1:0.90   ..*9   F1:0.78   ..*5
    Db2:0.95  ..*9   Db2:0.80  ..*5
    Db2:0.90  ..*9   Db2:0.78  ..*5
}

pattern sub_hold {
    F1:0.80   ..*31
    F1:0.80   ..*31
    Db2:0.80  ..*31
    Db2:0.80  ..*31
}

# Lead motif, four bars, built from F Ab C Eb so it sits over all four chords.
pattern lead_a {
    -   -   -   -     -   -   C5:0.55  ..     ..  ..  -   -     Ab4:0.50  ..  ..  ..
    ..  ..  -   -     -   -   -   -     F4:0.46  ..  ..  ..     ..  -   -   -
    -   -   -   -     -   -   Eb5:0.52  ..     ..  ..  -   -     C5:0.46  ..  ..  ..
    ..  ..  ..  ..    -   -   -   -     Ab4:0.42  ..  ..  ..     ..  ..  -   -
}

pattern lead_b {
    -   -   Ab5:0.50  ..     ..  -   -   -     -   -   F5:0.46  ..     ..  ..  -   -
    Eb5:0.48  ..  ..  ..     ..  ..  -   -     -   -   -   -     C5:0.44  ..  ..  ..
    -   -   Ab4:0.46  ..     ..  -   -   -     Eb5:0.44  ..  ..  ..     ..  -   -   -
    -   -   -   -     F4:0.42  ..  ..  ..     ..  ..  ..  ..     ..  ..  -   -
}

pattern silence {
    -  -  -  -   -  -  -  -   -  -  -  -   -  -  -  -
}

# ────────────────────────────────────────────────
# BUSES
# ────────────────────────────────────────────────

bus drums
drums { in > eq(low=2.0, mid=-1.0, high=2.0) > compressor(-7, ratio=2, attack=25, release=130, makeup=2.92db) > master }

# The cloud. The chord goes in and only its tail comes out: the `reverb` node
# is wet only, so what reaches master has none of the attack. That is what the
# recipe gets by resampling the tail, and here it comes without resampling.
#
# There used to be a `capture(4, start=8, speed=0.75)` here. It recorded four
# bars of tail and repeated them forever, so the cloud stopped following the
# harmony: the cosine similarity between a bar over Fm9 and one over Abmaj9
# was 1.000, and the centroid stayed stuck at 338 Hz for seven scenes. A tape
# loop, not a cloud.
bus haze
haze { in > reverb(0.92)
          > highpass(300hz, 0.02)
          > lowpass(2.8khz, 0.02, lfo_bars=16, lfo_depth=1100)
          > autopan(0.45, bars=16)
          > master }

bus tape
tape { in > delay(1/4, 0.48) > lowpass(1800, 0.10) > autopan(0.5, bars=4) > master }

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play silence
    using brk
    velocity 1.0
    level 0.86
    reverb_send 0.08
    out > drums
}

track sub {
    play silence
    using sub
    velocity 1.0
    level 0.30
    gate 0.95
    sidechain 0.18
    out > lowpass(190, 0.02) > master
}

track pad {
    play silence
    using cloud
    pan 0.45
    velocity 0.95
    level 0.30
    reverb_send 0.48
    delay_send 0.14
    sidechain 0.40
    # and ducks when the plate hits, instead of turning the plate up
    sidechain 0.28 from=rhodes
    out > highpass(290hz, 0.02) > eq(low=0.0, mid=-2.5, high=1.0)
        > lowpass(3.4khz, 0.02, lfo_bars=16, lfo_depth=1500)
        > autopan(0.30, bars=12)
        > master
}

track haze {
    play silence
    using cloud
    velocity 0.9
    level 0.32              # the cloud was what sat in front, not the pad:
                            # it was 6.4 dB above the plate and in its band
    sidechain 0.35
    out > haze
}

track rhodes {
    play silence
    using chapa
    velocity 0.9
    level 0.22              # behind the pad, not in front: measured, not by eye
    gate 0.55               # short note: the plate is a hit, not a held chord
    pan -0.20
    reverb_send 0.06        # almost dry. The floor between hits goes from -15 to -36 dB.
    delay_send 0.0
    sidechain 0.30
    out > highpass(260, 0.02)
        # The envelope filter. `peak` is Q = 0.5 + n*19.5, and a resonant
        # filter's response time is Q/(pi*f): with peak 0.92 at 220 Hz that is
        # 26.7 ms, heard as a late attack however fast the hit. At peak 0.58
        # and 480 Hz it is 7.8 ms. `wobble` is what sets this apart from a
        # plain wah: the resonance does not move once and stay, it oscillates
        # and dies with the note, which is what a thin metal plate does as it flexes.
        > autowah(0.88, base=480hz, range=2600hz, peak=0.58, attack=1,
                  release=520, wobble=1500hz, wobble_hz=6)
        > eq(low=-2.0, mid=0.5, high=1.5)
        # envelope panning, and two autopans with coprime periods on top: the
        # phases do not line up again for 77 bars
        > panenv(0.65, attack=3, release=240)
        > autopan(0.50, bars=7) > autopan(0.30, bars=11) > master
}

track ghost {
    play silence
    using chapa
    pan -0.32
    velocity 0.85
    level 0.33
    reverb_send 0.40
    sidechain 0.0
    out > highpass(220, 0.02) > chorus(0.35) > tape
}

track glass {
    play silence
    using glass
    velocity 0.8
    level 0.416
    gate 0.40
    pan -0.45
    reverb_send 0.52
    delay_send 0.34
    sidechain 0.35
    arp up rate=16 gate=0.35 octaves=2
    out > highpass(700, 0.02) > lowpass(7khz, 0.02) > master
}

track lead {
    play silence
    using lead
    velocity 0.85
    level 0.572
    gate 0.80
    pan 0.28
    reverb_send 0.40
    delay_send 0.30
    sidechain 0.30
    out > highpass(300, 0.02) > master
}

track air {
    play silence
    using air
    pan 0.4
    velocity 0.8
    level 0.15
    reverb_send 0.55
    delay_send 0.16
    sidechain 0.35
    out > highpass(900, 0.02) > lowpass(8khz, 0.02) > autopan(0.45, bars=16) > master
}

# ────────────────────────────────────────────────
# MASTER — glue only. A break has to keep its crest factor.
# ────────────────────────────────────────────────

# gain(0.354) at the head of the master: what the engine used to take off this
# song's fullest scene when it scaled every scene by 1/sqrt(its tracks). The
# master chain is fed as it was; scenes with fewer tracks now play as written.
master {
    in > gain(0.354) > eq(low=1.5, mid=-0.5, high=1.5)
       > tilt(0.0)
       > compressor(-6, ratio=1.5, attack=45, release=220, makeup=3.46db)
       > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# INTRO — chords and atmosphere, nothing else. Also reused as the tail.
scene intro {
    reverb_mix = 0.55
    delay_mix = 0.25
    auto cloud cutoff 0.46 > 0.76            # 1.7khz -> 6.6khz
    auto master tilt -0.25 > -0.05
    track sub { play sub_hold using sub sidechain 0.0 velocity 0.85 level 0.16 }
    track pad { play voice_intro using cloud sidechain 0.0 velocity 0.85 pan 0.45 }
    track haze { play voice_intro using cloud velocity 0.45 }
    track air { play air_low    using air   sidechain 0.0 velocity 0.22 pan 0.4 }
}

# LIFT — shakers and the sub arrive; still no kick.
scene lift {
    reverb_mix = 0.50
    delay_mix = 0.25
    auto cloud cutoff 0.38 > 0.46            # 1.2khz -> 1.7khz
    track drums  { play brk_air    using brk  level 0.62 }
    track pad { play voice_intro using cloud velocity 0.9 pan 0.45 }
    track haze { play voice_intro using cloud velocity 0.9 }
    track air { play air_low    using air pan 0.4 }
    track sub    { play sub_hold   using sub  velocity 0.85 }
    track rhodes { play rhodes_a   using chapa velocity 0.7 pan -0.38 }
}

# BUILD — the break assembles, the filter opens, the reverb pulls back.
scene build {
    reverb_mix = 0.45
    delay_mix = 0.22
    auto cloud cutoff 0.46 > 0.58            # 1.7khz -> 2.9khz
    auto brk kick_level 0.75 > 0.95
    auto master tilt -0.12 > 0.0
    track drums  { play brk_build using brk level 0.64 }
    track pad { play voice_a   using cloud pan 0.45 }
    track haze { play voice_a using cloud }
    track air { play air_low   using air pan 0.4 }
    track sub    { play sub_a     using sub velocity 0.80 }
    track rhodes { play rhodes_a  using chapa pan -0.38 }
}

# DROP A — the break enters whole.
scene drop_a {
    reverb_mix = 0.36
    delay_mix = 0.20
    auto cloud cutoff 0.54 > 0.64 > 0.56     # 2.4khz -> 3.8khz -> 2.6khz
    track drums  { play brk_main using brk level 0.80 }
    track sub    { play sub_a    using sub }
    track pad { play voice_a  using cloud pan 0.45 }
    track haze { play voice_a using cloud }
    track rhodes { play rhodes_a using chapa pan -0.38 }
    track glass { play glass_a  using glass pan -0.45 }
    track air { play air_high using air pan 0.4 }
}

# DROP B — chords move to Ab, break varies, ghost starts feeding the echo chamber.
scene drop_b {
    reverb_mix = 0.38
    delay_mix = 0.24
    auto cloud cutoff 0.56 > 0.50            # 2.6khz -> 2.0khz
    auto lead mod_index 0.26 > 0.36
    track drums  { play brk_var   using brk level 0.80 }
    track sub    { play sub_b     using sub }
    track pad { play voice_b   using cloud pan 0.45 }
    track haze { play voice_b using cloud }
    track rhodes { play rhodes_b  using chapa pan -0.38 }
    track lead { play lead_a    using lead pan 0.28 }
    track ghost { play ghost_hold using chapa velocity 0.55 pan -0.32 }
    track air { play air_low   using air pan 0.4 }
}

# BREAKDOWN — no drums, reverb frozen, the echo chamber carries the chords.
scene breakdown {
    reverb_mix = 0.52
    delay_mix = 0.28
    auto reverb_freeze 0 > 1
    auto cloud cutoff 0.54 > 0.72            # 2.4khz -> 5.5khz
    auto master tilt -0.30 > 0.0
    # Without this the scene measured 82.7% mids and 0% sub: a bare mass of
    # mids. The pad needs something below to float on, which is exactly what
    # its 290 Hz highpass takes away from it.
    track sub { play sub_hold using sub sidechain 0.0 velocity 0.85 }
    track pad { play voice_break using cloud sidechain 0.0 velocity 0.72 pan 0.45 }
    track haze { play voice_break using cloud velocity 0.72 }
    track air { play air_high    using air   sidechain 0.0 velocity 0.62 pan 0.4 }
    track ghost { play ghost_hold  using chapa velocity 0.66 pan -0.32 }
    track lead { play lead_b      using lead  sidechain 0.0 velocity 0.55 pan 0.28 }
}

# DROP C — everything, the fullest the record gets.
scene drop_c {
    reverb_mix = 0.34
    delay_mix = 0.20
    auto cloud cutoff 0.58 > 0.70 > 0.60     # 2.9khz -> 5.0khz -> 3.2khz
    auto glass mod_index 0.36 > 0.46
    track drums  { play brk_peak using brk level 1.0 }
    track sub    { play sub_a    using sub }
    track pad { play voice_a  using cloud pan 0.45 }
    track haze { play voice_a using cloud }
    track rhodes { play rhodes_a using chapa velocity 1.0 pan -0.38 }
    track glass { play glass_b  using glass velocity 0.95 pan -0.45 }
    track lead { play lead_b   using lead velocity 0.95 pan 0.28 }
    track air { play air_high using air pan 0.4 }
}

# OUTRO — the break thins out, the tail takes over.
scene outro {
    reverb_mix = 0.50
    delay_mix = 0.26
    auto drums level 0.80 > 0.0
    auto cloud cutoff 0.56 > 0.34            # 2.6khz -> 960hz
    auto master tilt 0.0 > -0.30
    track drums  { play brk_thin  using brk }
    track sub    { play sub_hold  using sub velocity 0.8 }
    track pad { play voice_a   using cloud pan 0.45 }
    track haze { play voice_a using cloud }
    track air { play air_low   using air pan 0.4 }
    track rhodes { play rhodes_a  using chapa velocity 0.7 pan -0.38 }
}

# ────────────────────────────────────────────────
# ARRANGEMENT — 84 bars
# ────────────────────────────────────────────────

arrange {
    intro x8
    lift x8
    build x8
    drop_a x16
    drop_b x8
    breakdown x8
    drop_c x16
    outro x8
    intro x4
}
