# Firestarter — big beat in the manner of The Prodigy, E phrygian, 136 BPM
# A band, not a synth: two distorted guitars double-tracked hard left and
# right, a fuzz bass, a breakbeat played in a room with crashes marking the
# sections; the rave comes on top of that as a hoover, stabs, a siren and a shout. Every element gets its own moment: the
# shout only lands drops, the siren only lives in the break and the build, the
# hoover has a section of its own, and one bar of silence cuts the song in two.
tempo 136
meter 4/4
scale E phrygian
swing 0.54
humanize 0.07 timing 0.01
sidechain 0.25 attack=1ms release=80ms

delay sync=eighth feedback=0.3 filter=0.5
reverb size=0.4 damp=0.55 predelay=10 sidechain=0.3

reverb_return { in > highpass(250hz, 0.05) > out }
delay_return  { in > highpass(350hz, 0.05) > lowpass(5khz, 0.05) > out }

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# The break: a fat kick, a snare that cracks, tight hats
module beats breaks {
    kick_level 1.0
    kick_decay 45%
    kick_pitch 0.9x
    kick_click 50%
    kick_drive 80%
    snare_level 1.0
    snare_decay 55%
    snare_pitch 0.85x
    snare_snap 60%
    snare_drive 60%
    snare_pan 0.0
    hihat_level 0.7
    hihat_decay 35%
    hihat_pitch 1.3x
    hihat_pan 0.2
    clap_level 0.6
    clap_pan -0.15
    crash_pan 0.25
}

# Junk: a second kit for the industrial section, all top end and grit
module beats junk {
    snare_level 0.8
    snare_decay 5%
    snare_pitch 1.6x
    snare_snap 100%
    snare_pan 0.3
    hihat_level 0.8
    hihat_decay 8%
    hihat_pitch 2x
    hihat_pan -0.35
}

# Fuzz: a rock bass through a pedal. Saw plus a square an octave down, the
# filter left open, all the colour from the distortion in the chain
module bass fuzz {
    osc1_wave saw
    osc2_wave square
    osc2_pitch -12st
    cutoff 1500hz
    cutoff_env 20hz
    resonance 0%
    glide 5%
    attack 2ms
    decay 300ms
    sustain 90%
    release 60ms
}

# Reese: three saws, one a quarter tone off and one an octave down
module bass reese {
    osc1_wave saw
    osc2_wave saw
    osc3_wave saw
    osc2_pitch 0.25st
    osc3_pitch -12st
    cutoff 350hz
    cutoff_env 900hz
    resonance 20%
    glide 10%
    attack 3ms
    decay 400ms
    sustain 70%
    release 80ms
}

# Guitars: root, fifth and octave -- a power chord -- with no filter
# envelope at all. The distortion and the cabinet are in the track chains;
# the second guitar is detuned a few cents so the two sides never lock into
# one mono sound, the way a riff tracked twice never does
module bass guitar {
    osc1_wave saw
    osc2_wave saw
    osc3_wave saw
    osc2_pitch 7st
    osc3_pitch 12st
    cutoff 5khz
    cutoff_env 20hz
    resonance 0%
    glide 0%
    attack 1ms
    decay 2s
    sustain 100%
    release 120ms   # what 60ms played as before envelope times meant what they say
}

module bass guitar2 {
    osc1_wave saw
    osc2_wave saw
    osc3_wave saw
    osc2_pitch 7.08st
    osc3_pitch 11.92st
    cutoff 5khz
    cutoff_env 20hz
    resonance 0%
    glide 0%
    attack 1ms
    decay 2s
    sustain 100%
    release 120ms   # what 60ms played as before envelope times meant what they say
}

# Hoover: detuned saws that bend between notes, the rave siren of '92
module bass hoover {
    osc1_wave saw
    osc2_wave saw
    osc3_wave saw
    osc2_pitch 0.4st
    osc3_pitch -12st
    cutoff 3khz
    cutoff_env 1khz
    resonance 10%
    glide 25%
    attack 20ms
    decay 500ms
    sustain 90%
    release 300ms
    vibrato_rate 5hz
    vibrato_depth 10%
}

# Stabs: short organ chords, the call to the riff's response
module keys stab {
    voice_mode poly
    cutoff 3khz
    resonance 25%
    detune 20%
    chorus_mix 20%
    attack 1ms
    decay 250ms
    sustain 0%
    release 150ms
}

# Siren: an air-raid wail, one cycle a bar
module fm siren {
    algorithm two_op
    level 1.5
    mod_index 30%
    waveform sine
    op0_ratio 1x
    op1_ratio 2x
    op0_envelope 0.05 0.5 1.0 0.4
    op1_envelope 0.05 0.5 1.0 0.4
    lfo_target pitch
    lfo_sync bar
    lfo_waveform triangle
    lfo_depth 40%
}

# Shout: a noisy FM burst through a vowel filter, a throat saying "HAH"
module fm shout {
    algorithm pair_plus_two
    level 2.0
    mod_index 80%
    feedback 70%
    waveform sine
    op0_ratio 1x
    op1_ratio 1.41x
    op2_ratio 2.9x
    op3_ratio 1x
    op0_envelope 0.005 0.35 0.3 0.15
    op1_envelope 0.005 0.3 0.3 0.15
    op2_envelope 0.005 0.25 0.3 0.15
    op3_envelope 0.005 0.3 0.3 0.15
}

# Laser: a rising FM zap, only in the second build
module fm laser {
    algorithm two_op
    level 1.6
    mod_index 60%
    waveform sine
    op0_ratio 1x
    op1_ratio 2.5x
    op0_envelope 0.001 0.12 0.0 0.06
    op1_envelope 0.001 0.08 0.0 0.05
    lfo_target pitch
    lfo_sync quarter
    lfo_waveform saw
    lfo_depth 100%
}

# Whoosh: feedback noise that swells under the builds
module fm whoosh {
    algorithm pair_plus_two
    level 1.2
    mod_index 100%
    feedback 100%
    waveform sine
    op0_ratio 5.3x
    op1_ratio 2.51x
    op2_ratio 7.1x
    op3_ratio 1.43x
    op0_envelope 0.5 1.0 1.0 0.5
    op1_envelope 0.5 1.0 1.0 0.5
    op2_envelope 0.5 1.0 1.0 0.5
    op3_envelope 0.5 1.0 1.0 0.5
    op0_feedback 90%
    lfo_target mod_index
    lfo_sync bars_2
    lfo_waveform triangle
    lfo_depth 30%
}

# ────────────────────────────────────────────────
# DRUMS
# ────────────────────────────────────────────────

# The break: kick on one and the and-of-three, snare on two and four,
# ghost notes in between
pattern beat_a {
    kick:    X - - - - - - - - - X - - - - -  X - - - - - - - - - X - - x:0.7 - -
    snare:   - - - - X - - o - o - - X - - o  - o - - X - - o - - - o X - o -
    hat:     x o x o x o x o x o x o x o x o  x o x o x o x o x o x o x o - -
    openhat: - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - x -
}

# Stomp: the kick pushes the and-of-two, clap doubles the snare
pattern beat_stomp {
    kick:    X - - - - - X - X - - - - - - -
    snare:   - - - - X - - - - - - - X - - -
    clap:    - - - - X - - - - - - - X - - -
    hat:     - - x - - - x - - - x - - - x -
}

pattern beat_half {
    kick:    X - - - - - - - - - x - - - - -
    snare:   - - - - - - - - X - - - - - - -
    hat:     x - - - x - - - x - - - x - - -
}

# Four bars of snare that fold in on themselves, then two sixteenths of nothing
pattern beat_roll {
    kick:    X - - - X - - - X - - - X - - -  X - - - X - - - X - - - X - - -  X - - - X - - - X - - - X - - -  X - - - X - - - X - - - - - - -
    snare:   x - - - x - - - x - - - x - - -  x - x - x - x - x - x - x - x -  x x x x x x x x x x x x x x x x  X*2 X*2 X*2 X*2 X*2 X*2 X*2 X*2 X*3 X*3 X*3 X*3 X*4 X*4 - -
    hat:     x x x x x x x x x x x x x x x x  x x x x x x x x x x x x x x x x  x x x x x x x x x x x x x x x x  - - - - - - - - - - - - - - - -
}

pattern crash_16 {
    crash: X -*127  x -*127
}

pattern crash_8 {
    crash: X -*127
}

pattern beat_junk {
    snare:   - - x - - x - - - - x - - x - x
    hat:     x*2 - x - x*3 - x - x*2 - x - x*4 - x -
}

# ────────────────────────────────────────────────
# BASS
# ────────────────────────────────────────────────

pattern bass_a {
    E1:1.0 - E1:0.8 -   G1:1.0 .. .. E1:0.8   E1:0.9 - F1:1.0 ..   E1:0.9 - D1:1.0 ..
    E1:1.0 - E1:0.8 -   G1:1.0 .. .. E1:0.8   A1:1.0 .. G1:0.9 ..  F1:1.0 .. .. ..
}

# Locked to the stomp kick
pattern bass_stomp {
    E1:1.0 .. .. .. - - E1:0.9 ..   E1:1.0 .. .. .. - - F1:0.8 ..
}

pattern reese_drone {
    E1:0.8 ..*63
}

# ────────────────────────────────────────────────
# RIFF, HOOVER, STABS
# ────────────────────────────────────────────────

# Palm mutes (short, chugging) against open power chords that ring
pattern riff {
    E2:0.8(gate=0.35) E2:0.7(gate=0.35) E2:0.8(gate=0.35) E2:0.7(gate=0.35)   G2:1.0 .. .. E2:0.8(gate=0.35)   E2:0.8(gate=0.35) E2:0.7(gate=0.35) F2:1.0 ..   E2:0.8(gate=0.35) E2:0.7(gate=0.35) D2:1.0 ..
    E2:0.8(gate=0.35) E2:0.7(gate=0.35) E2:0.8(gate=0.35) E2:0.7(gate=0.35)   G2:1.0 .. .. E2:0.8(gate=0.35)   A2:1.0 .. G2:0.9 ..   F2:1.0 .. .. ..
}

# The same riff an octave up, for the industrial switch
pattern riff_high {
    E3:0.8(gate=0.35) E3:0.7(gate=0.35) E3:0.8(gate=0.35) E3:0.7(gate=0.35)   G3:1.0 .. .. E3:0.8(gate=0.35)   E3:0.8(gate=0.35) E3:0.7(gate=0.35) F3:1.0 ..   E3:0.8(gate=0.35) E3:0.7(gate=0.35) D3:1.0 ..
    E3:0.8(gate=0.35) E3:0.7(gate=0.35) E3:0.8(gate=0.35) E3:0.7(gate=0.35)   G3:1.0 .. .. E3:0.8(gate=0.35)   A3:1.0 .. G3:0.9 ..   F3:1.0 .. .. ..
}

pattern hoover_line {
    E3:1.0 .. .. ..   .. .. ~D3:0.9 ..   ~E3:0.9 .. .. ..   - - G3:0.9 ~F3:0.9
    E3:1.0 .. .. ..   .. .. .. ..        - - - -            B2:0.9 .. ~C3:0.9 ..
    E3:1.0 .. .. ..   .. .. ~D3:0.9 ..   ~E3:0.9 .. .. ..   - - A3:0.9 ~G3:0.9
    ~F3:0.9 .. .. ..  ~E3:0.9 .. .. ..   .. .. .. ..        - - - -
}

# In the second drop the hoover only answers, every other two bars
pattern hoover_call {
    -*32
    E3:1.0 .. .. ..   .. .. ~D3:0.9 ..   ~E3:0.9 .. .. ..   - - A3:0.9 ~G3:0.9
    ~F3:0.9 .. .. ..  ~E3:0.9 .. .. ..   .. .. .. ..        - - - -
}

pattern stabs {
    - - - -  - - [E3 G3 B3]:0.9 -  - - - -  - - - -
    - - - -  - - [E3 G3 B3]:0.8 -  - - - [F3 A3 C4]:0.9  - - - -
    - - - -  - - [E3 G3 B3]:0.9 -  - - - -  - - - -
    [D3 F3 A3]:0.9 - - [D3 F3 A3]:0.7  - - [F3 A3 C4]:0.9 -  - - - -  - - - -
}

# ────────────────────────────────────────────────
# FX
# ────────────────────────────────────────────────

pattern siren_hold {
    E4:0.8 ..*63
}

# One shout on the first beat of a sixteen-bar drop
pattern shout_16 {
    E3:1.0 .. .. .. -*252
}

pattern shout_8 {
    E3:1.0 .. .. .. -*60  E3:0.9 .. .. .. -*60
}

pattern shout_stop {
    E3:1.0 .. .. .. -*12
}

pattern laser_fill {
    -*48
    E5:0.7 - - -  E5:0.8 - - -  E5:0.9*2 - E5:0.9*2 -  E5:1.0*4 E5:1.0*4 - -
}

pattern swell {
    E3:0.8 ..*63
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

# The big-beat sound: the whole kit squashed and driven as one
bus drums
drums { in > compressor(-14, ratio=6, attack=5, release=60, makeup=3db) > saturate(0.5) > eq(low=2, mid=1, high=2) > master }

track drums {
    play beat_a
    using breaks
    level 0.8
    velocity 1.0
    reverb_send 0.14
    out > highpass(30hz, 0.05) > drums
}

track crash {
    play crash_16
    using breaks
    level 0.5
    velocity 1.0
    reverb_send 0.2
    out > highpass(300hz, 0.05) > drums
}

track junk {
    play beat_junk
    using junk
    level 0.5
    velocity 1.0
    delay_send 0.15
    out > bitcrush(6, 0.4) > highpass(400hz, 0.05) > drums
}

track bass {
    play bass_a
    using fuzz
    level 0.2
    velocity 1.0
    gate 0.9
    out > saturate(4.0) > lowpass(1800hz, 0.05) > highpass(35hz, 0.05) > master
}

# The cabinet: cut the fizz above 4.5 kHz and the mud below 90 Hz, push the
# mids where a guitar lives
track gtr_l {
    play riff
    using guitar
    level 0.2
    velocity 1.0
    gate 1.0
    pan -0.7
    reverb_send 0.06
    sidechain 0.1
    out > highpass(90hz, 0.05) > saturate(8.0) > eq(low=-2, mid=4, high=-3) > lowpass(4500hz, 0.05) > highpass(100hz, 0.01) > master
}

track gtr_r {
    play riff
    using guitar2
    level 0.2
    velocity 1.0
    gate 1.0
    pan 0.7
    reverb_send 0.06
    sidechain 0.1
    out > highpass(90hz, 0.05) > saturate(8.0) > eq(low=-2, mid=4, high=-3) > lowpass(4500hz, 0.05) > highpass(100hz, 0.01) > master
}

track hoover {
    play hoover_line
    using hoover
    level 0.3
    velocity 1.0
    gate 0.95
    pan -0.1
    reverb_send 0.2
    delay_send 0.1
    sidechain 0.35
    out > highpass(150hz, 0.05) > chorus(0.6) > phaser(0.4, bars=4) > saturate(0.5) > master
}

track stabs {
    play stabs
    using stab
    level 0.6
    velocity 1.0
    pan -0.3
    delay_send 0.2
    reverb_send 0.15
    out > saturate(0.6) > highpass(250hz, 0.05) > master
}

track siren {
    play siren_hold
    using siren
    level 0.06
    velocity 1.0
    pan 0.35
    reverb_send 0.3
    delay_send 0.1
    out > highpass(300hz, 0.05) > autopan(0.6, bars=2) > master
}

track shout {
    play shout_16
    using shout
    level 0.7
    velocity 1.0
    gate 1.0
    reverb_send 0.4
    delay_send 0.15
    out > highpass(300hz, 0.05) > vowel(a) > gain(4) > saturate(1.0) > master
}

track laser {
    play laser_fill
    using laser
    level 0.25
    velocity 1.0
    pan -0.4
    delay_send 0.2
    out > highpass(400hz, 0.05) > master
}

track whoosh {
    play swell
    using whoosh
    level 0.05
    velocity 1.0
    reverb_send 0.3
    out > highpass(800hz, 0.05) > lowpass(9khz, 0.05) > autopan(0.5, hz=0.4) > master
}

master {
    in > lowpass(20000, 0.05)
       > compressor(-6, ratio=2, attack=10, release=80, makeup=0db)
       > saturate(0.3)
       > eq(low=1, high=1)
       > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# The riff alone, its filter opening
scene intro {
    auto guitar cutoff 0.5 > 0.8
    auto guitar2 cutoff 0.5 > 0.8
    track gtr_l { play riff using guitar pan -0.7 }
    track gtr_r { play riff using guitar2 pan 0.7 }
}

# The break comes in through a closed filter
scene intro2 {
    auto master cutoff 800 > 20000
    track drums { play beat_a using breaks }
    track gtr_l { play riff using guitar pan -0.7 }
    track gtr_r { play riff using guitar2 pan 0.7 }
    track crash { play crash_8 using breaks }
}

scene build {
    auto drums level 0.4 > 0.8
    auto whoosh level 0.0 > 0.12
    track drums  { play beat_roll using breaks }
    track siren  { play siren_hold using siren pan 0.35 }
    track whoosh { play swell using whoosh }
}

scene drop1 {
    track shout { play shout_16 using shout }
    track drums { play beat_a using breaks }
    track bass  { play bass_a using fuzz }
    track gtr_l { play riff using guitar pan -0.7 }
    track gtr_r { play riff using guitar2 pan 0.7 }
    track stabs { play stabs using stab pan -0.3 }
    track crash { play crash_16 using breaks }
}

# The riff steps out and the hoover takes the lead
scene hooversection {
    track drums  { play beat_a using breaks }
    track bass   { play bass_a using fuzz }
    track hoover { play hoover_line using hoover pan -0.1 }
    track crash { play crash_16 using breaks }
}

# One bar: the shout and its echo, nothing else
scene stop {
    reverb_mix = 0.6
    track shout { play shout_stop using shout }
}

scene breakdown {
    auto guitar cutoff 0.45 > 0.72
    auto guitar2 cutoff 0.45 > 0.72
    auto reese cutoff 0.1 > 0.3
    track drums { play beat_half using breaks }
    track bass  { play reese_drone using reese level 0.1 }
    track gtr_l { play riff using guitar pan -0.7 level 0.13 }
    track gtr_r { play riff using guitar2 pan 0.7 level 0.13 }
    track siren { play siren_hold using siren pan 0.35 }
}

scene build2 {
    auto drums level 0.4 > 0.8
    auto whoosh level 0.0 > 0.12
    auto master cutoff 2000 > 20000
    track drums  { play beat_roll using breaks }
    track laser  { play laser_fill using laser pan -0.4 }
    track whoosh { play swell using whoosh }
}

scene drop2 {
    track shout  { play shout_16 using shout }
    track drums  { play beat_stomp using breaks }
    track bass   { play bass_stomp using fuzz }
    track gtr_l { play riff using guitar pan -0.7 }
    track gtr_r { play riff using guitar2 pan 0.7 }
    track stabs  { play stabs using stab pan -0.3 }
    track hoover { play hoover_call using hoover pan -0.1 }
    track crash { play crash_16 using breaks }
}

# The machine room: the junk kit on top, the riff an octave up
scene switch {
    track shout { play shout_8 using shout }
    track drums { play beat_a using breaks }
    track junk  { play beat_junk using junk }
    track bass  { play bass_a using fuzz }
    track gtr_l { play riff_high using guitar pan -0.7 }
    track gtr_r { play riff_high using guitar2 pan 0.7 }
    track crash { play crash_8 using breaks }
}

scene drop3 {
    track shout  { play shout_16 using shout }
    track drums  { play beat_a using breaks }
    track bass   { play bass_a using fuzz }
    track gtr_l { play riff using guitar pan -0.7 }
    track gtr_r { play riff using guitar2 pan 0.7 }
    track hoover { play hoover_line using hoover pan -0.1 }
    track stabs  { play stabs using stab pan -0.3 }
    track crash { play crash_16 using breaks }
}

scene outro {
    auto master cutoff 20000 > 500
    track drums { play beat_a using breaks }
    track gtr_l { play riff using guitar pan -0.7 }
    track gtr_r { play riff using guitar2 pan 0.7 }
}

arrange {
    intro x8
    intro2 x8
    build x4
    drop1 x16
    hooversection x16
    stop x1
    breakdown x16
    build2 x4
    drop2 x16
    switch x8
    drop3 x16
    outro x8
}
