# ╔═══════════════════════════════════════════════╗
# ║  demo.synth — Dark Minimal Techno            ║
# ║  128 BPM, A minor, 4/4                       ║
# ╚═══════════════════════════════════════════════╝

# ── Globals ──
tempo 128
meter 4/4
scale A minor
sidechain 0.3

# ── Buses ──
bus drumBus

# ────────────────────────────────────────────────
# INSTRUMENTS
# ────────────────────────────────────────────────

# Acid bass: 3 detuned saws → resonant ladder filter
instrument bass {
  gain 1.8
  osc saw(55) as osc1
  osc saw(55, pitch=-12) as osc2
  osc square(55) as osc3
  osc1 > mix
  osc2 > mix
  osc3 > mix
  mix > gain(0.333) as prescale
  prescale > ladder(50, 0.7, ea=0.005, ed=0.3, edepth=1500) as filter
  filter > adsr(0.005, 0.2, 0.8, 0.15) as amp
  amp > out
}

# Kick drum: pitch-sweeping sine (300→55Hz) + noise click → combined saturation
instrument kick {
  gain 1.0
  pitch_osc sine(300, 55, 0.995) as body
  body > perc(0.001, 0.35) as bodyEnv
  noise() as click
  click > highpass(3000, 0.5) as clickFilt
  clickFilt > perc(0.001, 0.001) as clickEnv
  bodyEnv > mix
  clickEnv > mix
  mix > saturate(2.0) as sat
  sat > out
}

# Closed hihat: 6 metallic square waves → HP filter
instrument hat {
  gain 2.0
  fixosc square(245) as sq1
  fixosc square(306) as sq2
  fixosc square(365) as sq3
  fixosc square(430) as sq4
  fixosc square(538) as sq5
  fixosc square(615) as sq6
  sq1 > mix
  sq2 > mix
  sq3 > mix
  sq4 > mix
  sq5 > mix
  sq6 > mix
  mix > gain(0.167) as scaled
  scaled > highpass(7000, 0.3) as filt
  filt > perc(0.001, 0.04) as env
  env > out
}

# Open hihat: metallic squares, longer decay
instrument openhat {
  gain 2.0
  fixosc square(245) as sq1
  fixosc square(306) as sq2
  fixosc square(365) as sq3
  fixosc square(430) as sq4
  fixosc square(538) as sq5
  fixosc square(615) as sq6
  sq1 > mix
  sq2 > mix
  sq3 > mix
  sq4 > mix
  sq5 > mix
  sq6 > mix
  mix > gain(0.167) as scaled
  scaled > highpass(7000, 0.3) as filt
  filt > perc(0.001, 0.25) as env
  env > out
}

# Snare: tone + noise through bandpass (matching BeatsModule)
instrument snare {
  gain 2.5
  noise() as n
  fixosc sine(180) as body
  n > mix
  body > mix
  mix > bandpass(2000, 0.4) as filt
  filt > perc(0.001, 0.12) as env
  env > out
}

# Pad: thick detuned saws, slow envelope
instrument pad {
  osc saw(220) as osc1
  osc saw(221) as osc2
  osc1 > mix
  osc2 > mix
  mix > lowpass(1800, 0.3) as filt
  filt > adsr(0.8, 0.4, 0.7, 1.5) as amp
  amp > out
}

# Stab: short percussive chord hit
instrument stab {
  gain 1.3
  osc square(440) as osc1
  osc saw(441) as osc2
  osc1 > mix
  osc2 > mix
  mix > lowpass(2500, 0.35, ea=0.003, ed=0.1, edepth=3000) as filt
  filt > perc(0.003, 0.12) as env
  env > out
}

# ────────────────────────────────────────────────
# PATTERNS (each row = 4 steps = 1 beat)
# ────────────────────────────────────────────────

# Bass: driving acid line with velocity dynamics + per-step filter p-locks
pattern bassline {
  A1:0.9(cutoff=50, edepth=1800, res=0.75, gate=0.4)  -  A1:0.5(cutoff=50, edepth=600, res=0.6, gate=0.25)  -
  -  -  G1:0.7(cutoff=50, edepth=1200, res=0.7, gate=0.3)  -
  A1:0.8(cutoff=50, edepth=1500, res=0.72, gate=0.35)  -  -  A1:0.4(cutoff=50, edepth=300, res=0.5, gate=0.2)
  C2:0.6(cutoff=50, edepth=800, res=0.65, gate=0.25)  -  A1:0.7(cutoff=50, edepth=1000, res=0.68, gate=0.3)  -
}

# Bass: sparse intro line
pattern bass_intro {
  A1:0.7 - - -
  - - - -
  A1:0.6 - - -
  - - - -
}

# Bass: variation with movement
pattern bass_var {
  A1:0.9 -      E1:0.6 -
  -      G1:0.7 -      A1:0.5
  C2:0.8 -      A1:0.6 -
  E1:0.7 -      G1:0.5 -
}

# ── Drums ──

# Kick: 4 on the floor with accent dynamics
pattern kick_4x4 {
  x:0.95 - - -
  x:0.8  - - -
  x:0.9  - - -
  x:0.8  - - -
}

# Closed hats: offbeat with ghost dynamics
pattern hat_offbeat {
  -      - x:0.5 -
  -      - x:0.6 -
  -      - x:0.5 -
  -      - x:0.7 -
}

# Closed hats: driving 16ths with accent pattern
pattern hat_16th {
  x:0.5 x:0.3 x:0.6 x:0.3
  x:0.5 x:0.3 x:0.7 x:0.3
  x:0.5 x:0.3 x:0.6 x:0.3
  x:0.5 x:0.3 x:0.7 x:0.4
}

# Open hat: accents
pattern openhat_accent {
  - - - -
  - - - x:0.7
  - - - -
  - - - x:0.8
}

# Snare: beats 2 and 4
pattern snare_2_4 {
  - - - -
  x:0.85 - - -
  - - - -
  x:0.8  - - -
}

# Snare: with ghost notes
pattern snare_ghost {
  -       -      -       -
  x:0.85  -      -       x:0.3
  -       -      -       -
  x:0.8   -      x:0.25  -
}

# Pads: sustained Am (held with ties)
pattern pad_am {
  A3:0.4 .. .. ..
  ..     .. .. ..
  ..     .. .. ..
  ..     .. .. ..
}

# Pads: sustained Dm (held with ties)
pattern pad_dm {
  D3:0.4 .. .. ..
  ..     .. .. ..
  ..     .. .. ..
  ..     .. .. ..
}

# Stab: syncopated minor stab
pattern stab_hit {
  E4:0.7 -      -      -
  -      -      E4:0.5 -
  -      -      -      -
  E4:0.6 -      -      -
}

# Stab: offbeat rhythm
pattern stab_off {
  -      -      E4:0.6 -
  -      -      -      -
  -      -      E4:0.5 -
  -      E4:0.7 -      -
}

# ────────────────────────────────────────────────
# BUS FX CHAINS
# ────────────────────────────────────────────────



drumBus {
  in > compressor(-6.0, ratio=4.0, attack=10, release=80) > saturate(0.15) > master
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track bass {
  play bassline
  using bass
  velocity 0.85
  level 0.55
  gate 0.4
  pan 0.0
  delay_send 0.1
  reverb_send 0.08
  out > drive(0.25) > master
}

track kick {
  play kick_4x4
  using kick
  level 0.7
  pan 0.0
  out > drumBus
}

track hats {
  play hat_offbeat
  using hat
  velocity 0.6
  level 0.55
  pan 0.3
  out > drumBus
}

track openhat {
  play openhat_accent
  using openhat
  velocity 0.45
  level 0.4
  pan -0.2
  out > drumBus
}

track snare {
  play snare_2_4
  using snare
  velocity 0.75
  level 0.7
  pan 0.0
  reverb_send 0.06
  out > drumBus
}

track pads {
  play pad_am
  using pad
  velocity 0.4
  level 0.45
  pan 0.0
  reverb_send 0.3
  out > master
}

track stabs {
  play stab_hit
  using stab
  velocity 0.5
  level 0.4
  gate 0.3
  pan -0.4
  delay_send 0.2
  reverb_send 0.12
  out > master
}

# ────────────────────────────────────────────────
# MASTER
# ────────────────────────────────────────────────

master {
  in > eq(low=3.0, mid=1.0, high=0.5) > compressor(-6.0, ratio=4.0, attack=10, release=80, makeup=2.80) > limiter > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# Intro: kick + sparse bass
scene intro {
  track kick { play kick_4x4 using kick level 0.426 }
  track bass { play bass_intro using bass level 0.2506 velocity 0.7 }
}

# Buildup: add hats + open hat
scene buildup {
  track kick { play kick_4x4 using kick level 0.9 }
  track bass { play bass_intro using bass level 0.65 velocity 0.8 }
  track hats { play hat_offbeat using hat level 0.45 velocity 0.5 pan 0.3 }
  track openhat { play openhat_accent using openhat level 0.3 velocity 0.4 pan -0.2 }
}

# Main: full groove
scene main {
  track kick { play kick_4x4 using kick level 0.9 }
  track bass { play bassline using bass level 0.75 velocity 0.85 }
  track hats { play hat_16th using hat level 0.5 velocity 0.55 pan 0.3 }
  track openhat { play openhat_accent using openhat level 0.35 velocity 0.4 pan -0.2 }
  track snare { play snare_2_4 using snare level 0.7 velocity 0.75 }
  track pads { play pad_am using pad level 0.4 velocity 0.35 }
  track stabs { play stab_hit using stab level 0.35 velocity 0.45 pan -0.4 }
}

# Drop: bass variation + ghost snares
scene drop {
  track kick { play kick_4x4 using kick level 0.9 }
  track bass { play bass_var using bass level 0.8 velocity 0.9 }
  track hats { play hat_16th using hat level 0.55 velocity 0.6 pan 0.3 }
  track openhat { play openhat_accent using openhat level 0.4 velocity 0.45 pan -0.2 }
  track snare { play snare_ghost using snare level 0.7 velocity 0.75 }
  track stabs { play stab_off using stab level 0.4 velocity 0.5 pan 0.4 }
}

# Breakdown: pads only + sparse hats
scene breakdown {
  track pads { play pad_dm using pad level 0.5 velocity 0.4 }
  track hats { play hat_offbeat using hat level 0.3 velocity 0.35 pan 0.3 }
}

# ────────────────────────────────────────────────
# ARRANGEMENT (30 bars)
# ────────────────────────────────────────────────

arrange {
  intro x4
  buildup x4
  main x4
  drop x4
  breakdown x4
  main x4
  drop x4
  intro x2
}
