{
  "name": "tatum-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build ../wasm --target web --out-dir ../web/src/wasm-pkg --out-name tatum_wasm",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "codemirror": "^6.0.2",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.10",
    "vite-plugin-wasm": "^3.4.1"
  }
}
