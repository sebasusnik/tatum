# Liquid Probe — how close does the engine get to a liquid DnB pad today?
# Fm9 -> Dbmaj7 voicings, slow-attack unison keys + FM "rhodes" layer,
# big wet reverb bus, highpass/lowpass inserts, slow filter LFO, sidechain.
tempo 172
scale F minor
sidechain 0.4

reverb size=1.0 damp=0.25 predelay=40

module keys cloud {
    voice_mode unison
    cutoff 0.28
    resonance 0.35
    detune 0.45
    chorus_mix 0.6
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8       # one cycle every 8 bars
    lfo_depth 0.08
    attack 1.0            # 2 s: no transient, the chord blooms
    decay 0.8
    sustain 0.9
    release 1.0
}

module fm rhodes {
    algorithm two_op
    waveform sine
    mod_index 0.3
    op1_ratio 0.871       # 14:1 tine
    op0_envelope 0.01 0.9 0.35 0.6
    op1_envelope 0.01 0.3 0.05 0.3
    chorus_mix 0.4
    lfo_target amplitude
    lfo_waveform sine
    lfo_sync free
    lfo_rate 0.03         # ~0.7 Hz tremolo
    lfo_depth 0.15
}

module bass sub {
    cutoff 0.1
    cutoff_env 0.0
    resonance 0.05
    osc1_wave saw
    osc2_pitch 0.5
    attack 0.1
    decay 0.5
    sustain 0.9
    release 0.3
}

module beats kit {
    kick_level 0.9
    kick_decay 0.35
    kick_click 0.4
    snare_level 0.8
    snare_decay 0.3
    snare_snap 0.6
    hihat_level 0.5
    hihat_decay 0.25
}

# Fm9 for two bars, Dbmaj7 for two bars. Held with ties; the loop sustains.
pattern voicings { Fm9:0.6 ..*31  Dbmaj9:0.6 ..*31 }

pattern rhodes_hits {
    [F3 Ab3 C4 Eb4 G4]:0.45 .. .. .. .. .. .. .. .. .. - - - - - -
    - - - - [F3 Ab3 C4 Eb4]:0.35 .. .. .. .. .. - - - - - -
    [Db3 F3 Ab3 C4]:0.45 .. .. .. .. .. .. .. .. .. - - - - - -
    - - - - [Db3 F3 Ab3 C4 Eb4]:0.35 .. .. .. .. .. - - - - - -
}

pattern sub_line {
    F1:0.9 .. .. .. .. .. .. .. .. .. .. .. - - F1:0.7 ..
    .. .. .. .. .. .. .. .. .. .. .. .. .. .. .. ..
    Db1:0.9 .. .. .. .. .. .. .. .. .. .. .. - - Db1:0.7 ..
    .. .. .. .. .. .. .. .. .. .. .. .. .. .. .. ..
}

pattern amen_ish {
    kick:  X - - -  - - x -  - - X -  - - - -
    snare: - - - -  X - - -  - - - x  X - - -
    hat:   x - x -  x - x -  x - x -  x - x x
}

track pad    { play voicings using cloud level 0.15 reverb_send 0.4 delay_send 0.1 sidechain 0.5
               out > highpass(300, 0.4) > lowpass(3200, 0.3, lfo_bars=16, lfo_depth=1200) > phaser(0.35, bars=6) > autopan(0.3, bars=8) > master }
track rhodes { play rhodes_hits using rhodes level 0.15 reverb_send 0.6 delay_send 0.25
               out > highpass(220, 0.3) > vowel(o, a, bars=8, mix=0.5) > master }
track sub    { play sub_line using sub level 0.4 out > master }
track drums  { play amen_ish using kit level 0.55 out > saturate(0.3) > master }

master { in > eq(low=1.0, mid=-0.5, high=1.0) > compressor(-12, ratio=3, attack=5, release=80, makeup=1) > limiter > out }

scene cloud_only {
    track pad    { play voicings using cloud }
    track rhodes { play rhodes_hits using rhodes }
}

scene full {
    track pad    { play voicings using cloud }
    track rhodes { play rhodes_hits using rhodes }
    track sub    { play sub_line using sub }
    track drums  { play amen_ish using kit }
}

arrange { cloud_only x8  full x8 }
