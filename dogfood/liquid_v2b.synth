# liquid_v2b — "FM electric piano cloud"  (revision 2)
# Same brief, same chords, same arrangement, same reverb architecture and same drums as
# liquid_v2a. The only things that change are the source and one movement effect.
#
# Source: a dual_pairs FM electric piano (tine ratio 14:1, low mod index, slow tremolo)
# instead of the unison saw keys, with the keys pad kept as a quiet layer underneath.
# The `wash` plate carries a 12-bar vowel morph instead of A's phaser.
#
# Rev 2, same cleanup as A: chorus down (0.50 -> 0.28 on the piano, 0.60 -> 0.30 on the
# keys layer), keys detune 0.42 -> 0.24, operator feedback down, vowel mix 0.45 -> 0.30,
# global reverb size 1.0 -> 0.8 with damp 0.45, and the intro scored well below the
# groove with the keys layer removed so it is the cleanest thing in the track.
#
# Chords: Fm9 -> Dbmaj9 -> Abmaj9 -> Eb7sus4, two bars each, held with ties (8-bar loop).
# Arrangement: intro 8 (cloud alone) / groove 8 (drums in) / frozen 4 / full 12.

tempo 172
scale F minor
humanize 0.03 timing 0.012
sidechain 0.45

delay sync=dotted_eighth feedback=0.38 filter=0.6 sidechain=0.4
reverb size=0.8 damp=0.45 predelay=60 sidechain=0.5

# Movement and ducking on the tail itself.
reverb_return { in > highpass(280, 0.25)
                   > lowpass(2400, 0.25, lfo_bars=16, lfo_depth=1100)
                   > autopan(0.35, bars=8)
                   > out }
delay_return  { in > highpass(400, 0.2) > out }

# ---------------------------------------------------------------- modules

# Main cloud source: FM electric piano. dual_pairs = two carrier/modulator pairs.
# Pair 1 is the tine: carrier at 1.0, modulator at 14.0 (the classic Rhodes bark).
# Pair 2 is the body: carrier at 1.0, modulator at 2.0, a warm hollow octave.
# Low mod index so it stays mellow wood, not a DX bell. The trick that makes it a pad
# and not a piano: the *modulator* envelopes also have slow attacks, so the tine
# brightness swells in over a second and settles back, instead of striking.
module fm tines {
    algorithm dual_pairs
    waveform sine
    mod_index 0.30             # low: no clang, and nothing for the reverb to turn into grit
    feedback 0.03              # rev 1 had 0.05; operator feedback is the FM equivalent of howl
    op0_ratio 0.032            # 1.0 — tine carrier
    op1_ratio 0.871            # 14.0 — the tine
    op2_ratio 0.032            # 1.0 — body carrier
    op3_ratio 0.097            # 2.0 — hollow octave modulator
    op0_envelope 1.0 0.9 0.9 1.0      # 2 s attack: no transient survives
    op1_envelope 0.9 0.7 0.35 0.8     # brightness blooms, then settles back
    op2_envelope 1.0 0.9 0.85 1.0
    op3_envelope 0.85 0.8 0.5 0.9
    chorus_mix 0.28            # rev 1 had 0.5
    lfo_target amplitude
    lfo_waveform sine
    lfo_sync bars_2            # slow tremolo, the electric-piano breath
    lfo_depth 0.12
    vibrato_rate 0.22
    vibrato_depth 0.03
}

# The keys pad kept underneath, quiet: it fills the gaps between the FM partials.
module keys air {
    voice_mode poly
    detune 0.24                # rev 1 had 0.42
    chorus_mix 0.3             # rev 1 had 0.6
    cutoff 0.30
    resonance 0.18
    attack 1.0
    decay 0.9
    sustain 0.92
    release 1.0
    lfo_target cutoff
    lfo_waveform sine
    lfo_sync bars_16           # cycle 2: 16 bars
    lfo_depth 0.12
    vibrato_rate 0.3
    vibrato_depth 0.03
}

# The only layer that reaches the master dry: a tighter two_op version of the same
# piano, so the chord changes read. Its LFO walks the mod index, so the timbre drifts.
module fm tines_body {
    algorithm two_op
    waveform sine
    mod_index 0.36
    feedback 0.05
    op0_ratio 0.032
    op1_ratio 0.871
    op0_envelope 0.8 0.8 0.85 1.0     # ~0.45 s: still soft, but the change reads
    op1_envelope 0.7 0.6 0.3 0.7
    chorus_mix 0.2
    lfo_target mod_index
    lfo_waveform triangle
    lfo_sync bars_4
    lfo_depth 0.12
    vibrato_rate 0.25
    vibrato_depth 0.03
}

module bass sub_osc {
    cutoff 0.12
    cutoff_env 0.05
    resonance 0.06
    glide 0.1
    osc1_wave saw
    osc2_pitch 0.5
    osc3_pitch 0.5
    attack 0.2
    decay 0.6
    sustain 0.95
    release 0.45
    lfo_target cutoff
    lfo_waveform sine
    lfo_sync bars_4
    lfo_depth 0.05
}

module beats kit {
    kick_level 0.95
    kick_decay 0.32
    kick_pitch 0.28
    kick_click 0.35
    kick_drive 0.15
    snare_level 0.85
    snare_decay 0.28
    snare_snap 0.55
    snare_drive 0.1
    hihat_level 0.45
    hihat_decay 0.2
    hihat_pan 0.25
}

# ---------------------------------------------------------------- patterns

pattern voicings {
    Fm9:0.6 ..*31
    Dbmaj9:0.6 ..*31
    Abmaj9:0.55 ..*31
    Eb7sus4:0.6 ..*31
}

pattern sub_line {
    F1:0.85 ..*13 - -
    F1:0.7 ..*13 - -
    Db1:0.85 ..*13 - -
    Db1:0.7 ..*13 - -
    Ab1:0.85 ..*13 - -
    Ab1:0.7 ..*13 - -
    Eb1:0.85 ..*13 - -
    Eb1:0.7 ..*13 - -
}

# Simple two-step. Context, not the point.
pattern brk {
    kick:  X - - -  - - - -  - - x -  - - - -   X - - -  - - - o  - - x -  - - - -
    snare: - - - -  X - - -  - - - o  X - - -   - - - -  X - - -  - - - -  X - - o
    hat:   x - o -  x - o -  x - o -  x - o x   x - o -  x - o -  x - o -  o - x o
}

# ---------------------------------------------------------------- buses

bus wash
# Short 100% wet plate, the near field. The vowel morph is the B-variant character:
# a slow throaty movement that suits the FM piano better than a phaser would.
wash { in > reverb(0.45)
          > gain(0.4)
          > vowel(o, a, bars=12, mix=0.3)
          > autopan(0.3, bars=10)
          > master }

bus kitbus
kitbus { in > compressor(-10, ratio=3.5, attack=8, release=70) > saturate(0.25) > master }

# ---------------------------------------------------------------- tracks
#
# NOTE: every `track ... { ... out > ... }` is on ONE line on purpose. A track chain
# written across several lines is silently truncated at the first newline — the rest of
# the chain AND the destination are dropped, the track falls back to `> master`, and
# `synth_check` still reports ok. Both of these files were wrong that way until the
# chains were flattened. Bus, master and reverb_return chains do NOT have this problem.

# gain(4.2) / gain(3.8): fm at a given track level runs ~12 dB under unison keys, so the
# make-up lives in the chain and the scene levels stay on the same scale as liquid_v2a.
track cloud { play voicings using tines level 0.3 reverb_send 0.7 delay_send 0.1 sidechain 0.5 out > highpass(300, 0.25) > lowpass(4000, 0.2, lfo_bars=16, lfo_depth=1500) > gain(4.2) > wash }
track layer { play voicings using air level 0.12 reverb_send 0.5 sidechain 0.4 out > highpass(340, 0.25) > lowpass(3800, 0.2, lfo_bars=14, lfo_depth=1500) > wash }
track body  { play voicings using tines_body level 0.1 reverb_send 0.3 delay_send 0.15 sidechain 0.6 out > highpass(330, 0.3) > lowpass(3400, 0.25, lfo_bars=9, lfo_depth=1200) > chorus(0.25) > autopan(0.25, bars=6) > gain(3.8) > master }
track sub   { play sub_line using sub_osc level 0.42 sidechain 0.2 out > lowpass(260, 0.1) > saturate(0.2) > master }
track drums { play brk using kit level 0.55 reverb_send 0.08 out > kitbus }

master { in > tilt(0)
            > eq(low=1.0, mid=-1.0, high=0.5)
            > compressor(-6, ratio=2, attack=15, release=180, makeup=1.15)
            > limiter(0.95)
            > out }

# ---------------------------------------------------------------- scenes

# Cloud alone, and deliberately the cleanest thing in the track: one source, no air
# layer, low wet, dark tilt. Nothing ducks here (no kick), so it is scored lowest.
scene intro {
    reverb_mix = 0.45
    auto master tilt -0.45 > -0.15
    auto tines mod_index 0.22 > 0.32
    track cloud { play voicings using tines level 0.12 }
}

scene groove {
    reverb_mix = 0.7
    auto master tilt -0.1 > 0.02
    auto tines mod_index 0.32 > 0.27 > 0.34
    track cloud { play voicings using tines level 0.193 }
    track layer { play voicings using air level 0.03086 }
    track body  { play voicings using tines_body level 0.089 }
    track sub   { play sub_line using sub_osc level 0.369 }
    track drums { play brk using kit level 0.64 }
}

# Break: pads silent, global hall frozen, the tail is the only pad sound.
scene frozen {
    reverb_freeze = 1
    reverb_mix = 0.38
    auto master tilt 0.0 > -0.35
    track sub   { play sub_line using sub_osc level 0.18 }
    track drums { play brk using kit level 0.26 }
}

scene full {
    reverb_mix = 0.78
    auto master tilt -0.15 > 0.06
    auto tines mod_index 0.28 > 0.40 > 0.30
    auto air cutoff 0.28 > 0.38
    track cloud { play voicings using tines level 0.197 }
    track layer { play voicings using air level 0.04025 }
    track body  { play voicings using tines_body level 0.099 }
    track sub   { play sub_line using sub_osc level 0.566 }
    track drums { play brk using kit level 0.765 }
}

arrange { intro x8  groove x8  frozen x4  full x12 }
