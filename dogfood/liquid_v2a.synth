# liquid_v2a — "keys cloud"  (revision 2)
# Liquid DnB pad, Calibre / LTJ Bukem school. 172 BPM, F minor, 32 bars.
#
# Rev 2 answers the listener: rev 1 "saturates in the intro" and had a "feedback-howl".
# Neither was clipping. The causes were sound design: detune 0.55 + chorus 0.7 on a
# 5-note unison chord beats hard enough to read as distortion, an 8-stage phaser at
# feedback 0.5 rings, and size 1.0 on the global reverb piled a held pad into a roar.
# Everything here is gentler: detune 0.26, chorus 0.30, phaser 4 stages / mix 0.30 /
# feedback 0.20, reverb size 0.8 with damp 0.45 and a dark return.
#
# Two reverbs, which is how this is actually built:
#   - the long hall is the GLOBAL send. `sidechain=0.5` ducks the return against the
#     kick, so the tail itself pumps — the thing that makes the pad flow under the break.
#     `reverb_return` carries the movement on the tail: a 16-bar lowpass and an 8-bar
#     autopan, applied to the cloud rather than to what feeds it.
#   - the near field is the `wash` bus: a short 100%-wet plate carrying the phaser.
# No pad reaches the master dry except `body`, which exists only to keep the chords
# readable.
#
# Chords: Fm9 -> Dbmaj9 -> Abmaj9 -> Eb7sus4, two bars each, held with ties (8-bar loop).
# Arrangement: intro 8 (cloud alone) / groove 8 (drums in) / frozen 4 / full 12.

tempo 172
scale F minor
humanize 0.03 timing 0.012
sidechain 0.45

delay sync=dotted_eighth feedback=0.38 filter=0.6 sidechain=0.4
reverb size=0.8 damp=0.45 predelay=60 sidechain=0.5

# Movement and ducking on the tail itself.
reverb_return { in > highpass(280, 0.25)
                   > lowpass(2400, 0.25, lfo_bars=16, lfo_depth=1100)
                   > autopan(0.35, bars=8)
                   > out }
delay_return  { in > highpass(400, 0.2) > out }

# ---------------------------------------------------------------- modules

# Main cloud source. Gentle: the reverb, not the detune, does the washing out.
module keys haze {
    voice_mode unison
    detune 0.26            # rev 1 had 0.55, which beat like distortion
    chorus_mix 0.3         # rev 1 had 0.7
    cutoff 0.30
    resonance 0.18         # rev 1 had 0.32; with an LFO on the cutoff it rang
    attack 1.0             # 2 s bloom: no transient survives into the reverb
    decay 0.85
    sustain 0.95
    release 1.0
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8        # cycle 1: 8 bars
    lfo_depth 0.09
    vibrato_rate 0.22
    vibrato_depth 0.03
}

# Octave-up air layer, a different detune so it beats gently against `haze`.
module keys air {
    voice_mode unison
    detune 0.16
    chorus_mix 0.22
    cutoff 0.40
    resonance 0.15
    attack 1.0
    decay 0.9
    sustain 0.9
    release 1.0
    lfo_target cutoff
    lfo_waveform sine
    lfo_sync bars_16       # cycle 2: 16 bars
    lfo_depth 0.12
    vibrato_rate 0.3
    vibrato_depth 0.03
}

# The only pad that reaches the master dry: keeps the chord changes readable.
module keys warm {
    voice_mode octave
    detune 0.2
    chorus_mix 0.18
    cutoff 0.34
    resonance 0.18
    attack 0.82            # ~0.5 s: still no transient, but the change reads
    decay 0.8
    sustain 0.9
    release 1.0
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_4
    lfo_depth 0.07
    vibrato_rate 0.25
    vibrato_depth 0.03
}

module bass sub_osc {
    cutoff 0.12
    cutoff_env 0.05
    resonance 0.06
    glide 0.1
    osc1_wave saw
    osc2_pitch 0.5
    osc3_pitch 0.5
    attack 0.2
    decay 0.6
    sustain 0.95
    release 0.45
    lfo_target cutoff
    lfo_waveform sine
    lfo_sync bars_4
    lfo_depth 0.05
}

module beats kit {
    kick_level 0.95
    kick_decay 0.32
    kick_pitch 0.28
    kick_click 0.35
    kick_drive 0.15
    snare_level 0.85
    snare_decay 0.28
    snare_snap 0.55
    snare_drive 0.1
    hihat_level 0.45
    hihat_decay 0.2
    hihat_pan 0.25
}

# ---------------------------------------------------------------- patterns

pattern voicings {
    Fm9:0.6 ..*31
    Dbmaj9:0.6 ..*31
    Abmaj9:0.55 ..*31
    Eb7sus4:0.6 ..*31
}

pattern voicings_hi {
    Fm9/4:0.5 ..*31
    Dbmaj9/4:0.5 ..*31
    Abmaj9/4:0.45 ..*31
    Eb7sus4/4:0.5 ..*31
}

pattern sub_line {
    F1:0.85 ..*13 - -
    F1:0.7 ..*13 - -
    Db1:0.85 ..*13 - -
    Db1:0.7 ..*13 - -
    Ab1:0.85 ..*13 - -
    Ab1:0.7 ..*13 - -
    Eb1:0.85 ..*13 - -
    Eb1:0.7 ..*13 - -
}

# Simple two-step. Context, not the point.
pattern brk {
    kick:  X - - -  - - - -  - - x -  - - - -   X - - -  - - - o  - - x -  - - - -
    snare: - - - -  X - - -  - - - o  X - - -   - - - -  X - - -  - - - -  X - - o
    hat:   x - o -  x - o -  x - o -  x - o x   x - o -  x - o -  x - o -  o - x o
}

# ---------------------------------------------------------------- buses

bus wash
# Short 100% wet plate, the near field. The phaser is the A-variant character:
# 4 stages, low feedback, so it swirls instead of howling.
wash { in > reverb(0.45)
          > gain(0.4)
          > phaser(0.3, bars=12, stages=4, feedback=0.2)
          > autopan(0.3, bars=10)
          > master }

bus kitbus
kitbus { in > compressor(-10, ratio=3.5, attack=8, release=70) > saturate(0.25) > master }

# ---------------------------------------------------------------- tracks
#
# NOTE: every `track ... { ... out > ... }` is on ONE line on purpose. A track chain
# written across several lines is silently truncated at the first newline — the rest of
# the chain AND the destination are dropped, the track falls back to `> master`, and
# `synth_check` still reports ok. Both of these files were wrong that way until the
# chains were flattened. Bus, master and reverb_return chains do NOT have this problem.

track cloud { play voicings using haze level 0.3 reverb_send 0.7 delay_send 0.1 sidechain 0.5 out > highpass(300, 0.25) > lowpass(4000, 0.2, lfo_bars=16, lfo_depth=1500) > wash }
track layer { play voicings_hi using air level 0.12 reverb_send 0.5 sidechain 0.4 out > highpass(500, 0.2) > lowpass(5500, 0.2, lfo_bars=14, lfo_depth=2000) > wash }
track body  { play voicings using warm level 0.1 reverb_send 0.3 delay_send 0.15 sidechain 0.6 out > highpass(330, 0.3) > lowpass(3400, 0.25, lfo_bars=9, lfo_depth=1200) > chorus(0.25) > autopan(0.25, bars=6) > master }
track sub   { play sub_line using sub_osc level 0.42 sidechain 0.2 out > lowpass(260, 0.1) > saturate(0.2) > master }
track drums { play brk using kit level 0.55 reverb_send 0.08 out > kitbus }

master { in > tilt(0)
            > eq(low=1.0, mid=-1.0, high=0.5)
            > compressor(-6, ratio=2, attack=15, release=180, makeup=1.15)
            > limiter(0.95)
            > out }

# ---------------------------------------------------------------- scenes

# Cloud alone, and deliberately the cleanest thing in the track: one source, no air
# layer, low wet, dark tilt. Nothing ducks here (no kick), so it is scored lowest.
scene intro {
    reverb_mix = 0.45
    auto master tilt -0.45 > -0.15
    auto haze cutoff 0.20 > 0.30
    track cloud { play voicings using haze level 0.12 }
}

scene groove {
    reverb_mix = 0.7
    auto master tilt -0.1 > 0.02
    auto haze cutoff 0.30 > 0.26 > 0.33
    track cloud { play voicings using haze level 0.22 }
    track layer { play voicings_hi using air level 0.08 }
    track body  { play voicings using warm level 0.1 }
    track sub   { play sub_line using sub_osc level 0.45 }
    track drums { play brk using kit level 0.78 }
}

# Break: pads silent, global hall frozen, the tail is the only pad sound.
scene frozen {
    reverb_freeze = 1
    reverb_mix = 0.28
    auto master tilt 0.0 > -0.35
    track sub   { play sub_line using sub_osc level 0.18 }
    track drums { play brk using kit level 0.26 }
}

scene full {
    reverb_mix = 0.78
    auto master tilt -0.15 > 0.06
    auto haze cutoff 0.28 > 0.38 > 0.30
    auto air cutoff 0.36 > 0.44
    track cloud { play voicings using haze level 0.378 }
    track layer { play voicings_hi using air level 0.162 }
    track body  { play voicings using warm level 0.189 }
    track sub   { play sub_line using sub_osc level 0.666 }
    track drums { play brk using kit level 0.9 }
}

arrange { intro x8  groove x8  frozen x4  full x12 }
