# deephouse.synth — MCP dogfood composition
# 122 BPM, F minor, 32 bars: intro(4) groove(8) build(4) drop(8) breakdown(4) outro(4)

tempo 122
meter 4/4
scale F minor
sidechain 0.35
swing 0.58
humanize 0.3 timing 0.15

# ────────────────────────────────────────────────
# MODULE INSTRUMENTS
# ────────────────────────────────────────────────

module bass sub_bass {
    cutoff 0.14
    cutoff_env 0.5
    resonance 0.45
    glide 0.15
    osc2_pitch 0.5
    osc1_wave saw
    osc2_wave saw
    keytrack 0.35
    attack 0.005
    decay 0.3
    sustain 0.75
    release 0.18
}

module bass arp_lead {
    cutoff 0.4
    cutoff_env 0.6
    resonance 0.55
    glide 0.02
    osc1_wave square
    osc2_wave saw
    osc2_pitch 0.55
    keytrack 0.2
    attack 0.001
    decay 0.18
    sustain 0.4
    release 0.12
}

module fm stab_fm {
    algorithm two_op
    mod_index 0.6
    feedback 0.12
    waveform sine
    attack 0.001
    decay 0.14
    sustain 0.12
    release 0.1
    op0_envelope 0.001 0.14 0.1 0.1
    op1_envelope 0.001 0.1 0.05 0.08
}

module keys warm_pad {
    voice_mode unison
    cutoff 0.2
    resonance 0.15
    detune 0.2
    chorus_mix 0.35
    attack 0.9
    decay 0.6
    sustain 0.8
    release 1.0
}

module beats drums {
    kick_level 1.0
    kick_decay 0.5
    kick_click 0.3
    kick_pitch 0.3
    snare_level 0.7
    snare_decay 0.35
    snare_pan 0.05
    hihat_level 0.7
    hihat_decay 0.4
    hihat_pan 0.25
    clap_level 0.85
    clap_pan -0.1
}

# ────────────────────────────────────────────────
# PATTERNS
# ────────────────────────────────────────────────

pattern silence {
    - - - -
    - - - -
    - - - -
    - - - -
}

# Drums

pattern drums_intro {
    kick: x - - - - - - - - - - - - - - -
    hat:  - - - - - - - - - - - - - - x -
}

pattern drums_groove {
    kick: X - - - X - - - X - - - X - - -
    hat:  - - x - - - x - - - x - - - x -
    clap: - - - - X - - - - - - - X - - -
}

pattern drums_build {
    kick: X - - - X - - - X - - - X - - -
    hat:  - - x - - - x - - - x - - x x x
    clap: - - - - X - - - - - - - X - - -
}

pattern drums_drop {
    kick: X - - - X - - - X - - - X - x -
    hat:  x - x - x - x - x - x - x - x -
    clap: - - - - X - - - - - - - X - - X
}

pattern drums_breakdown {
    kick: - - - - - - - - - - - - - - - -
    hat:  - - o - - - x - - - o - - - x -
}

pattern drums_outro {
    kick: x - - - - - - - x - - - - - - -
    hat:  - - - - - - - - - - - - - - x -
}

# Bass — F minor root motion, ties, slides, per-step filter locks

pattern bass_intro {
    F1:0.4 - .. -
    - - - -
    F1:0.35 - - -
    - - - -
}

pattern bass_groove {
    F1:0.85(edepth=0.50, res=0.60) - - F1:0.5(edepth=0.30, res=0.45)
    - Ab1:0.7(edepth=0.45, res=0.55) .. -
    ~Eb1:0.75(edepth=0.48, res=0.58) - Eb1:0.4(edepth=0.25, res=0.40) -
    C1:0.6(edepth=0.40, res=0.50) - - Ab1:0.55(edepth=0.35, res=0.48)
}

pattern bass_build {
    F1:0.8(edepth=0.50, res=0.60) - F1:0.5(edepth=0.35, res=0.50) -
    ~Ab1:0.75(edepth=0.50, res=0.58) - - Ab1:0.5(edepth=0.30, res=0.45)
    Eb1:0.7(edepth=0.45, res=0.55) - Eb1:0.5(edepth=0.30, res=0.45) -
    C1:0.65(edepth=0.40, res=0.50) - Db1:0.5(edepth=0.30, res=0.42) -
}

pattern bass_drop {
    F1:0.9(edepth=0.55, res=0.62) - - F1:0.55(edepth=0.35, res=0.48)
    - Ab1:0.8(edepth=0.50, res=0.58) .. -
    ~Eb1:0.82(edepth=0.52, res=0.60) - Eb1:0.5(edepth=0.30, res=0.45) -
    C1:0.7(edepth=0.42, res=0.52) - - Ab1:0.6(edepth=0.38, res=0.50)
}

pattern bass_breakdown {
    F1:0.5 .. .. ..
    ..     .. .. ..
    ..     .. .. ..
    ..     .. .. ..
}

pattern bass_outro {
    F1:0.35 - - -
    - - - -
    F1:0.3 - - -
    - - - -
}

# FM stab — chords on off-beats

pattern stab_chords {
    - - [F3 Ab3 C4]:0.5 -
    - - - -
    - - [F3 Ab3 C4]:0.45 -
    - [Ab3 C4 Eb4]:0.5 - -
}

pattern stab_drop {
    - [F3 Ab3 C4]:0.55 - -
    - - [Ab3 C4 Eb4]:0.5 -
    - [F3 Ab3 C4]:0.5 - -
    - - [Ab3 C4 Eb4]:0.55 -
}

# Warm pad — sustained Fm chord, tied across 2 bars

pattern pad_fm {
    [F3 Ab3 C4]:0.4 .. .. ..
    ..              .. .. ..
    ..              .. .. ..
    ..              .. .. ..
    ..              .. .. ..
    ..              .. .. ..
    ..              .. .. ..
    ..              .. .. ..
}

# Arp lead — held chord for the arpeggiator to chew on

pattern arp_lead_pat {
    [F3 Ab3 C4 Eb4] .. .. ..
    ..              .. .. ..
    ..              .. .. ..
    ..              .. .. ..
}

# ────────────────────────────────────────────────
# BUS FX
# ────────────────────────────────────────────────

bus drumBus



drumBus {
    in > compressor(-8.0, ratio=4.0, attack=8, release=60) > saturate(0.08) > master
}

# ────────────────────────────────────────────────
# TRACKS (top-level defaults, reconfigured per scene)
# ────────────────────────────────────────────────

track bass {
    play bass_intro
    using sub_bass
    velocity 0.8
    level 0.5
    gate 0.9
    pan 0.0
    delay_send 0.05
    reverb_send 0.08
    out > drive(0.15) > master
}

track drums {
    play drums_groove
    using drums
    velocity 1.0
    level 0.5
    pan 0.0
    out > drumBus
}

track stab {
    play silence
    using stab_fm
    velocity 0.5
    level 0.4
    gate 0.25
    pan -0.25
    delay_send 0.2
    reverb_send 0.15
    out > master
}

track pad {
    play silence
    using warm_pad
    velocity 0.5
    level 0.4
    pan 0.05
    reverb_send 0.3
    out > master
}

track lead {
    play silence
    using arp_lead
    velocity 0.6
    level 0.35
    gate 0.7
    pan 0.15
    delay_send 0.15
    reverb_send 0.2
    arp up rate=16 gate=0.6 octaves=2
    out > master
}

# ────────────────────────────────────────────────
# MASTER
# ────────────────────────────────────────────────

master {
    in > eq(low=3.0, mid=1.2, high=0.8) > compressor(-8.0, ratio=3.5, attack=10, release=100, makeup=2.0) > limiter > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# Intro (4 bars): quietest — just kick pulse + sparse sub bass
scene intro {
    track drums { play drums_intro using drums velocity 0.9 level 0.4 out > drumBus }
    track bass  { play bass_intro  using sub_bass velocity 0.6 level 0.35 out > drive(0.1) > master }
}

# Groove (8 bars): full four-on-the-floor groove, stab + pad enter
scene groove {
    track drums { play drums_groove using drums    velocity 1.0 level 0.55 out > drumBus }
    track bass  { play bass_groove  using sub_bass  velocity 0.85 level 0.55 out > drive(0.15) > master }
    track stab  { play stab_chords  using stab_fm   velocity 0.55 level 0.4 delay_send 0.2 reverb_send 0.15 out > master }
    track pad   { play pad_fm       using warm_pad  velocity 0.5 level 0.4 reverb_send 0.3 out > master }
}

# Build (4 bars): rising energy, slow pad filter sweep
scene build {
    auto warm_pad cutoff 0.18 > 0.55

    track drums { play drums_build using drums    velocity 1.0 level 0.6  out > drumBus }
    track bass  { play bass_build  using sub_bass  velocity 0.9 level 0.58 out > drive(0.18) > master }
    track stab  { play stab_chords using stab_fm   velocity 0.6 level 0.42 delay_send 0.2 reverb_send 0.15 out > master }
    track pad   { play pad_fm      using warm_pad  velocity 0.55 level 0.45 reverb_send 0.32 out > master }
}

# Drop (8 bars): loudest — full drums, bass, stab, pad + filtered arp lead
scene drop {
    auto sub_bass cutoff 0.16 > 0.26

    track drums { play drums_drop    using drums    velocity 1.0 level 0.65 out > drumBus }
    track bass  { play bass_drop     using sub_bass  velocity 0.95 level 0.62 out > drive(0.2) > master }
    track stab  { play stab_drop     using stab_fm   velocity 0.65 level 0.45 delay_send 0.18 reverb_send 0.12 out > master }
    track pad   { play pad_fm        using warm_pad  velocity 0.5 level 0.4 reverb_send 0.3 out > master }
    track lead  { play arp_lead_pat  using arp_lead  velocity 0.65 level 0.4 gate 0.7 delay_send 0.15 reverb_send 0.2 arp up rate=16 gate=0.6 octaves=2 out > master }
}

# Breakdown (4 bars): pull back — pad + sparse hats, no kick
scene breakdown {
    auto warm_pad cutoff 0.3 > 0.5 > 0.2

    track drums { play drums_breakdown using drums    velocity 0.75 level 0.35 out > drumBus }
    track bass  { play bass_breakdown  using sub_bass  velocity 0.5 level 0.4 out > master }
    track pad   { play pad_fm          using warm_pad  velocity 0.55 level 0.48 reverb_send 0.42 out > master }
}

# Outro (4 bars): fade down — quietest along with intro
scene outro {
    auto sub_bass cutoff_env 0.5 > 0.2

    track drums { play drums_outro using drums    velocity 0.8 level 0.35 out > drumBus }
    track bass  { play bass_outro  using sub_bass  velocity 0.55 level 0.35 out > drive(0.1) > master }
    track pad   { play pad_fm      using warm_pad  velocity 0.3 level 0.28 reverb_send 0.4 out > master }
}

# ────────────────────────────────────────────────
# ARRANGEMENT (32 bars)
# ────────────────────────────────────────────────

arrange {
    intro x4
    groove x8
    build x4
    drop x8
    breakdown x4
    outro x4
}
