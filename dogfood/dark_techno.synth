# dark_techno.synth — Dark Techno (Sunn O))) drone x Sven Vaeth groove)
# 132 BPM, E phrygian, 48 bars.
# Section map: intro(8) kick_enter(8) groove(8) breakdown(8) drop(12) outro(4)

tempo 132
meter 4/4
scale E phrygian
swing 0.55
sidechain 0.5

reverb size=0.9 damp=0.3 predelay=30 sidechain=0.5
reverb_return { in > lowpass(2200, 0.3, lfo_bars=16, lfo_depth=900) > autopan(0.35, bars=12) > out }
delay sync=dotted_eighth feedback=0.35 filter=0.4

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

# Sunn O))) drone: stacked square/saw across three octaves, low cutoff, high
# resonance, a 16-bar filter LFO so it never sits still even when "static".
module bass drone {
    cutoff 0.15
    cutoff_env 0.0
    resonance 0.78
    osc1_wave square
    osc2_wave saw
    osc2_pitch 0.25
    osc3_wave square
    osc3_pitch 0.75
    attack 0.32
    decay 0.4
    sustain 0.95
    release 0.85
    glide 0.1
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_16
    lfo_depth 0.2
}

# Doom-organ overtones an octave above the drone: fifth voicing,
# saturated and phased for movement.
module keys doomorgan {
    voice_mode fifth
    cutoff 0.35
    resonance 0.4
    detune 0.3
    chorus_mix 0.35
    attack 0.55
    decay 0.5
    sustain 0.9
    release 0.9
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 0.12
    vibrato_rate 0.2
    vibrato_depth 0.05
}

# Sven Vaeth kit: hard, dry, driven kick.
module beats kit {
    kick_level 1.0
    kick_decay 0.42
    kick_pitch 0.3
    kick_click 0.5
    kick_drive 0.55
    clap_level 0.85
    clap_pan 0.1
    hihat_level 0.6
    hihat_decay 0.28
    hihat_pitch 0.42
    hihat_pan 0.25
}

# Rolling 16th-note sub bassline that answers the kick.
module bass pulse {
    cutoff 0.32
    cutoff_env 0.6
    resonance 0.5
    glide 0.03
    osc1_wave saw
    osc2_wave square
    osc2_pitch 0.5
    attack 0.0
    decay 0.18
    sustain 0.3
    release 0.14
}

# Tight metallic FM stab, interjecting between kicks in the drop.
module fm stab {
    algorithm two_op
    waveform sine
    mod_index 0.5
    feedback 0.2
    op0_envelope 0.001 0.12 0.0 0.08
    op1_envelope 0.001 0.08 0.0 0.05
}

# ────────────────────────────────────────────────
# PATTERNS
# ────────────────────────────────────────────────

# Drone chords — one chord per scene, held with ties for the whole section.
# NOTE: "E5" is NOT usable as a chord symbol here — the parser greedily reads
# root+digit as an absolute note (E, octave 5) whenever the octave digit is
# 0..6, so "E5" means the note E5, not the power-chord quality "5", and a
# trailing "/octave" on it is a parse error ("unexpected slash"). Used
# Esus4 for the drop instead: still a big, open, harder-edged voicing.
pattern drone_em8    { Em/2:0.7     ..*127 }
pattern drone_cm8    { Cm/2:0.7     ..*127 }
pattern drone_edrop12 { Esus4/2:0.75 ..*191 }
pattern drone_em4    { Em/2:0.55    ..*63 }

pattern organ_em8    { Em/3:0.5      ..*127 }
pattern organ_cm8    { Cm/3:0.5      ..*127 }
pattern organ_edrop12 { Esus4/3:0.55  ..*191 }
pattern organ_em4    { Em/3:0.35     ..*63 }

# Drums
pattern beat_enter {
    kick: X - - - X - - - X - - - X - - -
    hat:  - x:0.3 - x:0.3  - x:0.3 - x:0.3  - x:0.3 - x:0.3  - x:0.3 - x:0.3
}

pattern beat_groove {
    kick:    X - - - X - - - X - - - X - - -
    clap:    - - - - X - - - - - - - X - - -
    hat:     x - o?0.4 - x - x?0.5 - x - o?0.35 - x - x x
    openhat: - - x:0.4 - - - x:0.35 - - - x:0.4 - - - x:0.35 -
}

pattern beat_drop {
    kick:    X - - - X - - - X - - - X - - -
    clap:    - - - - X - - - - - - - X - - -
    hat:     x x?0.6 x x?0.5  x x?0.6 x x?0.5  x x?0.6 x x?0.5  x x?0.6 x x*2
    openhat: - - x:0.5 - - - x:0.45 - - - x:0.5 - - - x:0.45 -
}

# Rolling 16th-note bass, root-heavy with passing tones.
pattern bass_pulse_groove {
    1.2:0.9 1.2:0.5 1.2:0.7 1.2:0.5   1.2:0.85 1.2:0.5 2.2:0.6 1.2:0.5   1.2:0.9 1.2:0.5 1.2:0.7 1.2:0.5   5.2:0.75 1.2:0.5 1.2:0.6 -
}

pattern bass_pulse_drop {
    1.2:0.95 ~1.2:0.6 1.2:0.8 1.2:0.55   1.2:0.9 ~2.2:0.6 1.2:0.75 1.2:0.55   1.2:0.95 ~5.2:0.6 1.2:0.8 1.2:0.55   1.2:0.9 ~1.2:0.6 1.2:0.75 -
}

# FM stab, answers the kick on the off-beats (the "&" of 2 and the "&" of 4).
pattern stab_answer {
    - - - - - - 1.4:0.6 - - - - - - - 1.4:0.55 -
}

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track bassdrone {
    play drone_em8
    using drone
    velocity 0.9
    level 0.42
    gate 1.0
    reverb_send 0.35
    sidechain 0.55
    out > saturate(0.35) > master
}

track organ {
    play organ_em8
    using doomorgan
    velocity 0.85
    level 0.28
    gate 1.0
    reverb_send 0.5
    delay_send 0.15
    sidechain 0.6
    out > saturate(0.4) > phaser(0.45, bars=14) > master
}

track drums {
    play beat_enter
    using kit
    velocity 1.0
    level 0.85
    reverb_send 0.06
    out > master
}

track bassline {
    play bass_pulse_groove
    using pulse
    velocity 0.9
    level 0.5
    gate 0.35
    sidechain 0.65
    out > saturate(0.2) > master
}

track stab {
    play stab_answer
    using stab
    velocity 0.85
    level 0.32
    gate 0.2
    pan 0.15
    delay_send 0.2
    reverb_send 0.25
    sidechain 0.5
    out > saturate(0.3) > master
}

# ────────────────────────────────────────────────
# MASTER
# ────────────────────────────────────────────────

master {
    in > tilt(0.0)
       > eq(low=2.0, mid=0.0, high=-1.0)
       > compressor(-8, ratio=3.5, attack=15, release=90, makeup=1.5)
       > limiter
       > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

# 1. Drone-only intro — nothing else. No drums here, so sidechain is inert
# (synth_check warning); levels are set low on purpose since this must be
# the quietest section in the render.
scene intro {
    track bassdrone { play drone_em8 using drone level 0.32 reverb_send 0.35 sidechain 0.55 }
    track organ     { play organ_em8 using doomorgan level 0.2 reverb_send 0.5 sidechain 0.6 }
}

# 2. Kick enters, drone holds.
scene kick_enter {
    track bassdrone { play drone_em8 using drone level 0.36 reverb_send 0.35 sidechain 0.55 }
    track organ     { play organ_em8 using doomorgan level 0.22 reverb_send 0.5 sidechain 0.6 }
    track drums     { play beat_enter using kit level 0.78 reverb_send 0.06 }
}

# 3. Groove with bass — drone moves to Cm, claps and ghost hats enter.
scene groove {
    track bassdrone { play drone_cm8 using drone level 0.42 reverb_send 0.35 sidechain 0.55 }
    track organ     { play organ_cm8 using doomorgan level 0.28 reverb_send 0.5 sidechain 0.6 }
    track drums     { play beat_groove using kit level 0.85 reverb_send 0.06 }
    track bassline  { play bass_pulse_groove using pulse level 0.55 gate 0.35 sidechain 0.65 }
}

# 4. Breakdown — kick and bassline drop out, drone rises, reverb freezes.
# No drums here either, so sidechain is inert (synth_check warning); levels
# sit below the groove's ducked-but-louder mix so the breakdown reads as a
# dip in energy, not a volume spike, even though the filter is opening up.
scene breakdown {
    reverb_freeze = 1
    auto drone cutoff 0.15 > 0.5
    auto doomorgan cutoff 0.35 > 0.6

    track bassdrone { play drone_em8 using drone level 0.22 reverb_send 0.35 sidechain 0.55 }
    track organ     { play organ_em8 using doomorgan level 0.14 reverb_send 0.5 sidechain 0.6 }
}

# 5. The drop — everything, master brightens.
scene drop {
    auto drone cutoff 0.5 > 0.32
    auto doomorgan cutoff 0.6 > 0.4
    auto master tilt -0.2 > 0.3

    track bassdrone { play drone_edrop12 using drone level 0.62 reverb_send 0.3 sidechain 0.6 }
    track organ     { play organ_edrop12 using doomorgan level 0.4 reverb_send 0.45 sidechain 0.65 }
    track drums     { play beat_drop using kit level 1.0 reverb_send 0.06 }
    track bassline  { play bass_pulse_drop using pulse level 0.68 gate 0.35 sidechain 0.7 }
    track stab      { play stab_answer using stab level 0.4 gate 0.2 pan 0.15 delay_send 0.2 reverb_send 0.25 sidechain 0.5 }
}

# 6. Outro — drone alone, dying. No drums here, so sidechain is inert
# (synth_check warning); starts already below the drop's level and fades to
# near-silence so it lands as the quietest moment alongside the intro.
scene outro {
    auto drone cutoff 0.32 > 0.08
    auto doomorgan cutoff 0.4 > 0.12
    auto bassdrone level 0.3 > 0.03
    auto organ level 0.18 > 0.02

    track bassdrone { play drone_em4 using drone level 0.3 reverb_send 0.35 sidechain 0.55 }
    track organ     { play organ_em4 using doomorgan level 0.18 reverb_send 0.5 sidechain 0.6 }
}

# ────────────────────────────────────────────────
# ARRANGEMENT — 48 bars
# ────────────────────────────────────────────────

arrange {
    intro x8
    kick_enter x8
    groove x8
    breakdown x8
    drop x12
    outro x4
}
