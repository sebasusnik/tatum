# round2_deephouse.synth — Deep House, 122 BPM, F minor
# intro(4) -> groove(8) -> build(4) -> drop(8) -> breakdown(4) -> outro(4) = 32 bars

tempo 122
meter 4/4
scale F minor
sidechain 0.3
swing 0.58
humanize 0.3 timing 0.15

delay sync=dotted_eighth feedback=0.35 filter=0.5
reverb size=0.75 damp=0.3 predelay=25

# ────────────────────────────────────────────────
# MODULES
# ────────────────────────────────────────────────

module beats kit {
    kick_level 1.0
    kick_decay 0.5
    kick_pitch 0.3
    kick_click 0.35
    kick_drive 0.1
    hihat_level 0.7
    hihat_decay 0.35
    hihat_pitch 0.5
    hihat_pan 0.25
    clap_level 0.85
    clap_pan -0.1
}

module bass sub {
    cutoff 0.16
    cutoff_env 0.4
    resonance 0.4
    glide 0.08
    osc1_wave saw
    osc2_wave saw
    osc2_pitch 0.25
    keytrack 0.3
    attack 0.005
    decay 0.3
    sustain 0.75
    release 0.12
}

module fm stab {
    algorithm two_op
    mod_index 0.5
    feedback 0.12
    waveform sine
    chorus_mix 0.15
    op0_envelope 0.001 0.15 0.1 0.12
    op1_envelope 0.001 0.1 0.05 0.08
}

module keys cloud {
    voice_mode unison
    detune 0.4
    chorus_mix 0.55
    cutoff 0.26
    resonance 0.32
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync free
    lfo_rate 0.008
    lfo_depth 0.1
    vibrato_rate 0.3
    vibrato_depth 0.05
    attack 1.0
    decay 0.6
    sustain 0.8
    release 1.0
}

module keys arp_lead {
    voice_mode poly
    cutoff 0.3
    resonance 0.55
    attack 0.002
    decay 0.15
    sustain 0.4
    release 0.15
    lfo_target cutoff
    lfo_waveform sine
    lfo_sync free
    lfo_rate 0.05
    lfo_depth 0.08
}

# ────────────────────────────────────────────────
# PATTERNS
# ────────────────────────────────────────────────

pattern silence {
    - - - -
    - - - -
    - - - -
    - - - -
}

# Drums
pattern drums_intro {
    kick: X - - -  - - - -  X - - -  - - - -
    hat:  - - x -  - - x -  - - x -  - - x -
}

pattern drums_groove {
    kick:  X - - -  X - - -  X - - -  X - - -
    hat:   - - x -  - - x -  - - x -  - - x -
    clap:  - - - -  X - - -  - - - -  X - - -
}

pattern drums_build {
    kick:  X - - -  X - - -  X - - x  X - x -
    hat:   - - x -  - x x -  - - x -  x x x x
    clap:  - - - -  X - - -  - - - -  X - - -
}

pattern drums_drop {
    kick:    X - - -  X - - -  X - - -  X - - x
    hat:     - - x -  - - x -  - - x -  - - x -
    clap:    - - - -  X - - -  - - - -  X - - -
    openhat: - - - -  - - - -  - - - -  - - - x
}

pattern drums_breakdown {
    hat: - - x -  - - x -  - - x -  - - x -
}

pattern drums_outro {
    kick: X - - -  - - - -  X - - -  - - - -
    hat:  - - x -  - - x -  - - x -  - - x -
}

# Bass
pattern bass_intro {
    F1:0.5 - - -
    -      - - -
    F1:0.4 - - -
    -      - - -
}

pattern bass_groove {
    F1:0.85(edepth=0.40, res=0.50) -  -  F1:0.5(edepth=0.25, res=0.35)
    -  Eb1:0.7(edepth=0.35, res=0.45) .. -
    Ab1:0.75(edepth=0.40, res=0.48) -  F1:0.4(edepth=0.20, res=0.30) -
    C1:0.6(edepth=0.30, res=0.40) -  -  Eb1:0.55(edepth=0.30, res=0.40)
}

pattern bass_build {
    F1:0.85(edepth=0.45, res=0.50) - F1:0.6 -
    F1:0.85(edepth=0.45, res=0.50) - F1:0.6 -
    Ab1:0.85(edepth=0.45, res=0.50) - Ab1:0.6 -
    Ab1:0.9(edepth=0.50, res=0.55) - Ab1:0.65 -
}

pattern bass_drop {
    F1:0.95(edepth=0.55, res=0.60) -  -  F1:0.6(edepth=0.35, res=0.45)
    -  Eb1:0.8(edepth=0.45, res=0.55) .. -
    Ab1:0.85(edepth=0.50, res=0.58) -  F1:0.5(edepth=0.30, res=0.40) -
    C1:0.7(edepth=0.40, res=0.50) -  -  Eb1:0.65(edepth=0.35, res=0.45)
}

pattern bass_breakdown {
    F1:0.5 .. .. ..
    ..     .. .. ..
    ..     .. .. ..
    ..     .. .. ..
}

pattern bass_outro {
    F1:0.4 - - -
    -      - - -
    F1:0.3 - - -
    -      - - -
}

# FM stab, chords on the off-beats
pattern stab_off {
    -  -  [Ab3 C4 Eb4]:0.5   -
    -  -  [F3 Ab3 C4]:0.45   -
    -  -  [Ab3 C4 Eb4]:0.5   -
    -  -  [Db3 F3 Ab3]:0.45  -
}

pattern stab_drop {
    -  -  [Ab3 C4 Eb4]:0.6   -
    -  -  [F3 Ab3 C4]:0.55   -
    -  -  [Ab3 C4 Eb4]:0.6   -
    -  -  [Eb3 G3 Bb3]:0.55  -
}

# Liquid pad, jazz voicings held with ties, 2-bar chord movement
pattern pad_verse {
    [F3 Ab3 C4 Eb4 G4]:0.35 .. .. ..
    ..                       .. .. ..
    ..                       .. .. ..
    ..                       .. .. ..
    [Db3 F3 Ab3 C4 Eb4]:0.35 .. .. ..
    ..                        .. .. ..
    ..                        .. .. ..
    ..                        .. .. ..
}

pattern pad_drop {
    [F3 Ab3 C4 Eb4 G4]:0.4 .. .. ..
    ..                      .. .. ..
    ..                      .. .. ..
    ..                      .. .. ..
    [Ab3 C4 Eb4 G4]:0.4 .. .. ..
    ..                   .. .. ..
    ..                   .. .. ..
    ..                   .. .. ..
}

pattern pad_breakdown {
    [F3 Ab3 C4 Eb4 G4]:0.45 .. .. ..
    ..                        .. .. ..
    ..                        .. .. ..
    ..                        .. .. ..
    [Db3 F3 Ab3 C4 Eb4]:0.45 .. .. ..
    ..                         .. .. ..
    ..                         .. .. ..
    ..                         .. .. ..
}

pattern pad_outro {
    [F3 Ab3 C4 Eb4]:0.3 .. .. ..
    ..                    .. .. ..
    ..                    .. .. ..
    ..                    .. .. ..
    [F3 Ab3 C4 Eb4]:0.2 .. .. ..
    ..                    .. .. ..
    ..                    .. .. ..
    ..                    .. .. ..
}

# Arp lead: chord held, arpeggiator plays through it
pattern arp_chord {
    [F4 Ab4 C5 Eb5]:0.6 .. .. ..
    ..                    .. .. ..
    ..                    .. .. ..
    ..                    .. .. ..
}

# ────────────────────────────────────────────────
# BUS FX
# ────────────────────────────────────────────────

bus drumBus
drumBus { in > compressor(-8.0, ratio=4.0, attack=8, release=60) > saturate(0.12) > master }

# ────────────────────────────────────────────────
# TRACKS
# ────────────────────────────────────────────────

track drums {
    play drums_intro
    using kit
    velocity 1.0
    level 0.5
    pan 0.0
    out > drumBus
}

track bass {
    play bass_intro
    using sub
    velocity 0.8
    level 0.5
    gate 0.9
    pan 0.0
    sidechain 0.4
    delay_send 0.05
    reverb_send 0.1
    out > drive(0.15) > master
}

track stab {
    play silence
    using stab
    velocity 0.5
    level 0.3
    gate 0.25
    pan -0.25
    delay_send 0.3
    reverb_send 0.15
    out > saturate(0.35) > master
}

track pad {
    play silence
    using cloud
    velocity 0.4
    level 0.28
    reverb_send 0.4
    delay_send 0.12
    sidechain 0.4
    out > highpass(280, 0.4) > lowpass(3500, 0.3) > master
}

track arp {
    play silence
    using arp_lead
    velocity 0.5
    level 0.32
    gate 0.6
    pan 0.15
    delay_send 0.25
    reverb_send 0.2
    arp off
    out > saturate(0.2) > master
}

# ────────────────────────────────────────────────
# MASTER
# ────────────────────────────────────────────────

master {
    in > eq(low=2.0, mid=1.0, high=1.0) > compressor(-9.0, ratio=3.0, attack=8, release=80, makeup=2.0) > limiter(0.92) > out
}

# ────────────────────────────────────────────────
# SCENES
# ────────────────────────────────────────────────

scene intro {
    track drums { play drums_intro using kit velocity 0.9 level 0.45 }
    track bass  { play bass_intro  using sub  velocity 0.7 level 0.4 gate 0.9 sidechain 0.4 }
    track pad   { play pad_verse   using cloud velocity 0.3 level 0.18 reverb_send 0.45 sidechain 0.4 }
}

scene groove {
    auto sub cutoff 0.16 > 0.2

    track drums { play drums_groove using kit velocity 1.0 level 0.55 }
    track bass  { play bass_groove using sub velocity 0.9 level 0.55 gate 0.9 sidechain 0.5 delay_send 0.05 reverb_send 0.1 }
    track stab  { play stab_off using stab velocity 0.55 level 0.32 gate 0.25 delay_send 0.3 reverb_send 0.15 }
    track pad   { play pad_verse using cloud velocity 0.4 level 0.24 reverb_send 0.4 delay_send 0.12 sidechain 0.4 }
}

scene build {
    auto sub cutoff 0.18 > 0.26
    auto cloud cutoff 0.26 > 0.4

    track drums { play drums_build using kit velocity 1.0 level 0.58 }
    track bass  { play bass_build using sub velocity 0.9 level 0.58 gate 0.85 sidechain 0.5 }
    track stab  { play stab_off using stab velocity 0.6 level 0.35 gate 0.25 delay_send 0.3 reverb_send 0.12 }
    track pad   { play pad_verse using cloud velocity 0.45 level 0.26 reverb_send 0.35 delay_send 0.1 sidechain 0.45 }
}

scene drop {
    auto sub cutoff 0.2 > 0.28

    track drums { play drums_drop using kit velocity 1.0 level 0.68 }
    track bass  { play bass_drop using sub velocity 0.95 level 0.65 gate 0.9 sidechain 0.55 }
    track stab  { play stab_drop using stab velocity 0.65 level 0.42 gate 0.25 delay_send 0.25 reverb_send 0.12 }
    track pad   { play pad_drop using cloud velocity 0.5 level 0.32 reverb_send 0.35 delay_send 0.1 sidechain 0.5 }
    track arp   { play arp_chord using arp_lead velocity 0.6 level 0.32 gate 0.6 pan 0.15 delay_send 0.25 reverb_send 0.2 arp up rate=16 gate=0.6 octaves=2 }
}

scene breakdown {
    auto cloud cutoff 0.3 > 0.45 > 0.3

    track drums { play drums_breakdown using kit velocity 0.8 level 0.4 }
    track bass  { play bass_breakdown using sub velocity 0.5 level 0.3 gate 0.9 sidechain 0.3 }
    track pad   { play pad_breakdown using cloud velocity 0.4 level 0.24 reverb_send 0.5 delay_send 0.15 sidechain 0.3 }
}

scene outro {
    auto sub cutoff_env 0.4 > 0.2
    auto cloud cutoff 0.3 > 0.15

    track drums { play drums_outro using kit velocity 0.85 level 0.4 }
    track bass  { play bass_outro using sub velocity 0.6 level 0.35 gate 0.9 sidechain 0.35 }
    track pad   { play pad_outro using cloud velocity 0.35 level 0.2 reverb_send 0.45 delay_send 0.1 sidechain 0.35 }
}

# ────────────────────────────────────────────────
# ARRANGEMENT (32 bars)
# ────────────────────────────────────────────────

arrange {
    intro x4
    groove x8
    build x4
    drop x8
    breakdown x4
    outro x4
}
