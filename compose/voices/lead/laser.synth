# Laser lead: serial FM with a growling index LFO and vibrato, held notes
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named by its role. `use` it from any song.
module fm laser {
    algorithm serial4
    level 1.6
    mod_index 55%
    feedback 22%
    waveform sine
    op0_ratio 1x
    op1_ratio 2x
    op2_ratio 1.005x
    op3_ratio 3x
    op0_envelope 0.004 0.25 0.7 0.15
    op1_envelope 0.002 0.18 0.5 0.12
    op2_envelope 0.002 0.30 0.4 0.12
    op3_envelope 0.001 0.10 0.2 0.08
    lfo_target mod_index
    lfo_sync bars_2
    lfo_waveform triangle
    lfo_depth 35%
    vibrato_rate 5.5hz
    vibrato_depth 18%
}

pattern laser_line {
    1.4:0.9  ..  ..  2.4:0.8   ..  ..  1.4:0.8  ..   5.3:0.9  ..  ..  ..   7.3:0.8  ..  1.4:0.9  ..
    2.4:0.9  ..  ..  3.4:0.8   ..  ..  2.4:0.8  ..   1.4:0.9  ..  ..  ..   ..  ..  -  -
    1.4:0.9  ..  ..  2.4:0.8   ..  ..  1.4:0.8  ..   5.4:1.0  ..  ..  4.4:0.8   ..  3.4:0.8  2.4:0.8  ..
    1.4:0.9  ..  ..  ..   <5.3:0.6 7.3:0.7 1.4:0.8 2.4:0.9>  <3.4:0.8 5.4:0.9 7.4:0.95 1.5:1.0>  1.5:1.0  ..   ..  ..  ..  ..   -  -  -  -
}

track lead {
    play laser_line
    using laser
    level 0.12
    velocity 1.0
    gate 0.95
    pan 0.05
    delay_send 0.3
    reverb_send 0.22
    sidechain 0.45
    out > highpass(300hz, 0.05)
        > saturate(0.3) as drive
        > phaser(0.3, bars=8) as ph
        > master
}
