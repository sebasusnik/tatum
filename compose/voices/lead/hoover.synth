# Hoover: four layers of saws and pulses, every note diving in, one envelope filter bending them
# A voice: its modules, its patterns in degrees of whatever scale the groove
# sets, and its tracks. `use` it from any song. Four layers, one a side and
# two pulses between, beat slowly against each other; the envelope filter is
# on their bus, so one follower hears all four.
module bass hoover {
    osc2_pitch -12st
    osc3_pitch 0.11st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

module bass hoover_r {
    osc2_pitch -12.07st
    osc3_pitch -0.09st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

# The pulse layers: two squares a fifth of a semitone apart, the hoover's PWM.
module bass hoover_pl {
    osc1_wave square
    osc2_wave square
    osc3_wave saw
    osc2_pitch 0.23st
    osc3_pitch -12.15st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

module bass hoover_pr {
    osc1_wave square
    osc2_wave square
    osc3_wave saw
    osc2_pitch -0.21st
    osc3_pitch 12.1st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

# Two bars of call, two of nothing.
pattern hoover_line {
    <1.4:1.0 ~1.3> .. .. ..  1.3:0.8 .. ~7.2 ..  ~1.3 .. .. ..  <5.3:0.9 ~5.2> .. ~6.2 ..
    .. .. .. <6.3:0.85 ~6.2>  .. ~5.2 .. ..  .. .. 5.2:0.75 ..  .. .. .. ..
    -*32
}

bus hoover_bus
hoover_bus { in > autowah(0.03, base=350hz, range=1500hz, peak=0.7, attack=6, release=300, wobble=300, wobble_hz=2.75, lowpass, wet=0.85)
               > highpass(200hz, 0.05) > lowpass(5khz, 0.05) > master }

track hoover {
    play hoover_line
    using hoover
    level 0.34
    pan -0.6
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover_bus
}

track hoover_r {
    play hoover_line
    using hoover_r
    level 0.34
    pan 0.6
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover_bus
}

track hoover_pl {
    play hoover_line
    using hoover_pl
    level 0.26
    pan -0.25
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover_bus
}

track hoover_pr {
    play hoover_line
    using hoover_pr
    level 0.22
    pan 0.25
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > hoover_bus
}
