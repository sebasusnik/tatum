# Hoover: saws an octave apart, every note diving in, an envelope filter bending it
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named by its role. `use` it from any song.
module bass hoover {
    osc2_pitch -12st
    osc3_pitch 0.11st
    cutoff 1.4khz
    cutoff_env 700hz
    resonance 0.05
    glide 0.42
    attack 30ms
    decay 600ms
    sustain 0.65
    release 350ms
}

# Two bars of call, two of nothing.
pattern hoover_line {
    <1.4:1.0 ~1.3> .. .. ..  1.3:0.8 .. ~7.2 ..  ~1.3 .. .. ..  <5.3:0.9 ~5.2> .. ~6.2 ..
    .. .. .. <6.3:0.85 ~6.2>  .. ~5.2 .. ..  .. .. 5.2:0.75 ..  .. .. .. ..
    -*32
}

track lead {
    play hoover_line
    using hoover
    level 0.4
    gate 0.95
    reverb_send 0.22
    delay_send 0.1
    out > autowah(0.03, base=350hz, range=1500hz, peak=0.7, attack=6, release=300, wobble=300, wobble_hz=2.75, lowpass, wet=0.85) as wah
        > highpass(200hz, 0.05)
        > lowpass(5khz, 0.05) as lp
        > master
}
