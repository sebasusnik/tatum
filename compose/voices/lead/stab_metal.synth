# Struck metal in a chord, twice a bar, answering whatever plays
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named as the voice. `use` it from any song.
module fm stab_metal {
    algorithm dual_pairs
    level 1.8
    mod_index 75%
    feedback 25%
    waveform sine
    op0_ratio 1x
    op1_ratio 3.41x
    op2_ratio 1x
    op3_ratio 5.07x
    op0_envelope 0.001 0.18 0.0 0.1
    op1_envelope 0.001 0.1 0.0 0.06
    op2_envelope 0.001 0.14 0.0 0.08
    op3_envelope 0.001 0.06 0.0 0.04
}

pattern stab_metal_line {
    - - - -  - - - -  - - - -  - - - -
    - - - -  - - [1.3 5.3 2.4]:0.9 -  - - - -  - - [1.3 5.3 2.4]:0.7 -
}

track stab_metal {
    play stab_metal_line
    using stab_metal
    level 0.15
    velocity 1.0
    gate 0.4
    pan -0.3
    delay_send 0.25
    reverb_send 0.15
    out > highpass(250hz, 0.05)
        > bitcrush(8, 0.3, wet=0) as crush
        > master
}
