# A dub chord on the offbeat: detuned, chorused, filtered to a mumble; the echoes are the melody
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named as the voice. `use` it from any song.
module keys chord_dub {
    voice_mode poly
    detune 22%
    chorus_mix 55%
    cutoff 1.7khz
    resonance 26%
    attack 14ms
    decay 210ms
    sustain 6%
    release 260ms
    lfo_target cutoff
    lfo_waveform triangle
    lfo_sync bars_8
    lfo_depth 14%
    vibrato_rate 0.6hz
    vibrato_depth 3%
}

pattern chord_dub_stabs {
    -  -  [1.3 3.3 5.3 7.3 2.4]:0.7   -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.5   -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.64  -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.46  -
    -  -  [1.3 3.3 5.3 7.3 2.4]:0.7   -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.5   -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.64  -    -  -  -  -
    -  -  [1.3 3.3 5.3 7.3 2.4]:0.68  -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.5   -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.62  -    -  -  [1.3 3.3 5.3 7.3 2.4]:0.44  -
    -  -  [6.2 1.3 3.3 5.3 7.3]:0.66  -    -  -  [6.2 1.3 3.3 5.3 7.3]:0.5   -    -  -  [6.2 1.3 3.3 5.3 7.3]:0.6   -    -  -  -  -
}

track chord_dub {
    play chord_dub_stabs
    using chord_dub
    level 0.29
    gate 0.16
    velocity 0.75
    pan -0.12
    delay_send 0.85
    reverb_send 0.60
    sidechain 0.5
    out > highpass(300hz, 0.15)
        > lowpass(3.6khz, 0.12, lfo_bars=8, lfo_depth=1400) as lp
        > compressor(-14, ratio=2.0, attack=15, release=200, makeup=3db)
        > saturate(0.2) as drive
        > master
}
