# A shaker of FM noise: sixteenths with fixed accents, ghosts coming and going
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named by its role. `use` it from any song.
module fm shaker {
    algorithm pair_plus_two
    level 1.2
    mod_index 100%
    feedback 100%
    waveform sine
    op0_ratio 7.1x
    op1_ratio 5.3x
    op2_ratio 9.7x
    op3_ratio 2.51x
    op0_envelope 0.002 0.045 0.0 0.03
    op1_envelope 0.002 0.045 0.0 0.03
    op2_envelope 0.002 0.045 0.0 0.03
    op3_envelope 0.002 0.045 0.0 0.03
    op0_feedback 90%
}

pattern shaker_line {
    5.5:0.50 5.5:0.33 5.5:0.76 5.5:0.27 5.5:0.46 5.5:0.21 5.5:0.82 5.5:0.22 5.5:0.51 - 5.5:0.77 5.5:0.33 5.5:0.59 5.5:0.28 5.5:0.90 5.5:0.37
    5.5:0.49 5.5:0.22 5.5:0.80 - 5.5:0.48 5.5:0.33 5.5:0.81 5.5:0.21 5.5:0.46 5.5:0.34 5.5:0.81 5.5:0.32 5.5:0.52 5.5:0.36 5.5:0.85 5.5:0.31
    5.5:0.53 - 5.5:0.86 5.5:0.40 5.5:0.47 5.5:0.35 5.5:0.77 5.5:0.21 5.5:0.55 - 5.5:0.84 - 5.5:0.50 - 5.5:0.84 5.5:0.29
    5.5:0.58 - 5.5:0.82 - 5.5:0.46 - 5.5:0.85 - 5.5:0.57 5.5:0.28 5.5:0.85 5.5:0.29 5.5:0.48 5.5:0.21 5.5:0.87 5.5:0.25
}

track perc {
    play shaker_line
    using shaker
    level 0.08
    velocity 1.0
    gate 0.2
    pan 0.3
    reverb_send 0.08
    out > highpass(6khz, 0.05)
        > lowpass(14khz, 0.05) as lp
        > autopan(0.4, hz=0.3) as pan
        > master
}
