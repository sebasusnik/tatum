# A 303: squelch with slides, the resonance high, the filter plucked by velocity
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named as the voice. `use` it from any song.
module bass acid {
    osc1_wave saw
    cutoff 260hz
    cutoff_env 3200hz
    resonance 84%
    glide 14%
    keytrack 20%
    attack 1ms
    decay 170ms
    sustain 15%
    release 40ms
    vel_env 60%
}

pattern acid_line {
    1.2:0.9  1.2:0.5  ~2.2:0.8  1.2:0.6   5.2:0.9  -  1.3:0.9  ~7.2:0.7
    1.2:0.8  1.2:0.5  4.2:0.8   -         ~5.2:0.9  3.2:0.6  1.3:1.0  ~2.3:0.8
    1.2:0.9  -        1.2:0.6   ~1.3:0.9  7.2:0.7  5.2:0.8  -  2.2:0.9
    1.2:0.8  <1.2:0.6 1.3:0.8>  ~2.2:0.7  1.2:0.6   5.1:0.9  -  ~1.2:0.8  -
}

track acid {
    play acid_line
    using acid
    level 0.6
    velocity 1.0
    gate 0.55
    pan 0.1
    delay_send 0.18
    reverb_send 0.06
    out > highpass(150hz, 0.05)
        > saturate(0.6) as drive
        > autopan(0.35, bars=4, wet=0) as pan
        > master
}
