# Jungle sub: the fundamental and a hair of the second, holding and sliding
# A voice: one module, its pattern in degrees of whatever scale the groove
# sets, and a track named by its role. `use` it from any song.
module bass sub_jungle {
    cutoff 115hz
    cutoff_env 60hz
    resonance 0.05
    glide 0.22
    attack 2ms
    decay 400ms
    sustain 0.9
    release 90ms
}

# Four bars. The gaps are where the kick is heard.
pattern sub_jungle_line {
    1.1:0.95 ..*9  - -  1.1:0.7 ..  3.1:0.8 ..
    ~1.1:0.9 ..*7  - -  - -  7.1:0.8 .. .. ..
    6.1:0.95 ..*9  - -  6.1:0.7 ..  5.1:0.8 ..
    ~4.1:0.9 ..*5  - -  5.1:0.85 ..  ~6.1 ..  ~5.1 .. .. ..
}

track bass {
    play sub_jungle_line
    using sub_jungle
    level 0.5
    gate 0.95
    sidechain 0.3
    out > lowpass(160hz, 0.05) as lp > master
}
